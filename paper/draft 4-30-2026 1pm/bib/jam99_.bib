  keywords  = {quantum > measurement, quantum > harmonic oscillator, detector > displacement > NV center, magnetic resonance > NV center, cantilever > readout > NV center, MRFM > NV center},
  owner     = {jam99},
  timestamp = {2012.06.04},
}

