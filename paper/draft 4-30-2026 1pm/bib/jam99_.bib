@Article{Kroeze2004jun,
  author    = {Kroeze, Jessica E. and Savenije, Tom J. and Warman, John M.},
  title     = {Electrodeless Determination of the Trap Density, Decay Kinetics, and Charge Separation Efficiency of Dye-Sensitized Nanocrystalline {TiO}$_2$},
  journal   = {J. Am. Chem. Soc.},
