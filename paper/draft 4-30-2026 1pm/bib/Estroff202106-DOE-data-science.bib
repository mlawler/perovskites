@article{Chung2023apr,
  title = {Engineering {{Perovskite Precursor Inks}} for {{Scalable Production}} of {{High-Efficiency Perovskite Photovoltaic Modules}}},
  author = {Chung, Jaehoon and Kim, Seung-Woo and Li, You and Mariam, Tamanna and Wang, Xiaoming and Rajakaruna, Manoj and Saeed, Muhammad Mohsin and Abudulimu, Abasi and Shin, Seong Sik and Guye, Kathryn N. and Huang, Zixu and Westbrook, Robert J. E. and Miller, Emily and Subedi, Biwas and Podraza, Nikolas J. and Heben, Michael J. and Ellingson, Randy J. and Ginger, David S. and Song, Zhaoning and Yan, Yanfa},
  year = 2023,
  month = apr,
  journal = {Advanced Energy Materials},
  volume = {13},
  number = {22},
  pages = {2300595},
  issn = {1614-6840},
  doi = {10.1002/aenm.202300595},
  urldate = {2024-01-10},
  abstract = {Blade coating of perovskite solar cells (PSCs) and modules has progressed considerably toward the industrial production of perovskite photovoltaics. Developing stable perovskite precursors is critical for achieving uniform coating over large areas. Here, the engineering of a perovskite precursor solution consisting of 2-methoxyethanol (2-Me) and 1,3-dimethyl-imidazolidinone (DMI) with superior intermediate phase stability that enables scalable production of efficient perovskite solar modules is reported. With this perovskite precursor solution, uniform and pinhole-less perovskite film is deposited over a large area of {$>$} 100 cm2 and higher-efficiency PSCs and modules are obtained. The best-performing unit cell and module with n-i-p configuration reach power conversion efficiencies of 23.4\% and 20.1\%, respectively. Additionally, a series of non-destructive metrology methods, such as spectroscopic ellipsometry, hyperspectral photoluminescence, electroluminescence, and laser beam-induced current mapping, are employed to assess and guide the development the blade-coated perovskite modules. This results show that rational engineering of precursor inks for blade coating is promising for the scalable production of efficient perovskite solar modules.},
  copyright = {\copyright{} 2023 The Authors. Advanced Energy Materials published by Wiley-VCH GmbH},
  langid = {english},
  keywords = {blade coating,metrology,perovskite photovoltaic modules,perovskite solar cells,precursor ink engineering},
  file = {/Users/jam99/Zotero/storage/6MLQLH8R/Chung et al_2023_Engineering Perovskite Precursor Inks for Scalable Production of.pdf;/Users/jam99/Zotero/storage/X8KMIYW8/aenm.html}
}

@article{Coffey2006sep,
  type = {Article},
  title = {Time-Resolved Electrostatic Force Microscopy of Polymer Solar Cells},
  author = {Coffey, David C. and Ginger, David S.},
  year = 2006,
  month = sep,
  journal = {Nat. Mater.},
  volume = {5},
  number = {9},
  pages = {735--740},
  issn = {1476-1122},
  doi = {10.1038/nmat1712},
  abstract = {Blends of conjugated polymers with fullerenes, polymers, or nanocrystals make promising materials for low-cost photovoltaic applications. Different processing conditions affect the efficiencies of these solar cells by creating a variety of nanostructured morphologies, however, the relationship between film structure and device efficiency is not fully understood. We introduce time-resolved electrostatic force microscopy (EFM) as a means to measure photoexcited charge in polymer films with a resolution of 100nm and 100 mu s. These EFM measurements correlate well with the external quantum efficiencies measured for a series of polymer photodiodes, providing a direct link between local morphology, local optoelectronic properties and device performance. The data show that the domain centres account for the majority of the photoinduced charge collected in polyfluorene blend devices. These results underscore the importance of controlling not only the length scale of phase separation, but also the composition of the domains when optimizing nanostructured solar cells.},
  langid = {english},
  keywords = {duplicate-citation-key},
  timestamp = {2009.07.31}
}

@article{Coffey2023sep,
  title = {In Situ Spin Coater for Multimodal Grazing Incidence X-Ray Scattering Studies},
  author = {Coffey, Aidan H. and Slack, Jonathan and Cornell, Earl and Yang, Lee L. and Anderson, Kevan and Wang, Kang and Dou, Letian and Zhu, Chenhui},
  year = 2023,
  month = sep,
  journal = {Rev. Sci. Instrum.},
  volume = {94},
  number = {9},
  pages = {093906},
  issn = {0034-6748},
  doi = {10.1063/5.0159297},
  urldate = {2024-02-09},
  abstract = {We present herein a custom-made, in situ, multimodal spin coater system with an integrated heating stage that can be programmed with spinning and heating recipes and that is coupled with synchrotron-based, grazing-incidence wide- and small-angle x-ray scattering. The spin coating system features an adaptable experimental chamber, with the ability to house multiple ancillary probes such as photoluminescence and visible optical cameras, to allow for true multimodal characterization and correlated data analysis. This system enables monitoring of structural evolutions such as perovskite crystallization and polymer self-assembly across a broad length scale (2 \AA --150~nm) with millisecond temporal resolution throughout a complete thin film fabrication process. The use of this spin coating system allows scientists to gain a deeper understanding of temporal processes of a material system, to develop ideal conditions for thin film manufacturing.},
  file = {/Users/jam99/Zotero/storage/84R9VVKP/Coffey et al_2023_In situ spin coater for multimodal grazing incidence x-ray scattering studies.pdf;/Users/jam99/Zotero/storage/QYH5TTHC/In-situ-spin-coater-for-multimodal-grazing.html}
}

@article{Cohen2019auga,
  title = {Breakdown of the {{Static Picture}} of {{Defect Energetics}} in {{Halide Perovskites}}: {{The Case}} of the {{Br Vacancy}} in {{CsPbBr3}}},
  shorttitle = {Breakdown of the {{Static Picture}} of {{Defect Energetics}} in {{Halide Perovskites}}},
  author = {Cohen, Ayala V. and Egger, David A. and Rappe, Andrew M. and Kronik, Leeor},
  year = 2019,
  month = aug,
  journal = {J. Phys. Chem. Lett.},
  volume = {10},
  number = {16},
  pages = {4490--4498},
  publisher = {American Chemical Society},
  doi = {10.1021/acs.jpclett.9b01855},
  urldate = {2023-04-03},
  abstract = {We consider the Br vacancy in CsPbBr3 as a prototype for the impact of structural dynamics on defect energetics in halide perovskites (HaPs). Using first-principles molecular dynamics based on density functional theory, we find that the static picture of defect energetics breaks down; the energy level associated with a Br vacancy is found to be intrinsically dynamic, oscillating by as much as 1 eV on the picosecond time scale at room temperature. These significant energy fluctuations are correlated with the distance between the neighboring Pb atoms across the vacancy and with the electrostatic potential at these Pb atomic sites. We expect this unusually strong coupling of structural dynamics and defect energetics to bear important implications for both experimental and theoretical analyses of defect characteristics in HaPs. It may also hold significant ramifications for carrier transport and defect tolerance in this class of photovoltaic materials.},
  file = {/Users/jam99/Zotero/storage/RR3LZTSD/Cohen et al. - 2019 - Breakdown of the Static Picture of Defect Energeti.pdf;/Users/jam99/Zotero/storage/SBF9IYBH/acs.jpclett.html}
}

