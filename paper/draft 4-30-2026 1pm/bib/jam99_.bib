@Article{Miller2012jul,
  author    = {Miller, Owen D. and Yablonovitch, Eli and Kurtz, Sarah R.},
  title     = {Strong Internal and External Luminescence as Solar Cells Approach the Shockley-Queisser Limit},
  journal   = {IEEE J. Photovoltaics},
  year      = {2012},
  volume    = {2},
  number    = {3},
  month     = {jul},
  pages     = {303 -- 311},
  doi       = {10.1109/JPHOTOV.2012.2198434},
  url       = {http://dx.doi.org/10.1109/JPHOTOV.2012.2198434},
  abstract  = {Absorbed sunlight in a solar cell produces electrons and holes. However, at the open-circuit condition, the carriers have no place to go. They build up in density, and ideally, they emit external luminescence that exactly balances the incoming sunlight. Any additional nonradiative recombination impairs the carrier density buildup, limiting the open-circuit voltage. At open circuit, efficient external luminescence is an indicator of low internal optical losses. Thus, efficient external luminescence is, counterintuitively, a necessity for approaching the Shockley-Queisser (SQ) efficiency limit. A great solar cell also needs to be a great light-emitting diode. Owing to the narrow escape cone for light, efficient external emission requires repeated attempts and demands an internal luminescence efficiency 90 [percent].},
  comment   = {Suggested filename = {Miller2012jul Strong Internal and External Luminescence as Solar Cells Approach the Shockley-Queisser Limit.pdf},
Source = {wxdoi2bib}},
  file      = {Miller2012jul Strong Internal and External Luminescence as Solar Cells Approach the Shockley-Queisser Limit.pdf:UNSORTED/Miller2012jul Strong Internal and External Luminescence as Solar Cells Approach the Shockley-Queisser Limit.pdf:PDF},
  keywords  = {project > EFM, project > MRFM, devices > solar cell > limits, devices > solar cell > limits and records, devices > solar cell > Voc},
  owner     = {jam99},
  timestamp = {2016.12.01},
}

