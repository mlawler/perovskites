@Article{Kronik1999dec,
  author    = {Kronik, L and Shapira, Y},
  title     = {Surface Photovoltage Phenomena: {T}heory, Experiment, and Applications},
  journal   = {Surf. Sci. Rep.},
  year      = {1999},
  volume    = {37},
