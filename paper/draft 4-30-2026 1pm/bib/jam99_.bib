  journal   = {Synthetic Metals},
  keywords  = {materials > PES > PDI, materials > PES > PDI8-CN2, materials > PES > PDI > derivatives > fluorinated, project > EFM, devices > OFET, charge trapping > measurements > TFT, charge trapping > measurements > transistor, charge trapping > measurements > bias stress},
