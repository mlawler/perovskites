  author    = {Li, Cheng and Tscheuschner, Steffen and Paulus, Fabian and Hopkinson, Paul E. and Kie{\ss}ling, Johannes and K\"ohler, Anna and Vaynzof, Yana and Huettner, Sven},
  title     = {Iodine Migration and Its Effect on Hysteresis in Perovskite Solar Cells},
