  file      = {Park2012nov Stability-Improved Organic N-Channel Thin-Film Transistors with nm-Thin Hydrophobic Polymer-Coated High-k Dielectrics.pdf:UNSORTED/Park2012nov Stability-Improved Organic N-Channel Thin-Film Transistors with nm-Thin Hydrophobic Polymer-Coated High-k Dielectrics.pdf:PDF},
  keywords  = {materials > PES > PTCDI–C13, materials > PES > PTCDI derivative,, materials > PES > perylenebisimides, materials > PES > perylene derivatives, materials > PES > n-type, materials > PES > n-channel, devices > FET, charge trapping > measurements > photo-excited charge collection spectroscopy, charge trapping > measurements > transistor, charge trapping > measurements > light},
