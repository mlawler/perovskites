  file = {/Users/jam99/Zotero/storage/8V47M8LE/Horiachyi et al. - 2025 - Efficient launching of shear phonons in photostrictive halide perovskites.pdf}
}

@article{Hou2023oct,
  title = {Synthesis of {{2D}} Perovskite Crystals via Progressive Transformation of Quantum Well Thickness},
  author = {Hou, Jin and Li, Wenbin and Zhang, Hao and Sidhik, Siraj and Fletcher, Jared and Metcalf, Isaac and Anantharaman, Surendra B. and Shuai, Xinting and Mishra, Anamika and Blancon, Jean-Christophe and Katan, Claudine and Jariwala, Deep and Even, Jacky and Kanatzidis, Mercouri G. and Mohite, Aditya D.},
  year = 2023,
