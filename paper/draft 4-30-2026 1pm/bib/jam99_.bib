  author    = {Nichol, John M. and Naibert, Tyler R. and Hemesath, Eric R. and Lauhon, Lincoln J. and Budakian, Raffi},
  title     = {Nanoscale {F}ourier-Transform Magnetic Resonance Imaging},
  journal   = {Phys. Rev. X},
