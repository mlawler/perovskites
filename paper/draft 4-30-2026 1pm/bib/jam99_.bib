  number      = {10, Part 2A},
  month       = {may},
  pages       = {6217 -- 6222},
  issn        = {0021-8979},
  doi         = {10.1063/1.355404},
  url         = {http://dx.doi.org/10.1063/1.355404},
  abstract    = {We present an experimental study of the thermally activated switching of the magnetization of individual isolated gamma-Fe2O3 Particles. These particles are prolate ellipsoids approximately 3000 angstrom long and 650 angstrom wide. The measured angular dependence of the switching field, H(s)(theta), is consistent at large angles with a uniform rotation, but as theta approaches zero, other modes of reversal appear possible, and most likely the mode of reversal is curling. By measuring the probability of reversal of the moment as a function of time and applied magnetic field at T approximately 300 K, we found that the switching was thermally assisted, but couldn't be described by hopping over a single energy barrier. Our results indicate that the dynamics of switching are described by a complex path in the energy landscape.},
  affiliation = {LEDERMAN, M (Reprint Author), UNIV CALIF SAN DIEGO,CTR MAGNET RECORDING RES,LA JOLLA,CA 92093. UNIV CALIF SAN DIEGO,DEPT PHYS,LA JOLLA,CA 92093. YOKOHAMA CITY UNIV,DEPT CHEM,KANAZAWA KU,YOKOHAMA 236,JAPAN.},
  comment     = {See Lederman1994oct. In this study, temperature was varied. While the magnetization (at low angles) was thermally activated, the dynamics "are complex and not descibed by hopping over a single barrier". Cited = 46.

Suggested filename = Lederman1994may Measurement of Thermal Switching of the Magnetization of Single-Domain Particles 10.1063/1.355404 *.pdf},
