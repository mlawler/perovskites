  author    = {Beal, Rachel E. and Slotcavage, Daniel J. and Leijtens, Tomas and Bowring, Andrea R. and Belisle, Rebecca A. and Nguyen, William H. and Burkhard, George F. and Hoke, Eric T. and McGehee, Michael D.},
