@Article{Garner2004jun,
  author    = {Garner, S. R. and Kuehn, S. and Dawlaty, J. M. and Jenkins, N. E. and Marohn, J. A.},
  title     = {Force-Gradient Detected Nuclear Magnetic Resonance},
  journal   = {Appl. Phys. Lett.},
  year      = {2004},
  volume    = {84},
  number    = {25},
  month     = {jun},
  pages     = {5091 -- 5093},
  doi       = {10.1063/1.1762700},
  url       = {http://dx.doi.org/10.1063/1.1762700},
  abstract  = {We have detected nuclear magnetic resonance in GaAs by selectively inverting Ga-71 spins to create a local force gradient which shifts the mechanical resonance frequency of a nearby magnet tipped microcantilever. Employing a low spring constant cantilever (60 muN/m) at 4.4 K and 7 T, we demonstrate a magnetic moment sensitivity of 7.5x10(-21) J/T, equal to the Curie Law magnetization from 7.1x10(8) Ga-71 spins. The method obviates the need to spin-lock sample magnetization during detection, allowing the signal to be collected for a time approaching the full spin-lattice relaxation time. (C) 2004 American Institute of Physics.},
  c1        = {Cornell Univ, Ctr Nanoscale Syst, Ithaca, NY 14853 USA.EOLEOLCornell Univ, Dept Chem & Biol Chem, Ithaca, NY 14853 USA.},
  comment   = {Suggested filename = Garner2004jun Force-gradient detected nuclear magnetic resonance 10.1063/1.1762700 *.pdf},
  em        = {jam99@cornell.edu},
  file      = {Garner2004jun Force-gradient detected nuclear magnetic resonance 10.1063\:1.1762700 *.pdf:UNSORTED/Garner2004jun Force-gradient detected nuclear magnetic resonance 10.1063\:1.1762700 *.pdf:PDF},
  j9        = {APPL PHYS LETT},
  ji        = {Appl. Phys. Lett.},
  keywords  = {marohn-manuscript, MRFM > NMR, MRFM > force gradient, MRFM > magnet-on-tip >NMR},
  owner     = {jam99},
  pg        = {3},
  rp        = {Garner, SR, Cornell Univ, Ctr Nanoscale Syst, Ithaca, NY 14853 USA.},
  sc        = {Physics, Applied},
  sn        = {0003-6951},
