  keywords-plus = {LIGHT-EMITTING-DIODES; HETEROJUNCTION SOLAR-CELLS; HOLE-TRANSPORTING MATERIALS; CONJUGATED TRIBLOCK COPOLYMERS; DONOR-ACCEPTOR HETEROJUNCTIONS; COIL DIBLOCK COPOLYMER; THIN-FILMS; HIGH-EFFICIENCY; REGIOREGULAR POLY(3-HEXYLTHIOPHENE); SUPRAMOLECULAR ORGANIZATION},
