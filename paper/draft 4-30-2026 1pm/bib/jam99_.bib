  number    = {4},
  pages     = {043703},
  doi       = {10.1063/1.4816433},
  url       = {http://dx.doi.org/10.1063/1.4816433},
  abstract  = {Magnetic resonance imaging (MRI) is conventionally performed in very high fields, and this leads to some restrictions in applications. To remove such restrictions, the ultra-low field MRI approach has been proposed. Because of the loss of sensitivity, the detection methods based on superconducting quantum interference devices (SQUIDs) in a shielded room were used. Atomic magnetometers have similar sensitivity as SQUIDs and can also be used for MRI, but there are some technical difficulties to overcome. We demonstrate that MRI of the human brain can be obtained with an atomic magnetometer with in-plane resolution of 3~mm in 13~min.},
  comment   = {Suggested filename = {Savukov2013jul Magnetic-resonance Imaging of the Human Brain With an Atomic Magnetometer.pdf}},
