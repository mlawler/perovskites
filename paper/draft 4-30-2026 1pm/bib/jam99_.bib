@Article{DeYoreo2015jul,
  author    = {De Yoreo, J. J. and Gilbert, P. U. P. A. and Sommerdijk, N. A. J. M. and Penn, R. L. and Whitelam, S. and Joester, D. and Zhang, H. and Rimer, J. D. and Navrotsky, A. and Banfield, J. F. and Wallace, A. F. and Michel, F. M. and Meldrum, F. C. and Colfen, H. and Dove, P. M.},
  title     = {Crystallization by Particle Attachment in Synthetic, Biogenic, and Geologic Environments},
  doi       = {10.1126/science.aaa6760},
  number    = {6247},
