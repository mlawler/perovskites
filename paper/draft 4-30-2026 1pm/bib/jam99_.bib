@Article{Street2003aug,
  author    = {Street, R. A. and Salleo, A. and Chabinyc, M. L.},
  title     = {Bipolaron mechanism for bias-stress effects in polymer transistors},
  language  = {English},
  volume    = {68},
  number    = {8},
  pages     = {85316},
  doi       = {10.1103/PhysRevB.68.085316},
  url       = {http://dx.doi.org/10.1103/PhysRevB.68.085316},
  abstract  = {The slow formation of hole bipolarons is proposed to explain the bias-stress effect that is observed in some polymer thin-film transistors ({TFT}). {T}he primary evidence is the observation that holes are removed from the channel at a rate proportional to the square of their concentration. {A}s bound hole pairs form, they deplete the {TFT} channel of mobile holes, which reduces the {TFT} current and causes a threshold voltage shift. {T}he slow rate of bipolaron formation is attributed to the mutual {C}oulomb repulsion of the holes. {C}ontrasting stress effects in different polymers are related to the magnitude of the bipolaron binding energy. {P}resent experiments cannot distinguish whether the bipolarons are intrinsic, or associated with disorder, interfaces, or impurities},
  comment   = {Suggested filenames = Street2003aug Bipolaron mechanism for bias-stress effects in polymer transistors 10.1103/PhysRevB.68.085316 *.pdf},
  copyright = {Copyright 2003, IEE},
  file      = {Street2003aug Bipolaron mechanism for bias-stress effects in polymer transistors 10.1103\:PhysRevB.68.085316 *.pdf:UNSORTED/Street2003aug Bipolaron mechanism for bias-stress effects in polymer transistors 10.1103\:PhysRevB.68.085316 *.pdf:PDF},
  journal   = {Phys. Rev. B},
  keywords  = {charge trapping > mechanisms > immobile bipolarons, materials > PES > F8T2, materials > PES > P3HT, charge trapping; de- > mechanisms > recombination polarons},
  month     = {aug},
  owner     = {jam99},
