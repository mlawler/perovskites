@Article{Abragam1958mar,
  Title                    = {Spin Temperature},
  Author                   = {Abragam, A. and Proctor, W. G.},
  Journal                  = {Phys. Rev.},
  Year                     = {1958},

  Month                    = {mar},
  Number                   = {5},
  Pages                    = {1441--1458},
  Volume                   = {109},

  Abstract                 = {The introduction of the concept of spin-temperature into the literature has not been adequately supported by theory and experiment, and it has not been clear when the concept is essential, merely convenient, or possibly inapplicable. In fields high compared to a defined "local field" and where the individual energy levels are equidistant, it is argued that spin temperature is a convenient but unnecessary notion. Where the levels are not equidistant a spin temperature cannot generally be defined. Experiments are cited or described which demonstrate the rapid establishment of a Boltzmann population ratio when three or more levels are equidistant.

It is for low fields, those which are comparable with the local field, that a theoretical examination making use of thermodynamic principles yields new quantitative predictions. In particular, a spin temperature is analytically defined, and its identity with thermodynamic temperature is experimentally established. Studies in "spin calorimetry," or the thermal mixing of two or more spin systems, strengthen the validity of the concept.},
  Doi                      = {10.1103/PhysRev.109.1441},
  File                     = {Abragam1958mar.pdf:Abragam1958mar.pdf:PDF},
  Keywords                 = {magnetic resonance > spin temperature, magnetic resonance > cross depolarization},
  Numpages                 = {17},
  Owner                    = {ewm},
  Publisher                = {American Physical Society},
  Timestamp                = {2010.10.13},
  Url                      = {http://dx.doi.org/10.1103/PhysRev.109.1441}
}

