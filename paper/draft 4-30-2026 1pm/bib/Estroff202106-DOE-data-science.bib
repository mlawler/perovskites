@article{Chen2019jan,
  title = {Precise {{Control}} of {{Crystal Growth}} for {{Highly Efficient CsPbI2Br Perovskite Solar Cells}}},
  author = {Chen, Weijie and Chen, Haiyang and Xu, Guiying and Xue, Rongming and Wang, Shuhui and Li, Yaowen and Li, Yongfang},
