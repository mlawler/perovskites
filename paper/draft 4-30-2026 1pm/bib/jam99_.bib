  url       = {http://dx.doi.org/10.1016/j.solidstatesciences.2012.04.019},
  abstract  = {Some physical properties of the cubic perovskites CsXF3 (X = Ca, Sr and Hg) have been investigated using pseudopotential plane-wave method based on the density functional theory. The calculated lattice parameters within GGA and LDA agree reasonably with the available experimental data. The elastic constants and their pressure derivatives are predicted using the static finite strain technique. We derived the bulk and shear moduli, Young's modulus, Poisson's ratio and Lame's constants for ideal polycrystalline aggregates. The analysis of B/G ratio indicates that CsXF3 (X = Ca, Sr and Hg) are ductile materials. The thermal effect on the volume, bulk modulus, heat capacity and Debye temperature was predicted.},
  comment   = {Suggested filename = {Ghebouli2012jul Theoretical Prediction of the Structural, Elastic, Electronic, Optical and Thermal Properties of the Cubic Perovskites CsXF3 (X = Ca, Sr and Hg) Under Pressure Effect.pdf},
