@Article{Krupenkin2004may,
  author    = {Krupenkin, Tom N. and Taylor, J. Ashley and Schneider, Tobias M. and Yang, Shu},
  title     = {From Rolling Ball to Complete Wetting: {T}he Dynamic Tuning of Liquids on Nanostructured Surfaces},
