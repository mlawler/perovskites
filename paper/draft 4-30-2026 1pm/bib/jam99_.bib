@Article{Long2018sep,
  author    = {Long, Guankui and Jiang, Chongyun and Sabatini, Randy and Yang, Zhenyu and Wei, Mingyang and Quan, Li Na and Liang, Qiuming and Rasmita, Abdullah and Askerka, Mikhail and Walters, Grant and Gong, Xiwen and Xing, Jun and Wen, Xinglin and Quintero-Bermudez, Rafael and Yuan, Haifeng and Xing, Guichuan and Wang, X. Renshaw and Song, Datong and Voznyy, Oleksandr and Zhang, Mingtao and Hoogland, Sjoerd and Gao, Weibo and Xiong, Qihua and Sargent, Edward H.},
