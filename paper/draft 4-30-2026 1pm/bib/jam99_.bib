}

@Article{Lederman1993may,
  author      = {Lederman, M and Gibson, GA and Schultz, S},
  title       = {Observation of Thermal Switching of a Single Ferromagnetic Particle},
  journal     = {J. Appl. Phys.},
  year        = {1993},
  volume      = {73},
  number      = {10, Part 2B},
  month       = {may},
  pages       = {6961-6963},
  issn        = {0021-8979},
  doi         = {10.1063/1.352397},
  url         = {http://dx.doi.org/10.1063/1.352397},
  abstract    = {A magnetic force microscope (MFM) has been shown to be able to detect fields emanating from submicrometer permalloy particles with magnetic moments as low as 10(-13) emu. We have used this MFM equiped with an in situ electromagnet to study the angular dependence of the switching field H(s)(theta), and the probability of thermal switching of a single-domain permalloy particle as a function of the time duration of an applied magnetic field H. The angular dependence of H(s)(theta) is significantly different from that expected for coherent rotation. For applied magnetic fields close to H(s), the time dependence of the probability for not switching cannot be fit with a simple exponential. These data indicate that multiple-energy barriers of similar height are involved in the thermally activated process responsible for the reversal.},
  affiliation = {LEDERMAN, M (Reprint Author), UNIV CALIF SAN DIEGO,CTR MAGNET RECORDING RES,LA JOLLA,CA 92093. UNIV CALIF SAN DIEGO,DEPT PHYS,LA JOLLA,CA 92093.},
  comment     = {An MFM study, at room temperature, of the switching field vs angle, the distribution of switching fields over many particles, and the switching-time distribution of a few particles. Sample: permalloy rods, 715 nm long, 148 wide, and 50 nm thick. "The data suggests that thermal switching is more complex than hopping over a single barrier." Cited = 52.


