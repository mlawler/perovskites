@Article{Ariga2008jan,
  author         = {Ariga, Katsuhiko and Hill, Jonathan P. and Lee, Michael V. and Vinu, Ajayan and Charvet, Richard and Acharya, Somobrata},
  title          = {Challenges and breakthroughs in recent research on self-assembly},
  journal        = {Sci. Technol. Adv. Mater.},
