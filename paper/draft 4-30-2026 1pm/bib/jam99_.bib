@Article{Glatzel2008apr,
  author    = {Glatzel, Th and Rusu, M and Sadewasser, S and Lux-{S}teiner, M Ch},
  title     = {Surface photovoltage analysis of thin {CdS} layers on polycrystalline chalcopyrite absorber layers by {K}elvin probe force microscopy},
