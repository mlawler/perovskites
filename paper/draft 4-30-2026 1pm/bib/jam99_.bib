@Article{Liu2016sep,
  author    = {Liu, Chuan and Huseynova, Gunel and Xu, Yong and Long, Dang Xuan and Park, Won-Tae and Liu, Xuying and Minari, Takeo and Noh, Yong-Young},
  title     = {Universal Diffusion-limited Injection and the {H}ook Effect in Organic Thin-film Transistors},
