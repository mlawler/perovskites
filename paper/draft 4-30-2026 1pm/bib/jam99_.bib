  author    = {Ledbetter, M. P. and Savukov, I. M. and Budker, D. and Shah, V. and Knappe, S. and Kitching, J. and Michalak, D. J. and Xu, S. and Pines, A.},
  title     = {Zero-field remote detection of {NMR} with a microfabricated atomic magnetometer},
