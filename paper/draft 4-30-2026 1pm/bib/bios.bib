@Article{Slinker2007nov,
    author = "Slinker, Jason D. and DeFranco, John A. and Jaquith, Michael J. and Silveira, William R. and Zhong, Yu-Wu and Moran-Mirabal, Jose M. and Craighead, Harold G. and Abru\ {n}a, Hector D. and Marohn, John A. and Malliaras, George G.",
    title = "Direct measurement of the electric-field distribution in a light-emitting electrochemical cell",
    volume = "6",
    number = "11",
    pages = "894 -- 899",
    issn = "14761122",
    doi = "10.1038/nmat2021",
    url = "http://dx.doi.org/10.1038/nmat2021",
    abstract = "The interplay between ionic and electronic charge carriers in mixed conductors offers rich physics and unique device potential. In light-emitting electrochemical cells (LEECs), for example, the redistribution of ions assists the injection of electronic carriers and leads to efficient light emission. The mechanism of operation of LEECs has been controversial, as there is no consensus regarding the distribution of electric field in these devices. Here, we probe the operation of LEECs using electric force microscopy on planar devices. We show that obtaining the appropriate boundary conditions is essential for capturing the underlying device physics. A patterning scheme that avoids overlap between the mixed-conductor layer and the metal electrodes enabled the accurate in situ measurement of the electric-field distribution. The results show that accumulation and depletion of mobile ions near the electrodes create high interfacial electric fields that enhance the injection of electronic carriers.",
    comment = "Suggested filename = Slinker2007nov Direct measurement of the electric-field distribution in a light-emitting electrochemical cell 10.1038/nmat2021 *.pdf Funding = NSF-DMR-0706508",
    file = "Slinker2007nov Direct measurement of the electric-field distribution in a light-emitting electrochemical cell 10.1038\:nmat2021 *.pdf:UNSORTED/Slinker2007nov Direct measurement of the electric-field distribution in a light-emitting electrochemical cell 10.1038\:nmat2021 *.pdf:PDF",
    journal = "Nat. Mater.",
    key = "Electrochemical cells",
    keywords = "marohn-manuscript, devices > LEEC, nanopatterning > parylene",
    month = "nov",
    owner = "jam99",
    timestamp = "2019.03.03",
    year = "2007"
}

@Article{Smieska2012dec,
    author = "Smieska, Louisa M. and Pozdin, Vladimir A. and Luria, Justin L. and Hennig, Richard G. and Hines, Melissa A. and Lewis, Chad A. and Marohn, John A.",
    title = "Following Chemical Charge Trapping in Pentacene Thin Films by Selective Impurity Doping and Wavelength-resolved Electric Force Microscopy",
    volume = "22",
    number = "24",
    pages = "5096 -- 5106",
    doi = "10.1002/adfm.201200595",
    url = "http://dx.doi.org/10.1002/adfm.201200595",
    abstract = "Charge trapping is one of several factors that limit the performance of organic electronic materials, yet even in pentacene, a prototypical small-molecule semiconductor, the precise chemical nature of charge trapping remains poorly understood. Here we examine the effects of three chemical trap-precursor candidates by layering thin pentacene films with different pentacene defect species. We study the resulting charge trapping in each device via scanned-probe electric force microscopy coupled with variable-wavelength sample illumination. First, we find that layering with pentacen-6(13H)-one (PHO) readily produces uniform charge trapping everywhere in the transistor channel, as expected for an active blanket-deposited trap-precursor. However, layering with 6,13-dihydropentacene (DHP) produces fewer, more isolated traps, closely resembling the surface potential distribution in pristine pentacene thin films. Second, we measure the rates of trap-clearing versus illuminating wavelength (trap-clearing spectra), revealing enhanced trap-clearing rates at wavelengths assigned to the absorption of either pentacene or the charged trap species. The trap-clearing spectrum for the PHO-layered sample closely resembles the spectrum obtained from pentacene aged in a working transistor, while the trap-clearing spectrum for the DHP-layered sample resembles the spectrum observed in pristine pentacene. We conclude that PHO competently creates traps in pentacene which match the expected trap-clearing spectrum for degraded pentacene while DHP does not, and that the chemical trap species in aged pentacene is very likely PHO+.",
    comment = "Suggested filename = Smieska2012aug Following Chemical Charge Trapping in Pentacene Thin Films by Selective Impurity Doping andWavelength-resolved Electric Force Microscopy IN PRESS.pdf",
    file = "Smieska2012aug Following Chemical Charge Trapping in Pentacene Thin Films by Selective Impurity Doping andWavelength-resolved Electric Force Microscopy IN PRESS.pdf:UNSORTED/Smieska2012aug Following Chemical Charge Trapping in Pentacene Thin Films by Selective Impurity Doping andWavelength-resolved Electric Force Microscopy IN PRESS.pdf:PDF",
    journal = "Adv. Funct. Mater.",
    keywords = "marohn-manuscript, grant-Marohn-NSF-DMR-1006633, grant-CCMR-NSF-DMR-1120296, grant-Brown-NSF-NSF-DMR-1006633, grant-CNF-NSF-ECS-0335765",
    month = "dec",
    owner = "jam99",
    timestamp = "2019.03.03",
    year = "2012"
}

@Article{Smieska2016feb,
    author = "Smieska, Louisa M. and Li, Zhong and Ley, David and Braunschweig, Adam B. and Marohn, John A.",
    title = "Trap-clearing Spectroscopy in Perylene Diimide Derivatives",
    volume = "28",
    number = "3",
    pages = "813 -- 820",
    doi = "10.1021/acs.chemmater.5b04025",
    url = "http://dx.doi.org/10.1021/acs.chemmater.5b04025",
    abstract = "Perylene diimide (PDI) derivatives are important components of organic circuits and photovoltaic systems, but the electron trapping mechanism(s) in higher-LUMO PDIs (-3 to -4 eV, where radical anions are expected to react with atmospheric water and oxygen) are not well characterized. Here, we examine the spatial distribution of traps in transistors made from PDIs with these higher LUMO levels, and measure trap-clearing spectra in $n-$type organic materials using time- and wavelength-resolved frequency-modulated Kelvin probe force microscopy (FM-KPFM). We find that the rate of trap-clearing under visible light does not follow a LUMO-level trend, and we observe spectral evidence for different trapping mechanisms on bare versus HMDS-treated SiO$\_2$.",
    comment = "suggested filename = {Smieska2016jan Trap-clearing Spectroscopy in Perylene Diimide Derivatives.pdf}",
    file = "Smieska2016feb Trap-clearing Spectroscopy in Perylene Diimide Derivatives.pdf:Smieska2016feb Trap-clearing Spectroscopy in Perylene Diimide Derivatives.pdf:PDF",
    journal = "Chem. Mater.",
    keywords = "marohn-manuscript, grant-Marohn-NSF-DMR-1006633, grant-Marohn-NSF-DMR-1309540",
    month = "feb",
    owner = "jam99",
    timestamp = "2019.03.03",
    year = "2016"
}

@Article{Snaith2014may,
    author = "Snaith, Henry J. and Abate, Antonio and Ball, James M. and Eperon, Giles E. and Leijtens, Tomas and Noel, Nakita K. and Stranks, Samuel D. and Wang, Jacob Tse-Wei and Wojciechowski, Konrad and Zhang, Wei",
    title = "Anomalous Hysteresis in Perovskite Solar Cells",
    volume = "5",
    number = "9",
    pages = "1511 -- 1515",
    doi = "10.1021/jz500113x",
    url = "http://dx.doi.org/10.1021/jz500113x",
    abstract = "Perovskite solar cells have rapidly risen to the forefront of emerging photovoltaic technologies, exhibiting with rapidly rising efficiencies. This is likely to continue to rise, but in the development of these solar cells there are unusual characteristics which have arisen; specifically an anomalous hysteresis in the current-voltage curves. In this letter we identify this phenomenon and show some examples of factors which make the hysteresis more or less extreme. We also demonstrate stabilized power output under working conditions, and suggest that this is a useful parameter to present, alongside the current voltage scan derived power conversion efficiency. We hypothesize three possible origins of the effect and discuss its implications on device efficiency and future research directions. Understanding and resolving the hysteresis is essential for further progress, and is likely to lead to a further step improvement in performance.",
    comment = "Suggested filename = {Snaith2014may Anomalous Hysteresis in Perovskite Solar Cells.pdf}, Source = {wxdoi2bib}",
    file = "Snaith2014may Anomalous Hysteresis in Perovskite Solar Cells.pdf:UNSORTED/Snaith2014may Anomalous Hysteresis in Perovskite Solar Cells.pdf:PDF",
    journal = "J. Phys. Chem. Lett.",
    keywords = "project > EFM, personnel > Tirmzi, collaborator > Hanrath, materials > semiconductor > perovskite > halide segregation, materials > semiconductor > perovskite > hysteresis, devices > solar cell > perovskite",
    month = "may",
    owner = "jam99",
    timestamp = "2019.03.03",
    year = "2014"
}

@Article{Stevenson2017jan,
    author = "Stevenson, James and Sorenson, Blaire and Subramaniam, Varun Hari and Raiford, James and Khlyabich, Petr P. and Loo, Yueh-Lin and Clancy, Paulette",
    title = "Mayer Bond Order as a Metric of Complexation Effectiveness in Lead Halide Perovskite Solutions",
    volume = "29",
    number = "6",
    pages = "2435 -- 2444",
    doi = "10.1021/acs.chemmater.6b04327",
    url = "http://dx.doi.org/10.1021/acs.chemmater.6b04327",
    abstract = "One of the most appealing features of solar cells made from hybrid organic-inorganic perovskites is that they can be processed directly from solution, leading to low cost, energy-efficient processing. Numerous studies have shown that the composition of these solutions and the choice of solvent (or solvent blend) affects the efficiency of the resulting solar cell. Despite the importance of this correlation for performance, the choice of solvent(s) used to deposit the perovskite precursors has been largely a matter of experimental trial-and-error. In this work, we present a coherent theory explaining the molecular origin of the efficacy of solvent choice, which lends itself to the creation of a fast quantum mechanical-based screening process that facilitates the design of effective new solvents. We also provide the first theoretical confirmation of complexation of HOIP precursors in solution, including their structure and relative stability. We show that the Mayer bond order of a solvent's polar atoms predicts the solubility of the perovskite lead halide precursors in the solvent much more reliably than the relative polarity and Hansen polar solubility parameter suggested in the literature as being figures of merit.",
    comment = "Suggested filename = {Stevenson2017jan Mayer Bond Order as a Metric of Complexation Effectiveness in Lead Halide Perovskite Solutions.pdf}, Source = {wxdoi2bib}",
    file = "Stevenson2017jan Mayer Bond Order as a Metric of Complexation Effectiveness in Lead Halide Perovskite Solutions.pdf:Stevenson2017jan Mayer Bond Order as a Metric of Complexation Effectiveness in Lead Halide Perovskite Solutions.pdf:PDF",
    journal = "Chem. Mater.",
    keywords = "project > EFM, collaborator > Clancy, materials > semiconductor > perovskite",
    month = "jan",
    owner = "jam99",
    timestamp = "2019.03.03",
    year = "2017"
}

@Article{Stranks2015may,
    author = "Stranks, Samuel D. and Snaith, Henry J.",
