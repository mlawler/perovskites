@Article{Aharoni1986sep,
  author      = {Aharoni, A},
  title       = {Perfect and Imperfect Particles},
  journal     = {{IEEE} Trans. Mag.},
  year        = {1986},
  volume      = {22},
  number      = {5},
  month       = {sep},
  pages       = {478 -- 483},
  issn        = {0018-9464},
  doi         = {10.1109/TMAG.1986.1064461},
  url         = {http://dx.doi.org/10.1109/TMAG.1986.1064461},
  abstract    = {The theory of magnetization reversal process in an isolated, ellipsoidal particle is rigorous, and its results are unambiguous. There is no approximation in this theory, except for the assumption of a perfect single crystal, with a perfectly smooth spheroidal surface, and nothing new can be found, as long as this assumption is maintained. In order to advance towards a theory of realistic particles, one must look for ways to take into account the effect of nonellipsoidal shape and of crystalline defects, as well as the effect of magnetic interactions between the particles.},
  affiliation = {AHARONI, A (Reprint Author), WEIZMANN INST SCI,DEPT ELECTR,IL-76100 REHOVOT,ISRAEL. UNIV CALIF SAN DIEGO,CTR MAGNET RECORDING RES,LA JOLLA,CA 92093.},
  comment     = {Great perspective! A wonderful summary in words of the equations in Brown1957mar. For a prolate spheroid, only three switching modes are theoretically possible: coherent rotation, curling, and buckling (which ... "may be safely overlooked"). A simple equation for the curling "nucleation field" is given. Explains on p. 480 why a 30 nm to 60 nm diameter cobalt sphere will be uniformly magnetized as a single coherent domain at zero field, yet still switch via the curling mechanism. Note on p. 482 that, as of 1986, the mechanism of nucleation and pinning of domain walls was not understood!


Suggested filename = Aharoni1986sep Perfect and Imperfect Particles *.pdf},
  file        = {Aharoni1986sep Perfect and Imperfect Particles 10.1109\:TMAG.1986.1064461.pdf:UNSORTED/Aharoni1986sep Perfect and Imperfect Particles 10.1109\:TMAG.1986.1064461.pdf:PDF},
