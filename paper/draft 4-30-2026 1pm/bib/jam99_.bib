@Article{DeVience2015jan,
  author    = {DeVience, Stephen J. and Pham, Linh M. and Lovchinsky, Igor and Sushkov, Alexander O. and Bar-Gill, Nir and Belthangady, Chinmay and Casola, Francesco and Corbett, Madeleine and Zhang, Huiliang and Lukin, Mikhail and Park, Hongkun and Yacoby, Amir and Walsworth, Ronald L.},
  title     = {Nanoscale {NMR} Spectroscopy and Imaging of Multiple Nuclear Species},
