  file        = {Nakatani2003aug Faster magnetic walls in rough wires 10.1038\:nmat931 *.pdf:UNSORTED/Nakatani2003aug Faster magnetic walls in rough wires 10.1038\:nmat931 *.pdf:PDF},
  journal-iso = {Nat. Mater.},
  keywords    = {nanomagnetics, nanomagnetics > switching > domain wall propagation, materials > magnetic > permalloy},
  owner       = {jam99},
  timestamp   = {2010.05.30},
