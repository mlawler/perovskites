@Article{Binshtein2015may,
  author    = {Binshtein, Elad and Ohi, Melanie D.},
  title     = {Cryo-Electron Microscopy and the Amazing Race to Atomic Resolution},
  journal   = {Biochemistry},
  year      = {2015},
  volume    = {54},
