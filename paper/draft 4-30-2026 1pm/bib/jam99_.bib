@Article{Nieuwendaal2012mar,
  author    = {Nieuwendaal, Ryan C. and Ro, Hyun Wook and Germack, David S. and Kline, R. Joseph and Toney, Michael F. and Chan, Calvin K. and Agrawal, Amit and Gundlach, David and Vanderhart, David L. and Delongchamp, Dean M.},
