  author = {Horiachyi, Dmytro O. and Nestoklon, Mikhail O. and Akimov, Ilya A. and Trifonov, Artur V. and Siverin, Nikita V. and Kopteva, Nataliia E. and Kosarev, Alexander N. and Yakovlev, Dmitri R. and Gusev, Vitalyi E. and Fries, Melina and Trukhina, Olga and Dyakonov, Vladimir and Bayer, Manfred},
