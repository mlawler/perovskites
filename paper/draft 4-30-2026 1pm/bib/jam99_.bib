  keywords  = {project > EFM, charge generation > CT state, project > MRFM, personnel > Curley, personnel > Dwyer, charge transport > measurements > SCLC},
  owner     = {jam99},
  timestamp = {2015.11.11},
}

@Article{deQuilettes2016jul,
  author    = {{deQuilettes}, Dane W. and Koch, Susanne and Burke, Sven and Paranji, Rajan K. and Shropshire, Alfred J. and Ziffer, Mark E. and Ginger, David S.},
  title     = {Photoluminescence Lifetimes Exceeding 8 $\mu$s and Quantum Yields Exceeding 30\% in Hybrid Perovskite Thin Films by Ligand Passivation},
  journal   = {ACS Energy Lett.},
  year      = {2016},
  month     = {jul},
  pages     = {438 -- 444},
  doi       = {10.1021/acsenergylett.6b00236},
  url       = {http://dx.doi.org/10.1021/acsenergylett.6b00236},
  abstract  = {We study the effects of a series of post-deposition ligand treatments on the photoluminescence (PL) of polycrystalline methylammonium lead triiodide perovskite thin films. We show that a variety of Lewis bases can improve the bulk PL quantum efficiency (PLQE) and extend the average PL lifetime, $\langle \tau \rangle$, with large enhancements concentrated at grain boundaries. Notably, we demonstrate thin-film PLQE as high as $35 \pm 1$ percent and $\langle \tau \rangle$ as long as $8.82 \pm 0.03$ us at solar equivalent carrier densities using tri-n-octylphosphine oxide-treated films. Using glow discharge optical emission spectroscopy and nuclear magnetic resonance spectroscopy, we show that the ligands are incorporated primarily at the film surface and are acting as electron donors. These results indicate it is possible to obtain thin-film PL lifetime and PLQE values that are comparable to those from single crystals by control over surface chemistry.},
  comment   = {Suggested filename = {deQuilettes2016jul Photoluminescence Lifetimes Exceeding 8 mus and Quantum Yields Exceeding 30% in Hybrid Perovskite Thin Films by Ligand Passivation.pdf}, Source = {wxdoi2bib}},
  file      = {deQuilettes2016jul Photoluminescence Lifetimes Exceeding 8 us and Quantum Yields Exceeding 30 percent in Hybrid Perovskite Thin Films by Ligand Passivation.pdf:UNSORTED/deQuilettes2016jul Photoluminescence Lifetimes Exceeding 8 us and Quantum Yields Exceeding 30 percent in Hybrid Perovskite Thin Films by Ligand Passivation.pdf:PDF},
  keywords  = {project > EFM, materials > semiconductor > perovskite},
  owner     = {jam99},
  timestamp = {2016.08.03},
}

@Article{deQuilettes2016may,
  author    = {{deQuilettes}, Dane W. and Zhang, Wei and Burlakov, Victor M. and Graham, Daniel J. and Leijtens, Tomas and Osherov, Anna and Bulovic, Vladimir and Snaith, Henry J. and Ginger, David S. and Stranks, Samuel D.},
  title     = {Photo-induced Halide Redistribution in Organic--inorganic Perovskite Films},
  journal   = {Nat Comms},
  year      = {2016},
  volume    = {7},
  month     = {may},
  pages     = {11683},
  doi       = {10.1038/ncomms11683},
  url       = {http://dx.doi.org/10.1038/ncomms11683},
  abstract  = {Organic-inorganic perovskites such as CH3NH3PbI3 are promising materials for a variety of optoelectronic applications, with certified power conversion efficiencies in solar cells already exceeding 21 [percent]. Nevertheless, state-of-the-art films still contain performance-limiting non-radiative recombination sites and exhibit a range of complex dynamic phenomena under illumination that remain poorly understood. Here we use a unique combination of confocal photoluminescence (PL) microscopy and chemical imaging to correlate the local changes in photophysics with composition in CH3NH3PbI3 films under illumination. We demonstrate that the photo-induced ``brightening'' of the perovskite PL can be attributed to an order-of-magnitude reduction in trap state density. By imaging the same regions with time-of-flight secondary-ion-mass spectrometry, we correlate this photobrightening with a net migration of iodine. Our work provides visual evidence for photo-induced halide migration in triiodide perovskites and reveals the complex interplay between charge carrier populations, electronic traps and mobile halides that collectively impact optoelectronic performance.},
  comment   = {Suggested filename = {deQuilettes2016may Photo-induced Halide Redistribution in Organic--inorganic Perovskite Films.pdf}, Source = {wxdoi2bib}},
  file      = {deQuilettes2016may Photo-induced Halide Redistribution in Organic--inorganic Perovskite Films.pdf:UNSORTED/deQuilettes2016may Photo-induced Halide Redistribution in Organic--inorganic Perovskite Films.pdf:PDF},
  keywords  = {project > EFM, personnel > Tirmzi, collaborator > Hanrath, materials > semiconductor > perovskite, materials > semiconductor > perovskite > halide motion},
  owner     = {jam99},
  timestamp = {2019.01.26},
}

@Article{Derylo2011nov,
