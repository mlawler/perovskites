@PhdThesis{Picone2014,
  author    = {Picone, Rico},
  title     = {Separative magnetization transport: {T}heory, model, and experiment},
  year      = {2014},
  url       = {http://hdl.handle.net/1773/26053},
  abstract  = {We present a theoretical framework for modeling the transport of any number of globally con- served quantities, in any spatial configuration, and apply it to obtain a model of magnetization transport for spin-systems with two spin-species. The framework allows an entropy function to define a model that explicitly respects the laws of thermodynamics. A one-species model is derived as a special case. In the high spin-temperature (linear) limit, this model is shown to be equivalent to the model of nuclear spin transport of Genack and Redfield. The two-species model is novel in that it describes systems of two spin-species and systems with large polarization. It is explored numerically and shown to be consistent with experimental results, which are also presented, but are insufficient to validate the model. This is followed by a numerical exploration of a potential experiment that could validate the model. Analytic, steady state solutions for the one- and two-species models are derived. The separative quality of transport is quantified by two figures of merit: one static and the other dynamic. The theoretical framework, two-species model, and experimental results provide a foundation for further study of separative magnetization transport (SMT), and in particular the study of harnessing it to induce hyperpolarization by optimizing the presented figures of merit},
  comment   = {Suggested filename = {Picone2014 Separative magnetization transport ~ Theory, model, and experiment.pdf}},
  file      = {Picone2014 Separative magnetization transport ~ Theory, model, and experiment.pdf:Picone2014 Separative magnetization transport ~ Theory, model, and experiment.pdf:PDF},
  keywords  = {magnetic resonance > DNP, project > MRFM, magnetic resonance > DNP > mechanisms > separative magnetization transport},
  owner     = {jam99},
  school    = {University of Washington, Seattle},
  timestamp = {2015.12.10},
}

@Article{Picone2015jan,
  author    = {Picone, Rico A.R. and Garbini, Joseph L. and Sidles, John A.},
  title     = {Modeling Spin Magnetization Transport in a Spatially Varying Magnetic Field},
  journal   = {J. Magn. Magn. Mater.},
  year      = {2015},
  volume    = {374},
  month     = {jan},
  pages     = {440 -- 450},
  doi       = {10.1016/j.jmmm.2014.08.079},
  url       = {http://dx.doi.org/10.1016/j.jmmm.2014.08.079},
  abstract  = {We present a framework for modeling the transport of any number of globally conserved quantities in any spatial configuration and apply it to obtain a model of magnetization transport for spin-systems that is valid in new regimes (including high-polarization). The framework allows an entropy function to define a model that explicitly respects the laws of thermodynamics. Three facets of the model are explored. First, it is expressed as nonlinear partial differential equations that are valid for the new regime of high dipole-energy and polarization. Second, the nonlinear model is explored in the limit of low dipole-energy (semi-linear), from which is derived a physical parameter characterizing separative magnetization transport (SMT). It is shown that the necessary and sufficient condition for SMT to occur is that the parameter is spatially inhomogeneous. Third, the high spin-temperature (linear) limit is shown to be equivalent to the model of nuclear spin transport of Genack and Redfield (1975) [1]. Differences among the three forms of the model are illustrated by numerical solution with parameters corresponding to a magnetic resonance force microscopy (MRFM) experiment (Degen eL al., 2009 [2]; Kuehn et al., 2008 [3]; Sidles et al., 2003[4]; Dougherty et al., 2000[5]). A family of analytic, steady-state solutions to the nonlinear equation is derived and shown to be the spin-temperature analog of the Langevin paramagnetic equation and Curie's law. Finally, we analyze the separative quality of magnetization transport, and a steady-state solution for the magnetization is shown to be compatible with Fenske's separative mass transport equation (Fenske, 1932 [6]).},
  comment   = {Suggested filename = {Picone2015jan Modeling Spin Magnetization Transport in a Spatially Varying Magnetic Field.pdf},
Source = {wxdoi2bib}},
  file      = {Picone2015jan Modeling Spin Magnetization Transport in a Spatially Varying Magnetic Field.pdf:UNSORTED/Picone2015jan Modeling Spin Magnetization Transport in a Spatially Varying Magnetic Field.pdf:PDF},
  keywords  = {magnetic resonance > DNP, project > MRFM, magnetic resonance > DNP > mechanisms > separative magnetization transport},
  owner     = {jam99},
  timestamp = {2015.11.25},
}

