@article{Li2023febb,
  title = {Rational Design of {{Lewis}} Base Molecules for Stable and Efficient Inverted Perovskite Solar Cells},
  author = {Li, Chongwen and Wang, Xiaoming and Bi, Enbing and Jiang, Fangyuan and Park, So Min and Li, You and Chen, Lei and Wang, Zaiwei and Zeng, Lewei and Chen, Hao and Liu, Yanjiang and Grice, Corey R. and Abudulimu, Abasi and Chung, Jaehoon and Xian, Yeming and Zhu, Tao and Lai, Huagui and Chen, Bin and Ellingson, Randy J. and Fu, Fan and Ginger, David S. and Song, Zhaoning and Sargent, Edward H. and Yan, Yanfa},
  year = 2023,
  month = feb,
  journal = {Science},
  volume = {379},
  number = {6633},
  pages = {690--694},
  publisher = {American Association for the Advancement of Science},
  doi = {10.1126/science.ade3970},
  urldate = {2023-03-15},
  abstract = {Lewis base molecules that bind undercoordinated lead atoms at interfaces and grain boundaries (GBs) are known to enhance the durability of metal halide perovskite solar cells (PSCs). Using density functional theory calculations, we found that phosphine-containing molecules have the strongest binding energy among members of a library of Lewis base molecules studied herein. Experimentally, we found that the best inverted PSC treated with 1,3-bis(diphenylphosphino)propane (DPPP), a diphosphine Lewis base that passivates, binds, and bridges interfaces and GBs, retained a power conversion efficiency (PCE) slightly higher than its initial PCE of \textasciitilde 23\% after continuous operation under simulated AM1.5 illumination at the maximum power point and at \textasciitilde 40{$^\circ$}C for {$>$}3500 hours. DPPP-treated devices showed a similar increase in PCE after being kept under open-circuit conditions at 85{$^\circ$}C for {$>$}1500 hours.},
  keywords = {lead-halide perovskite > stability},
  file = {/Users/jam99/Zotero/storage/B5A7IPKS/Li et al_2023_Rational design of Lewis base molecules for stable and efficient inverted.pdf}
}

@article{Li2023mar,
  title = {Ink Design Enabling Slot-Die Coated Perovskite Solar Cells with >22\% Power Conversion Efficiency, Micro-Modules, and 1 Year of Outdoor Performance Evaluation},
  author = {Li, Jinzhao and Dagar, Janardan and Shargaieva, Oleksandra and Maus, Oliver and Remec, Marco and Emery, Quiterie and Khenkin, Mark and Ulbrich, Carolin and Akhundova, Fatima and Márquez, José A. and Unold, Thomas and Fenske, Markus and Schultz, Christof and Stegemann, Bert and Al-Ashouri, Amran and Albrecht, Steve and Esteves, Alvaro Tejada and Korte, Lars and Köbler, Hans and Abate, Antonio and Többens, Daniel M. and Zizak, Ivo and List-Kratochvil, Emil J. W. and Schlatmann, Rutger and Unger, Eva},
  year = 2023,
  month = mar,
  journal = {Advanced Energy Materials},
  volume = {n/a},
  number = {n/a},
  pages = {2203898},
  issn = {1614-6840},
  doi = {10.1002/aenm.202203898},
  urldate = {2023-03-11},
  abstract = {The next technological step in the exploration of metal-halide perovskite solar cells is the demonstration of larger-area device prototypes under outdoor operating conditions. The authors here demonstrate that when slot-die coating the halide perovskite layers on large areas, ribbing effects may occur but can be prevented by adjusting the precursor ink's rheological properties. For formamidinium lead triiodide (FAPbI3) precursor inks based on 2-methoxyethanol, the ink viscosity is adjusted by adding acetonitrile (ACN) as a co-solvent leading to smooth FAPbI3 thin-films with high quality and layer homogeneity. For an optimized content of 46 vol% of the ACN co-solvent, a certified steady-state performance of 22.3% is achieved in p-i-n FAPbI3-perovskite solar cells. Scaling devices to larger areas by making laser series-interconnected mini-modules of 12.7 cm2, a power conversion efficiency of 17.1% is demonstrated. A full year of outdoor stability testing with continuous maximum power point tracking on encapsulated devices is performed and it is demonstrated that these devices maintain close to 100% of their initial performance during winter and spring followed by a significant performance decline during warmer summer months. This work highlights the importance of the real-condition evaluation of larger area device prototypes to validate the technological potential of halide perovskite photovoltaics.},
  langid = {english},
  keywords = {lead-halide perovskite > manufacturing,lead-halide perovskite > slot-die coating,long-term outdoor study,perovskite solar cells,ribbing,slot-die coating},
  file = {/Users/jam99/Zotero/storage/W2QWR6H9/Li et al_Ink Design Enabling Slot-Die Coated Perovskite Solar Cells with 22% Power.pdf;/Users/jam99/Zotero/storage/IGR6FFM3/aenm.html}
}

@misc{Li2024jan,
  type = {{{SSRN Scholarly Paper}}},
  title = {Grain {{Orientation Management}} and {{Non-Radiative Recombination Suppression}} for {{Ultra-Stable Perovskite Light-Emitting Diodes}} with {{Record Brightness}}},
  author = {Li, Zhiqi and Ren, Zhiwei and Liang, Qiong and Fong, Patrick W. K. and Liu, Heng and Lu, Xinhui and Kymissis, Ioannis (John) and Li, Gang},
  year = 2024,
  month = jan,
  number = {4687767},
  address = {Rochester, NY},
  doi = {10.2139/ssrn.4687767},
  urldate = {2024-02-25},
  abstract = {Three-dimensional (3D) polycrystalline perovskite, featured with high charge-transport ability, is emerging as promising candidates for high-brightness light-emitting applications. However, 3D perovskite light-emitting diodes (PeLEDs) is difficult to achieve high brightness, efficiency and stability simultaneously, as they are limited by the trade-off between the advanced external quantum efficiency (EQE) and the inevitable roll-off. Here, we develop a 3D FAPbI3 perovskite material system that enables high brightness, high efficiency and long device lifetime simultaneously, engineered by an alkyl-chain-length-dependent ammonium salt molecule modulation strategy. Combining molecular interaction monitoring/tracking, crystallization visualization, and molecular dynamics simulation, we elucidate the roles of alkylammonium salts on crystal orientation management, grain size controlling, non-radiative recombination suppression, and thus device performances. By weakening the adverse impact of alkyl-ammonium salt molecule assisted crystallization management, we significantly enhance the orientated crystallization and molecular passivation. Consequently, we simultaneously obtain efficient, ultra-bright and stable PeLEDs with a high EQE of 23.2\%, a record radiance of 1593 W\,sr-1\,m-2 (direct-current (DC) operation) and a record lifetime of 227 h (T50, at a high excitation current of 100 mA cm-2), representing the best performance for the DC-drived NIR PeLEDs at high brightness levels.},
  langid = {english},
  keywords = {alkylammonium salts,brightness,crystal orientation,perovskite light-emitting diodes,stability}
}

@article{Li2024may,
  title = {Long-{{Range Strain}} in {{Lead Halide Perovskite Single Crystals}}},
  author = {Li, Yiping and Tian, Hongxing and Li, Nan and Guo, Junjun and Ling, Xufeng and Yuan, Jianyu and Zhao, Jingjing and Deng, Yehao},
  year = 2024,
  month = may,
  journal = {Crystal Growth \& Design},
  publisher = {American Chemical Society},
  issn = {1528-7483},
  doi = {10.1021/acs.cgd.4c00123},
  urldate = {2024-05-20},
  abstract = {Strain plays a crucial role in semiconductor materials, often arising from heterointerfaces that involve materials with mismatched lattice parameters or thermal expansion coefficients. As a result, homogeneous single crystals are generally presumed to be strain-free. Contrary to this conventional belief, our study unveils the presence of long-range strain in free-standing lead halide perovskite single crystals. Remarkably, we have observed that spatial temperature inhomogeneity in the solution during crystal growth, induced by processes such as seeding or temperature ramping, leads to the development of long-range and residual strain within these single crystals. Such a strain is found to impact the band gap and carrier mobility of perovskite single crystals. This discovery challenges existing perceptions and introduces a new perspective for understanding and designing the physical and optoelectronic properties of perovskite single-crystalline devices, particularly in applications such as radiation detectors.},
  keywords = {lead-halide perovskite > crystallization,lead-halide perovskite > single crystals,personnel > Hiralal,personnel > Liu,personnel > Petroff},
  file = {/Users/jam99/Zotero/storage/B464A2W2/Li et al_2024_Long-Range Strain in Lead Halide Perovskite Single Crystals.pdf}
}

