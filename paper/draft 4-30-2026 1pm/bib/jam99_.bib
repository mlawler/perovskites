}

@Article{Poggio2010aug,
  author         = {Poggio, M. and Degen, C. L.},
  title          = {Force-Detected Nuclear Magnetic Resonance: {R}ecent Advances and Future Challenges},
  journal        = {Nanotechnology},
  year           = {2010},
  volume         = {21},
  number         = {34},
  month          = {aug},
  pages          = {342001},
  issn           = {0957-4484},
  doi            = {10.1088/0957-4484/21/34/342001},
  url            = {http://dx.doi.org/10.1088/0957-4484/21/34/342001},
  abstract       = {We review recent efforts to detect small numbers of nuclear spins using magnetic resonance force microscopy. Magnetic resonance force microscopy (MRFM) is a scanning probe technique that relies on the mechanical measurement of the weak magnetic force between a microscopic magnet and the magnetic moments in a sample. Spurred by the recent progress in fabricating ultrasensitive force detectors, MRFM has rapidly improved its capability over the last decade. Today it boasts a spin sensitivity that surpasses conventional, inductive nuclear magnetic resonance detectors by about eight orders of magnitude. In this review we touch on the origins of this technique and focus on its recent application to nanoscale nuclear spin ensembles, in particular on the imaging of nanoscale objects with a three-dimensional (3D) spatial resolution better than 10 nm. We consider the experimental advances driving this work and highlight the underlying physical principles and limitations of the method. Finally, we discuss the challenges that must be met in order to advance the technique towards single nuclear spin sensitivity-and perhaps-to 3D microscopy of molecules with atomic resolution.},
  article-number = {342001},
  comment        = {Suggested filename = Poggio2010aug Force-detected nuclear magnetic resonance ~ recent advances and future challenges 10.1088/0957-4484/21/34/342001 *.pdf},
  file           = {Poggio2010aug Force-detected nuclear magnetic resonance ~ recent advances and future challenges 10.1088\:0957-4484\:21\:34\:342001 *.pdf:UNSORTED/Poggio2010aug Force-detected nuclear magnetic resonance ~ recent advances and future challenges 10.1088\:0957-4484\:21\:34\:342001 *.pdf:PDF},
  keywords       = {MRFM, MRFM > reviews},
  owner          = {jam99},
  timestamp      = {2010.09.14},
  unique-id      = {ISI:000280632500002},
}

