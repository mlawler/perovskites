  journal   = {ACS Appl. Mater. Interfaces},
  keywords  = {project > EFM, personnel > Tirmzi, materials > semiconductor > perovskite,materials > semiconductor > perovskite > grain boundaries, SPM > KPFM, SPM > cp-AFM, SPM > cAFM},
  month     = {dec},
