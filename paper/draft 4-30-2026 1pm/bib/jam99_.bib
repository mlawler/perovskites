  keywords  = {magnetic resonance > hydrogen exchange},
  owner     = {jam99},
  timestamp = {2014.06.23},
}

@Article{Eperon2015jan,
  author    = {Eperon, Giles E. and Bryant, Daniel and Troughton, Joel and Stranks, Samuel D. and Johnston, Michael B. and Watson, Trystan and Worsley, David A. and Snaith, Henry J.},
  title     = {Efficient, Semitransparent Neutral-Colored Solar Cells Based on Microstructured Formamidinium Lead Trihalide Perovskite},
