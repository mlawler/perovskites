@Article{Schmidt2015dec,
  author    = {Schmidt, Moritz J. and Fedoseev, Artem and B\"ucker, Dennis and Borbas, Julia and Peter, Christine and Drescher, Malte and Summerer, Daniel},
  title     = {{EPR} Distance Measurements in Native Proteins With Genetically Encoded Spin Labels},
  volume    = {10},
