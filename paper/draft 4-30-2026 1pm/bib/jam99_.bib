@Article{Hardin2013apr,
  author    = {Hardin, William G. and Slanac, Daniel A. and Wang, Xiqing and Dai, Sheng and Johnston, Keith P. and Stevenson, Keith J.},
  title     = {Highly Active, Nonprecious Metal Perovskite Electrocatalysts for Bifunctional Metal--Air Battery Electrodes},
  journal   = {J. Phys. Chem. Lett.},
