@Article{Ziffer2016jun,
  author    = {Ziffer, Mark E. and Mohammed, Joseph C. and Ginger, David S.},
  title     = {Electroabsorption Spectroscopy Measurements of the Exciton Binding Energy, Electron--Hole Reduced Effective Mass, and Band Gap in the Perovskite {CH}$_{3}${NH}$_{3}${PbI}$_{3}$},
  volume    = {3},
  number    = {6},
  pages     = {1060 -- 1068},
  doi       = {10.1021/acsphotonics.6b00139},
  url       = {http://dx.doi.org/10.1021/acsphotonics.6b00139},
  abstract  = {We use electroabsorption (EA) spectroscopy to measure the exciton binding energy (E-B), electron hole reduced effective mass (mu), and one-electron band gap (E-g) at the fundamental absorption edge of the hybrid organic-inorganic perovskite CH3NH3PbI3 in its tetragonal phase at 300 K. By studying the second-harmonic EA spectra at the fundamental absorption edge we establish that the room temperature EA response in CH3NH3PbI3 follows the low-field Franz-Keldysh-Aspnes (FKA) effect. Following FKA analysis we find that mu = 0.12 +/- 0.03m(0), E-B = 7.4 meV, and E-g = 1.633 eV. Our results provide direct experimental evidence that at room temperature primary transitions occurring in CH3NH3PbI3 can essentially be described in terms of free carrier generation.},
  comment   = {Suggested filename = {Ziffer2016jun Electroabsorption Spectroscopy Measurements of the Exciton Binding Energy, Electron--Hole Reduced Effective Mass, and Band Gap in the Perovskite CH 3NH 3PbI 3.pdf},
Source = {wxdoi2bib}},
  file      = {Ziffer2016jun Electroabsorption Spectroscopy Measurements of the Exciton Binding Energy, Electron--Hole Reduced Effective Mass, and Band Gap in the Perovskite CH3NH3PbI3.pdf:Ziffer2016jun Electroabsorption Spectroscopy Measurements of the Exciton Binding Energy, Electron--Hole Reduced Effective Mass, and Band Gap in the Perovskite CH3NH3PbI3.pdf:PDF},
  journal   = {ACS Photonics},
  keywords  = {project > EFM, personnel > Tirmzi, collaborator > Hanrath, materials > semiconductor > perovskite, materials > semiconductor > MAPbI3, materials > semiconductor > perovskite > exciton binding energy},
  month     = {jun},
