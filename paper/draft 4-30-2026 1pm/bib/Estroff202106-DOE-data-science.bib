@article{Giridharagopal2012jan,
  title = {Submicrosecond Time Resolution Atomic Force Microscopy for Probing Nanoscale Dynamics},
  author = {Giridharagopal, Rajiv and Rayermann, Glennis E. and Shao, Guozheng and Moore, David T. and Reid, Obadiah G. and Tillack, Andreas F. and Masiello, {\relax David}. J. and Ginger, David S.},
