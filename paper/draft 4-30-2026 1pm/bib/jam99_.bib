@Article{Harris2001nov,
  author    = {Robin K. Harris and Edwin D. Becker and Sonia M. Cabral de Menezes and Robin Goodfellow and Pierre Granger},
  title     = {NMR nomenclature. Nuclear spin properties and conventions for chemical shifts (IUPAC Recommendations 2001)},
  journal   = {Pure Appl. Chem.},
  year      = {2001},
  volume    = {73},
  number    = {11},
  month     = {nov},
  pages     = {1795--1818},
  doi       = {10.1351/pac200173111795},
  url       = {http://dx.doi.org/10.1351/pac200173111795},
  abstract  = {A unified scale is recommended for reporting the NMR chemical shifts of all nuclei relative to the 1H resonance of tetramethylsilane (TMS). The unified scale is designed to provide a precise ratio of the resonance frequency of a given nuclide to that of the primary reference, the 1H resonance of TMS in dilute solution (volume fraction, ? < 1%) in chloroform. Referencing procedures are discussed, including matters of practical application of the unified scale. Special attention is paid to recommended reference samples, and values of for secondary references on the unified scale are listed, many of which are the results of new measurements.
Some earlier recommendations relating to the reporting of chemical shifts are endorsed. The chemical shift, ?, is redefined to avoid previous ambiguities but to leave practical usage unchanged. Relations between the unified scale and recently published recommendations for referencing in aqueous solutions (for specific use in biochemical work) are discussed, as well as the special effects of working in the solid state with magic-angle spinning. In all, nine new recommendations relating to chemical shifts are made.
Standardized nuclear spin data are also presented in tabular form for the stable (and some unstable) isotopes of all elements with nonzero quantum numbers. The information given includes quantum numbers, isotopic abundances, magnetic moments, magnetogyric ratios and receptivities, together with quadrupole moments and line-width factors where appropriate.},
  comment   = {Suggested filename = Harris2001nov NMR nomenclature. Nuclear spin properties and conventions for chemical shifts (IUPAC Recommendations 2001) 10.1351/pac200173111795 *.pdf},
  file      = {Harris2001nov NMR nomenclature. Nuclear spin properties and conventions for chemical shifts (IUPAC Recommendations 2001) 10.1351\:pac200173111795 *.pdf:UNSORTED/Harris2001nov NMR nomenclature. Nuclear spin properties and conventions for chemical shifts (IUPAC Recommendations 2001) 10.1351\:pac200173111795 *.pdf:PDF},
  keywords  = {magnetic resonance > reference},
  owner     = {ewm},
  timestamp = {2010.06.01},
}

@MastersThesis{Harsila2010mar,
  author    = {Scott Harsila},
  title     = {High Stability Displacement Interferometry for Magnetic Resonance Force Microscopy},
  year      = {2010},
  month     = {mar},
  abstract  = {This thesis describes the noise and drift characteristics of displacement sensing interferometry when used in Magnetic Resonance Force Microscopy (MRFM) and techniques to reduce their eect. MRFM requires sub-nanometer position control overlong periods of time for accurate imaging. MRFM utilizes displacement interferometry for position feedback of the sample scanner apparatus. In order to achieve this stability, compensation techniques for laser power and wavelength drift eects must be applied. A xed-length cavity designed to track changes in laser power and wave- length can be utilized for compensation. This "wavetracking" cell provides an in situ length reference for creating a compensation signal within an MRFM apparatus. Two wavetracker cells were designed, one for room temperature (293K) stability and one designed to be stable after a large change in temperature (from 293K to 4K). The room temperature device was predicted to have a room temperature length stability of 148 picometers per K. The cooldown device was predicted to have a length change standard deviation of 182 nanometers during a change in temperature of 293K to 4K, and when at 4K to have a length stability of 4 picometers per K. A compensated MRFM displacement interferometer has been shown to have a predicted stability of 20 picometers at room temperature.},
  comment   = {Suggested filename = Harsila2010mar High Stability Displacement Interferometry for Magnetic Resonance Force Microscopy *.pdf},
  file      = {Harsila2010mar High Stability Displacement Interferometry for Magnetic Resonance Force Microscopy *.pdf:UNSORTED/Harsila2010mar High Stability Displacement Interferometry for Magnetic Resonance Force Microscopy *.pdf:PDF;Harsila2010mar-README.rtf:UNSORTED/Harsila2010mar-README.rtf:Rich Text Format},
  keywords  = {SPM > fiber-optic interferometer, MRFM> fiber-optic interferometer, SPM > fiber-optic interferometer > two wavelength},
  owner     = {jam99},
  school    = {University of Washington},
  timestamp = {2011.09.09},
}

@Article{Hartmann1962dec,
  author    = {Hartmann, S. R. and Hahn, E. L.},
  title     = {Nuclear Double Resonance in the Rotating Frame},
  journal   = {Phys. Rev.},
  year      = {1962},
  volume    = {128},
  number    = {5},
  month     = {dec},
  pages     = {2042 -- 2053},
  doi       = {10.1103/PhysRev.128.2042},
  url       = {http://dx.doi.org/10.1103/PhysRev.128.2042},
  abstract  = {A double nuclear resonance spectroscopy method is introduced which depends upon effects of magnetic dipole-dipole coupling between two different nuclear species. In solids a minimum detectability of the order of 10^14 to 10^16 nuclear Bohr magnetons/cc of a rare b nuclear species is predicted, to be measured in terms of the change in a strong signal displayed by an abundant a nuclear species. The a magnetization is first oriented by a strong radio-frequency field in the frame of reference rotating at its Larmor frequency. The b nuclear resonance is obtained simultaneously with a second radio-frequency field; and with the condition that the a and b spins have the same Larmor frequencies in their respective rotating frames, a cross relaxation will occur between the two spin systems. The cross-relaxation interaction, which lasts for the order of a long spin-lattice relaxation time of the a magnetization, is arranged to produce a cumulative demagnetization of the a system when maximum sensitivity is desired. Final observation of the reduced a magnetization indicates the nuclear resonance of the b system. The concepts of uniform spin temperature, when it is valid, and of nonuniform spin temperature where spin diffusion is important, are applied. The density matrix method formulates the double resonance interaction rate in second order. Preliminary tests of the double resonance effect are carried out with a nuclear quadrupole system.},
  comment   = {Classic! Suggested filename = Hartmann1962dec Nuclear Double Resonance in the Rotating Frame 10.1103:PhysRev.128.2042 *.pdf.},
  file      = {Hartmann1962dec Nuclear Double Resonance in the Rotating Frame 10.1103\:PhysRev.128.2042 *.pdf:UNSORTED/Hartmann1962dec Nuclear Double Resonance in the Rotating Frame 10.1103\:PhysRev.128.2042 *.pdf:PDF},
  keywords  = {magnetic resonance, magnetic resonance > double res, magnetic resonance > double res > Hartman-Hahn},
  numpages  = {11},
  owner     = {jam99},
  publisher = {American Physical Society},
  timestamp = {2010.03.14},
}

@Article{Hartnett2014nov,
  author    = {Hartnett, Patrick E. and Timalsina, Amod and Matte, H. S. S. Ramakrishna and Zhou, Nanjia and Guo, Xugang and Zhao, Wei and Facchetti, Antonio and Chang, Robert P. H. and Hersam, Mark C. and Wasielewski, Michael R. and Marks, Tobin J.},
  title     = {Slip-Stacked Perylenediimides as an Alternative Strategy for High Efficiency Nonfullerene Acceptors in Organic Photovoltaics},
  journal   = {J. Am. Chem. Soc.},
  year      = {2014},
  volume    = {136},
  number    = {46},
  month     = {nov},
  pages     = {16345 -- 16356},
  doi       = {10.1021/ja508814z},
  url       = {http://dx.doi.org/10.1021/ja508814z},
  abstract  = {Perylenediimide (PDI)-based acceptors offer a potential replacement for fullerenes in bulk-heterojunction (BHJ) organic photovoltaic cells (OPVs). The most promising efforts have focused on creating twisted PDI dimers to disrupt aggregation and thereby suppress excimer formation. Here, we present an alternative strategy for developing high-performance OPVs based on PDI acceptors that promote slip-stacking in the solid state, thus preventing the coupling necessary for rapid excimer formation. This packing structure is accomplished by substitution at the PDI 2,5,8,11-positions (``headland positions''). Using this design principle, three PDI acceptors, N,N-bis(n-octyl)-2,5,8,11-tetra(n-hexyl)-PDI (Hexyl-PDI), N,N-bis(n-octyl)-2,5,8,11-tetraphenethyl-PDI (Phenethyl-PDI), and N,N-bis(n-octyl)-2,5,8,11-tetraphenyl-PDI (Phenyl-PDI), were synthesized, and their molecular and electronic structures were characterized. They were then blended with the donor polymer PBTI3T, and inverted OPVs of the structure ITO/ZnO/Active Layer/MoO3/Ag were fabricated and characterized. Of these, 1:1 PBTI3T:Phenyl-PDI proved to have the best performance with Jsc = 6.56 mA/cm2, Voc = 1.024 V, FF = 54.59\%, and power conversion efficiency (PCE) = 3.67\%. Devices fabricated with Phenethyl-PDI and Hexyl-PDI have significantly lower performance. The thin film morphology and the electronic and photophysical properties of the three materials are examined, and although all three materials undergo efficient charge separation, PBTI3T:Phenyl-PDI is found to have the deepest LUMO, intermediate crystallinity, and the most well-mixed domains. This minimizes geminate recombination in Phenyl-PDI OPVs and affords the highest PCE. Thus, slip-stacked PDI strategies represent a promising approach to fullerene replacements in BHJ OPVs.},
  comment   = {Suggested filename = {Hartnett2014nov Slip-Stacked Perylenediimides as an Alternative Strategy for High Efficiency Nonfullerene Acceptors in Organic Photovoltaics.pdf},
Source = {wxdoi2bib}},
  keywords  = {materials > PES > PDI, project > EFM},
  owner     = {jam99},
  timestamp = {2014.11.20},
}

@Article{Hausmanns2003may,
  author      = {Hausmanns, B and Krome, TP and Dumpich, G},
  title       = {Magnetoresistance and magnetization reversal process of {Co} nanowires covered with {Pt}},
  journal     = {J. Appl. Phys.},
  year        = {2003},
  volume      = {93},
  number      = {10, Part 3},
  month       = {may},
  pages       = {8095-8097},
  issn        = {0021-8979},
