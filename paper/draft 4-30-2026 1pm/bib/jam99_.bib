@Article{Chen2013aug,
  author    = {Chen, Dongyang and Hickner, Michael A. and Agar, Ertan and Kumbur, E. Caglan},
  title     = {Optimized Anion Exchange Membranes for Vanadium Redox Flow Batteries},
  journal   = {ACS Appl. Mater. Interfaces},
  year      = {2013},
  volume    = {5},
  number    = {15},
  month     = {aug},
  pages     = {7559 -- 7566},
  doi       = {10.1021/am401858r},
  url       = {http://dx.doi.org/10.1021/am401858r},
  abstract  = {In order to understand the properties of low vanadium permeability anion exchange membranes for vanadium redox flow batteries (VRFBs), quaternary ammonium functionalized Radel (QA-Radel) membranes with three ion exchange capacities (IECs) from 1.7 to 2.4 mequiv per gram were synthesized and 55 to 60 micrometer thick membrane samples were evaluated for their transport properties and in-cell battery performance. The ionic conductivity and vanadium permeability of the membranes were investigated and correlated to the battery performance through measurements of Coulombic efficiency, voltage efficiency and energy efficiency in single cell tests, and capacity fade during cycling. Increasing the IEC of the QA-Radel membranes increased both the ionic conductivity and VO2+ permeability. The 1.7 mequiv per gram IEC QA-Radel had the highest Coulombic efficiency and best cycling capacity maintenance in the VRFB, while the cell's voltage efficiency was limited by the membrane's low ionic conductivity. Increasing the IEC resulted in higher voltage efficiency for the 2.0 and 2.4 mequiv per gram samples, but the cells with these membranes displayed reduced Coulombic efficiency and faster capacity fade. The QA-Radel with an IEC of 2.0 mequiv per gram had the best balance of ionic conductivity and VO2+ permeability, achieving a maximum power density of 218 mW per centimeter squared which was higher than the maximum power density of a VRFB assembled with a Nafion N212 membrane in our system. While anion exchange membranes are under study for a variety of VRFB applications, this work demonstrates that the material parameters must be optimized to obtain the maximum cell performance.},
  comment   = {Suggested filename = {Chen2013aug Optimized Anion Exchange Membranes for Vanadium Redox Flow Batteries.pdf},
Source = {wxdoi2bib}},
