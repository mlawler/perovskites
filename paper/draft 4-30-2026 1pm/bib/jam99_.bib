@Article{Cadby2008may,
  author         = {Cadby, A. and Khalil, G. and Fox, A. M. and Lidzey, D. G.},
  title          = {Mapping Exciton Quenching in Photovoltaic-Applicable Polymer Blends Using Time-Resolved Scanning Near-Field Optical Microscopy},
  journal        = {J. Appl. Phy.},
  year           = {2008},
  volume         = {103},
  number         = {9},
  month          = {may},
  pages          = {093715},
  issn           = {0021-8979},
  doi            = {10.1063/1.2910826},
  url            = {http://dx.doi.org/10.1063/1.2910826},
  abstract       = {We have used time-resolved scanning near-field microscopy to image the fluorescence decay lifetime across a phase-separated blend of the photovoltaic-applicable polymers poly(9,9(')-dioctylfluorene-alt-benzothiadiazole) (F8BT) and poly(9,9(')-dioctylfluorene-alt-bis- N,N-'-(4-butylphenyl)-bis-N,N-'-phenyl-1,4-phenylenediamine) (PFB). We show that the efficiency of local fluorescence quenching is composition dependent, with excitons on F8BT molecules being more effectively quenched when F8BT is trapped at a low concentration in a PFB-rich phase. Despite such presumed differences in charge-carrier generation efficiency, our results demonstrate that charge extraction from F8BT:PFB devices is the most dominant mechanism limiting their operational efficiency. (c) 2008 American Institute of Physics.},
  article-number = {093715},
  comment        = {Suggested filename = Cadby2008may Mapping exciton quenching in photovoltaic-applicable polymer blends using time-resolved scanning near-field optical microscopy 10.1063/1.2910826 *.pdf

Cites = Alvarado1998aug

From Groves2010may review:

We used trEFM to measure both the morphology of PFB/ F8BT blends and the photoinduced charging rate \cite{Coffey2006sep}. Figure 6b shows the trEFM charging rate from the same area as the topography image of Figure 6a. Surprisingly, the areas with the highest charging rates are at the centers of the topographically visible domains, not their edges. Indeed, the edges of the domain show reduced photocurrent. This suggests that the visible domain edges likely act as recombination centers, (a hypothesis consistent with a number of other imaging and spectroscopic studies on PFB/F8BT blends) \cite{McNeill2004dec,Cadby2008may}. Increased recombination at the visible domain boundaries may be due to local composition or chain orientation at the domain boundaries.

From Justin Luria:

Attached is little bit of light reading for you, JOURNAL OF APPLIED PHYSICS 103, 093715 2008 (with meta-data embedded). They use PL quenching lifetimes to determine geminate recombination strength. Fluroescence decay lifetimes are significantly shorter in the blend than in pure F8BT, indicating quenching from excitons being split. In otherwords, the shorter the lifetime, the fewer excitons are being split. Their measurements show larger exciton generation from F8BT absorption while in the PFB phase (due to F8BT nano islands). The reasoning is that the nano islands have interfaces very close by from wherever the exciton is generated.

They fire on McNeil (Nano Letters 2004) saying that high scanning photocurrent in PFB is due to a better extraction efficiency rather than better charge generation efficiency.

They do not make any sort of call on exciton splitting from PFB, as FRET keeps the PL lifetimes shorter than what they are capable of detecting.

I think our paper makes strong conclusions regarding which material is the workhorse of the two, where this paper can not. Even though PFB shows better hole transport (ala McNeil 2004) At the end of the day, the open circuit voltage is due to F8BT.},
  file           = {Cadby2008may Mapping exciton quenching in photovoltaic-applicable polymer blends using time-resolved scanning near-field optical microscopy 10.1063\:1.2910826 *.pdf:UNSORTED/Cadby2008may Mapping exciton quenching in photovoltaic-applicable polymer blends using time-resolved scanning near-field optical microscopy 10.1063\:1.2910826 *.pdf:PDF},
  keywords       = {materials > PES > PFB, materials > PES > F8BT, charge separation > measurements > tr-NSOM},
  owner          = {jam99},
  timestamp      = {2011.04.06},
  unique-id      = {ISI:000255983200084},
}

@Article{Cadena2016apr,
  author    = {Cadena, Maria J. and Sung, Seung Hyun and Boudouris, Bryan W. and Reifenberger, Ronald and Raman, Arvind},
  title     = {Nanoscale Mapping of Dielectric Properties of Nanomaterials From Kilohertz to Megahertz Using Ultrasmall Cantilevers},
  journal   = {ACS Nano},
  year      = {2016},
  volume    = {10},
  number    = {4},
  month     = {apr},
  pages     = {4062 -- 4071},
  doi       = {10.1021/acsnano.5b06893},
  url       = {http://dx.doi.org/10.1021/acsnano.5b06893},
  abstract  = {Electrostatic force microscopy (EFM) is often used for nanoscale dielectric spectroscopy, the measurement of local dielectric properties of materials as a function of frequency. However, the frequency range of atomic force microscopy (AFM)-based dielectric spectroscopy has been limited to a few kilohertz by the resonance frequency and noise of soft microcantilevers used for this purpose. Here, we boost the frequency range of local dielectric spectroscopy by 3 orders of magnitude from a few kilohertz to a few megahertz by developing a technique that exploits the high resonance frequency and low thermal noise of ultrasmall cantilevers (USCs). We map the frequency response of the real and imaginary components of the capacitance gradient by using second-harmonic EFM and a theoretical model, which relates cantilever dynamics to the complex dielectric constant. We demonstrate the method by mapping the nanoscale dielectric spectrum of polymer-based materials for organic electronic devices. Beyond offering a powerful extension to AFM-based dielectric spectroscopy, the approach also allows the identification of electrostatic excitation frequencies which affords high dielectric contrast on nanomaterials.},
  comment   = {Suggested filename = {Cadena2016apr Nanoscale Mapping of Dielectric Properties of Nanomaterials From Kilohertz to Megahertz Using Ultrasmall Cantilevers.pdf},
Source = {wxdoi2bib}},
  file      = {Cadena2016apr Nanoscale Mapping of Dielectric Properties of Nanomaterials From Kilohertz to Megahertz Using Ultrasmall Cantilevers.pdf:UNSORTED/Cadena2016apr Nanoscale Mapping of Dielectric Properties of Nanomaterials From Kilohertz to Megahertz Using Ultrasmall Cantilevers.pdf:PDF},
  keywords  = {project > EFM, SPM > KPFM > quantitative, measurements > dielectric spectroscopy, SPM > KPFM > dielectric spectroscopy},
  owner     = {jam99},
  timestamp = {2016.05.04},
}

@Article{Caffrey2009apr,
  author    = {Caffrey, Martin and Cherezov, Vadim},
  title     = {Crystallizing Membrane Proteins Using Lipidic Mesophases},
  journal   = {Nat. Protoc.},
