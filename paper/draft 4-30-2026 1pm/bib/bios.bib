@Article{Choi2010apr,
    author = "Choi, Joshua J. and Luria, Justin and Hyun, Byung-Ryool and Bartnik, Adam C. and Sun, Liangfeng and Lim, Yee-Fun and Marohn, John A. and Wise, Frank W. and Hanrath, Tobias",
