@Article{Wittstock2007feb,
  author    = {Wittstock, Gunther and Burchardt, Malte and Pust, Sascha E. and Shen, Yan and Zhao, Chuan},
  title     = {Scanning Electrochemical Microscopy for Direct Imaging of Reaction Rates},
  volume    = {46},
  number    = {10},
  pages     = {1584 -- 1617},
  doi       = {10.1002/anie.200602750},
  url       = {http://dx.doi.org/10.1002/anie.200602750},
  abstract  = {Not only in electrochemistry but also in biology and in membrane transport, localized processes at solid--liquid or liquid--liquid interfaces play an important role at defect sites, pores, or individual cells, but are difficult to characterize by integral investigation. Scanning electrochemical microscopy is suitable for such investigations. After two decades of development, this method is based on a solid theoretical foundation and a large number of demonstrated applications. It offers the possibility of directly imaging heterogeneous reaction rates and locally modifying substrates by electrochemically generated reagents. The applications range from classical electrochemical problems, such as the investigation of localized corrosion and electrocatalytic reactions in fuel cells, sensor surfaces, biochips, and microstructured analysis systems, to mass transport through synthetic membranes, skin and tissue, as well as intercellular communication processes. Moreover, processes can be studied that occur at liquid surfaces and liquid--liquid interfaces.},
  comment   = {Suggested filename = {Wittstock2007feb Scanning Electrochemical Microscopy for Direct Imaging of Reaction Rates.pdf}},
  file      = {Wittstock2007feb Scanning Electrochemical Microscopy for Direct Imaging of Reaction Rates.pdf:UNSORTED/Wittstock2007feb Scanning Electrochemical Microscopy for Direct Imaging of Reaction Rates.pdf:PDF},
  journal   = {Angew. Chem. Int. Ed.},
  keywords  = {SPM > SECM-AFM},
  month     = {feb},
  owner     = {jam99},
  timestamp = {2019.03.03},
  year      = {2007},
}

@Article{Wohlgenannt2001jan,
  author    = {Wohlgenannt, M. and Tandon, Kunj and Mazumdar, S. and Ramasesha, S. and Vardeny, Z. V.},
  title     = {Formation Cross-sections of Singlet and Triplet Excitons in $\pi$-conjugated Polymers},
  volume    = {409},
  number    = {6819},
  pages     = {494 -- 497},
  doi       = {10.1038/35054025},
  url       = {http://dx.doi.org/10.1038/35054025},
  abstract  = {Electroluminescence in organic light-emitting diodes arises from a charge-transfer reaction between the injected positive and negative charges by which they combine to form singlet excitons that subsequently decay radiatively. The quantum yield of this process (the number of photons generated per electron or hole injected) is often thought1 to have a statistical upper limit of 25 per cent. This is based on the assumption that the formation cross-section of singlet excitons, -- is approximately the same as that of any one of the three equivalent non-radiative triplet exciton states, -- ; that is, --. However, recent experimental2 and theoretical3 work suggests that -- may be greater than 1. Here we report direct measurements of -- for a large number of -conjugated polymers and oligomers. We have found that there exists a strong systematic, but not monotonic, dependence of --on the optical gap of the organic materials. We present a detailed physical picture of the charge-transfer reaction for correlated -electrons, and quantify this process using exact valence bond calculations. The calculated -- reproduces the experimentally observed trend. The calculations also show that the strong dependence of -- on the optical gap is a signature of the discrete excitonic energy spectrum, in which higher energy excitonic levels participate in the charge recombination process.},
  comment   = {Suggested filename = {Wohlgenannt2001jan Formation Cross-sections of Singlet and Triplet Excitons in pi-conjugated Polymers.pdf}, Source = {wxdoi2bib}},
  file      = {Wohlgenannt2001jan Formation Cross-sections of Singlet and Triplet Excitons in pi-conjugated Polymers.pdf:UNSORTED/Wohlgenannt2001jan Formation Cross-sections of Singlet and Triplet Excitons in pi-conjugated Polymers.pdf:PDF},
  journal   = {Nature},
  keywords  = {magnetic resonance > detection > optical},
  month     = {jan},
  owner     = {jam99},
  timestamp = {2019.03.03},
  year      = {2001},
}

@Article{Wolf2001nov,
  Title                    = {Spintronics: {A} spin-based electronics vision for the future},
  Author                   = {Wolf, S. A. and Awschalom, D. D. and Buhrman, R. A. and Daughton, J. M. and Von Molnar, S. and Roukes, M. L. and Chtchelkanova, A. Y. and Treger, D. M.},
  Journal                  = {Science},
  Year                     = {2001},

  Month                    = {nov},
  Number                   = {5546},
  Pages                    = {1488 -- 1495},
  Volume                   = {294},

  Abstract                 = {This review describes a new paradigm of electronics based on the spin degree of freedom of the electron. Either adding the spin degree of freedom to conventional charge-based electronic devices or using the spin alone has the potential advantages of nonvolatility, increased data processing speed, decreased electric power consumption, and increased integration densities compared with conventional semiconductor devices. To successfully incorporate spins into existing semiconductor technology, one has to resolve technical issues such as efficient injection, transport, control and manipulation, and detection of spin polarization as welt as spin-polarized currents. Recent advances in new materials engineering hold the promise of realizing spintronic devices in the near future. We review the current state of the spin-based devices, efforts in new materials fabrication, issues in spin transport, and optical spin manipulation.},
  Doi                      = {10.1126/science.1065389},
  File                     = {Wolf2001nov Spintronics ~ A spin-based electronics vision for the future 10.1126\:science.1065389 *.pdf:UNSORTED/Wolf2001nov Spintronics ~ A spin-based electronics vision for the future 10.1126\:science.1065389 *.pdf:PDF},
  Keywords                 = {MRFM > magnetometry, nanomagnetics},
  Owner                    = {jam99},
  Timestamp                = {2009.08.08},
  Url                      = {http://dx.doi.org/10.1126/science.1065389}
}

