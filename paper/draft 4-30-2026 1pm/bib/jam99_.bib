}

@Article{Yan2004aug,
  author    = {He Yan and Tobin J. Marks},
  title     = {Electron-blocking mechanisms at the hole transport layer-emissive layer interface in polymer light-emitting diodes: {E}nhanced device performance with a novel electron-blocking interlayer},
  volume    = {5519},
