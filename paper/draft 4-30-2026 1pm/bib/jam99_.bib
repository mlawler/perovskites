@Unpublished{Marohn2016oct,
  Title                    = {Nanoscale Functional Imaging of Organic Materials},
  Author                   = {Marohn, John A},
  Note                     = {National Institute of Standards and Technology, Gaithersburg, Maryland; October 28},

  Month                    = {oct},
  Year                     = {2016},

  Abstract                 = {Nanometer-scale Functional Imaging of Organic Materials
Using microcantilevers to detect magnetic resonance, spectroscopically probe electronic energy levels, image charge generation, and study charge diffusion and recombination in nanometer-scale samples

John A. Marohn
Professor, Dept. of Chemistry and Chemical Biology
Member, Field of Materials Science and Engineering
Cornell University, Ithaca, New York USA

Imaging the structure and function of organic materials at nanometer resolution represents a major challenge. 

To address this challenge, we are pushing magnetic resonance imaging (MRI) to nanometer resolution. I will describe the development of attonewton-sensitivity cantilevers with integrated nanomagnet tips. We have used these cantilevers to detect magnetic resonance from a polymer film at cryogenic temperatures with a sensitivity of a few hundred proton magnetic moments. These experiments detected proton magnetization fluctuations present in small, nanometer-scale volumes of spins. I will describe efforts to significantly improve the per-spin sensitivity and acquisition time of nano-MRI experiments by using dynamic nuclear polarization to create a measurable net nuclear spin polarization, pushing the experiment out of the spin noise limit. Taken together, these experiments suggest that the magnetic resonance force microscope is on its way to becoming a powerful new route for creating a three-dimensional image of a single copy of a globular protein, membrane protein, or macromolecular complex. 

In the second half of my talk I will describe nanoscale studies of charges in organic semiconductors. I will show that scanning Kelvin probe microscopy (SKPM) – when equipped with variable-wavelength sample illumination – can be used to infer the electronic energy levels of charged defect states in an organic thin-film transistor. I will show movies of surface voltage versus wavelength collected over an organic bulk heterojunction solar cell; from this data we can obtain localized charge-generation spectra for the different material phases present in the solar cell. Both of these studies give new microscopic insight into how to improve organic semiconductor materials. I will show that cantilever frequency noise in an SKPM experiment is a sensitive probe of both thermal atomic motions and charge fluctuations in an organic film. Comparisons between theory and experiment indicate that this capability can give fresh insight into the effect of inter-carrier Coulomb repulsion on charge mobility in organic semiconductors. Finally, I will describe experiments we have invented for detecting photovoltage and photocapacitance with a spatial resolution of nanometers and a time resolution of nanoseconds. 

John Marohn earned a B.S. in Chemistry and a B.A. in Physics from the University of Rochester, earned a Ph.D. in Chemistry working with Daniel P. Weitekamp at the California Institute of Technology, and did postdoctoral work at the U.S. Army Research Laboratory with Doran Smith as a U.S. National Research Council Postdoctoral Associate. In 1999 he joined Cornell University where he is a member of the Cornell Center for Materials Research and a member of the Field of Materials Science and Engineering. In 2006, Marohn created the first international conference on nanometer-scale magnetic resonance imaging; the 5th International nano-MRI conference was held in 2015. In AY 2011 he was a visiting scientist at The Scripps Research Institute in La Jolla, California.},
  Keywords                 = {marohn-talk-invited, grant-Afshari-ARO-W911NF1410674, grant-Marohn-NSF-DMR-1309540},
  Owner                    = {jam99},
  Timestamp                = {2017.03.03}
}

