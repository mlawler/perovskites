@Unpublished{Marohn2004mar,
  Title                    = {Batch-Fabricated Ultrasensitive Magnetic-Tipped Cantilevers and Modulation-Free Cantilever Detected Nuclear Magnetic Resonance},
  Author                   = {John A. Marohn},
  Note                     = {March Meeting of the American Physical Society, Division of Condensed Matter Physics Session on Magnetic Resonance Force Microscopy; Montreal, Canada; March 22 -- 26},

  Month                    = {mar},
  Year                     = {2004},

  Abstract                 = {We report the first batch fabrication of magnetic-tipped ultralow spring constant cantilevers. We have studied magnetization and thermomagnetic fluctuations in individual submicon nickel magnets using cantilever magnetometry and have examined force sensitivity of low spring constant cantilevers as a function of tip-sample distance and voltage, at room and cryogenic temperatures and in high vacuum. Finally, we have demonstrated a method for detecting nuclear magnetic resonance with a cantilever that does not require modulating sample magnetization at the cantilever resonance frequency, allowing, in principle, direct observation of z-axis magnetization in real time. For this reason our technique's requirements on sample spin relaxation characteristics are far less stringent than for previous MRFM protocols and even conventional solid-state NMR, allowing a much wider array of systems to be characterized by nuclear magnetic resonance at low temperature.},
  Keywords                 = {marohn-talk-invited},
  Owner                    = {jam99},
  Timestamp                = {2012.06.07},
  Url                      = {http://flux.aps.org/meetings/YR04/MAR04/baps/abs/S8830001.html}
}

