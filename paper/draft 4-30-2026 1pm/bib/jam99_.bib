@Article{Hegyi2013feb,
  author    = {Hegyi, Alex and Yablonovitch, Elisabeth},
  title     = {Molecular Imaging by Optically Detected Electron Spin Resonance of Nitrogen-Vacancies in Nanodiamonds},
  journal   = {Nano Lett.},
  year      = {2013},
  volume    = {ASAP},
  month     = {feb},
  doi       = {10.1021/nl304570b},
  url       = {http://dx.doi.org/10.1021/nl304570b},
  abstract  = {We propose a novel biomedical imaging technique, called nanodiamond imaging, that noninvasively records the three-dimensional distribution of biologically tagged nanodiamonds in vivo. Our technique performs optically detected electron spin resonance of nitrogen-vacancy centers in nanodiamonds, a nontoxic nanomaterial that is easily biologically functionalized. We demonstrate the feasibility of the technique by imaging multiple nanodiamond targets within pieces of chicken breast; it is the first demonstration of imaging within scattering tissue by optically detected magnetic resonance. We achieve a sensitivity equivalent to 740 pg of nanodiamond in 100 s of measurement time and a spatial resolution of 800 $\mu$m over a 1 cm$^2$ field of view, and we show how the technique has the potential to yield images with combined high sensitivity (100 fg nanodiamond) AND high spatial resolution (100 $\mu$m) over organism-scale fields of view, features which are mutually exclusive in existing imaging modalities except at the shallowest imaging depths.},
  comment   = {Suggested filename = {Hegyi2013feb Molecular Imaging by Optically Detected Electron Spin Resonance of Nitrogen-Vacancies in Nanodiamonds.pdf}},
  file      = {Hegyi2013feb Molecular Imaging by Optically Detected Electron Spin Resonance of Nitrogen-Vacancies in Nanodiamonds.pdf:UNSORTED/Hegyi2013feb Molecular Imaging by Optically Detected Electron Spin Resonance of Nitrogen-Vacancies in Nanodiamonds.pdf:PDF},
  keywords  = {biology, magnetic resonance > NV center},
  owner     = {jam99},
  timestamp = {2013.02.12},
}

@Article{Heijer2014may,
  author    = {den Heijer, M. and Fokkema, V. and Saedi, A. and Schakel, P. and Rost, M. J.},
  title     = {Improving the Accuracy of Walking Piezo Motors},
  journal   = {Rev. Sci. Instrum.},
  year      = {2014},
  volume    = {85},
  number    = {5},
  month     = {may},
  pages     = {055007},
  doi       = {10.1063/1.4878624},
  url       = {http://dx.doi.org/10.1063/1.4878624},
  abstract  = {Many application areas require ultraprecise, stiff, and compact actuator systems with a high positioning resolution in combination with a large range as well as a high holding and pushing force. One promising solution to meet these conflicting requirements is a walking piezo motor that works with two pairs of piezo elements such that the movement is taken over by one pair, once the other pair reaches its maximum travel distance. A resolution in the pm-range can be achieved, if operating the motor within the travel range of one piezo pair. However, applying the typical walking drive signals, we measure jumps in the displacement up to 2.4 mu m, when the movement is given over from one piezo pair to the other. We analyze the reason for these large jumps and propose improved drive signals. The implementation of our new drive signals reduces the jumps to less than 42 nm and makes the motor ideally suitable to operate as a coarse approach motor in an ultra-high vacuum scanning tunneling microscope. The rigidity of the motor is reflected in its high pushing force of 6.4 N.},
  comment   = {Suggested filename = {denHeijer2014may Improving the Accuracy of Walking Piezo Motors.pdf},
Source = {wxdoi2bib}},
  file      = {denHeijer2014may Improving the Accuracy of Walking Piezo Motors.pdf:denHeijer2014may Improving the Accuracy of Walking Piezo Motors.pdf:PDF},
  keywords  = {nanopositioning, nanopositioning > slip-stick},
  owner     = {jam99},
  timestamp = {2017.04.03},
}

@Article{Hell2015nov,
  author    = {Hell, Stefan W and Sahl, Steffen J and Bates, Mark and Zhuang, Xiaowei and Heintzmann, Rainer and Booth, Martin J and Bewersdorf, Joerg and Shtengel, Gleb and Hess, Harald and Tinnefeld, Philip and Honigmann, Alf and Jakobs, Stefan and Testa, Ilaria and Cognet, Laurent and Lounis, Brahim and Ewers, Helge and Davis, Simon J and Eggeling, Christian and Klenerman, David and Willig, Katrin I and Vicidomini, Giuseppe and Castello, Marco and Diaspro, Alberto and Cordes, Thorben},
  title     = {The 2015 Super-Resolution Microscopy Roadmap},
  journal   = {J. Phys. D: Appl. Phys.},
  year      = {2015},
  volume    = {48},
  number    = {44},
  month     = {nov},
  pages     = {443001},
  doi       = {10.1088/0022-3727/48/44/443001},
  url       = {http://dx.doi.org/10.1088/0022-3727/48/44/443001},
  abstract  = {Far-field optical microscopy using focused light is an important tool in a number of scientific disciplines including chemical, (bio)physical and biomedical research, particularly with respect to the study of living cells and organisms. Unfortunately, the applicability of the optical microscope is limited, since the diffraction of light imposes limitations on the spatial resolution of the image. Consequently the details of, for example, cellular protein distributions, can be visualized only to a certain extent. Fortunately, recent years have witnessed the development of 'super-resolution' far-field optical microscopy (nanoscopy) techniques such as stimulated emission depletion (STED), ground state depletion (GSD), reversible saturated optical (fluorescence) transitions (RESOLFT), photoactivation localization microscopy (PALM), stochastic optical reconstruction microscopy (STORM), structured illumination microscopy (SIM) or saturated structured illumination microscopy (SSIM), all in one way or another addressing the problem of the limited spatial resolution of far-field optical microscopy. While SIM achieves a two-fold improvement in spatial resolution compared to conventional optical microscopy, STED, RESOLFT, PALM/STORM, or SSIM have all gone beyond, pushing the limits of optical image resolution to the nanometer scale. Consequently, all super-resolution techniques open new avenues of biomedical research. Because the field is so young, the potential capabilities of different super-resolution microscopy approaches have yet to be fully explored, and uncertainties remain when considering the best choice of methodology. Thus, even for experts, the road to the future is sometimes shrouded in mist. The super-resolution optical microscopy roadmap of Journal of Physics D: Applied Physics addresses this need for clarity. It provides guidance to the outstanding questions through a collection of short review articles from experts in the field, giving a thorough discussion on the concepts underlying super-resolution optical microscopy, the potential of different approaches, the importance of label optimization (such as reversible photoswitchable proteins) and applications in which these methods will have a significant impact.},
  comment   = {Suggested filename = {Hell2015nov The 2015 Super-resolution Microscopy Roadmap.pdf},
Source = {wxdoi2bib}},
  file      = {Hell2015nov The 2015 Super-resolution Microscopy Roadmap.pdf:UNSORTED/Hell2015nov The 2015 Super-resolution Microscopy Roadmap.pdf:PDF},
  keywords  = {project > MRFM, microscopy > optical > super-resolution > review},
  owner     = {jam99},
  timestamp = {2016.08.09},
}

