@Article{Uhlemann2013jul,
  author    = {Uhlemann, Stephan and M\"uller, Heiko and Hartel, Peter and Zach, Joachim and Haider, Max.},
  title     = {Thermal Magnetic Field Noise Limits Resolution in Transmission Electron Microscopy},
  volume    = {111},
