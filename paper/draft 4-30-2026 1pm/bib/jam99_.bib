@Article{Huber1998mar,
  author    = {H\"uber, Martina M. and Staubli, Andrea B. and Kustedjo, Karen and Gray, Mike H. B. and Shih, John and Fraser, Scott E. and Jacobs, Russell E. and Meade, Thomas J.},
  title     = {Fluorescently Detectable Magnetic Resonance Imaging Agents},
  journal   = {Bioconjugate Chem.},
  year      = {1998},
  volume    = {9},
  number    = {2},
  month     = {mar},
  pages     = {242 -- 249},
  doi       = {10.1021/bc970153k},
  url       = {http://dx.doi.org/10.1021/bc970153k},
  abstract  = {This report describes the synthesis, characterization, and in vivo testing of several bifunctional contrast-enhancing agents for optical and magnetic resonance imaging (MRI) of experimental animals. These new agents integrate the advantages of both techniques since they can be visualized simultaneously by light and MRI microscopy. Employing this strategy allows the same biological structures of a specimen to be studied at dramatically different resolutions and depths. The complexes possess a metal chelator for binding a paramagnetic ion, gadolinium (Gd3+), and a covalently attached fluorescent dye. The first class of complexes are low-molecular weight species that are composed of the macrocyclic tetraamine 1,4,7,10-tetraazacyclododecane-N,N`,N`~`,N`~``-tetraacetic acid (DOTA) as the metal-chelating ligand coupled to tetramethylrhodamine. The second class of MRI-enhancing agents are composed of high-molecular weight polymers that are membrane impermeable and once injected into a cell or cells are trapped inside. These complexes possess multiple copies of both the metal-chelator-diethylenetriaminepentaacetic acid (DTPA) and the tetramethylrhodamine attached to a macromolecular framework of either poly(d-lysine) (pdl) or dextran. Images acquired of single cells after injection with these bifunctional agents enabled us to follow the relative motions and reorganizations of different cell layers during amphibian gastrulation and neurulation in Xenopus laevis embryos.},
  comment   = {Suggested filename = {Huber1998mar Fluorescently Detectable Magnetic Resonance Imaging Agents.pdf}

Cited 115 times as of 2013/04/30.},
  file      = {Huber1998mar Fluorescently Detectable Magnetic Resonance Imaging Agents.pdf.pdf:UNSORTED/Huber1998mar Fluorescently Detectable Magnetic Resonance Imaging Agents.pdf.pdf:PDF},
  owner     = {jam99},
  timestamp = {2013.04.30},
}

@Article{Ha2014aug,
  author    = {Ha, D. and Paulsen, J. and Sun, N. and Song, Y.-Q. and Ham, D.},
  title     = {Scalable {NMR} Spectroscopy With Semiconductor Chips},
  journal   = {Proc. Natl. Acad. Sci.},
  year      = {2014},
  volume    = {111},
  number    = {33},
  month     = {aug},
  pages     = {11955 -- 11960},
  doi       = {10.1073/pnas.1402015111},
  url       = {http://dx.doi.org/10.1073/pnas.1402015111},
  abstract  = {State-of-the-art NMR spectrometers using superconducting magnets have enabled, with their ultrafine spectral resolution, the determination of the structure of large molecules such as proteins, which is one of the most profound applications of modern NMR spectroscopy. Many chemical and biotechnological applications, however, involve only small-to-medium size molecules, for which the ultrafine resolution of the bulky, expensive, and high-maintenance NMR spectrometers is not required. For these applications, there is a critical need for portable, affordable, and low-maintenance NMR spectrometers to enable in-field, on-demand, or online applications (e.g., quality control, chemical reaction monitoring) and co-use of NMR with other analytical methods (e.g., chromatography, electrophoresis). As a critical step toward NMR spectrometer miniaturization, small permanent magnets with high field homogeneity have been developed. In contrast, NMR spectrometer electronics capable of modern multidimensional spectroscopy have thus far remained bulky. Complementing the magnet miniaturization, here we integrate the NMR spectrometer electronics into 4-mm2silicon chips. Furthermore, we perform various multidimensional NMR spectroscopies by operating these spectrometer electronics chips together with a compact permanent magnet. This combination of the spectrometer-electronics-on-a-chip with a permanent magnet represents a useful step toward miniaturization of the overall NMR spectrometer into a portable platform.},
  comment   = {Suggested filename = {Ha2014aug Scalable NMR Spectroscopy With Semiconductor Chips.pdf}, Source = {wxdoi2bib}},
  file      = {Ha2014aug Scalable NMR Spectroscopy With Semiconductor Chips.pdf:UNSORTED/Ha2014aug Scalable NMR Spectroscopy With Semiconductor Chips.pdf:PDF},
  keywords  = {project > MRFM, collaboration > Afshari},
  owner     = {jam99},
  timestamp = {2014.09.24},
}

@Article{Ha2014jan,
  author    = {Ha, Ji Won and Ruberu, T. Purnima A. and Han, Rui and Dong, Bin and Vela, Javier and Fang, Ning},
  title     = {Super-Resolution Mapping of Photogenerated Electron and Hole Separation in Single Metal--Semiconductor Nanocatalysts},
  journal   = {J. Am. Chem. Soc.},
  year      = {2014},
  volume    = {136},
  number    = {4},
  month     = {jan},
  pages     = {1398 -- 1408},
  doi       = {10.1021/ja409011y},
  url       = {http://dx.doi.org/10.1021/ja409011y},
  abstract  = {Metal–semiconductor heterostructures are promising visible light photocatalysts for many chemical reactions. Here, we use high-resolution superlocalization imaging to reveal the nature and photocatalytic properties of the surface reactive sites on single Au–CdS hybrid nanocatalysts. We experimentally reveal two distinct, incident energy-dependent charge separation mechanisms that result in completely opposite photogenerated reactive sites (e– and h+) and divergent energy flows on the hybrid nanocatalysts. We find that plasmon-induced hot electrons in Au are injected into the conduction band of the CdS semiconductor nanorod. The specifically designed Au-tipped CdS heterostructures with a unique geometry (two Au nanoparticles at both ends of each CdS nanorod) provide more convincing high-resolution single-turnover mapping results and clearly prove the two charge separation mechanisms. Engineering the direction of energy flow at the nanoscale can provide an efficient way to overcome important challenges in photocatalysis, such as controlling catalytic activity and selectivity. These results bear enormous potential impact on the development of better visible light photocatalysts for solar-to-chemical energy conversion.},
  comment   = {Suggested filename = {Ha2014jan Super-Resolution Mapping of Photogenerated Electron and Hole Separation in Single Metal--Semiconductor Nanocatalysts.pdf}, Source = {wxdoi2bib}},
  file      = {Ha2014jan Super-Resolution Mapping of Photogenerated Electron and Hole Separation in Single Metal--Semiconductor Nanocatalysts.pdf:Ha2014jan Super-Resolution Mapping of Photogenerated Electron and Hole Separation in Single Metal--Semiconductor Nanocatalysts.pdf:PDF},
  keywords  = {project > EFM, project > EMC2, microscopy > optical > super-resolution},
  owner     = {jam99},
  timestamp = {2014.04.02},
}

