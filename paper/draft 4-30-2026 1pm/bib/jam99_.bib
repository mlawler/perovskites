@Article{Yang2015aug,
  author    = {Yang, Ye and Yan, Yong and Yang, Mengjin and Choi, Sukgeun and Zhu, Kai and Luther, Joseph M. and Beard, Matthew C.},
  title     = {Low Surface Recombination Velocity in Solution-grown CH$_3$NH$_3$PbBr$_3$ Perovskite Single Crystal},
  volume    = {6},
  pages     = {7961},
  doi       = {10.1038/ncomms8961},
  url       = {http://dx.doi.org/10.1038/ncomms8961},
  abstract  = {Organic-inorganic hybrid perovskites are attracting intense research effort due to their impressive performance in solar cells. While the carrier transport parameters such as mobility and bulk carrier lifetime shows sufficient characteristics, the surface recombination, which can have major impact on the solar cell performance, has not been studied. Here we measure surface recombination dynamics in CH3NH3PbBr3 perovskite single crystals using broadband transient reflectance spectroscopy. The surface recombination velocity is found to be 3.4 /pm 0.1E3 cm/s, approximately 2 to 3 orders of magnitude lower than that in many important unpassivated semiconductors employed in solar cells. Our result suggests that the planar grain size for the perovskite thin films should be larger than approximately 30 micrometer to avoid the influence of surface recombination on the effective carrier lifetime.},
  comment   = {Suggested filename = {Yang2015aug Low Surface Recombination Velocity in Solution-grown CH3NH3PbBr3 Perovskite Single Crystal.pdf},
Source = {wxdoi2bib}},
  file      = {Yang2015aug Low Surface Recombination Velocity in Solution-grown CH3NH3PbBr3 Perovskite Single Crystal.pdf:UNSORTED/Yang2015aug Low Surface Recombination Velocity in Solution-grown CH3NH3PbBr3 Perovskite Single Crystal.pdf:PDF},
  journal   = {Nat Comms},
  keywords  = {materials > semiconductor > perovskite},
  month     = {aug},
  owner     = {jam99},
  timestamp = {2019.03.03},
  year      = {2015},
}

@Article{Yang2011apr,
  author    = {Yang, Y. T. and Callegari, C. and Feng, X. L. and Roukes, M. L.},
  title     = {Surface Adsorbate Fluctuations and Noise in Nanoelectromechanical Systems},
  volume    = {11},
  number    = {4},
  pages     = {1753 -- 1759},
  doi       = {10.1021/nl2003158},
  url       = {http://dx.doi.org/10.1021/nl2003158},
  abstract  = {Physisorption on solid surfaces is important in both fundamental studies and technology. Adsorbates can also be critical for the performance of miniature electromechanical resonators and sensors. Advances in resonant nanoelectromechanical systems (NEMS), particularly mass sensitivity attaining the single-molecule level, make it possible to probe surface physics in a new regime, where a small number of adatoms cause a detectable frequency shift in a high quality factor (Q) NEMS resonator, and adsorbate fluctuations result in resonance frequency noise. Here we report measurements and analysis of the kinetics and fluctuations of physisorbed xenon (Xe) atoms on a high-Q NEMS resonator vibrating at 190.5 MHz. The measured adsorption spectrum and frequency noise, combined with analytic modeling of surface diffusion and adsorption−desorption processes, suggest that diffusion dominates the observed excess noise. This study also reveals new power laws of frequency noise induced by diffusion, which could be important in other low-dimensional nanoscale systems.},
  comment   = {Suggested filename = Yang2011apr Surface Adsorbate Fluctuations and Noise in Nanoelectromechanical Systems 10.1021/nl2003158 *.pdf},
  file      = {Yang2011apr Surface Adsorbate Fluctuations and Noise in Nanoelectromechanical Systems 10.1021\:nl2003158 *.pdf:UNSORTED/Yang2011apr Surface Adsorbate Fluctuations and Noise in Nanoelectromechanical Systems 10.1021\:nl2003158 *.pdf:PDF},
  journal   = {Nano Lett.},
  month     = {apr},
  owner     = {jam99},
  timestamp = {2019.03.03},
  year      = {2011},
}

