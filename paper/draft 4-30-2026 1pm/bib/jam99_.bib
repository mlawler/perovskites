  author    = {Yan, Han and Li, Denghua and Li, Chao and Lu, Kun and Zhang, Yajie and Wei, Zhixiang and Yang, Yanlian and Wang, Chen},
  title     = {Bridging Mesoscopic Blend Structure and Property to Macroscopic Device Performance via in Situ Optoelectronic Characterization},
  volume    = {22},
