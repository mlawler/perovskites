@Article{Dixon1964sepI,
  author    = {Dixon, R. W. and Bloembergen, N.},
  title     = {Electrically Induced Perturbations of Halogen Nuclear Quadrupole Interactions in Polycrystalline Compounds. {I}. {P}henomenological Theory and Experimental Results},
  journal   = {J. Chem. Phys.},
  year      = {1964},
  volume    = {41},
  number    = {6},
  month     = {sep},
  pages     = {1720 -- 1738},
  doi       = {10.1063/1.1726152},
  url       = {http://dx.doi.org/10.1063/1.1726152},
  abstract  = {When a nucleus in a dielectric solid occupies a lattice site which which lacks inversion symmetry, the application of an external electric field causes a change in the electric field gradient at this nucleus. The magnitude of the change is proportional to the applied field. When the nucleus has spin greater than one-half and possesses a nonzero quadrupole moment, the quadrupole interaction energy is, therefore, a linear function of the applied field. This field gradient perturbation is discussed phenomenologically through the use of a third rank tensor R which relates the electric field and the electric field gradient via the equation e&Delta;q = R. E. Changes in the quadrupole interaction energy, observed as broadenings of nuclear quadrupole resonance lines in zero magnetic field, have been obtained for Cl<sup>35</sup>, Br<sup>81</sup>, and I<sup>127</sup> nuclei in halogenated polycrystalline compounds including several halogenated methanes and benzenes, the solid halogens, and iodic acid. Broadened line shapes, local electric field corrections, and restrictions imposed by nuclear site symmetries are discussed. All observations are consistent with the phenomenological theory.},
  comment   = {Suggested filename = Dixon1964sepI Electrically induced perturbations of halogen nuclear quadrupole interactions in polycrystalline compounds. I. Phenomenological theory and experimental results 10.1063/1.1726152 *.pdf},
  copyright = {Copyright 2004, IEE},
  file      = {Dixon1964sepI Electrically induced perturbations of halogen nuclear quadrupole interactions in polycrystalline compounds. I. Phenomenological theory and experimental results 10.1063\:1.1726152 *.pdf:UNSORTED/Dixon1964sepI Electrically induced perturbations of halogen nuclear quadrupole interactions in polycrystalline compounds. I. Phenomenological theory and experimental results 10.1063\:1.1726152 *.pdf:PDF},
  keywords  = {magnetic resonance > Stark shifts},
  owner     = {jam99},
  timestamp = {2010.10.02},
}

