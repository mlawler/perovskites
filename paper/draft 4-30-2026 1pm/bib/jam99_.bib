@Article{Garcia-Belmonte2016oct,
  author    = {Garcia-Belmonte, Germ\`a and Bisquert, Juan},
  title     = {Distinction Between Capacitive and Noncapacitive Hysteretic Currents in Operation and Degradation of Perovskite Solar Cells},
  journal   = {ACS Energy Lett.},
  year      = {2016},
  volume    = {1},
  number    = {4},
  month     = {oct},
  pages     = {683 -- 688},
  doi       = {10.1021/acsenergylett.6b00293},
  url       = {http://dx.doi.org/10.1021/acsenergylett.6b00293},
  abstract  = {Perovskite solar cells suffer from significant performance distortions under working conditions, usually known by the generic label of hysteretic effects. A classification of the fluctuations associated with current-voltage curves, centered on capacitance analysis, including measurements in voltage sweep, is provided here. Scan rate constitutes an easy-to-implement probing technique able to differentiate between capacitive and noncapacitive contributions to the overall hysteretic response. Capacitive hysteresis shows a distinctive response with scan rate and mainly originates at TiO2 interfaces contacting perovskite materials. It relies on the interfacial ability to accommodate both ionic and electronic charges in a highly reversible way. Noncapacitive hysteresis points to the occurrence of interfacial energetics modification or contact reactivity caused by perovskite ionic motion. It exhibits positive values for reverse scans, in opposition to what is observed for capacitive currents. Connections between irreversible noncapacitve currents and device degradation are highlighted. The interfaces between the perovskite absorber and extracting layers play a determining role in the overall mechanisms of operation of this type of solar cell.},
  comment   = {Suggested filename = {Garcia-Belmonte2016oct Distinction Between Capacitive and Noncapacitive Hysteretic Currents in Operation and Degradation of Perovskite Solar Cells.pdf},
Source = {wxdoi2bib}},
  file      = {Garcia-Belmonte2016oct Distinction Between Capacitive and Noncapacitive Hysteretic Currents in Operation and Degradation of Perovskite Solar Cells.pdf:UNSORTED/Garcia-Belmonte2016oct Distinction Between Capacitive and Noncapacitive Hysteretic Currents in Operation and Degradation of Perovskite Solar Cells.pdf:PDF},
  keywords  = {project > EFM, personnel > Tirmzi, collaborator > Hanrath, materials > semiconductor > perovskite, materials > semiconductor > perovskite > ion motion, devices > solar cell > degradation, devices > solar cell > hysteresis},
  owner     = {jam99},
  timestamp = {2016.12.11},
}

