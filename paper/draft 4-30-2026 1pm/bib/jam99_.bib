  file      = {Xu2011mar Formation of ultra-smooth 45 degree micromirror on (100) silicon with low concentration TMAH and surfactant 10.1016\:j.sna.2010.12.018 *.pdf:UNSORTED/Xu2011mar Formation of ultra-smooth 45 degree micromirror on (100) silicon with low concentration TMAH and surfactant 10.1016\:j.sna.2010.12.018 *.pdf:PDF},
