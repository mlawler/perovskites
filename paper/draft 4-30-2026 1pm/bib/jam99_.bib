  ISSN                     = {1090-7807},
  Journal-iso              = {J. Magn. Reson.},
  Keywords                 = {magnetic resonance, magnetic resonance > double res, magnetic resonance > dipolar recoupling, magnetic resonance > double res > REDOR, pulsed spin locking, sensitivity enhancement},
  Keywords-plus            = {DYNAMIC NUCLEAR-POLARIZATION; OPTICALLY PUMPED NMR; TORSION ANGLE-PHI; MAGNETIC-RESONANCE; ROTATING SOLIDS; CHEMICAL-SHIFT; C-13 NMR; CORRELATION SPECTROSCOPY; MOLECULAR-STRUCTURE; INDIUM-PHOSPHIDE},
  Language                 = {English},
  Number-of-cited-references = {62},
