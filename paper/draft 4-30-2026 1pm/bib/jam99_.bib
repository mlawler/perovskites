@Article{Pignard2000jan,
  author      = {Pignard, S and Goglio, G and Radulescu, A and Piraux, L and Dubois, S and Declemy, A and Duvail, JL},
  title       = {Study of the magnetization reversal in individual nickel nanowires},
  journal     = {J. Appl. Phys.},
  year        = {2000},
  volume      = {87},
  number      = {2},
  month       = {jan},
  pages       = {824 -- 829},
  issn        = {0021-8979},
  doi         = {10.1063/1.371947},
  url         = {http://dx.doi.org/10.1063/1.371947},
  abstract    = {The magnetization reversal of Ni nanowires was studied by anisotropic magnetoresistance measurements at temperatures between 15 and 300 K. The wires, synthesized by electrodeposition in a nanoporous polycarbonate membrane, are regular cylinders 22 mu m long with a diameter of 75 or 35 nm. The nucleation field was measured on individual nanowires as a function of the angle between the applied field and the wire axis. The results are quantitatively analyzed using classical magnetization reversal theories. Measurements of the nucleation field first obtained as a function of temperature evidence an extra uniaxial anisotropy induced by the contraction of the membrane at low temperature. Combining SQUID measurements and x-ray diffractometry at different temperatures, a clear picture of the large magnetoelastic effect was obtained. (C) 2000 American Institute of Physics. {[}S0021-8979(00)03902-5].},
  affiliation = {Pignard, S (Reprint Author), Unite Physicochim \& Phys Mat, Pl Croix Sud 1, B-1348 Louvain, Belgium. Unite Physicochim \& Phys Mat, B-1348 Louvain, Belgium. Met Phys Lab, UMR 6630, F-86960 Futuroscope, France. Inst Mat Nantes, Lab Phys Cristalline, F-44322 Nantes, France.},
  comment     = {Transport measurements were performed on Ni wires fabricated from two different nanoporous membranes samples, with pore diameters of d = 75 \pm 5 nm and d = 35 \pm 5 nm. The total length of the wires is 22 microns. "... for angles larger than 40°, the reasonably good agreement between experiment and calculation ... tends to indicate that the magnetization reversal is a coherent one." 

