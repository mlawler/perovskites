@article{Kirmani2024jan,
  title = {Unraveling Radiation Damage and Healing Mechanisms in Halide Perovskites Using Energy-Tuned Dual Irradiation Dosing},
  author = {Kirmani, Ahmad R. and Byers, Todd A. and Ni, Zhenyi and VanSant, Kaitlyn and Saini, Darshpreet K. and Scheidt, Rebecca and Zheng, Xiaopeng and Kum, Tatchen Buh and Sellers, Ian R. and {McMillon-Brown}, Lyndsey and Huang, Jinsong and Rout, Bibhudutta and Luther, Joseph M.},
