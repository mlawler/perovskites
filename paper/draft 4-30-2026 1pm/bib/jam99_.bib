@Article{Deibel2009aug,
  author    = {Deibel, C. and Wagenpfahl, A. and Dyakonov, V.},
  title     = {Origin of Reduced Polaron Recombination in Organic Semiconductor Devices},
  journal   = {Phys. Rev. B},
