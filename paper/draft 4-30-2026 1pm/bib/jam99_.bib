  journal   = {Phys. Rev. Applied},
  keywords  = {materials > semiconductor > perovskite, materials > semiconductor > perovskite > MAPbI3, materials > semiconductor semiconductor > perovskite > MAPbCl3, materials > semiconductor > perovskite > mixed, measurements > photoluminescence, measurements > transient Voc, project > EFM, personnel > Tirmzi, collaborator > Hanrath},
