  journal   = {Nat Phys},
  keywords  = {MRFM > magnetometry > diamond defect},
  month     = sep,
  owner     = {jam99},
  publisher = {Nature Publishing Group},
  timestamp = {2019.03.03},
  year      = {2011},
}

@Article{Arias2002mar,
  author    = {Arias, A. C. and Corcoran, N. and Banach, M. and Friend, R. H. and MacKenzie, J. D. and Huck, W. T. S.},
