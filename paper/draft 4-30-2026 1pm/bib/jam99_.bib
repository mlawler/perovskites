@Unpublished{Marohn2006jun,
  author    = {Marohn, J. A. and Jenkins, N. E. and Kuehn, S. and Hickman, S. A.},
  title     = {1. {F}ourier Encoding of Spin Locations via Nanomagnet Shuttling and then 2. {D}etecting Magnetization Using Force Gradients},
  note      = {Kavli Institute at Cornell Summer School -- ``Magnetic Resonance Force Microscopy: {R}outes to Three-Dimensional Imaging of Single Molecules''; Ithaca, New York, USA; June 21 -- 24},
  url       = {http://www.research.cornell.edu/KIC/events/MRFM2006/},
  abstract  = {Assuming only one second per data point of signal averaging, producing a three dimensional nuclear spin density image having even just 64 × 64 × 64 pixels using the demonstrated MRFM image deconvolution schemes could take longer than three days. In this talk we will detail an alternative, linear, Fourier-based approach to image reconstruction in MRFM. In this new approach, magnet shuttling generates local time- dependent magnetic field gradients that, acting in concert with rf pulses, lead to spin evolution frequencies linearly proportional to the x or y coordinate of the spin in a sensitive slice.

In the first talk we will explain how our FT-MRFM approach enables rapid acquisition of both one dimensional spin density projections (in one minute) or two-dimensional projections (in one hour). Our previously published FT-MRFM pulse sequence demanded application of a complicated, high duty cycle, pulse train (Kempf and Marohn, Phys. Rev. Lett., 2003) and the signal analysis was limited to thermally polarized spins. In this talk we present a far simpler, low rf power, version of the FT-MRFM experiment. We describe design rules for predicting the expected resolution, and present analytical theory and numerical simulations showing how the FT-MRFM image-encoding concept can be extended to a stochastically polarized sample of spins.

In the second half of the talk we will address spin readout. The IBM group’s i-OSCAR approach to spin readout requires continuous application of rf and, moreover, is limited to samples in which spins can be coherently modulated for nearly a second. In order to remove both of these restrictions, we recently introduced a force-gradient approach to detecting spin magnetization that allows Cantilever Enabled Readout of Magnetization Inversion Transients (Garner et al., Appl. Phys. Lett., 2005). In this talk we contrast the i- OSCAR and CERMIT approaches to nuclear spin readout, and show how to optimize CERMIT readout for single proton detection.

Finally, we will demonstrate force-gradient detection of electron-spin resonance in a micron-scale sample of DPPH at 4.2K. In a comparatively small applied magnetic field gradient, the observed cantilever frequency shift agrees well with simulations. At high gradient, however, the signal is surprising – far larger than predicted and having an unexpected lineshape. We believe this surprising signal is a consequence of rapid electron spin diffusion.},
  comment   = {Talk available at http://www.research.cornell.edu/KIC/events/MRFM2006/
Review:
FT-MRFM discussed in detail publicly},
  month     = {jun},
  owner     = {jam99},
  timestamp = {2019.03.03},
  year      = {2006},
}

@Unpublished{Marohn2011mara,
  Title                    = {Rapid Serial Prototyping and Analysis of Nanomagnet-Tipped Attonewton-Sensitivity Cantilevers for Magnetic Resonance Force Microscopy},
  Author                   = {John A. Marohn and Eric Moore and Jonilyn Longenecker},
  Note                     = {American Physical Society March Meeting; Dallas, Texas; March 21 -- 25},

  Month                    = {mar},
  Year                     = {2011},

  Abstract                 = {Magnetic resonance force microscopy offers exciting possibilities for imaging protons and electrons in native and spin-labeled biomolecules. The central component of a magnetic resonance force microscope experiment is a custom-fabricated attonewton-sensitivity cantilever with an overhanging magnetic-nanorod tip. We have recently developed a method for making precision tips which involves 1) fabricating overhanging magnetic tips on shortened mock cantilevers, 2) using focused ion beam milling and deposition (FIB/FID) to cut the mock cantilever (and attached tip) free from the substrate, and then 3) attaching the released structure to a full-length high-sensitivity cantilever. The resulting magnets have been characterized by cantilever magnetometry, high-resolution transmission electron microscopy (HR-TEM), and nanometer-resolution electron energy loss spectroscopy (EELS). This approach to fabrication and analysis is allowing us to optimize tips for proposed single-electron-spin imaging experiments in a very short time. Rapid access to such high-quality tips will significantly advance our ability to image individual biomolecules and macromolecular complexes.},
  Keywords                 = {marohn-talk-contributed, grant-Sidles-ARO-W911NF-05-1-0403, grant-Marohn-NIH-5R01GM-070012, grant-CNS-NSF-EEC-0646547, grant-CNS-NSF-EEC-0117770, grant-CNF-NSF-ECS-0335765},
  Owner                    = {jam99},
