@Article{Siminovitch2004jan,
  author    = {Siminovitch, David and Untidt, Thomas and Nielsen, Niels Chr.},
  title     = {Exact Effective Hamiltonian Theory. II. Polynomial Expansion of Matrix Functions and Entangled Unitary Exponential Operators},
  volume    = {120},
  number    = {1},
