@Article{Lansdorp2012feb,
  author    = {Lansdorp, Bob M. and Saleh, Omar A.},
  title     = {Power Spectrum and Allan Variance Methods for Calibrating Single-molecule Video-tracking Instruments},
  volume    = {83},
