@Article{Butler2010oct,
  author    = {Butler, Mark and Norton, Valerie and Weitekamp, Daniel},
  title     = {Nanoscale Torsional Resonator for Polarization and Spectroscopy of Nuclear Spins},
  journal   = {Phys. Rev. Lett.},
  year      = {2010},
  volume    = {105},
  number    = {17},
  month     = {oct},
  pages     = {177601},
  doi       = {10.1103/PhysRevLett.105.177601},
  url       = {http://dx.doi.org/10.1103/PhysRevLett.105.177601},
  abstract  = {We propose a torsional resonator that couples to the transverse spin dipole of an attached sample. The absence of relative motion eliminates a source of friction that would otherwise hinder nanoscale implementation. Enhanced spontaneous emission induced by the resonator relaxes the longitudinal spin dipole at a rate of similar to 1 s(-1) in the low-temperature limit. With signal averaging, single-proton magnetic resonance spectroscopy appears feasible at similar to 10 mK and a high magnetic field, while single-shot sensitivity is practical for samples with at least tens of protons in a volume of similar to 5 nm(3).},
  comment   = {Suggested filename = Butler2010oct Nanoscale Torsional Resonator for Polarization and Spectroscopy of Nuclear Spins 10.1103/PhysRevLett.105.177601 *.pdf},
  file      = {Butler2010oct Nanoscale Torsional Resonator for Polarization and Spectroscopy of Nuclear Spins 10.1103\:PhysRevLett.105.177601 *.pdf:UNSORTED/Butler2010oct Nanoscale Torsional Resonator for Polarization and Spectroscopy of Nuclear Spins 10.1103\:PhysRevLett.105.177601 *.pdf:PDF},
  keywords  = {MRFM > cantilevers > high-frequency, MRFM > DNP},
  owner     = {jam99},
  timestamp = {2012.03.20},
}

