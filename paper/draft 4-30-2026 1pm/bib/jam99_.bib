}

@Article{Qian2014dec,
  author    = {Qian, X. and Liu, J. and Fu, L. and Li, J.},
  title     = {Quantum Spin Hall Effect in Two-dimensional Transition Metal Dichalcogenides},
  journal   = {Science},
  year      = {2014},
  volume    = {346},
  number    = {6215},
  month     = {dec},
  pages     = {1344 -- 1347},
  doi       = {10.1126/science.1256815},
  url       = {http://dx.doi.org/10.1126/science.1256815},
  abstract  = {Quantum spin Hall (QSH) effect materials feature edge states that are topologically protected from backscattering. However, the small band gap in materials that have been identified as QSH insulators limits applications. We use first-principles calculations to predict a class of large-gap QSH insulators in two-dimensional transition metal dichalcogenides with 1T[prime] structure, namely, 1T[prime]-MX2 with M = (tungsten or molybdenum) and X = (tellurium, selenium, or sulfur). A structural distortion causes an intrinsic band inversion between chalcogenide-p and metal-d bands. Additionally, spin-orbit coupling opens a gap that is tunable by vertical electric field and strain. We propose a topological field effect transistor made of van der Waals heterostructures of 1T[prime]-MX2 and two-dimensional dielectric layers that can be rapidly switched off by electric field through a topological phase transition instead of carrier depletion.},
  comment   = {Suggested filename = {Qian2014dec Quantum Spin Hall Effect in Two-dimensional Transition Metal Dichalcogenides.pdf},
Source = {wxdoi2bib},
Comment = {A Topological transistor}},
  file      = {Qian2014dec Quantum Spin Hall Effect in Two-dimensional Transition Metal Dichalcogenides.pdf:UNSORTED/Qian2014dec Quantum Spin Hall Effect in Two-dimensional Transition Metal Dichalcogenides.pdf:PDF},
  keywords  = {project > MRFM, electronic structure > topoplogical insulator, device > transistor},
  owner     = {jam99},
  timestamp = {2016.08.16},
}

