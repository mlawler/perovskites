  title          = {Electron-electron interaction in carbon-coated ferromagnetic nanowires},
  journal        = {Phys. Rev. B},
  year           = {2005},
  volume         = {72},
  number         = {8},
  month          = {aug},
  pages          = {085457},
  issn           = {1098-0121},
  doi            = {10.1103/PhysRevB.72.085457},
  url            = {http://dx.doi.org/10.1103/PhysRevB.72.085457},
  abstract       = {We have investigated the low temperature resistance behavior and the magnetoresistance of single-domain cobalt nanowires of various thicknesses ranging between 5 nm and 32 nm and wire widths ranging down to 32 nm. The nanowires are coated with insulating carbon on three sides to prevent oxidation. Magnetic force microscopy investigations show that nanowires with widths below 800 nm are in a single-domain-like remanence state. The magnetoresistance is negative and is well explained by the anisotropic magnetoresistance (AMR). At low temperatures T > 30 K a logarithmic resistance increase is observed with decreasing temperature, which is consistently explained as originating from enhanced electron-electron interactions in two dimensions. Quantum corrections due to weak electron localization are not observed which is in contrast to recent theoretical predictions for two-dimensional ferromagnetic systems. However, the results are consistent with our earlier results obtained for platinum-capped and unprotected cobalt nanowires. A reduction of the wire width below about 400 nm yields a crossover behavior from two-dimensional to one-dimensional behavior with respect to the quantum corrections of the resistance.},
  affiliation    = {Brands, M (Reprint Author), Univ Duisburg Essen, Fachbereich Phys, D-47048 Duisburg, Germany. Univ Duisburg Essen, Fachbereich Phys, D-47048 Duisburg, Germany.},
  article-number = {085457},
  comment        = {FIG 1 is a nice MFM picture showing that a narrow rod acts as a single domain at remnance, while a wide rod has multiple domains! Suggested filename = Brands2005aug Electron-electron interaction in carbon-coated ferromagnetic nanowires 10.1103/PhysRevB.72.085457 *.pdf},
  file           = {Brands2005aug Electron-electron interaction in carbon-coated ferromagnetic nanowires 10.1103\:PhysRevB.72.085457 *.pdf:UNSORTED/Brands2005aug Electron-electron interaction in carbon-coated ferromagnetic nanowires 10.1103\:PhysRevB.72.085457 *.pdf:PDF},
  journal-iso    = {Phys. Rev. B},
  keywords       = {nanomagnetics, MRFM > magnetometry > magnetoresistance, materials > magnetic > cobalt, MRFM > magnetometry > MFM, SPM > MFM},
  owner          = {jam99},
