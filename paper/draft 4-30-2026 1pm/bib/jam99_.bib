@Article{Anders2016may,
  author    = {Anders, Jens and Handwerker, Jonas and Ortmanns, Maurits and Boero, Giovanni},
  title     = {A Low-power High-sensitivity Single-chip Receiver for {NMR} Microscopy},
  journal   = {J. Magn. Reson.},
  year      = {2016},
  volume    = {266},
  month     = {may},
  pages     = {41 -- 50},
  doi       = {10.1016/j.jmr.2016.03.004},
  url       = {http://dx.doi.org/10.1016/j.jmr.2016.03.004},
  abstract  = {Highlights: Fully-integrated CMOS NMR receiver with co-integrated planar detection coil; Spin sensitivity of 3E13 proton spin per root hertz 7 T and 340 picovolt per root hertz input-referred noise; High-resolution sensitivity corrected MR microscopy images down to 5 micrometer resolution; Sensitivity correction algorithm for planar receive coils in constant time imaging; Derivation and validation of the relation between spin sensitivity and image SNR.

Abstract: In this paper, we present a fully-integrated receiver for NMR microscopy applications manufactured in a 0.13 micrometer CMOS technology. The design co-integrates a 10-turn planar detection coil together with a complete quadrature, low-IF downconversion receiver on a single chip, which operates from a single 1.5 V supply with a total power dissipation of 18 mW. The detector's measured time-domain spin sensitivity is 3E13 proton spin per root hertz 7 T. Additionally, the paper discusses two important aspects of NMR microscopy using planar detection coils: the link between the detection coil's spin sensitivity and the achievable image SNR and the correction of image artifacts induced by the inhomogeneous sensitivity profile of planar detection coils. More specifically, we derive analytical expressions for both the theoretical image SNR as a function of the coil's spin sensitivity and the sensitivity correction for a known coil sensitivity profile in CTI MR imaging experiments. Both expressions are validated using measured data in the imaging section of the paper. Thanks to the improved spin sensitivity of the utilized integrated receiver chip compared to a previously presented design, we were able to obtain sensitivity corrected images in a 7 T spectroscopy magnet with isotropic resolutions of 9.6 micrometer and 5 micromter with single-shot SNRs of 37 and 15 in relatively short imaging times of 4.4 h and 24 h, respectively.},
  comment   = {Suggested filename = {Anders2016may A Low-power High-sensitivity Single-chip Receiver for NMR Microscopy.pdf},
Source = {wxdoi2bib}},
  file      = {Anders2016may A Low-power High-sensitivity Single-chip Receiver for NMR Microscopy.pdf:UNSORTED/Anders2016may A Low-power High-sensitivity Single-chip Receiver for NMR Microscopy.pdf:PDF},
  keywords  = {project > MRFM, collaborator > Afshari, microwaves > source > chip-scale, microwaves > source > CMOS},
  owner     = {jam99},
  timestamp = {2016.07.28},
}

