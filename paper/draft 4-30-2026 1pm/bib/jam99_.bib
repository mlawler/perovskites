@Article{Dykman2003apr,
  author         = {Dykman, MI and Platzman, PM and Seddighrad, P},
  title          = {Qubits with electrons on liquid helium},
  journal        = {Phys. Rev. B},
  year           = {2003},
  volume         = {67},
  number         = {15},
  month          = {apr},
  pages          = {155402},
  issn           = {1098-0121},
  doi            = {10.1103/PhysRevB.67.155402},
  url            = {http://dx.doi.org/10.1103/PhysRevB.67.155402},
  abstract       = {We study dissipation effects for electrons on the surface of liquid helium, which may serve as the qubits of a quantum computer. Each electron is localized in a 3D potential well formed by the image potential in helium and the potential from a submicron electrode submerged into helium. We estimate parameters of the confining potential and characterize the electron energy spectrum. Decay of the excited electron state is due to two-ripplon scattering and to scattering by phonons in helium. We identify mechanisms of coupling to phonons. An estimate of contributions from different scattering mechanisms shows that the decay rate should be less than or similar to10(4) s(-1). We analyze dephasing of the electron states due to quasielastic ripplon scattering off an electron. The dephasing rate is less than or similar to10(2) s(-1) for T = 10 mK and depends on temperature as T-3. Decay and decoherence of the electron states result also from classical and quantum electrode noise. We relate the corresponding relaxation rates to the power spectrum of the fluctuating electric field on the electron. The dependence of the rates on the electrode parameters is obtained.},
  article-number = {155402},
  comment        = {Suggested filename = Dykman2003apr Qubits with electrons on liquid helium 10.1103/PhysRevB.67.155402 *.pdf. JM met Mark Dykman during a visit to the Physics Dept of Michigan State University on 2010/04/26. He was unaware of our work and I was unaware of his.},
  file           = {Dykman2003apr Qubits with electrons on liquid helium 10.1103\:PhysRevB.67.155402 *.pdf:UNSORTED/Dykman2003apr Qubits with electrons on liquid helium 10.1103\:PhysRevB.67.155402 *.pdf:PDF},
  keywords       = {MRFM > surface dissipation},
  owner          = {jam99},
  timestamp      = {2010.05.04},
  unique-id      = {ISI:000182741400080},
}

