@Article{Stuwe2015mar,
  author    = {Stuwe, T. and Correia, A. R. and Lin, D. H. and Paduch, M. and Lu, V. T. and Kossiakoff, A. A. and Hoelz, A.},
  title     = {Architecture of the Nuclear Pore Complex Coat},
  volume    = {347},
