  Author                   = {M. Poggio and H. J. Mamin and C. L. Degen and M. H. Sherwood and D. Rugar},
  Journal                  = {Phys. Rev. Lett.},
  Year                     = {2009},

  Month                    = {feb},
  Number                   = {8},
  Pages                    = {087604},
  Volume                   = {102},

  Abstract                 = {We demonstrate nuclear double resonance for nanometer-scale volumes of spins where random fluctuations rather than Boltzmann polarization dominate. When the {Hartmann-Hahn} condition is met in a cross-polarization experiment, flip-flops occur between two species of spins and their fluctuations become coupled. We use magnetic resonance force microscopy to measure this effect between {1H} and {13C} spins in {13C-enriched} stearic acid. The development of a cross-polarization technique for statistical ensembles adds an important tool for generating chemical contrast in nanometer-scale magnetic resonance.},
  Doi                      = {10.1103/PhysRevLett.102.087604},
  File                     = {Poggio2009feb.pdf:Poggio2009feb.pdf:PDF},
  Keywords                 = {magnetic resonance > double res, magnetic resonance > double res > cross polarization, MRFM > NMR, MRFM > sample-on-tip, MRFM > samples > potassium hexafluoride, MRFM > cyclic adiabatic inversion, MRFM > rf source > microwire, MRFM > magnetization > statistical, MRFM > samples > stearic acids},
  Owner                    = {jam99},
  Timestamp                = {2011.03.01},
  Url                      = {http://link.aps.org/doi/10.1103/PhysRevLett.102.087604}
}

