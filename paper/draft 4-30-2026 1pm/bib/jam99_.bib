@Article{Hickman2010nov,
  author    = {Steven A. Hickman and Eric W. Moore and Sang-Gap Lee and Jonilyn G. Longenecker and Sarah J. Wright and Lee E. Harrell and John A. Marohn},
  title     = {Batch-fabrication of cantilevered magnets on attonewton-sensitivity mechanical oscillators for scanned-probe nanoscale magnetic resonance imaging},
