@Article{Limozin2009nov,
  author    = {Limozin, Laurent and Sengupta, Kheya},
  title     = {Quantitative Reflection Interference Contrast Microscopy ({RICM}) in Soft Matter and Cell Adhesion},
  journal   = {Chem. Eur. J. of Chem. Phys.},
