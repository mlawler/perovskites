{Spadafora2011dec,
  Title                    = {Local Contact Potential Difference of Molecular Self-assemblies Investigated by {K}elvin Probe Force Microscopy},
  Author                   = {Spadafora, Evan J. and Linares, Mathieu and Yahya, Wan~Zaireen~Nisa and Lincker, Fr'\{e}d\'{e}ric and Demadrille, Renaud and Grevin, Benjamin},
  Journal                  = {Appl. Phys. Lett.},
