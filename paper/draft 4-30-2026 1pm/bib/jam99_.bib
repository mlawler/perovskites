@Article{Nakajima2010feb,
  author    = {Nakajima, T. and Kobayashi, Y. and Komiyama, S. and Tsuboi, M. and Machida, T.},
  title     = {Scanning microscopy of nuclear spin polarization via quantum {H}all edge channels},
