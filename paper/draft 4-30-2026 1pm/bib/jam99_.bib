  J9                       = {BBA-MOL CELL RES},
  Ji                       = {Biochim. Biophys. Acta-Mol. Cell Res.},
  Owner                    = {jam99},
  Sn                       = {0167-4889},
  Timestamp                = {2012.10.31},
  Url                      = {http://dx.doi.org/10.1016/j.bbamcr.2005.06.007},
  Ut                       = {ISI:000234448700008}
}

