  owner     = {jam99},
  timestamp = {2019.03.03},
  year      = {2014},
}

@Article{Muellegger2014sep,
  author    = {M\"ullegger, Stefan and Tebi, Stefano and Das, Amal K. and Sch\"ofberger, Wolfgang and Faschinger, Felix and Koch, Reinhold},
  title     = {Radio Frequency Scanning Tunneling Spectroscopy for Single-Molecule Spin Resonance},
  volume    = {113},
  number    = {13},
  pages     = {133001},
