@Article{Meng2016feb,
  author    = {Meng, Weiwei and Saparov, Bayrammurad and Hong, Feng and Wang, Jianbo and Mitzi, David B. and Yan, Yanfa},
  title     = {Alloying and Defect Control Within Chalcogenide Perovskites for Optimized Photovoltaic Application},
  journal   = {Chem. Mater.},
  year      = {2016},
  volume    = {28},
