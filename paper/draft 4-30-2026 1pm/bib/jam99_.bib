@Article{Park2012sep,
  author    = {Park, Se Un and Dobigeon, Nicolas and Hero, Alfred O.},
  title     = {Semi-Blind Sparse Image Reconstruction With Application to {MRFM}},
  journal   = {IEEE Trans. on Image Process.},
  year      = {2012},
  volume    = {21},
