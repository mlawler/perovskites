@Article{Childress2006oct,
  author    = {Childress, L. and Dutt, M. V. G. and Taylor, J. M. and Zibrov, A. S. and Jelezko, F. and Wrachtrup, J. and Hemmer, P. R. and Lukin, M. D.},
  title     = {Coherent dynamics of coupled electron and nuclear spin qubits in diamond},
  journal   = {Science},
  year      = {2006},
  volume    = {314},
  number    = {5797},
  month     = {oct},
  pages     = {281--285},
  doi       = {10.1126/science.1131871},
  url       = {http://dx.doi.org/10.1126/science.1131871},
  abstract  = {Understanding and controlling the complex environment of solid-state quantum bits is a central challenge in spintronics and quantum information science. Coherent manipulation of an individual electron spin associated with a nitrogen-vacancy center in diamond was used to gain insight into its local environment. We show that this environment is effectively separated into a set of individual proximal C-13 nuclear spins, which are coupled coherently to the electron spin, and the remainder of the C-13 nuclear spins, which cause the loss of coherence. The proximal nuclear spins can be addressed and coupled individually because of quantum back-action from the electron, which modifies their energy levels and magnetic moments, effectively distinguishing them from the rest of the nuclei. These results open the door to coherent manipulation of individual isolated nuclear spins in a solid-state environment even at room temperature.},
  comment   = {recommended filename = Childress2006oct Coherent dynamics of coupled electron and nuclear spin qubits in diamond 10.1126/science.1131871 *.pdf},
  di        = {10.1126/science.1131871},
