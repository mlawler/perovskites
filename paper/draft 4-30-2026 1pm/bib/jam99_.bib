@Article{Suh2005jul,
  author    = {Suh, Kahp Y. and Jon, Sangyong},
  title     = {Control over Wettability of Polyethylene Glycol Surfaces Using Capillary Lithography},
  volume    = {21},
  number    = {15},
  pages     = {6836 -- 6841},
  doi       = {10.1021/la050878+},
  eprint    = {http://pubs.acs.org/doi/pdf/10.1021/la050878%2B},
  url       = {http://pubs.acs.org/doi/abs/10.1021/la050878%2B},
  abstract  = {We demonstrate that wettability of poly(ethylene glycol) (PEG) surfaces can be controlled using nanostructures with various geometrical features. Capillary lithography was used to fabricate PEG nanostructures using a new ultraviolet (UV) curable mold consisting of functionalized polyurethane with acrylate group (MINS101m, Minuta Tech.). Two distinct wetting states were observed depending of the height of nanostructures. At relatively lower heights (<300 nm for 150 nm pillars with 500 nm spacing), the initial contact angle of water was less than 80° and the water droplet easily invaded into the surface grooves, leading to a reduced contact angle at equilibrium (Wenzel state). At relatively higher heights (>400 nm for 150 nm pillars with 500 nm spacing), on the other hand, the nanostructured PEG surface showed hydrophobic nature and no significant change in contact angle was observed with time (Cassie state). The presence of two wetting states was also confirmed by dynamic wetting properties and contact-angle hysteresis. The wetting transition from hydrophilic (bare PEG surface) to hydrophobic (PEG nanostructures) was described by the Cassie−Baxter equation assuming that enhanced hydrophobicity is due to the heterogeneous wetting mediated by an air pocket on the surface. The measured contact angles in the Cassie state were increased with increasing air fraction, in agreement with the theoretical prediction.},
  comment   = {Suggested filename =Suh2005jul Control over Wettability of Polyethylene Glycol Surfaces Using Capillary Lithography 10.1021/la050878+ *.pdf},
  file      = {Suh2005jul Control over Wettability of Polyethylene Glycol Surfaces Using Capillary Lithography 10.1021\:la050878+ *.pdf:UNSORTED/Suh2005jul Control over Wettability of Polyethylene Glycol Surfaces Using Capillary Lithography 10.1021\:la050878+ *.pdf:PDF},
  journal   = {Langmuir},
  keywords  = {materials > gel > hydrogel, materials > gel > hydrogel > patterned},
  month     = {jul},
  owner     = {jam99},
  timestamp = {2019.03.03},
  year      = {2005},
}

@Article{Suloway2005jul,
  author    = {Suloway, Christian and Pulokas, James and Fellmann, Denis and Cheng, Anchi and Guerra, Francisco and Quispe, Joel and Stagg, Scott and Potter, Clinton S. and Carragher, Bridget},
  title     = {Automated molecular microscopy: {T}he new Leginon system},
  volume    = {151},
