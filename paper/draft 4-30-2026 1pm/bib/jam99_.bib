@Article{Xu2009dec,
  author    = {Xu, Weilin and Shen, Hao and Kim, Yoon Ji and Zhou, Xiaochun and Liu, Guokun and Park, Jiwoong and Chen, Peng},
  title     = {Single-Molecule Electrocatalysis by Single-Walled Carbon Nanotubes},
  volume    = {9},
  number    = {12},
  pages     = {3968 -- 3973},
