@Article{Richardson2016apr,
  author    = {Richardson, Giles and O'Kane, Simon E. J. and Niemann, Ralf G. and Peltola, Timo A. and Foster, Jamie M. and Cameron, Petra J. and Walker, Alison B.},
  title     = {Can Slow-moving Ions Explain Hysteresis in the Current--voltage Curves of Perovskite Solar Cells?},
  volume    = {9},
  number    = {4},
  pages     = {1476 -- 1485},
  doi       = {10.1039/c5ee02740c},
  url       = {http://dx.doi.org/10.1039/c5ee02740c},
  abstract  = {The hypothesis that ion motion is responsible for anomalous hysteresis in the current-voltage curves of perovskite solar cells is investigated through a combination of electrical transport modelling and experimental measurements. In a combined computational and experimental study, good agreement is obtained between experiment and the results of a charge transport model covering mixed ionic-electronic conduction. Our model couples electrons, holes and defect mediated ion motion suggesting that slow moving ions are indeed the origin of the hysteresis. The magnitude of the ion diffusion coefficient required to match experiment and theory, 1E-12 cm^2/Vs, depends on the cell, but is similar to that predicted by microscopic theory of vacancy mediated diffusion. The investigation is extended to preconditioning procedures which are known to substantially influence the hysteresis. The method developed for solving the stiff equations in the drift diffusion model is widely applicable to other double layer problems occurring in electrochemical applications such as the evolution of transmembrane potentials in living cells.},
  comment   = {Suggested filename = {Richardson2016apr Can Slow-moving Ions Explain Hysteresis in the Current-Voltage Curves of Perovskite Solar Cells.pdf},
Source = {wxdoi2bib}},
  file      = {Richardson2016apr Can Slow-moving Ions Explain Hysteresis in the Current-Voltage Curves of Perovskite Solar Cells.pdf:UNSORTED/Richardson2016apr Can Slow-moving Ions Explain Hysteresis in the Current-Voltage Curves of Perovskite Solar Cells.pdf:PDF},
  journal   = {Energy Environ. Sci.},
  keywords  = {project > EFM, personnel > Tirmzi, collaborator > Hanrath, materials > semiconductor > perovskite, materials > semiconductor > perovskite > ion motion, devices > solar cell > hysteresis, materials > semiconductor > perovskite > halide motion},
