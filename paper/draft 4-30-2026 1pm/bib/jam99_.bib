@Article{Gottesman2016nov,
  author    = {Gottesman, Ronen and Lopez-Varo, Pilar and Gouda, Laxman and Jimenez-Tejada, Juan~A. and Hu, Jiangang and Tirosh, Shay and Zaban, Arie and Bisquert, Juan},
  title     = {Dynamic Phenomena at Perovskite/Electron-Selective Contact Interface as Interpreted From Photovoltage Decays},
  journal   = {Chem},
  year      = {2016},
  volume    = {1},
