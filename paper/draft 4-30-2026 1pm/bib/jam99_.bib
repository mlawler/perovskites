@Article{Mueller1995mar,
  author    = {Mueller, K.T.},
  title     = {Analytic solutions for the time evolution of dipolar-dephasing {NMR} signals},
  journal   = {J. Magn. Reson. A},
  year      = {1995},
  language  = {English},
