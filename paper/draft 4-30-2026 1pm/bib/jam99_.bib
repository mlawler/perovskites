@Article{McNeill2009may,
  author    = {McNeill, Christopher R. and Watts, Benjamin and Thomsen, Lars and Belcher, Warwick J. and Greenham, Neil C. and Dastoor, Paul C. and Ade, Harald},
  title     = {Evolution of Laterally Phase-Separated Polyfluorene Blend Morphology Studied by X-ray Spectromicroscopy},
  journal   = {Macromolecules},
  year      = {2009},
  volume    = {42},
  number    = {9},
  month     = {may},
  pages     = {3347 -- 3352},
  issn      = {0024-9297},
  doi       = {10.1021/ma801816r},
  url       = {http://dx.doi.org/10.1021/ma801816r},
  abstract  = {The morphological evolution of laterally phase-separated polyfluorene blends composed of poly(9,9'- dioctylfluorene-co-bis-N,N'-(4-butylphenyl)-bis-N,N'-phenyl-1,4-phenylen ediamine) (PFB) and poly(9,9'-dioctylfluorene-co-benzothiadiazole) (F8BT) has been studied with scanning transmission X-ray microscopy (STXM). The degree of phase separation in the films was regulated by controlling the time spent in a solvent-saturated atmosphere during solution processing, typically between 1 and 6 min. For films with a 5:1 weight ratio of PFB:F8BT, we observe a systematic increase in domain size and domain purity, with the enclosed F8BT-rich domains growing both through coalescence and flow of material across the domain boundary. For 1:1 and 1:5 blends a more complicated evolution of morphology is observed with evidence of additional vertical stratification. For 1:1 blends, primary and secondary phase separation is observed, with the evolution of the PFB-rich phase evolving similar to the 5:1 blend. Increasingly, the PFB-rich spots within the F8BT domain are observed to disappear after around 3 min of morphology evolution. Similar behavior is also seen in 1:5 blends, where a dramatic partial phase inversion in observed. The origin of this transition is attributed to subsequent vertical phase separation, with PFB wetting the substrate/film interface or film/vapor interface or both. In addition to the mechanisms of phase separation, the implications of the observed morphology changes for device performance are also discussed.},
  comment   = {Suggested filename = McNeill2009may Evolution of Laterally Phase-Separated Polyfluorene Blend Morphology Studied by X-ray Spectromicroscopy 10.1021/ma801816r *.pdf},
  file      = {McNeill2009may Evolution of Laterally Phase-Separated Polyfluorene Blend Morphology Studied by X-ray Spectromicroscopy 10.1021\:ma801816r *.pdf:UNSORTED/McNeill2009may Evolution of Laterally Phase-Separated Polyfluorene Blend Morphology Studied by X-ray Spectromicroscopy 10.1021\:ma801816r *.pdf:PDF},
  owner     = {jam99},
  timestamp = {2011.04.30},
  unique-id = {ISI:000265781300018},
}

