@Article{Bi2014sep,
  author    = {Bi, Cheng and Shao, Yuchuan and Yuan, Yongbo and Xiao, Zhengguo and Wang, Chenggong and Gao, Yongli and Huang, Jinsong},
  title     = {Understanding the Formation and Evolution of Interdiffusion Grown Organolead Halide Perovskite Thin Films by Thermal Annealing},
  volume    = {2},
  number    = {43},
  pages     = {18508 -- 18514},
  doi       = {10.1039/C4TA04007D},
  url       = {http://dx.doi.org/10.1039/C4TA04007D},
  abstract  = {Organolead trihalide perovskites are emerging excellent active materials for thin film solar cells. Here, the formation and evolution of methylammonium lead iodide perovskite thin films grown by the low-temperature thermal annealing induced interdiffusion process are investigated. It is found that thermal annealing not only drives the formation of perovskite but also affects the morphology, optoelectronic properties and correlated device performance. Thermal annealing at 105 degrees C quickly drives the formation of phase-pure perovskite in a short time of 15 min, and continued thermal annealing up to two hours continuously increases the perovskite crystallinity and grain size without losing film continuity or coverage. The measured Hall mobility increases monotonically to 36.0 cm(2) V-1 s(-1) upon annealing, which is correlated with the increased crystallinity and grain size. Device efficiencies increase with an increased short circuit current density and fill factor with a longer annealing time up to two hours, and the highest device efficiency of 13.4 [percent] is achieved. It is found that the reduction of work function in the perovskite films, caused by the increased annealing duration, is linearly correlated with the open circuit voltage loss, which points out a path for the further increase of the device efficiency.},
  comment   = {Suggested filename = {Bi2014sep Understanding the Formation and Evolution of Interdiffusion Grown Organolead Halide Perovskite Thin Films by Thermal Annealing.pdf},
Source = {wxdoi2bib}},
  file      = {Bi2014sep Understanding the Formation and Evolution of Interdiffusion Grown Organolead Halide Perovskite Thin Films by Thermal Annealing.pdf:Bi2014sep Understanding the Formation and Evolution of Interdiffusion Grown Organolead Halide Perovskite Thin Films by Thermal Annealing.pdf:PDF},
  journal   = {J. Mater. Chem. A},
  keywords  = {project > EFM, personnel > Tirmzi},
  month     = {sep},
  owner     = {jam99},
  timestamp = {2019.03.03},
  year      = {2014},
}

@Article{Shi2015jan,
  author    = {Shi, D. and Adinolfi, V. and Comin, R. and Yuan, M. and Alarousu, E. and Buin, A. and Chen, Y. and Hoogland, S. and Rothenberger, A. and Katsiev, K. and Losovyj, Y. and Zhang, X. and Dowben, P. A. and Mohammed, O. F. and Sargent, E. H. and Bakr, O. M.},
