@Article{Sarracanie2015oct,
  author    = {Sarracanie, Mathieu and LaPierre, Cristen D. and Salameh, Najat and Waddington, David E. J. and Witzel, Thomas and Rosen, Matthew S.},
  title     = {Low-Cost High-Performance MRI},
  volume    = {5},
  pages     = {15177},
  doi       = {10.1038/srep15177},
  url       = {http://dx.doi.org/10.1038/srep15177},
  abstract  = {Magnetic Resonance Imaging (MRI) is unparalleled in its ability to visualize anatomical structure and function non-invasively with high spatial and temporal resolution. Yet to overcome the low sensitivity inherent in inductive detection of weakly polarized nuclear spins, the vast majority of clinical MRI scanners employ superconducting magnets producing very high magnetic fields. Commonly found at 1.5 to 3 tesla (T), these powerful magnets are massive and have very strict infrastructure demands that preclude operation in many environments. MRI scanners are costly to purchase, site, and maintain, with the purchase price approaching 1M USD per tesla (T) of magnetic field. We present here a remarkably simple, non-cryogenic approach to high-performance human MRI at ultra-low magnetic field, whereby modern under-sampling strategies are combined with fully-refocused dynamic spin control using steady-state free precession techniques. At 6.5 mT (more than 450 times lower than clinical MRI scanners) we demonstrate (2.5 x 3.5 x8.5) mm3 imaging resolution in the living human brain using a simple, open-geometry electromagnet, with 3D image acquisition over the entire brain in 6 minutes. We contend that these practical ultra-low magnetic field implementations of MRI (<10 mT) will complement traditional MRI, providing clinically relevant images and setting new standards for affordable (<50,000 USD) and robust portable devices.},
  comment   = {Suggested filename = {Sarracanie2015oct Low-Cost High-Performance MRI.pdf},
Source = {wxdoi2bib}},
  file      = {Sarracanie2015oct Low-Cost High-Performance MRI.pdf:UNSORTED/Sarracanie2015oct Low-Cost High-Performance MRI.pdf:PDF},
  journal   = {Sci. Rep.},
  month     = {oct},
  owner     = {jam99},
  timestamp = {2019.03.03},
  year      = {2015},
}

@Article{Sasakura2011oct,
  author    = {Sasakura, H. and Kuramitsu, S. and Hayashi, Y. and Tanaka, K. and Akazaki, T. and Hanamura, E. and Inoue, R. and Takayanagi, H. and Asano, Y. and Hermannstädter, C. and Kumano, H. and Suemune, I.},
  title     = {Enhanced Photon Generation in a Nb/n-InGaAs/p-InP Superconductor/Semiconductor-Diode Light Emitting Device},
