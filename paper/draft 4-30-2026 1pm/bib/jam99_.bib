@Unpublished{Chen2012jul,
  Title                    = {{MRFM} detection of a large slowly relaxing spin polarization induced by {ESR}},
  Author                   = {Lei Chen and Jonilyn G. Longenecker and Eric W. Moore and John A. Marohn},
  Note                     = {NanoMRI Conference 2012; Ascona, Switzerland; July 22 -- 27},

