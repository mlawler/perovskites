@Article{Hallam2009dec,
  author         = {Hallam, Toby and Lee, MiJung and Zhao, Ni and Nandhakumar, Iris and Kemerink, Martijn and Heeney, Martin and McCulloch, Iain and Sirringhaus, Henning},
  title          = {Local Charge Trapping in Conjugated Polymers Resolved by Scanning {K}elvin Probe Microscopy},
