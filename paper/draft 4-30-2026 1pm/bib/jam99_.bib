  keywords       = {materials > magnetic > cobalt, nanomagnetics, nanomagnetics > magnetoresistance, MRFM > magnetometry > magnetoresistance, nanomagnetics > switching > coherent rotation},
  owner          = {jam99},
  timestamp      = {2010.05.27},
  unique-id      = {ISI:000228013500045},
}

