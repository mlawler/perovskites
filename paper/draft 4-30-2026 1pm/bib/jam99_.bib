  pages     = {3838 -- 3849},
  doi       = {10.1109/TIP.2012.2199505},
  url       = {http://dx.doi.org/10.1109/TIP.2012.2199505},
  abstract  = {We propose a solution to the image deconvolution problem where the convolution kernel or point spread function (PSF) is assumed to be only partially known. Small perturbations generated from the model are exploited to produce a few principal components explaining the PSF uncertainty in a high-dimensional space. Unlike recent developments on blind deconvolution of natural images, we assume the image is sparse in the pixel basis, a natural sparsity arising in magnetic resonance force microscopy (MRFM). Our approach adopts a Bayesian Metropolis-within-Gibbs sampling framework. The performance of our Bayesian semi-blind algorithm for sparse images is superior to previously proposed semi-blind algorithms such as the alternating minimization algorithm and blind algorithms developed for natural images. We illustrate our myopic algorithm on real MRFM tobacco virus data.},
  comment   = {Suggested filename = Park2012sep Semi-Blind Sparse Image Reconstruction With Application to MRFM 10.1109/TIP.2012.2199505 *.pdf},
  file      = {Park2012sep Semi-Blind Sparse Image Reconstruction With Application to MRFM 10.1109\:TIP.2012.2199505 *.pdf:UNSORTED/Park2012sep Semi-Blind Sparse Image Reconstruction With Application to MRFM 10.1109\:TIP.2012.2199505 *.pdf:PDF},
  keywords  = {grant-Sidles-ARO-W911NF-05-1-0403},
  owner     = {jam99},
  timestamp = {2012.10.14},
}

