@Article{Popa2004nov,
  author    = {Popa, I. and Gaebel, T. and Domhan, M. and Wittmann, C. and Jelezko, F. and Wrachtrup, J.},
  title     = {Energy levels and decoherence properties of single electron and nuclear spins in a defect center in diamond},
  journal   = {Phys. Rev. B},
  year      = {2004},
  volume    = {70},
  number    = {20},
  month     = {nov},
  pages     = {201203},
  doi       = {10.1103/PhysRevB.70.201203},
  url       = {http://dx.doi.org/10.1103/PhysRevB.70.201203},
  abstract  = {The coherent behavior of the single electron and single nuclear spins of a defect center in diamond and a C-13 nucleus in its vicinity, respectively, are investigated. The energy levels associated with the hyperfine coupling of the electron spin of the defect center to the C-13 nuclear spin are analyzed. Methods of magnetic resonance, together with the optical readout of single defect centers, have been applied in order to observe the coherent dynamics of the electron and nuclear spins. Long coherence times, in the order of microseconds for electron spins and tens of microseconds for nuclear spins, recommend the studied system as a good experimental approach for implementing a two-qubit gate.},
  comment   = {suggested filename = Popa2004nov Energy levels and decoherence properties of single electron and nuclear spins in a defect center in diamond 10.1103/PhysRevB.70.201203 *.pdf},
  di        = {10.1103/PhysRevB.70.201203},
