@Article{Afeworki1992aug,
  Title                    = {Selective observation of the interface of heterogeneous polycarbonate/polystyrene blends by dynamic nuclear polarization carbon-13 NMR spectroscopy},
  Author                   = {Afeworki, Mobae and McKay, Robert A. and Schaefer, Jacob},
  Journal                  = {Macromolecules},
  Year                     = {1992},

  Month                    = {aug},
  Number                   = {16},
  Pages                    = {4084 -- 4091},
  Volume                   = {25},

  Abstract                 = {Heterogeneous blends of [3,3'-$^{13}{\rm C}_2$]polycarbonate and [{\it ul}-ring-$^{12}{\rm C}_6$]polystyrene were formed 
by serial film casting. The polystyrene phase of each blend was homogeneously doped with 2% by weight 
of a bis(dipheny1ene)phenylallyl free-radical complex with benzene. Proton polarization enhanced by dynamic 
nuclear polarization was generated in the polycarbonate phase by dipolar coupling to electrons in the polystyrene 
phase under 39-GHz microwave irradiation at the difference of the electron and proton Larmor frequencies. 
Proton magnetization was then transferred to carbons under matched, spin-lock conditions for detaction with 
chemical-shift selectivity by magic-angle spinning $^{13}$C NMR spectroecopy. The $^{13}$C signal from polycarbonate 
arises exclusively from chains which are at the polycarbonate/polystyrene interface. Signals from bulk poly- 
carbonate were suppressed by differencing techniques. Attempts at direct polarization transfers from electrons 
in the polystyrene phase to carbons in the polycarbonate phase failed.},
  Doi                      = {10.1021/ma00042a006},
  Eprint                   = {http://pubs.acs.org/doi/pdf/10.1021/ma00042a006},
  File                     = {Afeworki1992aug Selective observation of the interface of heterogeneous polycarbonate-polystyrene blends by dynamic nuclear polarization carbon-13 NMR spectroscopy 10.1021\:ma00042a006 *.pdf:UNSORTED/Afeworki1992aug Selective observation of the interface of heterogeneous polycarbonate-polystyrene blends by dynamic nuclear polarization carbon-13 NMR spectroscopy 10.1021\:ma00042a006 *.pdf:PDF},
  Keywords                 = {magnetic resonance, magnetic resonance > DNP, magnetic resonance > DNP > polymer blend, magnetic resonance > double res, magnetic resonance > double res > Hartman-Hahn, magnetic resonance > double res > Hartman-Hahn > polymer blend},
  Owner                    = {Sanggap},
  Timestamp                = {2010.10.14},
  Url                      = {http://dx.doi.org/10.1021/ma00042a006}
}

@Article{Afeworki1992aug2,
