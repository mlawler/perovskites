@Article{Chen2016aug,
  author    = {Chen, Y. and Yi, H. T. and Wu, X. and Haroldson, R. and Gartstein, Y. N. and Rodionov, Y. I. and Tikhonov, K. S. and Zakhidov, A. and Zhu, X. -Y. and Podzorov, V.},
