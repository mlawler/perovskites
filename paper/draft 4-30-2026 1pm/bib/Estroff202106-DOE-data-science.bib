}

@article{Zhang2020feb,
  title = {Achieving {{Reproducible}} and {{High-Efficiency}} ({$>$}21\%) {{Perovskite Solar Cells}} with a {{Presynthesized FAPbI}}{\textsubscript{3}} {{Powder}}},
  author = {Zhang, Yong and Seo, Seongrok and Lim, Soo Yeon and Kim, Younghoon and Kim, Seul-Gi and Lee, Do-Kyoung and Lee, Sun-Ho and Shin, Hyunjung and Cheong, Hyeonsik and Park, Nam-Gyu},
