}

@Article{Tousi2011oct,
  author    = {Tousi, Yahya M. and Afshari, Ehsan},
  title     = {A Miniature 2 {mW} 4 Bit 1.2 {GS/s} Delay-Line-Based {ADC} in 65 {nm} {CMOS}},
  volume    = {46},
  number    = {10},
  pages     = {2312 -- 2325},
  doi       = {10.1109/JSSC.2011.2162186},
  url       = {http://dx.doi.org/10.1109/JSSC.2011.2162186},
  abstract  = {A delay-line-based analog-to-digital converter for high-speed applications is introduced. The ADC converts the sampled input voltage to a delay that controls the propagation velocity of a digital pulse. The output digital code is generated based on the propagation length of the pulse in a fixed time window. The effects of quantization noise, jitter, and mismatch are discussed. We show that because of the averaging mechanism of the delay-line, this structure is more power efficient in the presence of noise and mismatch in deep sub-micron CMOS. To show the feasibility of this approach, a 4 bit 1.2 GS/s ADC is designed and fabricated in 65 nm CMOS in an active area of 110 $\mu$m $\times$ 105 $\mu$m. The measured INL and DNL of the ADC are below 0.8 bits and 0.5 bits and it achieves an SNDR of 20.4 dB at Nyquist rate. This delay-line-based ADC consumes 2 mW of power from a 1.2 V supply resulting in 196 fJ/conversion step without using any calibration or post-processing.},
  comment   = {Suggested filename = {Tousi2011oct A Miniature 2 mW 4 Bit 1.2 GS/s Delay-Line-Based ADC in 65 Nm CMOS.pdf}},
  journal   = {IEEE J. Solid-State Circuits},
  month     = {oct},
  owner     = {jam99},
  timestamp = {2019.03.03},
  year      = {2011},
}

@Article{Tousi2012dec,
  author    = {Tousi, Yahya M. and Momeni, Omeed and Afshari, Ehsan},
  title     = {A Novel {CMOS} High-Power Terahertz {VCO} Based on Coupled Oscillators: {T}heory and Implementation},
  volume    = {47},
  number    = {12},
  pages     = {3032 -- 3042},
  doi       = {10.1109/JSSC.2012.2217853},
  url       = {http://dx.doi.org/10.1109/JSSC.2012.2217853},
  abstract  = {We introduce a novel frequency tuning method for high-power terahertz sources in CMOS. In this technique, multiple core oscillators are coupled to generate, combine, and deliver their harmonic power to the output node without using varactors. By exploiting the theory of nonlinear dynamics, we control the coupling between the cores to set their phase shift and frequency. Using this method, two high-power terahertz VCOs are fabricated in a 65 nm LP bulk CMOS process. The first one has a measured output power of 0.76 mW at 290 GHz with 4.5\% tuning range and the output power of the second VCO is 0.46 mW at 320 GHz with 2.6\% tuning range. The output power of these signal sources is 4 orders of magnitude higher than previous CMOS VCOs and is even higher than VCOs implemented in compound semiconductors with much higher cut-off frequencies.},
  comment   = {Suggested filename = {Tousi2012dec A Novel CMOS High-Power Terahertz VCO Based on Coupled Oscillators ~ Theory and Implementation.pdf}},
  file      = {Tousi2012dec A Novel CMOS High-Power Terahertz VCO Based on Coupled Oscillators ~ Theory and Implementation.pdf:Tousi2012dec A Novel CMOS High-Power Terahertz VCO Based on Coupled Oscillators ~ Theory and Implementation.pdf:PDF},
  journal   = {IEEE J. Solid-State Circuits},
  month     = {dec},
  owner     = {jam99},
  timestamp = {2019.03.03},
  year      = {2012},
}

@Article{Tousi2012jun,
  author    = {Tousi, Yahya M. and Pourahmad, Vahnood and Afshari, Ehsan},
  title     = {Delay Coupled Oscillators for Frequency Tuning of Solid-State Terahertz Sources},
  volume    = {108},
  number    = {23},
  pages     = {234101},
  doi       = {10.1103/PhysRevLett.108.234101},
  url       = {http://dx.doi.org/10.1103/PhysRevLett.108.234101},
  abstract  = {We present a solid-state tunable terahertz source that exploits the theory of coupled oscillators to simultaneously achieve high output power and frequency tuning. Our proposed structure effectively generates and combines high power harmonics from multiple synchronized solid-state oscillators in a loop configuration. We study the dynamics of the system, find the stable modes, and show how the structure can dynamically select a desired coupling mode. Using this method, we fabricated 0.29 and 0.32~THz tunable sources with peak output powers of 0.76 and 0.5~mW both in a standard 65~nm bulk complementary metal-oxide semiconductor technology. This power level is around 10~000 times larger than the state of the art which demonstrates that the proposed concept achieves significantly higher output power for a given solid-state process.},
  comment   = {Suggested filename = {Tousi2012jun Delay Coupled Oscillators for Frequency Tuning of Solid-State Terahertz Sources.pdf}},
  file      = {Tousi2012jun Delay Coupled Oscillators for Frequency Tuning of Solid-State Terahertz Sources.pdf:UNSORTED/Tousi2012jun Delay Coupled Oscillators for Frequency Tuning of Solid-State Terahertz Sources.pdf:PDF},
  journal   = {Phys. Rev. Lett.},
  keywords  = {MRFM > microwaves, microwave > sources, microwave > sources > THz},
  month     = {jun},
  owner     = {jam99},
  timestamp = {2019.03.03},
  year      = {2012},
}

@Article{Tran2001jun,
  author    = {Tran, T. and Oliver, D. R. and Thomson, D. J. and Bridges, G. E.},
  title     = {``Zeptofarad'' ($10^{-21}$~F) Resolution Capacitance Sensor for Scanning Capacitance Microscopy},
  volume    = {72},
  number    = {6},
  pages     = {2618},
  doi       = {10.1063/1.1369637},
  url       = {http://dx.doi.org/10.1063/1.1369637},
  abstract  = {We describe a sensor for use in a scanning capacitance microscope (SCM) that is capable of "zeptofarad" (10(-21) F) capacitance measurement resolution in a 1 Hz bandwidth with a peak-to-peak sense voltage on the probe tip of no more than 300 mV. This sensitivity is based on experimental data and simulation results that are in excellent agreement. The complete sensor incorporates an oscillator (phase locked to a 10 MHz crystal oscillator), a coupled transmission line resonator, an amplifier, and a peak detector. The resonator is fabricated from copper-clad, low-loss dielectric material and its size is such that it is easily incorporated with a scanning probe microscope. The sensor's use in the SCM enables capacitance resolution that has not previously been possible while retaining the instrumental advantages of imaging at low sense voltages. The performance of this sensor is discussed and compared to alternative scanning capacitance microscopy methodologies.},
  comment   = {Suggested filename = {Tran2001jun Zeptofarad Resolution Capacitance Sensor for Scanning Capacitance Microscopy.pdf},
Source = {wxdoi2bib}},
  file      = {Tran2001jun Zeptofarad Resolution Capacitance Sensor for Scanning Capacitance Microscopy.pdf:UNSORTED/Tran2001jun Zeptofarad Resolution Capacitance Sensor for Scanning Capacitance Microscopy.pdf:PDF},
  journal   = {Rev. Sci. Instrum.},
  keywords  = {SPM > scanning capacitance, SPM > SCM},
  month     = {jun},
  owner     = {jam99},
  timestamp = {2019.03.03},
  year      = {2001},
}

