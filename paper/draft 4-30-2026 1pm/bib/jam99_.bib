@Article{Pines1973jul,
  author    = {Pines, A and Gibby, MG and Waugh, JS},
  title     = {Proton-Enhanced {NMR} of Dilute Spins in Solids},
  journal   = {J. Chem. Phys.},
  year      = {1973},
  volume    = {59},
  number    = {2},
