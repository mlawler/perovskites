@Article{Wang2009jun,
  author    = {Wang, Xiaoyong and Ren, Xiaofan and Kahen, Keith and Hahn, Megan A. and Rajeswaran, Manju and Maccagnano-Zacher, Sara and Silcox, John and Cragg, George E. and Efros, Alexander L. and Krauss, Todd D.},
  title     = {Non-blinking semiconductor nanocrystals},
  volume    = {459},
  number    = {7247},
  pages     = {686 -- 689},
  issn      = {0028-0836},
  doi       = {10.1038/nature08072},
  url       = {http://dx.doi.org/10.1038/nature08072},
  abstract  = {The photoluminescence from a variety of individual molecules1 and nanometre-sized crystallites is defined by large intensity fluctuations, known as 'blinking', whereby their photoluminescence turns 'on' and 'off' intermittently, even under continuous photoexcitation. For semiconductor nanocrystals, it was originally proposed that these 'off' periods corresponded to a nanocrystal with an extra charge. A charged nanocrystal could have its photoluminescence temporarily quenched owing to the high efficiency of non-radiative (for example, Auger) recombination processes between the extra charge and a subsequently excited electron-hole pair; photoluminescence would resume only after the nanocrystal becomes neutralized again. Despite over a decade of research, completely non-blinking nanocrystals, have not been synthesized and an understanding of the blinking phenomenon remains elusive. Here we report ternary core/shell CdZnSe/ZnSe semiconductor nanocrystals that individually exhibit continuous, nonblinking photoluminescence. Unexpectedly, these nanocrystals strongly photoluminesce despite being charged, as indicated by a multi-peaked photoluminescence spectral shape and short lifetime. To model the unusual photoluminescence properties of the CdZnSe/ZnSe nanocrystals, we softened the abrupt confinement potential of a typical core/shell nanocrystal, suggesting that the structure is a radially graded alloy of CdZnSe into ZnSe. As photoluminescence blinking severely limits the usefulness of nanocrystals in applications requiring a continuous output of single photons, these non-blinking nanocrystals may enable substantial advances in fields ranging from single-molecule biological labelling to low-threshold lasers.},
  comment   = {10.1038/nature08072
Review:
Suggested filename = Wang2009jun Non-blinking semiconductor nanocrystals 10.1038/nature08072 *.pdf},
  file      = {Wang2009jun Non-blinking semiconductor nanocrystals 10.1038\:nature08072 *.pdf:UNSORTED/Wang2009jun Non-blinking semiconductor nanocrystals 10.1038\:nature08072 *.pdf:PDF},
  journal   = {Nature},
  keywords  = {materials > nanocrystals > blinking, materials > nanocrystals > CdZnSe, materials > nanocrystals > ZnSe, materials > nanocrystals > core-shell},
  month     = {jun},
  owner     = {jam99},
  publisher = {Macmillan Publishers Limited. All rights reserved},
  timestamp = {2019.03.03},
  year      = {2009},
}

@Article{Wang2003dec,
  author    = {Wang, Y and Henry, JA and Zehnder, AT and Hines, MA},
  title     = {Surface chemical control of mechanical energy losses in micromachined silicon structures},
  volume    = {107},
  number    = {51},
  pages     = {14270 -- 14277},
  issn      = {1520-6106},
  doi       = {10.1021/jp0360164},
  url       = {http://dx.doi.org/10.1021/jp0360164},
  abstract  = {Mechanical energy dissipation in room-temperature micromechanical silicon torsional resonators, with resonant frequencies ranging from 2.2 to 23 MHz, is considerably increased when a single monolayer of hydrogen atoms is replaced by 13 Angstrom of silicon oxide (which corresponds to the oxidation of less than 2 silicon bilayers.) Measurements of oxidation-induced resonant frequency shifts show that increased dissipation cannot be attributed to chemically induced changes in the stress or tension of the resonator. The dependence of both the frequency shift and reduction in quality factor on resonator size are consistent with a chemically induced surface loss mechanism. Quantitative analysis shows that even relatively unstressed areas of the surface can contribute considerably to mechanical energy dissipation. The scaling of losses with resonator dimensions suggests that surface effects will become increasingly more important as the sizes of micromechanical devices continue to decrease.},
  comment   = {Suggested filename = Wang2003dec Surface chemical control of mechanical energy losses in micromachined silicon structures 10.1021/jp0360164 *.pdf},
  file      = {Wang2003dec Surface chemical control of mechanical energy losses in micromachined silicon structures 10.1021\:jp0360164 *.pdf:UNSORTED/Wang2003dec Surface chemical control of mechanical energy losses in micromachined silicon structures 10.1021\:jp0360164 *.pdf:PDF},
  journal   = {J. Phys. Chem. B},
  keywords  = {MRFM > cantilevers},
  month     = {dec},
  owner     = {jam99},
  timestamp = {2019.03.03},
  unique-id = {ISI:000187447200023},
  year      = {2003},
}

@Article{Wang1988jan,
  author    = {Zhiyne Wang and Jean-Philippe Ansermet and Charles P. Slichter},
  title     = {Nuclear Magnetic Resonance Study of Pt-Rh Bimetallic Clusters},
  volume    = {84},
  number    = {11},
  pages     = {3785-3802},
  doi       = {10.1039/F19888403785},
  url       = {http://dx.doi.org/10.1039/F19888403785},
  abstract  = {The use of pulsed nuclear magnetic resonance to study supported Pt?Rh bimetallic clusters is described. Using energy-dispersive spectroscopy it has been shown that each individual cluster contains both Pt and Rh. For lower-dispersion samples (larger metal particles) the centre of the particles is pure Pt. For higher-dispersion samples (smaller metal particles) the Pt concentration in the surface layer of the clusters has been measured from observation of the dependence of the height of the Pt spin echo on the time, t, between pulses of the echo sequence. For clusters on which 13CO has been adsorbed, the 13CO resonance frequency varies with the Pt?Rh ratio. 195Pt?13C spin-echo double resonance (SEDOR) has been employed to measure the fraction of Pt atoms in the surface layer of the cluster. By studying how the SEDOR signal depends on the frequency of the 13CO exciting pulse, it has been shown that the resonance frequency of 13CO is independent of whether the CO is bonded to Pt or Rh in a given sample. This result shows that the frequency shift of the 13CO is a non-local rather than a local phenomenon. The 13CO shift corresponds to that of pure Rh particles, even for surfaces which contain a substantial Pt content. The significance of this result is explained in terms of the mixing of the molecular and metallic wave-functions.},
  comment   = {suggested filename = Wang1988janNuclear magnetic resonance study of Pt-Rh bimetallic clusters http://dx.doi.org/10.1039/F19888403785 *.pdf},
  file      = {Wang1988janNuclear magnetic resonance study of Pt-Rh bimetallic clusters:C\:\\Users\\Jonilyn\\Desktop\\Unsorted\\Wang1988janNuclear magnetic resonance study of Pt-Rh bimetallic clusters.pdf:PDF},
  journal   = {J. Chem. Soc., Faraday Trans. I},
  keywords  = {magnetic resonance > double res, magnetic resonace > double res > SEDOR},
  month     = {jan},
  owner     = {Jonilyn},
  timestamp = {2019.03.03},
  year      = {1988},
}

