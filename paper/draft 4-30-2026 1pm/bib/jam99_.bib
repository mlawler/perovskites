@Article{Zhang2017mar,
  author    = {Zhang, Qiushi and Zheng, Xiaoyan and Kuang, Guowen and Wang, Weihua and Zhu, Lizhe and Pang, Rui and Shi, Xingqiang and Shang, Xuesong and Huang, Xuhui and Liu, Pei Nian and Lin, Nian},
  title     = {Single-Molecule Investigations of Conformation Adaptation of Porphyrins on Surfaces},
  volume    = {8},
