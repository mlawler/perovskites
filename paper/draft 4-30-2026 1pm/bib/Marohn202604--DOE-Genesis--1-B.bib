  author = {Kaharudin, Khairil E. and Jalaludin, Nabilah A. and Salehuddin, Fauziyah and Arith, Faiz and Zain, Anis S. M. and Ahmad, Ibrahim and Junos, Siti A. M. and Afifah Maheran, Abdul H.},
