@article{Poloni2016dec,
  title = {Best Practices for Real-Time in Situ Atomic Force and Chemical Force Microscopy of Crystals},
  author = {Poloni, Laura N. and Zhong, Xiaodi and Ward, Michael D. and Mandal, Trinanjana},
  year = 2016,
