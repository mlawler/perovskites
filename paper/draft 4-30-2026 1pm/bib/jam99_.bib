}

@Article{Laan2012feb,
  author    = {Laan, Liedewij and Pavin, Nenad and Husson, Julien and {Romet-Lemonne}, Guillaume and {van Duijn}, Martijn and L\'opez, Magdalena Preciado and Vale, Ronald D. and J\"ulicher, Frank and Reck-peterson, Samara L. and Dogterom, Marileen},
  title     = {Cortical Dynein Controls Microtubule Dynamics to Generate Pulling Forces That Position Microtubule Asters},
  journal   = {Cell},
  year      = {2012},
  volume    = {148},
  number    = {3},
  month     = {feb},
  pages     = {502 -- 514},
  doi       = {10.1016/j.cell.2012.01.007},
  url       = {http://dx.doi.org/10.1016/j.cell.2012.01.007},
  abstract  = {Dynein at the cortex contributes to microtubule-based positioning processes such as spindle positioning during embryonic cell division and centrosome positioning during fibroblast migration. To investigate how cortical dynein interacts with microtubule ends to generate force and how this functional association impacts positioning, we have reconstituted the ``cortical'' interaction between dynein and dynamic microtubule ends in an in vitro system using microfabricated barriers. We show that barrier-attached dynein captures microtubule ends, inhibits growth, and triggers microtubule catastrophes, thereby controlling microtubule length. The subsequent interaction with shrinking microtubule ends generates pulling forces up to several pN. By combining experiments in microchambers with a theoretical description of aster mechanics, we show that dynein-mediated pulling forces lead to the reliable centering of microtubule asters in simple confining geometries. Our results demonstrate the intrinsic ability of cortical microtubule-dynein interactions to regulate microtubule dynamics and drive positioning processes in living cells.},
  comment   = {Suggested filename = Laan2012feb Cortical Dynein Controls Microtubule Dynamics to Generate Pulling Forces That Position Microtubule Asters 10.1016/j.cell.2012.01.007 *.pdf'},
  file      = {Laan2012feb Cortical Dynein Controls Microtubule Dynamics to Generate Pulling Forces That Position Microtubule Asters 10.1016\:j.cell.2012.01.007 *.pdf:UNSORTED/Laan2012feb Cortical Dynein Controls Microtubule Dynamics to Generate Pulling Forces That Position Microtubule Asters 10.1016\:j.cell.2012.01.007 *.pdf:PDF;Laan2012feb TSRI Cell Bio Class Discussion.txt:UNSORTED/Laan2012feb TSRI Cell Bio Class Discussion.txt:Text},
  owner     = {jam99},
  timestamp = {2013.01.09},
}

@Article{Labaziewicz2008oct,
  author         = {Labaziewicz, Jaroslaw and Ge, Yufei and Leibrandt, David R. and Wang, Shannon X. and Shewmon, Ruth and Chuang, Isaac L.},
  title          = {Temperature Dependence of Electric Field Noise above Gold Surfaces},
  journal        = {Phys. Rev. Lett.},
  year           = {2008},
  volume         = {101},
  number         = {18},
  month          = {oct},
  pages          = {180602},
  doi            = {10.1103/PhysRevLett.101.180602},
  url            = {http://dx.doi.org/10.1103/PhysRevLett.101.180602},
  abstract       = {Electric field noise from fluctuating patch potentials is a significant problem for a broad range of precision experiments, including trapped ion quantum computation and single spin detection. Recent results demonstrated strong suppression of this noise by cryogenic cooling, suggesting an underlying thermal process. We present measurements characterizing the temperature and frequency dependence of the noise from 7 to 100 K, using a single Sr+ ion trapped 75 mu m above the surface of a gold plated surface electrode ion trap. The noise amplitude is observed to have an approximate 1/f spectrum around 1 MHz, and grows rapidly with temperature as T-beta for beta from 2 to 4. The data are consistent with microfabricated cantilever measurements of noncontact friction but do not extrapolate to the dc measurements with neutral atoms or contact potential probes.},
  affiliation    = {Labaziewicz, J (Reprint Author), MIT, Dept Phys, Ctr Ultracold Atoms, 77 Massachusetts Ave, Cambridge, MA 02139 USA. {[}Labaziewicz, Jaroslaw; Ge, Yufei; Leibrandt, David R.; Wang, Shannon X.; Shewmon, Ruth; Chuang, Isaac L.] MIT, Dept Phys, Ctr Ultracold Atoms, Cambridge, MA 02139 USA.},
  article-number = {180602},
  author-email   = {labaziew@mit.edu},
  comment        = {Cites Kuehn's PRL. Suggested filename = Labaziewicz2008oct Temperature Dependence of Electric Field Noise above Gold Surfaces 10.1103/PhysRevLett.101.180602 *.pdf},
  file           = {Labaziewicz2008oct Temperature Dependence of Electric Field Noise above Gold Surfaces 10.1103\:PhysRevLett.101.180602 *.pdf:UNSORTED/Labaziewicz2008oct Temperature Dependence of Electric Field Noise above Gold Surfaces 10.1103\:PhysRevLett.101.180602 *.pdf:PDF},
  journal-iso    = {Phys. Rev. Lett.},
  keywords       = {MRFM > surface dissipation, surface dissipation > friction, surface dissipation > electric field fluctuations},
  keywords-plus  = {TRAPPED IONS; 1/F NOISE; POTENTIALS; SOLIDS},
