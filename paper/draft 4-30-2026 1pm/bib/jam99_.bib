@Article{Treutlein2016jun,
  author    = {Treutlein, Barbara and Lee, Qian Yi and Camp, J. Gray and Mall, Moritz and Koh, Winston and Shariati, Seyed Ali Mohammad and Sim, Sopheak and Neff, Norma F. and Skotheim, Jan M. and Wernig, Marius and Quake, Stephen R.},
  title     = {Dissecting Direct Reprogramming From Fibroblast to Neuron Using Single-cell RNA-seq},
  volume    = {534},
  number    = {7607},
  pages     = {391 -- 395},
  doi       = {10.1038/nature18323},
  url       = {http://dx.doi.org/10.1038/nature18323},
  abstract  = {Direct lineage reprogramming represents a remarkable conversion of cellular and transcriptome states. However, the intermediate stages through which individual cells progress during reprogramming are largely undefined. Here we use single-cell RNA sequencing at multiple time points to dissect direct reprogramming from mouse embryonic fibroblasts to induced neuronal cells. By deconstructing heterogeneity at each time point and ordering cells by transcriptome similarity, we find that the molecular reprogramming path is remarkably continuous. Overexpression of the proneural pioneer factor Ascl1 results in a well-defined initialization, causing cells to exit the cell cycle and re-focus gene expression through distinct neural transcription factors. The initial transcriptional response is relatively homogeneous among fibroblasts, suggesting that the early steps are not limiting for productive reprogramming. Instead, the later emergence of a competing myogenic program and variable transgene dynamics over time appear to be the major efficiency limits of direct reprogramming. Moreover, a transcriptional state, distinct from donor and target cell programs, is transiently induced in cells undergoing productive reprogramming. Our data provide a high-resolution approach for understanding transcriptome states during lineage differentiation.},
  comment   = {Suggested filename = {Treutlein2016jun Dissecting Direct Reprogramming From Fibroblast to Neuron Using Single-cell RNA-seq.pdf},
Source = {wxdoi2bib}},
  file      = {Treutlein2016jun Dissecting Direct Reprogramming From Fibroblast to Neuron Using Single-cell RNA-seq.pdf:UNSORTED/Treutlein2016jun Dissecting Direct Reprogramming From Fibroblast to Neuron Using Single-cell RNA-seq.pdf:PDF},
  journal   = {Nature},
  keywords  = {biology > stem cells, biology > BRAIN initiative},
  month     = {jun},
  owner     = {jam99},
  timestamp = {2019.03.03},
  year      = {2016},
}

@Article{Trifunovic2015may,
  author    = {Trifunovic, Luka and Pedrocchi, Fabio L. and Hoffman, Silas and Maletinsky, Patrick and Yacoby, Amir and Loss, Daniel},
  title     = {High-efficiency Resonant Amplification of Weak Magnetic Fields for Single Spin Magnetometry at Room Temperature},
  volume    = {10},
  number    = {6},
  pages     = {541 -- 546},
  doi       = {10.1038/NNANO.2015.74},
  url       = {http://dx.doi.org/10.1038/NNANO.2015.74},
  abstract  = {Magnetic resonance techniques not only provide powerful imaging tools that have revolutionized medicine, but they have a wide spectrum of applications in other fields of science such as biology, chemistry, neuroscience and physics. However, current state-of-the-art magnetometers are unable to detect a single nuclear spin unless the tip-to-sample separation is made sufficiently small. Here, we demonstrate theoretically that by placing a ferromagnetic particle between a nitrogen--vacancy magnetometer and a target spin, the magnetometer sensitivity is improved dramatically. Using materials and techniques that are already experimentally available, our proposed set-up is sensitive enough to detect a single nuclear spin within ten milliseconds of data acquisition at room temperature. The sensitivity is practically unchanged when the ferromagnet surface to the target spin separation is smaller than the ferromagnet lateral dimensions; typically about a tenth of a micrometre. This scheme further benefits when used for nitrogen--vacancy ensemble measurements, enhancing sensitivity by an additional three orders of magnitude.},
  comment   = {Suggested filename = {Trifunovic2015may High-efficiency Resonant Amplification of Weak Magnetic Fields for Single Spin Magnetometry at Room Temperature.pdf},
Source = {wxdoi2bib}},
  file      = {Trifunovic2015may High-efficiency Resonant Amplification of Weak Magnetic Fields for Single Spin Magnetometry at Room Temperature.pdf:UNSORTED/Trifunovic2015may High-efficiency Resonant Amplification of Weak Magnetic Fields for Single Spin Magnetometry at Room Temperature.pdf:PDF},
  journal   = {Nature Nanotech},
  keywords  = {magnetic resonance > NV center, nanomagnetics, magnetic resonance > FMR},
  month     = {may},
  owner     = {jam99},
  timestamp = {2019.03.03},
  year      = {2015},
}

@Article{Trifunovic2013dec,
  author    = {Trifunovic, Luka and Pedrocchi, Fabio L. and Loss, Daniel},
  title     = {Long-Distance Entanglement of Spin Qubits via Ferromagnet},
  volume    = {3},
  number    = {4},
  pages     = {041023},
  doi       = {10.1103/PhysRevX.3.041023},
  url       = {http://dx.doi.org/10.1103/PhysRevX.3.041023},
  abstract  = {We propose a mechanism of coherent coupling between distant spin qubits interacting dipolarly with a ferromagnet. We derive an effective two-spin interaction Hamiltonian and find a regime where the dynamics is coherent. Finally, we present a sequence for the implementation of the entangling controlled-not gate and estimate the corresponding operation time to be a few tens of nanoseconds. A particularly promising application of our proposal is to atomistic spin qubits such as silicon-based qubits and nitrogen-vacancy centers in diamond to which existing coupling schemes do not apply.},
