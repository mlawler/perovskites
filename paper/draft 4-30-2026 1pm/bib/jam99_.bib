@Article{Foley2017jan,
  author    = {Foley, Benjamin J. and Girard, Justin and Sorenson, Blaire A. and Chen, Alexander Z. and Scott Niezgoda, J. and Alpert, Matthew R. and Harper, Angela F. and Smilgies, Detlef-M. and Clancy, Paulette and Saidi, Wissam A. and Choi, Joshua J.},
  title     = {Controlling Nucleation, Growth, and Orientation of Metal Halide Perovskite Thin Films With Rationally Selected Additives},
  volume    = {5},
  number    = {1},
  pages     = {113 -- 123},
  doi       = {10.1039/C6TA07671H},
  url       = {http://dx.doi.org/10.1039/C6TA07671H},
  abstract  = {Accelerating the progress toward realizing metal halide perovskite solar cells with improved efficiency, stability and reliability requires a deeper understanding of the thin film formation processes. This paper investigates the impact of rationally selected chemical additives in precursor solutions on the nucleation and growth of metal halide perovskite thin films. Computational screening was performed to guide the selection of tetrahydrothiophene oxide as an additive with stronger solvation efficacy than all other commonly used solvents. In situ grazing incidence X-ray diffraction measurements show that the additives suppress the formation of homogeneous nuclei as well as crystalline intermediate structures. Instead, heterogeneous nucleation on the substrate surface and growth of a thin film with a strongly preferential crystallographic orientation occur directly from the precursor solution. Density functional theory calculations show that the crystallographic orientation of the thin films can be tuned by altering the surface energies with the chemical additives. The crystallographic orientation of the thin films is found to have a significant impact on the open circuit voltage of solar cell devices, highlighting the importance of controlling the metal halide perovskite thin film orientation for improved solar cell efficiency.},
  comment   = {Suggested filename = {Foley2017jan Controlling Nucleation, Growth, and Orientation of Metal Halide Perovskite Thin Films With Rationally Selected Additives.pdf},
Source = {wxdoi2bib}},
  file      = {Foley2017jan Controlling Nucleation, Growth, and Orientation of Metal Halide Perovskite Thin Films With Rationally Selected Additives.pdf:Foley2017jan Controlling Nucleation, Growth, and Orientation of Metal Halide Perovskite Thin Films With Rationally Selected Additives.pdf:PDF},
  journal   = {J. Mater. Chem. A},
  keywords  = {project > EFM, collaborator > Clancy, materials > semiconductor > perovskite},
  month     = {jan},
  owner     = {jam99},
  timestamp = {2019.03.03},
  year      = {2017},
}

@Article{Stevenson2017jan,
  author    = {Stevenson, James and Sorenson, Blaire and Subramaniam, Varun Hari and Raiford, James and Khlyabich, Petr P. and Loo, Yueh-Lin and Clancy, Paulette},
  title     = {Mayer Bond Order as a Metric of Complexation Effectiveness in Lead Halide Perovskite Solutions},
  volume    = {29},
  number    = {6},
  pages     = {2435 -- 2444},
  doi       = {10.1021/acs.chemmater.6b04327},
  url       = {http://dx.doi.org/10.1021/acs.chemmater.6b04327},
  abstract  = {One of the most appealing features of solar cells made from hybrid organic-inorganic perovskites is that they can be processed directly from solution, leading to low cost, energy-efficient processing. Numerous studies have shown that the composition of these solutions and the choice of solvent (or solvent blend) affects the efficiency of the resulting solar cell. Despite the importance of this correlation for performance, the choice of solvent(s) used to deposit the perovskite precursors has been largely a matter of experimental trial-and-error. In this work, we present a coherent theory explaining the molecular origin of the efficacy of solvent choice, which lends itself to the creation of a fast quantum mechanical-based screening process that facilitates the design of effective new solvents. We also provide the first theoretical confirmation of complexation of HOIP precursors in solution, including their structure and relative stability. We show that the Mayer bond order of a solvent's polar atoms predicts the solubility of the perovskite lead halide precursors in the solvent much more reliably than the relative polarity and Hansen polar solubility parameter suggested in the literature as being figures of merit.},
  comment   = {Suggested filename = {Stevenson2017jan Mayer Bond Order as a Metric of Complexation Effectiveness in Lead Halide Perovskite Solutions.pdf},
Source = {wxdoi2bib}},
  file      = {Stevenson2017jan Mayer Bond Order as a Metric of Complexation Effectiveness in Lead Halide Perovskite Solutions.pdf:Stevenson2017jan Mayer Bond Order as a Metric of Complexation Effectiveness in Lead Halide Perovskite Solutions.pdf:PDF},
  journal   = {Chem. Mater.},
  keywords  = {project > EFM, collaborator > Clancy, materials > semiconductor > perovskite},
  month     = {jan},
  owner     = {jam99},
  timestamp = {2019.03.03},
  year      = {2017},
}

