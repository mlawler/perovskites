@Unpublished{O'Dea2011jun,
  Title                    = {Nanoscale conductivity of metal-doped oxides for fuel cell catalyst supports},
  Author                   = {James R. O'Dea and Chinmayee V. Subban and Francis J. DiSalvo and John A. Marohn},
  Note                     = {85th meeting of the ACS Colloids and Surface Science Symposia; Montreal, Quebec, Canada; June 19 -- 22},

  Month                    = {jun},
  Year                     = {2011},

  Abstract                 = {Carbon particles traditionally used as catalyst supports in hydrogen fuel cells are oxidized to CO2 at high potentials (~1.5 V), which exist at the cathode during startup and shutdown conditions. Due to their resistance to corrosion at the pH and potentials experienced in fuel cell operation, oxides are being explored as alternative catalyst supports. For oxides to become incorporated into fuel cells for this purpose, they must be at least as electrically conductive as the fuel cell's electrolyte is ionically conductive (~0.1 S/cm). However, of the oxides that are able to withstand fuel cell operating conditions - such as TiO2 - all are electrically insulating.
Recently, we have increased the conductivity of TiO2 by doping with tungsten, yet low conductivities still limit this material's use in fuel cells. It is hypothesized that a thin, non-conducting oxide layer forms around otherwise electrically conductive Ti1-xWxO2. We have used atomic force microscopy (AFM) current and phase imaging to probe the nanoscale electrical and compositional homogeneity of Ti0.7W0.3O2. These properties were found to depend on the method used to synthesize Ti0.7W0.3O2. Micron sized Ti0.7W0.3O2 particles prepared using a high temperature (1500 °C) solid-state route show electrical and compositional inhomogeneities not seen in smaller, Ti0.7W0.3O2 nanoparticles prepared using a sol-gel synthesis.},
  Keywords                 = {marohn-talk-contributed, grant-Abruna-DOE-DE-SC0001086},
  Owner                    = {jam99},
  Timestamp                = {2012.03.07},
  Url                      = {http://abstracts.acs.org/chem/coll2011/program/view.php?obj_id=84768&terms=}
}

