  volume    = {6},
  month     = {mar},
  pages     = {6620},
  doi       = {10.1038/ncomms7620},
  url       = {http://dx.doi.org/10.1038/ncomms7620},
  abstract  = {Current methods of chemical vapour deposition (CVD) of graphene on copper are complicated by multiple processing steps and by high temperatures required in both preparing the copper and inducing subsequent film growth. Here we demonstrate a plasma-enhanced CVD chemistry that enables the entire process to take place in a single step, at reduced temperatures (<420 degrees C), and in a matter of minutes. Growth on copper foils is found to nucleate from arrays of well-aligned domains, and the ensuing films possess sub-nanometre smoothness, excellent crystalline quality, low strain, few defects and room-temperature electrical mobility up to (6.0 \\pm 1.0) E4 cm^2/Vs better than that of large, single-crystalline graphene derived from thermal CVD growth. These results indicate that elevated temperatures and crystalline substrates are not necessary for synthesizing high-quality graphene.},
  comment   = {Suggested filename = {Boyd2015mar Single-step Deposition of High-mobility Graphene at Reduced Temperatures.pdf},
Source = {wxdoi2bib}},
  file      = {Boyd2015mar Single-step Deposition of High-mobility Graphene at Reduced Temperatures.pdf:Boyd2015mar Single-step Deposition of High-mobility Graphene at Reduced Temperatures.pdf:PDF},
  keywords  = {materials > PES > graphene, nanomanufacturing},
  owner     = {jam99},
  timestamp = {2015.03.28},
}

@Article{Brabec2001feb,
  author    = {Brabec, CJ and Sariciftci, NS and Hummelen, JC},
