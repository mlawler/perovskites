@Article{Tselev2014nov,
  author    = {Tselev, Alexander and Morozovska, Anna N and Udod, Alexei and Eliseev, Eugene A and Kalinin, Sergei V},
  title     = {Self-consistent Modeling of Electrochemical Strain Microscopy of Solid Electrolytes},
  volume    = {25},
  number    = {44},
  pages     = {445701},
  doi       = {10.1088/0957-4484/25/44/445701},
  url       = {http://dx.doi.org/10.1088/0957-4484/25/44/445701},
  abstract  = {Electrochemical strain microscopy (ESM) employs a strong electromechanical coupling in solid ionic conductors to map ionic transport and electrochemical processes with nanometer-scale spatial resolution. To elucidate the mechanisms of the ESM image formation, we performed self-consistent numerical modeling of the electromechanical response in solid electrolytes under the probe tip in a linear, small-signal regime using the Boltzmann-Planck-Nernst-Einstein theory and Vegard's law while taking account of the electromigration and diffusion. The characteristic time scales involved in the formation of the ESM response were identified. It was found that the dynamics of the charge carriers in the tip-electrolyte system with blocking interfaces can be described as charging of the diffuse layer at the tip-electrolyte interface through the tip contact spreading resistance. At the high frequencies used in the detection regime, the distribution of the charge carriers under the tip is governed by evanescent concentration waves generated at the tip-electrolyte interface. The ion drift length in the electric field produced by the tip determines the ESM response at high frequencies, which follows a 1/f asymptotic law. The electronic conductivity, as well as the electron transport through the electrode-electrolyte interface, do not have a significant effect on the ESM signal in the detection regime. The results indicate, however, that for typical solid electrolytes at room temperature, the ESM response originates at and contains information about the very surface layer of a sample, and the properties of the one-unit-cell-thick surface layer may significantly contribute to the ESM response, implying a high surface sensitivity and a high lateral resolution of the technique. On the other hand, it follows that a rigorous analysis of the ESM signals requires techniques that account for the discrete nature of a solid.},
  comment   = {Suggested filename = {Tselev2014nov Self-consistent Modeling of Electrochemical Strain Microscopy of Solid Electrolytes.pdf},
Source = {wxdoi2bib}},
  file      = {Tselev2014nov Self-consistent Modeling of Electrochemical Strain Microscopy of Solid Electrolytes.pdf:Tselev2014nov Self-consistent Modeling of Electrochemical Strain Microscopy of Solid Electrolytes.pdf:PDF},
  journal   = {Nanotechnology},
  keywords  = {SPM > spreading resistance, SPM > electrochemical strain microscopy (ESM), SPM > ESM},
  month     = {nov},
  owner     = {jam99},
  timestamp = {2019.03.03},
  year      = {2014},
}

@Article{Gross2017sep,
  author    = {Gross, I. and Akhtar, W. and Garcia, V. and Mart\'\inez, L. J. and Chouaieb, S. and Garcia, K. and Carr\'et\'ero, C. and Barth\'el\'emy, A. and Appel, P. and Maletinsky, P. and Kim, J.-V. and Chauleau, J. Y. and Jaouen, N. and Viret, M. and Bibes, M. and Fusil, S. and Jacques, V.},
  title     = {Real-space Imaging of Non-collinear Antiferromagnetic Order With a Single-spin Magnetometer},
  volume    = {549},
  number    = {7671},
  pages     = {252 -- 256},
  doi       = {10.1038/nature23656},
  url       = {http://dx.doi.org/10.1038/nature23656},
  abstract  = {Although ferromagnets have many applications, their large magnetization and the resulting energy cost for switching magnetic moments bring into question their suitability for reliable low-power spintronic devices. Non-collinear antiferromagnetic systems do not suffer from this problem, and often have extra functionalities: non-collinear spin order1 may break space-inversion symmetry2, 3 and thus allow electric-field control of magnetism4, 5, or may produce emergent spin-orbit effects6 that enable efficient spin-charge interconversion7. To harness these traits for next-generation spintronics, the nanoscale control and imaging capabilities that are now routine for ferromagnets must be developed for antiferromagnetic systems. Here, using a non-invasive, scanning single-spin magnetometer based on a nitrogen-vacancy defect in diamond8, 9, 10, we demonstrate real-space visualization of non-collinear antiferromagnetic order in a magnetic thin film at room temperature. We image the spin cycloid of a multiferroic bismuth ferrite (BiFeO3) thin film and extract a period of about 70 nanometres, consistent with values determined by macroscopic diffraction11, 12. In addition, we take advantage of the magnetoelectric coupling present in BiFeO3 to manipulate the cycloid propagation direction by an electric field. Besides highlighting the potential of nitrogen-vacancy magnetometry for imaging complex antiferromagnetic orders at the nanoscale, these results demonstrate how BiFeO3 can be used in the design of reconfigurable nanoscale spin textures.},
  comment   = {Suggested filename = {Gross2017sep Real-space Imaging of Non-collinear Antiferromagnetic Order With a Single-spin Magnetometer.pdf},
Source = {wxdoi2bib}},
  file      = {Gross2017sep Real-space Imaging of Non-collinear Antiferromagnetic Order With a Single-spin Magnetometer.pdf:Gross2017sep Real-space Imaging of Non-collinear Antiferromagnetic Order With a Single-spin Magnetometer.pdf:PDF},
  journal   = {Nature},
  keywords  = {magnetic resonance > NV center, materials > antiferromagnetic},
  month     = {sep},
  owner     = {jam99},
  timestamp = {2019.03.03},
  year      = {2017},
}

@Article{Boss2017may,
  author    = {Boss, J. M. and Cujia, K. S. and Zopes, J. and Degen, C. L.},
  title     = {Quantum Sensing With Arbitrary Frequency Resolution},
  volume    = {356},
  number    = {6340},
  pages     = {837 -- 840},
  doi       = {10.1126/science.aam7009},
  url       = {http://dx.doi.org/10.1126/science.aam7009},
  abstract  = {Quantum sensing takes advantage of well-controlled quantum systems for performing measurements with high sensitivity and precision. We have implemented a concept for quantum sensing with arbitrary frequency resolution, independent of the qubit probe and limited only by the stability of an external synchronization clock. Our concept makes use of quantum lock-in detection to continuously probe a signal of interest. Using the electronic spin of a single nitrogen-vacancy center in diamond, we demonstrate detection of oscillating magnetic fields with a frequency resolution of 70 microhertz over a megahertz bandwidth. The continuous sampling further guarantees an enhanced sensitivity, reaching a signal-to-noise ratio in excess of 1E4 for a 170-nanotesla test signal measured during a 1-hour interval. Our technique has applications in magnetic resonance spectroscopy, quantum simulation, and sensitive signal detection.},
  comment   = {Suggested filename = {Boss2017may Quantum Sensing With Arbitrary Frequency Resolution.pdf},
Source = {wxdoi2bib},
See also = {Schmitt2017may Submillihertz Magnetic Spectroscopy Performed With a Nanoscale Quantum Sensor.pdf}},
  file      = {Boss2017may Quantum Sensing With Arbitrary Frequency Resolution.pdf:Boss2017may Quantum Sensing With Arbitrary Frequency Resolution.pdf:PDF},
  journal   = {Science},
  keywords  = {magnetic resonance > NV center, MRFM > competition, magnetic resonance > sensitivity},
  month     = {may},
  owner     = {jam99},
  timestamp = {2019.03.03},
  year      = {2017},
}

@Article{Schmitt2017may,
  author    = {Schmitt, Simon and Gefen, Tuvia and St\"urner, Felix M. and Unden, Thomas and Wolff, Gerhard and M\"uller, Christoph and Scheuer, Jochen and Naydenov, Boris and Markham, Matthew and Pezzagna, Sebastien and Meijer, Jan and Schwarz, Ilai and Plenio, Martin and Retzker, Alex and McGuinness, Liam P. and Jelezko, Fedor},
  title     = {Submillihertz Magnetic Spectroscopy Performed With a Nanoscale Quantum Sensor},
  volume    = {356},
  number    = {6340},
  pages     = {832 -- 837},
  doi       = {10.1126/science.aam5532},
  url       = {http://dx.doi.org/10.1126/science.aam5532},
  abstract  = {Precise timekeeping is critical to metrology, forming the basis by which standards of time, length, and fundamental constants are determined. Stable clocks are particularly valuable in spectroscopy because they define the ultimate frequency precision that can be reached. In quantum metrology, the qubit coherence time defines the clock stability, from which the spectral linewidth and frequency precision are determined. We demonstrate a quantum sensing protocol in which the spectral precision goes beyond the sensor coherence time and is limited by the stability of a classical clock. Using this technique, we observed a precision in frequency estimation scaling in time \$T\$ as \$T^\{-3/2\}\$ for classical oscillating fields. The narrow linewidth magnetometer based on single spins in diamond is used to sense nanoscale magnetic fields with an intrinsic frequency resolution of 607 microhertz, which is eight orders of magnitude narrower than the qubit coherence time.},
  comment   = {Suggested filename = {Schmitt2017may Submillihertz Magnetic Spectroscopy Performed With a Nanoscale Quantum Sensor.pdf},
Source = {wxdoi2bib}, 
See also = {Boss2017may Quantum Sensing With Arbitrary Frequency Resolution.pdf}},
  file      = {Schmitt2017may Submillihertz Magnetic Spectroscopy Performed With a Nanoscale Quantum Sensor.pdf:Schmitt2017may Submillihertz Magnetic Spectroscopy Performed With a Nanoscale Quantum Sensor.pdf:PDF},
  journal   = {Science},
  keywords  = {magnetic resonance > NV center, MRFM > competition, magnetic resonance > sensitivity},
  month     = {may},
  owner     = {jam99},
  timestamp = {2019.03.03},
  year      = {2017},
}

