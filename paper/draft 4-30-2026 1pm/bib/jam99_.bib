}

@Article{Davis2011mar,
  author    = {Davis, Robert J. and Lloyd, Matthew T. and Ferreira, Summer R. and Bruzek, Matthew J. and Watkins, Scott E. and Lindell, Linda and Sehati, Parisa and Fahlman, Mats and Anthony, John E. and Hsu, Julia W. P.},
  title     = {Determination of energy level alignment at interfaces of hybrid and organic solar cells under ambient environment},
  journal   = {J. Mater. Chem.},
  year      = {2011},
  volume    = {21},
  number    = {6},
  month     = {mar},
  pages     = {1721--1729},
  issn      = {0959-9428},
  doi       = {10.1039/C0JM02349C},
  url       = {http://dx.doi.org/10.1039/C0JM02349C},
  abstract  = {Device function in organic electronics is critically governed by the transport of charge across interfaces of dissimilar materials. Accurate measurements of energy level positions in organic electronic devices are therefore necessary for assessing the viability of new materials and optimizing device performance. In contrast to established methods that are used in solution or vacuum environments, here we combine Kelvin probe measurements performed in ambient environments to obtain work function values with photoelectron spectroscopy in air to obtain ionization potential, so that a complete energy level diagram for organic semiconductors can be determined. We apply this new approach to study commonly used electron donor and acceptor materials in organic photovoltaics (OPV), including poly(3-hexylthiophene) (P3HT), [6,6]-phenyl C61 butyric acid methyl ester (PCBM), and ZnO, as well as examine new materials. Band alignments across the entire OPV devices are constructed and compared with actual device performance. The ability to determine interfacial electronic properties in the devices enables us to answer the outstanding question: why previous attempts to make OPV devices using 6,13-bis(triisopropylsilylethynyl) (TIPS)-pentacene as the electron donor were not successful.},
  comment   = {Suggested filename = Davis2011mar Determination of energy level alignment at interfaces of hybrid and organic solar cells under ambient environment 10.1039/C0JM02349C *.pdf},
  file      = {Davis2011mar Determination of energy level alignment at interfaces of hybrid and organic solar cells under ambient environment 10.1039\:C0JM02349C *.pdf:UNSORTED/Davis2011mar Determination of energy level alignment at interfaces of hybrid and organic solar cells under ambient environment 10.1039\:C0JM02349C *.pdf:PDF},
  owner     = {jll73},
  publisher = {The Royal Society of Chemistry},
  timestamp = {2011.06.04},
}

@Article{DeFilippis2015feb,
  author    = {De Filippis, G. and Cataudella, V. and Mishchenko, A.~S. and Nagaosa, N. and Fierro, A. and de Candia, A.},
  title     = {Crossover From Super- to Subdiffusive Motion and Memory Effects in Crystalline Organic Semiconductors},
