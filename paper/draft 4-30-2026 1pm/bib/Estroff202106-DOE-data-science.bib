@misc{Ruth2023jul,
  title = {A Thermodynamic Band Gap Model for Photoinduced Phase Segregation in Mixed-Halide Perovskites},
  author = {Ruth, Anthony and Okrepka, Halyna and Kamat, Prashant and Kuno, Masaru},
  year = 2023,
  month = jul,
  number = {arXiv:2307.06268},
  eprint = {2307.06268},
  primaryclass = {cond-mat},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2307.06268},
  urldate = {2023-07-21},
  abstract = {Provided is a comprehensive description of a band gap thermodynamic model, which predicts and explains key features of photosegregation in lead-based, mixed-halide perovskites. The model provides a prescription for illustrating halide migration driven by photocarrier energies. Where possible, model predictions are compared to experimental results. Free energy derivations are provided for three assumptions: (1) halide mixing in the dark, (2) a fixed number of photogenerated carriers funneling to and localizing in low band gap inclusions of the alloy, and (3) the statistical occupancy of said inclusions from a bath of thermalized photocarriers in the parent material. Model predictions include: excitation intensity (\$I\_\textbraceleft\textbackslash textrm\textbraceleft exc\textbraceright\textbraceright\$)-dependent terminal halide stoichiometries (\$x\_\textbraceleft\textbackslash textrm\textbraceleft terminal\textbraceright\textbraceright\$), excitation intensity thresholds (\$I\_\textbraceleft\textbackslash textrm\textbraceleft exc,threshold\textbraceright\textbraceright\$) below which photosegregation is suppressed, reduced segregation in nanocrystals as compared to thin films, the possibility to kinetically manipulate photosegregation rates via control of underlying mediators, asymmetries in forward and reverse photosegregation rate constants/activation energies, and a preference for high band gap products to recombine with the parent phase. What emerges is a cohesive framework for understanding ubiquitous photosegregation in mixed-halide perovskites and a rational basis by which to manage the phenomenon.},
  archiveprefix = {arXiv},
  keywords = {Condensed Matter - Materials Science,Condensed Matter - Soft Condensed Matter},
  file = {/Users/jam99/Zotero/storage/QPCW5JFL/Ruth et al. - 2023 - A thermodynamic band gap model for photoinduced ph.pdf;/Users/jam99/Zotero/storage/8FLRUSNK/2307.html}
}

