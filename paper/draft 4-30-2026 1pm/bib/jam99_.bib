@Article{Matsumoto2015sep,
  author    = {Matsumoto, Fukashi and Vorpahl, Sarah M. and Banks, Jannel Q. and Sengupta, Esha and Ginger, David S.},
  title     = {Photodecomposition and Morphology Evolution of Organometal Halide Perovskite Solar Cells},
  journal   = {J. Phys. Chem. C},
  year      = {2015},
  volume    = {119},
  number    = {36},
  month     = {sep},
  pages     = {20810 -- 20816},
  doi       = {10.1021/acs.jpcc.5b06269},
  url       = {http://dx.doi.org/10.1021/acs.jpcc.5b06269},
  abstract  = {We study the photoinduced degradation of hybrid organometal perovskite photovoltaics under illumination and ambient atmosphere using UVvis absorption, atomic force microscopy, and device performance. We correlate the structural changes in the surface of the perovskite film with changes in the optical and electronic properties of the devices. The photodecomposition of the methylammonium lead triiodide perovskite layer itself proceeds much more slowly than the photodegradation of the performance of devices with fullerene/bathocuproine/aluminum top contacts, indicating that the active layer alone is more stable than the interface with the electrodes in this geometry. The evolution of the perovskite active layer performance proceeded through several phases: (1) an initial improvement in device characteristics, (2) a plateau with very slow degradation, and (3) a catastrophic decline in material performance accompanied by marked changes in film morphology. The rapid increase in surface roughness of the active perovskite semiconductor associated with sudden failure also correlates with decreased absorption at the perovskite band edge and growth of a lead iodide absorption feature. We find that degradation requires both light and moisture, is accelerated at increased humidity, and scales linearly with light intensity, depending primarily on total photon dose.},
  comment   = {Suggested filename = {Matsumoto2015sep Photodecomposition and Morphology Evolution of Organometal Halide Perovskite Solar Cells.pdf},
Source = {wxdoi2bib}},
  file      = {Matsumoto2015sep Photodecomposition and Morphology Evolution of Organometal Halide Perovskite Solar Cells.pdf:UNSORTED/Matsumoto2015sep Photodecomposition and Morphology Evolution of Organometal Halide Perovskite Solar Cells.pdf:PDF},
  keywords  = {project > EFM, personnel > Dwyer, materials > semiconductor > perovskite, devices > solar cell > perovskite, devices > solar cell > degradation},
  owner     = {jam99},
  timestamp = {2015.09.30},
}

