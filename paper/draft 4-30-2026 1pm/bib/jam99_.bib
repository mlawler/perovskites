  pages     = {709 -- 713},
  doi       = {10.1021/nl2036222},
  url       = {http://dx.doi.org/10.1021/nl2036222},
  abstract  = {We present a new charge sensing technique for the excited-state spectroscopy of individual quantum dots, which requires no patterned electrodes. An oscillating atomic force microscope cantilever is used as a movable charge sensor as well as gate to measure the single-electron tunneling between an individual self-assembled InAs quantum dot and back electrode. A set of cantilever dissipation versus bias voltage curves measured at different cantilever oscillation amplitudes forms a diagram analogous to the Coulomb diamond usually measured with transport measurements. The excited-state levels as well as the electron addition spectrum can be obtained from the diagram. In addition, a signature which can result from inelastic tunneling by phonon emission or a peak in the density of states of the electrode is also observed, which demonstrates the versatility of the technique.},
  comment   = {Suggested filename = Cockins2012feb Excited-State Spectroscopy on an Individual Quantum Dot Using Atomic Force Microscopy 10.1021/nl2036222 *.pdf},
  file      = {Cockins2012feb Excited-State Spectroscopy on an Individual Quantum Dot Using Atomic Force Microscopy 10.1021\:nl2036222 *.pdf:UNSORTED/Cockins2012feb Excited-State Spectroscopy on an Individual Quantum Dot Using Atomic Force Microscopy 10.1021\:nl2036222 *.pdf:PDF},
  keywords  = {SPM > KPFM > quantitative, SPM > SKPM > quantitative, project > EFM},
  owner     = {jam99},
  timestamp = {2012.02.28},
}

