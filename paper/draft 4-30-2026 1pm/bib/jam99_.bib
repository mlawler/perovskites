@Article{Gallagher2009dec,
  author    = {Gallagher, Kevin G. and Pivovar, Bryan S. and Fuller, Thomas F.},
  title     = {Electro-osmosis and Water Uptake in Polymer Electrolytes in Equilibrium With Water Vapor at Low Temperatures},
