@article{Zhao2020jan,
  title = {Precise Stress Control of Inorganic Perovskite Films for Carbon-Based Solar Cells with an Ultrahigh Voltage of 1.622 {{V}}},
  author = {Zhao, Yuanyuan and Duan, Jialong and Wang, Yudi and Yang, Xiya and Tang, Qunwei},
  year = 2020,
