}

@Article{Murawski2015dec,
  author    = {Murawski, J. and M\"onch, T. and Milde, P. and Hein, M. P. and Nicht, S. and Zerweck-Trogisch, U. and Eng, L. M.},
  title     = {Tracking Speed Bumps in Organic Field-effect Transistors via Pump-probe {K}elvin-probe Force Microscopy},
  journal   = {J. Appl. Phys.},
  year      = {2015},
  volume    = {118},
  number    = {24},
  month     = {dec},
  pages     = {244502},
  doi       = {10.1063/1.4938529},
  url       = {http://dx.doi.org/10.1063/1.4938529},
  abstract  = {One of the great challenges in designing modern organic field-effect transistors is lowering the injection barriers that arise at the interfaces between the metallic electrodes and the semiconducting transport channel. Currently, these barriers are quantified mostly by time-independent and external inspection, techniques lacking temporal insight into the most relevant switching dynamics. We address this problem here by pump-probe Kelvin-probe force microscopy, which combines the high spatial resolution of standard Kelvin-probe force microscopy with a pump-probe, enabling time resolution down to nanoseconds. When investigating a dynamically operated pentacene-based organic field-effect transistor, pump-probe Kelvin-probe force microscopy is capable of in-situ probing the temporal charge evolution at any sample spot within the device. Thus, Schottky-barriers arising at the boundaries between electrodes and transport channel are identified as speed bumps for high-speed organic field-effect transistor operation, manifested by residual charges that are retained within the organic film upon switching the device.},
  comment   = {Suggested filename = {Murawski2015dec Tracking Speed Bumps in Organic Field-effect Transistors via Pump-probe Kelvin-probe Force Microscopy.pdf},
Source = {wxdoi2bib}},
  file      = {Murawski2015dec Tracking Speed Bumps in Organic Field-effect Transistors via Pump-probe Kelvin-probe Force Microscopy.pdf:UNSORTED/Murawski2015dec Tracking Speed Bumps in Organic Field-effect Transistors via Pump-probe Kelvin-probe Force Microscopy.pdf:PDF},
  keywords  = {project > EFM, personnel > Dwyer, SPM > ultrafast},
  owner     = {jam99},
  timestamp = {2016.01.13},
}

