@Article{Jones2008apr,
  author    = {Jones, Brooks A. and Facchetti, Antonio and Wasielewski, Michael R. and Marks, Tobin J.},
  title     = {Effects of Arylene Diimide Thin Film Growth Conditions on n-Channel OFET Performance},
  journal   = {Adv. Funct. Mater.},
  year      = {2008},
  volume    = {18},
  number    = {8},
  month     = {apr},
  pages     = {1329 -- 1339},
