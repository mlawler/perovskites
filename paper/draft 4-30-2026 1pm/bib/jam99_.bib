@Article{Wu2010aug,
  author    = {Wu, Ming-Chung and Wu, Yi-Jen and Yen, Wei-Che and Lo, Hsi-Hsing and Lin, Ching-Fuh and Su, Wei-Fang},
  title     = {Correlation between nanoscale surface potential and power conversion efficiency of P3HT/TiO2 nanorod bulk heterojunction photovoltaic devices},
  volume    = {2},
  number    = {8},
  pages     = {1448--1454},
  issn      = {2040-3364},
  doi       = {10.1039/B9NR00385A},
  url       = {http://dx.doi.org/10.1039/B9NR00385A},
  abstract  = {This is an in depth study on the surface potential changes of P3HT/TiO2 nanorod bulk heterojunction thin films. They are affected by interlayer structures, the molecular weight of P3HT, the processing solvents and the surface ligands on the TiO2. The addition of an electron blocking layer and/or the hole blocking layer to the P3HT/TiO2 thin film can facilitate charge carrier transport and result in a high surface potential shift. The changes in surface potential of multilayered bulk heterojunction films are closely correlated to their power conversion efficiency of photovoltaic devices. Changing ligand leads to the largest change in surface potential yielding the greatest effect on the power conversion efficiency. Merely changing the P3HT molecular weight is less effective and varying the processing solvents is least effective in increasing power conversion efficiency. The steric effect of the ligand has a large influence on the reduction of charge carrier recombination resulting in a great effect on the power conversion efficiency. By monitoring the changes in the surface potential of bulk heterojunction film of multilayer structures, we have obtained a useful guide for the fabrication of high performance photovoltaic devices.},
  comment   = {Suggested filename = Wu2010aug Correlation between nanoscale surface potential and power conversion efficiency of P3HT/TiO2 nanorod bulk heterojunction photovoltaic devices 10.1039/B9NR00385A *.pdf

Notes; Luria = Just ran across a paper in Nanoscale (RCS) discussing surface photovoltage measurements  in P3HT:TiO_2 nanorod blended films. They observe quite a large photovoltage in the presence of an underlayer (really it's closer to a bilayer). They attribute the increase photovoltage to the accumulation of electrons in the top layer (similar to what we propose). It's not a scanning wavelength paper, so no worry of being scooped. But it is to note that others are looking in to this realm. I've added a reference in the current draft. Attached is the pdf with the xmp metadata written to file.},
  file      = {Wu2010aug Correlation between nanoscale surface potential and power conversion efficiency of P3HT\:TiO2 nanorod bulk heterojunction photovoltaic devices 10.1039\:B9NR00385A *.pdf:UNSORTED/Wu2010aug Correlation between nanoscale surface potential and power conversion efficiency of P3HT\:TiO2 nanorod bulk heterojunction photovoltaic devices 10.1039\:B9NR00385A *.pdf:PDF},
  journal   = {Nanoscale},
  month     = {aug},
  owner     = {jam99},
  publisher = {The Royal Society of Chemistry},
  timestamp = {2019.03.03},
  year      = {2010},
}

@Article{Wu2009mar,
  author    = {Wu, P. and Shui, W. and Carlson, B. L. and Hu, N. and Rabuka, D. and Lee, J. and Bertozzi, C. R.},
  title     = {Site-specific Chemical Modification of Recombinant Proteins Produced in Mammalian Cells by Using the Genetically Encoded Aldehyde Tag},
  volume    = {106},
  number    = {9},
  pages     = {3000 -- 3005},
  doi       = {10.1073/pnas.0807820106},
  url       = {http://dx.doi.org/10.1073/pnas.0807820106},
  abstract  = {The properties of therapeutic proteins can be enhanced by chemical modification. Methods for site-specific protein conjugation are critical to such efforts. Here, we demonstrate that recombinant proteins expressed in mammalian cells can be site-specifically modified by using a genetically encoded aldehyde tag. We introduced the peptide sequence recognized by the endoplasmic reticulum (ER)-resident formylglycine generating enzyme (FGE), which can be as short as 6 residues, into heterologous proteins expressed in mammalian cells. Cotranslational modification of the proteins by FGE produced products bearing a unique aldehyde group. Proteins bearing this ``aldehyde tag'' were chemically modified by selective reaction with hydrazide- or aminooxy-functionalized reagents. We applied the technique to site-specific modification of monoclonal antibodies, the fastest growing class of biopharmaceuticals, as well as membrane-associated and cytosolic proteins expressed in mammalian cells.},
  comment   = {Suggested filename = {Wu2009mar Site-specific Chemical Modification of Recombinant Proteins Produced in Mammalian Cells by Using the Genetically Encoded Aldehyde Tag.pdf},
Source = {wxdoi2bib}},
  file      = {Wu2009mar Site-specific Chemical Modification of Recombinant Proteins Produced in Mammalian Cells by Using the Genetically Encoded Aldehyde Tag.pdf:UNSORTED/Wu2009mar Site-specific Chemical Modification of Recombinant Proteins Produced in Mammalian Cells by Using the Genetically Encoded Aldehyde Tag.pdf:PDF},
  journal   = {Proceedings of the National Academy of Sciences},
  keywords  = {biology > labeling > protein, biology > labeling > bioorthogonal},
  month     = {mar},
  owner     = {jam99},
  timestamp = {2019.03.03},
  year      = {2009},
}

@Article{Wu1974nov,
  author    = {Wu, S.H. and Anderson, R.L.},
  title     = {{MOSFET}'s in the $0^{\circ}\mathrm{K}$ Approximation},
  volume    = {17},
  number    = {11},
  pages     = {1125 -- 1137},
  doi       = {10.1016/0038-1101(74)90156-7},
  url       = {http://dx.doi.org/10.1016/0038-1101(74)90156-7},
  abstract  = {The static electrical characteristics below current saturation of MOSFET's with degenerate source and drain regions are calculated for operation at 0\~K. The expression for current takes the same form as at room temperature although the flat-band voltage and the voltage across the depletion region at threshold are altered slightly. Potential hills occur in the channel if the gate does not overlap source and drain or if the oxide thickness is increased in the overlap regions. Although these barriers do not affect operation appreciably at room temperature, at 0\~K a finite drain voltage (source-drain threshold voltage) is required to initiate conduction. This threshold voltage is included in the theory and the theory is compared with experimental results on p-channel enhancement mode MOSFET's at 4.2\~K using hole mobility in the channel as a matching parameter. The channel hole mobility (assumed constant along the channel) is found to be relatively independent of gate voltage but to increase with increasing (negative) drain voltage. Values ranging between 500 and 1000 cm2/Vs are deduced for drain voltages ranging from -1.2 V to -7 V. This compares to channel hole mobility values of 200 to 300 cm2/V-sec at room temperature. It is found that the channel width is on the order of 30 to 50 \\AA -- appreciably less than that at room temperature.},
  comment   = {Suggested filename = {Wu1974nov MOSFETs in the 0K Approximation.pdf},
Source = {wxdoi2bib}},
  file      = {Wu1974nov MOSFETs in the 0K Approximation.pdf:UNSORTED/Wu1974nov MOSFETs in the 0K Approximation.pdf:PDF},
  journal   = {Solid-State Electron.},
  keywords  = {project > MRFM, collaborator > Afshari, electronics > low temperature},
  month     = {nov},
  owner     = {jam99},
  timestamp = {2019.03.03},
  year      = {1974},
}

@Article{Wu2012apr,
  author    = {Wu, Shenping and Avila-sakar, Agustin and Kim, JungMin and Booth, David S. and Greenberg, Charles H. and Rossi, Andrea and Liao, Maofu and Li, Xueming and Alian, Akram and Griner, Sarah L. and Juge, Narinobu and Yu, Yadong and Mergel, Claudia M. and Chaparro-riggers, Javier and Strop, Pavel and Tampé, Robert and Edwards, Robert H. and Stroud, Robert M. and Craik, Charles S. and Cheng, Yifan},
  title     = {Fabs Enable Single Particle {cryoEM} Studies of Small Proteins},
  volume    = {20},
  number    = {4},
  pages     = {582 -- 592},
  doi       = {10.1016/j.str.2012.02.017},
  url       = {http://dx.doi.org/10.1016/j.str.2012.02.017},
  abstract  = {In spite of its recent achievements, the technique of single particle electron cryomicroscopy (cryoEM) has not been widely used to study proteins smaller than 100 kDa, although it is a highly desirable application of this technique. One fundamental limitation is that images of small proteins embedded in vitreous ice do not contain adequate features for accurate image alignment. We describe a general strategy to overcome this limitation by selecting a fragment antigen binding (Fab) to form a stable and rigid complex with a target protein, thus providing a defined feature for accurate image alignment. Using this approach, we determined a three-dimensional structure of an ∼65 kDa protein by single particle cryoEM. Because Fabs can be readily generated against a wide range of proteins by phage display, this approach is generally applicable to study many small proteins by single particle cryoEM.},
  comment   = {Suggested filename = Wu2012apr Fabs Enable Single Particle cryoEM Studies of Small Proteins 10.1016/j.str.2012.02.017 *.pdf},
  file      = {Wu2012apr Fabs Enable Single Particle cryoEM Studies of Small Proteins 10.1016\:j.str.2012.02.017 *.pdf:UNSORTED/Wu2012apr Fabs Enable Single Particle cryoEM Studies of Small Proteins 10.1016\:j.str.2012.02.017 *.pdf:PDF},
  journal   = {Structure},
  month     = {apr},
  owner     = {jam99},
  timestamp = {2019.03.03},
  year      = {2012},
}

