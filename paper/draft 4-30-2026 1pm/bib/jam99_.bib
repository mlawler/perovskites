@Article{Kadau2008sep,
  author         = {Kadau, Dirk and Hucht, Alfred and Wolf, Dietrich E.},
  title          = {Magnetic friction in {I}sing spin systems},
  journal        = {Phys. Rev. Lett.},
  year           = {2008},
  volume         = {101},
  number         = {13},
  month          = {sep},
  pages          = {137205},
  issn           = {0031-9007},
  doi            = {10.1103/PhysRevLett.101.137205},
  url            = {http://dx.doi.org/10.1103/PhysRevLett.101.137205},
  abstract       = {A new contribution to friction is predicted to occur in systems with magnetic correlations: Tangential relative motion of two Ising spin systems pumps energy into the magnetic degrees of freedom. This leads to a friction force proportional to the area of contact. The velocity and temperature dependence of this force are investigated. Magnetic friction is strongest near the critical temperature, below which the spin systems order spontaneously. Antiferromagnetic coupling leads to stronger friction than ferromagnetic coupling with the same exchange constant. The basic dissipation mechanism is explained. A surprising effect is observed in the ferromagnetically ordered phase: The relative motion can act like a heat pump cooling the spins in the vicinity of the friction surface.},
  affiliation    = {Kadau, D (Reprint Author), Univ Duisburg Essen, Dept Phys, D-47048 Duisburg, Germany. {[}Kadau, Dirk; Hucht, Alfred; Wolf, Dietrich E.] Univ Duisburg Essen, Dept Phys, D-47048 Duisburg, Germany. {[}Kadau, Dirk; Hucht, Alfred; Wolf, Dietrich E.] Univ Duisburg Essen, CeNIDE, D-47048 Duisburg, Germany. {[}Kadau, Dirk] ETH, Inst Bldg Mat, CH-8092 Zurich, Switzerland.},
  article-number = {137205},
  comment        = {Suggested filename = Kadau2008sep Magnetic friction in Ising spin systems 10.1103/PhysRevLett.101.137205 *.pdf},
  file           = {Kadau2008sep Magnetic friction in Ising spin systems 10.1103\:PhysRevLett.101.137205 *.pdf:UNSORTED/Kadau2008sep Magnetic friction in Ising spin systems 10.1103\:PhysRevLett.101.137205 *.pdf:PDF},
  journal-iso    = {Phys. Rev. Lett.},
  keywords       = {nanomagnetics, nanomagnetics > fluctuations, nanomagnetics > friction},
  owner          = {jam99},
  timestamp      = {2010.06.01},
  type           = {Article},
  unique-id      = {ISI:000259680600069},
}

