  unique-id      = {ISI:000246075300006},
  year           = {2007},
}

@Article{Tsoi2011sep,
  author    = {Tsoi, Wing C. and Nicholson, Patrick G. and Kim, Jong Soo and Roy, Debdulal and Burnett, Tim L. and Murphy, Craig E. and Nelson, Jenny and Bradley, Donal D. C. and Kim, Ji-Seon and Castro, Fernando A.},
  title     = {Surface and subsurface morphology of operating nanowire:fullerene solar cells revealed by photoconductive-AFM},
  volume    = {4},
  number    = {9},
  pages     = {3646},
  doi       = {10.1039/c1ee01944a},
  url       = {http://dx.doi.org/10.1039/c1ee01944a},
  abstract  = {The 3D nanometer scale phase separated morphology of organic solar cells crucially affects performance. We demonstrate that photoconductive atomic force microscopy can provide both surface and subsurface information in operating organic solar cells providing direct correlation between 3D film morphology, local nanoscale optoelectronic properties and device characteristics. P3HT nanowire:PCBM bulk-heterojunction working devices were investigated. The macroscopic solar cell performance improvements upon thermal annealing, such as an increase in the short circuit current, the open circuit voltage and the fill factor, are consistent with observed enrichment of PCBM at the air interface and increased nanowire crystallinity. PC-AFM is able to directly resolve the associated changes in charge transport and collection at the local scale, with an estimated depth resolution of at least 20 nm inside the film.},
  comment   = {Suggested filename = Tsoi2011sep Surface and subsurface morphology of operating nanowire-fullerene solar cells revealed by photoconductive-AFM 10.1039/c1ee01944a *.pdf},
  file      = {Tsoi2011sep Surface and subsurface morphology of operating nanowire-fullerene solar cells revealed by photoconductive-AFM 10.1039\:c1ee01944a *.pdf:UNSORTED/Tsoi2011sep Surface and subsurface morphology of operating nanowire-fullerene solar cells revealed by photoconductive-AFM 10.1039\:c1ee01944a *.pdf:PDF},
  journal   = {Energy Environ. Sci.},
  keywords  = {SPM > cp-AFM, materials > PES > P3HT, materials > PES > C60, devices > solar cell > PES},
  month     = {sep},
  owner     = {jam99},
  timestamp = {2019.03.03},
  year      = {2011},
}

