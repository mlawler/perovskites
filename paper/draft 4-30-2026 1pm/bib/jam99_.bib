  keywords  = {MRFM > competition, MRFM > magnetometry > atomic magnetometer, MRFM > magnetometry > Hanle effect, MRFM > luminescence depolarization, magnetic resonance > NMR > remote detection},
  owner     = {jam99},
  timestamp = {2011.01.06},
  unique-id = {ISI:000253469900009},
}

