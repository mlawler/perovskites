  keywords  = {materials > properties > superhydrophobic, materials > properties > superhydrophobic > polyaniline, materials > properties > superhydrophilic, materials > properties > superhydrophilic > polyaniline},
  owner     = {jam99},
  timestamp = {2012.03.29},
