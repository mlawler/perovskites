    journal = "Appl. Phys. Lett.",
    keywords = "project > EFM, personnel > Tirmzi, collaborator > Hanrath, materials > semiconductor > perovskite > ion motion, materials > semiconductor > perovskite > defects, materials > semiconductor > perovskite > doping",
    month = "feb",
    owner = "jam99",
