@Article{Kehayias2017dec,
  author    = {P. Kehayias and A. Jarmola and N. Mosavian and I. Fescenko and F. M. Benito and A. Laraoui and J. Smits and L. Bougas and D. Budker and A. Neumann and S. R. J. Brueck and V. M. Acosta},
  title     = {Solution Nuclear Magnetic Resonance Spectroscopy on a Nanostructured Diamond Chip},
  volume    = {8},
  number    = {1},
  pages     = {869},
  doi       = {10.1038/s41467-017-00266-4},
  url       = {http://dx.doi.org/10.1038/s41467-017-00266-4},
  abstract  = {Sensors using nitrogen-vacancy centers in diamond are a promising tool for small-volume nuclear magnetic resonance (NMR) spectroscopy, but the limited sensitivity remains a challenge. Here we show nearly two orders of magnitude improvement in concentration sensitivity over previous nitrogen-vacancy and picoliter NMR studies. We demonstrate NMR spectroscopy of picoliter-volume solutions using a nanostructured diamond chip with dense, high-aspect-ratio nanogratings, enhancing the surface area by 15 times. The nanograting sidewalls are doped with nitrogen-vacancies located a few nanometers from the diamond surface to detect the NMR spectrum of roughly 1 pL of fluid lying within adjacent nanograting
grooves. We perform 1H and 19F nuclear magnetic resonance spectroscopy at room temperature
in magnetic fields below 50 mT. Using a solution of CsF in glycerol, we determine that 4 \$\\pm\$ 2 \$\\times\$ 10\$^\{12\}\$ 19F spins in a 1 pl volume can be detected with a signal-to-noise ratio of 3 in
1 s of integration.},
  comment   = {Suggested filename = {Kehayias2017dec Solution Nuclear Magnetic Resonance Spectroscopy on a Nanostructured Diamond Chip.pdf},
Source = {wxdoi2bib},
Notes = {2017/10/16.  Corinne's comment at group meeting: ``The sensitivity numbers don't seem to work.  Requires a sample concentration at least 6 molar.  How is this useful?''}},
  file      = {:Kehayias2017dec Solution nuclear magnetic resonance spectroscopy on a nanostructured diamond chip.pdf:PDF},
  journal   = {Nat Comms},
  keywords  = {project > MRFM, magnetic resonance > NV center},
  month     = {dec},
  owner     = {jam99},
  timestamp = {2019.03.03},
  year      = {2017},
}

