  keywords  = {microscopy > electron > FIB, materials > magnetic > Co-Fe, microscopy > electron > TEM},
  owner     = {jam99},
  timestamp = {2011.10.19},
}

@Article{Buchaca-Domingo2015apr,
  author    = {Buchaca-Domingo, Ester and Vandewal, Koen and Fei, Zhuping and Watkins, Scott E. and Scholes, Fiona H. and Bannock, James H. and de Mello, John C. and Richter, Lee J. and DeLongchamp, Dean M. and Amassian, Aram and Heeney, Martin and Salleo, Alberto and Stingelin, Natalie},
  title     = {Direct Correlation of Charge Transfer Absorption With Molecular Donor:Acceptor Interfacial Area via Photothermal Deflection Spectroscopy},
  journal   = {J. Am. Chem. Soc.},
  year      = {2015},
  volume    = {137},
  number    = {16},
  month     = {apr},
  pages     = {5256 -- 5259},
  doi       = {10.1021/ja512410f},
  url       = {http://dx.doi.org/10.1021/ja512410f},
  abstract  = {Here we show that the charge transfer (CT) absorption signal in bulk-heterojunction solar cell blends, measured by photothermal deflection spectroscopy, is directly proportional to the density of molecular donor:acceptor interfaces. Since the optical transitions from the ground state to the interfacial CT state are weakly allowed at photon energies below the optical gap of both the donor and acceptor, we can exploit the use of this sensitive linear absorption spectroscopy for such quantification. Moreover, we determine the absolute molar extinction coefficient of the CT transition for an archetypical polymer:fullerene interface. The latter is ca 100 times lower than the extinction coefficient of the donor chromophore involved, allowing us to experimentally estimate the transition dipole moment as 0.3 D and the electronic coupling between the ground and CT states to be on the order of 30 meV.},
  comment   = {Suggested filename = {Buchaca-Domingo2015apr Direct Correlation of Charge Transfer Absorption With Molecular Donor ~ Acceptor Interfacial Area via Photothermal Deflection Spectroscopy.pdf},
Source = {wxdoi2bib}},
  file      = {Buchaca-Domingo2015apr Direct Correlation of Charge Transfer Absorption With Molecular Donor ~ Acceptor Interfacial Area via Photothermal Deflection Spectroscopy.pdf:UNSORTED/Buchaca-Domingo2015apr Direct Correlation of Charge Transfer Absorption With Molecular Donor ~ Acceptor Interfacial Area via Photothermal Deflection Spectroscopy.pdf:PDF},
  keywords  = {project > EFM, personnel > Dwyer, SPM > ultrafast, devices > solar cell > PES, devices > solar cell > PES > Voc, charge separation > Langevin recombination},
  owner     = {jam99},
  timestamp = {2016.12.01},
}

@Article{Buckley2010nov,
  author    = {Buckley, B. B. and Fuchs, G. D. and Bassett, L. C. and Awschalom, D. D.},
  title     = {Spin-Light Coherence for Single-Spin Measurement and Control in Diamond},
