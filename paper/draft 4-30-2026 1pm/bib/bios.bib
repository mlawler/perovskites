    volume = "10",
    number = "5",
    pages = "391 -- 402",
    doi = "10.1038/nnano.2015.90",
    url = "http://dx.doi.org/10.1038/nnano.2015.90",
    abstract = "Metal-halide perovskites are crystalline materials originally developed out of scientific curiosity. Unexpectedly, solar cells incorporating these perovskites are rapidly emerging as serious contenders to rival the leading photovoltaic technologies. Power conversion efficiencies have jumped from 3 [percent] to over 20 [percent] in just four years of academic research. Here, we review the rapid progress in perovskite solar cells, as well as their promising use in light-emitting devices. In particular, we describe the broad tunability and fabrication methods of these materials, the current understanding of the operation of state-of-the-art solar cells and we highlight the properties that have delivered light-emitting diodes and lasers. We discuss key thermal and operational stability challenges facing perovskites, and give an outlook of future research avenues that might bring perovskite technology to commercialization.",
    comment = "Suggested filename = {Stranks2015may Metal-halide Perovskites for Photovoltaic and Light-emitting Devices.pdf}, Source = {wxdoi2bib}",
    file = "Stranks2015may Metal-halide Perovskites for Photovoltaic and Light-emitting Devices.pdf:Stranks2015may Metal-halide Perovskites for Photovoltaic and Light-emitting Devices.pdf:PDF",
    journal = "Nature Nanotech.",
    keywords = "project > EFM, materials > semiconductor > perovskite. materials > semiconductor > perovskite > review",
    month = "may",
    owner = "jam99",
    timestamp = "2019.03.03",
    year = "2015"
}

