  file      = {Tao2016dec Cryo-EM Structure of the Open High-conductance Ca2+-activated K+ Channel.pdf:UNSORTED/Tao2016dec Cryo-EM Structure of the Open High-conductance Ca2+-activated K+ Channel.pdf:PDF},
  journal   = {Nature},
  keywords  = {project > MRFM, MRFM > competition, microscopy > cryo-electron, biology > protein > membrane, biology > protein > ion channel},
  month     = {dec},
  owner     = {jam99},
  timestamp = {2019.03.03},
  year      = {2016},
}

@Article{Tao2014apr,
  author    = {Tao, Y. and Boss, J. M. and Moores, B. A. and Degen, C. L.},
  title     = {Single-crystal Diamond Nanomechanical Resonators With Quality Factors Exceeding One Million},
  volume    = {5},
  doi       = {10.1038/ncomms4638},
  url       = {http://dx.doi.org/10.1038/ncomms4638},
  abstract  = {Diamond has gained a reputation as a uniquely versatile material, yet one that is intricate to grow and process. Resonating nanostructures made of single-crystal diamond are expected to possess excellent mechanical properties, including high-quality factors and low dissipation. Here we demonstrate batch fabrication and mechanical measurements of single-crystal diamond cantilevers with thickness down to 85 nm, thickness uniformity better than 20 nm and lateral dimensions up to 240 micrometer. Quality factors exceeding one million are found at room temperature, surpassing those of state-of-the-art single-crystal silicon cantilevers of similar dimensions by roughly an order of magnitude. The corresponding thermal force noise for the best cantilevers is 5E-19 N per root Hz at millikelvin temperatures. Single-crystal diamond could thus directly improve existing force and mass sensors by a simple substitution of resonator material. Presented methods are easily adapted for fabrication of nanoelectromechanical systems, optomechanical resonators or nanophotonic devices that may lead to new applications in classical and quantum science.},
  comment   = {Suggested filename = {Tao2014apr Single-crystal Diamond Nanomechanical Resonators With Quality Factors Exceeding One Million.pdf},
Source = {wxdoi2bib}},
  file      = {Tao2014apr Single-crystal Diamond Nanomechanical Resonators With Quality Factors Exceeding One Million.pdf:UNSORTED/Tao2014apr Single-crystal Diamond Nanomechanical Resonators With Quality Factors Exceeding One Million.pdf:PDF},
  journal   = {Nat Comms},
  keywords  = {MRFM > cantilever},
  month     = {apr},
  owner     = {jam99},
  timestamp = {2019.03.03},
  year      = {2014},
}

