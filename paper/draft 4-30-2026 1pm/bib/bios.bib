@Article{Swarnkar2016oct,
    author = "Swarnkar, A. and Marshall, A. R. and Sanehira, E. M. and Chernomordik, B. D. and Moore, D. T. and Christians, J. A. and Chakrabarti, T. and Luther, J. M.",
