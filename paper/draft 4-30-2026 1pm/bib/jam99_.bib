  file      = {Breguet1998nov Stick and slip actuators ~ Design, control, performances and applications 10.1109\:MHS.1998.745756 *.pdf:UNSORTED/Breguet1998nov Stick and slip actuators ~ Design, control, performances and applications 10.1109\:MHS.1998.745756 *.pdf:PDF},
