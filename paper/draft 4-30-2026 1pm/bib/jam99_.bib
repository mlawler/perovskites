@Article{Tsetseris2009apr,
  author    = {Tsetseris, L. and Pantelides, S. T.},
  title     = {Modification of the electronic properties of rubrene crystals by water and oxygen-related species},
  volume    = {10},
  number    = {2},
  pages     = {333 -- 340},
  issn      = {1566-1199},
  doi       = {10.1016/j.orgel.2008.12.009},
  url       = {http://dx.doi.org/10.1016/j.orgel.2008.12.009},
  abstract  = {The presence of impurities in organic semiconductors is an important limitation for the performance of related devices. Here, we investigate with density-functional theory calculations the effect of water and oxygen related species on the properties of the prototype system of rubrene, the current record-holder organic semiconductor in terms of carrier mobilities. We identify the most stable impurity structures, with species in either substitutional or interstitial configurations, and we analyze their complex role in changing the shape and profile of rubrene energy bands. In certain cases the impurities either give rise or help annihilate carrier traps, and we discuss the relevance of our findings for the optimizition of rubrene-based electronic systems. (C) 2008 Elsevier B.V. All rights reserved.},
  comment   = {Sugguested filename = Tsetseris2009apr Modification of the electronic properties of rubrene crystals by water and oxygen-related species 10.1016/j.orgel.2008.12.009 *.pdf},
  file      = {Tsetseris2009apr Modification of the electronic properties of rubrene crystals by water and oxygen-related species 10.1016\:j.orgel.2008.12.009 *.pdf:UNSORTED/Tsetseris2009apr Modification of the electronic properties of rubrene crystals by water and oxygen-related species 10.1016\:j.orgel.2008.12.009 *.pdf:PDF},
  journal   = {Org. Elec.},
  keywords  = {materials > PES > rubrene, charge trapping > mechanisms > H2O},
  month     = {apr},
  owner     = {jam99},
  timestamp = {2019.03.03},
  unique-id = {ISI:000264269600017},
  year      = {2009},
}

@Article{Tsetseris2008sep,
  author         = {Tsetseris, L. and Pantelides, S. T.},
  title          = {Large impurity effects in rubrene crystals: {F}irst-principles calculations},
  volume         = {78},
  number         = {11},
  pages          = {115205},
  issn           = {1098-0121},
  doi            = {10.1103/PhysRevB.78.115205},
  url            = {http://dx.doi.org/10.1103/PhysRevB.78.115205},
  abstract       = {Carrier mobilities of rubrene films are among the highest values reported for any organic semiconductor. Here, we probe with first-principles calculations the sensitivity of rubrene crystals on impurities. We find that isolated oxygen impurities create distinct peaks in the electronic density of states consistent with observations of defect levels in rubrene and that increased O content changes the position and shape of rubrene energy bands significantly. We also establish a dual role of hydrogen as individual H species and H impurity pairs create and annihilate deep carrier traps, respectively. The results are relevant to the performance and reliability of rubrene-based devices.},
  article-number = {115205},
  comment        = {Suggested filename = Tsetseris2008sep Large impurity effects in rubrene crystals ~ First-principles calculations 10.1103/PhysRevB.78.115205 *.pdf},
