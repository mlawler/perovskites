@Article{Yin2014feb,
  author    = {Yin, Wan-Jian and Shi, Tingting and Yan, Yanfapy},
  title     = {Unusual Defect Physics in {CH}$_{3}${NH}$_{3}${PbI}$_{3}$ Perovskite Solar Cell Absorber},
