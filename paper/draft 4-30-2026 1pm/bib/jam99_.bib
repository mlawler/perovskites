@Article{Vandewal2013nov,
  author    = {Vandewal, Koen and Albrecht, Steve and Hoke, Eric T. and Graham, Kenneth R. and Widmer, Johannes and Douglas, Jessica D. and Schubert, Marcel and Mateker, William R. and Bloking, Jason T. and Burkhard, George F. and Sellinger, Alan and Fr\'echet, Jean M. J. and Amassian, Aram and Riede, Moritz K. and McGehee, Michael D. and Neher, Dieter and Salleo, Alberto},
  title     = {Efficient Charge Generation by Relaxed Charge-transfer States at Organic Interfaces},
  volume    = {13},
  number    = {1},
  pages     = {63 -- 68},
  doi       = {10.1038/NMAT3807},
  url       = {http://dx.doi.org/10.1038/NMAT3807},
  abstract  = {Interfaces between organic electron-donating (D) and electron-accepting (A) materials have the ability to generate charge carriers on illumination. Efficient organic solar cells require a high yield for this process, combined with a minimum of energy losses. Here, we investigate the role of the lowest energy emissive interfacial charge-transfer state (CT1) in the charge generation process. We measure the quantum yield and the electric field dependence of charge generation on excitation of the charge-transfer (CT) state manifold via weakly allowed, low-energy optical transitions. For a wide range of photovoltaic devices based on polymer:fullerene, small-molecule:C60 and polymer:polymer blends, our study reveals that the internal quantum efficiency (IQE) is essentially independent of whether or not D, A or CT states with an energy higher than that of CT1 are excited. The best materials systems show an IQE higher than 90 percent without the need for excess electronic or vibrational energy.},
  comment   = {Suggested filename = {Vandewal2013nov Efficient Charge Generation by Relaxed Charge-transfer States at Organic Interfaces.pdf},
Source = {wxdoi2bib}},
  file      = {Vandewal2013nov Efficient Charge Generation by Relaxed Charge-transfer States at Organic Interfaces.pdf:Vandewal2013nov Efficient Charge Generation by Relaxed Charge-transfer States at Organic Interfaces.pdf:PDF},
  journal   = {Nat. Mater.},
  keywords  = {Devices > solar cell > PES > bulk heterojunction},
  month     = {nov},
  owner     = {jam99},
  timestamp = {2019.03.03},
  year      = {2013},
}

@Article{Vandewal2010mar,
  author    = {Vandewal, Koen and Tvingstedt, Kristofer and Gadisa, Abay and Ingan\"as, Olle and Manca, Jean V.},
  title     = {Relating the Open-circuit Voltage to Interface Molecular Properties of Donor:acceptor Bulk Heterojunction Solar Cells},
  volume    = {81},
  number    = {12},
  pages     = {125204},
  doi       = {10.1103/PhysRevB.81.125204},
  url       = {http://dx.doi.org/10.1103/PhysRevB.81.125204},
  abstract  = {The open-circuit voltage (V-oc) of polymer:fullerene bulk heterojunction solar cells is determined by the interfacial charge-transfer (CT) states between polymer and fullerene. Fourier-transform photocurrent spectroscopy and electroluminescence spectra of several polymer:fullerene blends are used to extract the relevant interfacial molecular parameters. An analytical expression linking these properties to V-oc is deduced and shown to be valid for photovoltaic devices comprising three commonly used conjugated polymers blended with the fullerene derivative {[}6,6]-phenyl-C61-butyric acid methyl ester (PCBM). V-oc is proportional to the energy of the CT states E-CT. The energetic loss q Delta V between E-CT and qV(oc) vanishes when approaching 0 K. It depends linearly on T and logarithmically on illumination intensity. Furthermore q Delta V can be reduced by decreasing the electronic coupling between polymer and fullerene or by reducing the nonradiative recombination rate. For the investigated devices we find a loss q Delta V of similar to 0.6 eV at room temperature and under solar illumination conditions, of which similar to 0.25 eV is due to radiative recombination via the CT state and similar to 0.35 eV is due to nonradiative recombination.},
  comment   = {Suggested filename = {Vandewal2010mar Relating the Open-circuit Voltage to Interface Molecular Properties of Donor ~ acceptor Bulk Heterojunction Solar Cells.pdf},
Source = {wxdoi2bib}},
  file      = {Vandewal2010mar Relating the Open-circuit Voltage to Interface Molecular Properties of Donor ~ acceptor Bulk Heterojunction Solar Cells.pdf:UNSORTED/Vandewal2010mar Relating the Open-circuit Voltage to Interface Molecular Properties of Donor ~ acceptor Bulk Heterojunction Solar Cells.pdf:PDF},
  journal   = {Phys. Rev. B},
  keywords  = {project > EFM, personnel > Dwyer, SPM > ultrafast, devices > solar cell > PES, devices > solar cell > PES > Voc, charge separation > Langevin recombination},
  month     = {mar},
  owner     = {jam99},
  timestamp = {2019.03.03},
  year      = {2010},
}

@Article{Vandewal2009nov,
  author    = {Vandewal, Koen and Tvingstedt, Kristofer and Gadisa, Abay and Inganas, Olle and Manca, Jean V.},
  title     = {On the origin of the open-circuit voltage of polymer-fullerene solar cells},
  volume    = {8},
  number    = {11},
  pages     = {904 -- 909},
  issn      = {1476-1122},
  doi       = {10.1038/NMAT2548},
  url       = {http://dx.doi.org/10.1038/NMAT2548},
  abstract  = {The increasing amount of research on solution-processable, organic donor-acceptor bulk heterojunction photovoltaic systems, based on blends of conjugated polymers and fullerenes has resulted in devices with an overall power-conversion efficiency of 6\%. For the best devices, absorbed photon-to-electron quantum efficiencies approaching 100\% have been shown. Besides the produced current, the overall efficiency depends critically on the generated photovoltage. Therefore, understanding and optimization of the open-circuit voltage (V-oc) of organic solar cells is of high importance. Here, we demonstrate that charge-transfer absorption and emission are shown to be related to each other and V-oc in accordance with the assumptions of the detailed balance and quasi-equilibrium theory. We underline the importance of the weak ground-state interaction between the polymer and the fullerene and we confirm that V-oc is determined by the formation of these states. Our work further suggests alternative pathways to improve V-oc of donor-acceptor devices.},
  comment   = {Suggested filename = Vandewal2009nov On the origin of the open-circuit voltage of polymer-fullerene solar cells 10.1038/NMAT2548 *.pdf

Cited = Maurano2010nov as "Other studies have considered alternative factors that can limit V_OC , including morphology [Liu2001dec], shunt resistance [Snaith2004sep], electric field dependent geminate recombination, [Koster2005mar], reverse saturation current [Potscavage2009nov], energetic disorder [Garcia-Belmonte2010mar] (note: also Garcia-Belmonte2010sep) and the presence of interfacial charge transfer states. [Vandewal2009nov](note: also Vandewal2010mar)"},
  file      = {Vandewal2009nov On the origin of the open-circuit voltage of polymer-fullerene solar cells 10.1038\:NMAT2548 *.pdf:UNSORTED/Vandewal2009nov On the origin of the open-circuit voltage of polymer-fullerene solar cells 10.1038\:NMAT2548 *.pdf:PDF},
  journal   = {Nat. Mater.},
