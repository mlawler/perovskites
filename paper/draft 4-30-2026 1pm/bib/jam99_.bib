@Article{Li2016nov,
  author    = {Li, Dong and Dong, Y. B. and Deng, Wei and Shi, Z. B. and Fu, B. Z. and Gao, J. M. and Wang, T. B. and Zhou, Yan and Liu, Yi and Yang, Q. W. and Duan, X. R.},
  title     = {Bayesian Tomography and Integrated Data Analysis in Fusion Diagnostics},
