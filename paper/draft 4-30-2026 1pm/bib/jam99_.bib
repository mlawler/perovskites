@Article{ODea2012jul,
  author    = {James R. {O'Dea} and Louisa M. Brown and Nikolas Hoepker and John A. Marohn and Sascha Sadewasser},
  title     = {Scanned Probe Microscopy of Solar Cells: {F}rom Inorganic Thin Films to Organic Photovoltaics},
  journal   = {Mater. Res. Soc. Bulletin},
  year      = {2012},
  volume    = {37},
  month     = {jul},
  pages     = {642 -- 650},
  doi       = {10.1557/mrs.2012.143},
  url       = {http://dx.doi.org/10.1557/mrs.2012.143},
  abstract  = {Scanned probe microscopy (SPM) has made significant contributions to our understanding of the sub-processes underlying photovoltaic action. Spatially resolved measurements of surface photovoltage and photocurrent have been particularly useful in understanding charge generation and separation. In thin-film inorganic solar cells, for example, Kelvin probe force microscopy has revealed that charge separation does not occur at a heterojunction as expected, but instead at a homojunction buried $\sim$50 nm within the absorbing layer. In organic photovoltaics, sub-micron maps of photocurrent have contributed to the field's understanding of the interplay between processing conditions, blend morphology, and device performance. Such \emph{functional imaging} distinguishes SPM from complimentary structural characterization techniques. Our goal in this review is to provide the materials science community with an appreciation for the capabilities, considerations, and limitations associated with SPM studies of solar cells materials and devices.d},
  comment   = {Suggested filename = O'Dea2012jul Scanned Probe Microscopy of Solar Cells ~ From Inorganic Thin Films to Organic Photovoltaics 10.1557/mrs.2012.143 *.pdf},
  file      = {O'Dea2012jul Scanned Probe Microscopy of Solar Cells ~ From Inorganic Thin Films to Organic Photovoltaics 10.1557\:mrs.2012.143 *.pdf:UNSORTED/O'Dea2012jul Scanned Probe Microscopy of Solar Cells ~ From Inorganic Thin Films to Organic Photovoltaics 10.1557\:mrs.2012.143 *.pdf:PDF},
  keywords  = {marohn-manuscript, grant-Abruna-DOE-DE-SC0001086, grant-Brown-NSF-NSF-DMR-1006633, grant-CNS-NSF-EEC-0117770, grant-CNS-NSF-EEC-0646547, grant-Marohn-NSF-DMR-1006633, SPM > PES > review},
