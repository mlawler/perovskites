  journal-iso = {J. Appl. Phys.},
  keywords    = {materials > magnetic > Fe2O3, MRFM > magnetometry > MFM, nanomagnetics > switching > coherent rotation, nanomagnetics > switching > curling},
  owner       = {jam99},
