@Article{Genack1975jul,
  author    = {Genack, A. Z. and Redfield, A. G.},
  title     = {Theory of Nuclear Spin Diffusion in a Spatially Varying Magnetic Field},
  journal   = {Phys. Rev. B},
  year      = {1975},
  volume    = {12},
  number    = {1},
  month     = {jul},
  pages     = {78 -- 87},
  doi       = {10.1103/PhysRevB.12.78},
  url       = {http://dx.doi.org/10.1103/PhysRevB.12.78},
  abstract  = {Spin diffusion driven by either a magnetization gradient or a field gradient is viewed as a flow of magnetization current. An expression for this current in a nonuniform field is derived. The magnetization current is the vehicle for a cross relaxation between the nuclear dipole-dipole energy and the spin energy of interaction with the inhomogeneous part of the magnetic field. From a measurement of the decay rate of dipole energy in the presence of large field gradients, which are present in type-II superconductors or at normal-superconductor interfaces, the spin-diffusion coefficient can be determined. Coupled differential equations describing magnetization and dipole energy densities are deduced and their solution is discussed.},
  comment   = {Suggested filename = {Genack1975jul Theory of Nuclear Spin Diffusion in a Spatially Varying Magnetic Field.pdf},
Source = {wxdoi2bib}},
  file      = {Genack1975jul Theory of Nuclear Spin Diffusion in a Spatially Varying Magnetic Field.pdf:UNSORTED/Genack1975jul Theory of Nuclear Spin Diffusion in a Spatially Varying Magnetic Field.pdf:PDF},
  keywords  = {MRFM > spin diffusion, magnetic resonance > spin diffusion},
  owner     = {jam99},
  timestamp = {2016.05.14},
}

@Article{Geraci2010aug,
  author    = {Geraci, Andrew A. and Papp, Scott B. and Kitching, John},
  title     = {Short-Range Force Detection Using Optically Cooled Levitated Microspheres},
  journal   = {Phys. Rev. Lett.},
  year      = {2010},
  volume    = {105},
  number    = {10},
  month     = {aug},
  pages     = {101101},
  doi       = {10.1103/PhysRevLett.105.101101},
  url       = {http://dx.doi.org/10.1103/PhysRevLett.105.101101},
  abstract  = {We propose an experiment using optically trapped and cooled dielectric micro-spheres for the detection of short-range forces. The center-of-mass motion of a microsphere trapped in vacuum can experience extremely low dissipation and quality factors of 1E12, leading to yoctonewton force sensitivity. Trapping the sphere in an optical field enables positioning at less than 1 micrometer from a surface, a regime where exotic new forces may exist. We expect that the proposed system could advance the search for non-Newtonian gravity forces via an enhanced sensitivity of 1E5 to 1E7 over current experiments at the 1 micrometer length scale. Moreover, our system may be useful for characterizing other short-range physics such as Casimir forces.},
  comment   = {Suggested filename = {Geraci2010aug Short-Range Force Detection Using Optically Cooled Levitated Microspheres.pdf}, Source = {wxdoi2bib}},
  file      = {Geraci2010aug Short-Range Force Detection Using Optically Cooled Levitated Microspheres.pdf:UNSORTED/Geraci2010aug Short-Range Force Detection Using Optically Cooled Levitated Microspheres.pdf:PDF},
  keywords  = {project > MRFM, surface dissipation > optical trap, surface dissipation > microsphere, MRFM > competition},
  owner     = {jam99},
  timestamp = {2014.09.09},
}

