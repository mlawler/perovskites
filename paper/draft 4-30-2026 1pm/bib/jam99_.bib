@Article{Haberkorn2011aug,
  author    = {Haberkorn, Niko and Kim, Sehee and Kim, Ki-Se and Sommer, Michael and Thelakkat, Mukudun and Sohn, Byeong-Hyeok and Theato, Patrick},
  title     = {Template-Assisted Fabrication of Highly Ordered Interpenetrating Polymeric Donor/Acceptor Nanostructures for Photovoltaic Applications},
  journal   = {Macromolecular Chemistry and Physics},
