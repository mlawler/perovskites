  keywords  = {magnetic resonance > ADRF},
  owner     = {jam99},
  timestamp = {2015.12.05},
}

@Article{Rambo2013mar,
  author    = {Rambo, Robert P. and Tainer, John A.},
  title     = {Accurate assessment of mass, models, and resolution bu small-angle scattering},
  journal   = {submitted},
  year      = {2013},
  month     = {mar},
  abstract  = {Achieving reliable, high-throughput structural characterizations of biological macromolecular complexes is a major challenge in the modern structural-genomics era1. In principle, small-angle scattering (SAS) with X-rays (SAXS) or neutrons (SANS) can meet this challenge by efficiently providing information that fully describes the structural state of a macromolecule in solution2-4. SAS can determine a scattering particles radius-ofgyration (Rg), volume (Vp), surface-to-volume ratio and correlation length (lc) with the latter three physical parameters dependent on the Porod invariant5, Q, an empirical SAS value defined for compact folded particles. However, SAS is uniquely capable of providing structural information on particles with flexibility such as intrinsically unstructured proteins6,7. Here, we define the volume-of-correlation, Vc: a SAS invariant derived from the information contained within the scattered intensities, I(q), that is specific to the structural state of the particle, yet independent of concentration and the requirements of a compact, folded particle. We show that, in combination with Rg, Vc defines a ratio, QR, that determines the molecular mass of proteins or RNA ranging from 10 to 1,000 kDa. Furthermore, we propose a method for the unbiased and accurate assessment of modeldata agreements (2free) that is statistically robust, akin to cross-validation and leasttrimmed squares methods8. Our approach prevents over-fitting of the SAS data and can be used with a newly defined statistical measure, RSAS, for quantitative evaluation of resolution. Together, these quantitative metrics (Vc, QR, 2free, and RSAS) provide powerful analytical tools for accurate macromolecular structural investigations in solution.},
  comment   = {Suggested filename = Rambo2013mar Accurate assessment of mass, models, and resolution bu small-angle scattering submitted.pdf},
  file      = {Rambo2013mar Accurate assessment of mass, models and resolution by small-angle scattering submitted.pdf:UNSORTED/Rambo2013mar Accurate assessment of mass, models and resolution by small-angle scattering submitted.pdf:PDF;Rambo2013mar Accurate assessment of mass, models and resolution by small-angle scattering submitted README.rtf:UNSORTED/Rambo2013mar Accurate assessment of mass, models and resolution by small-angle scattering submitted README.rtf:Rich Text Format},
  keywords  = {MFFM > competition, MRFM >, MRFM > imaging > image recontruction},
  owner     = {jam99},
  timestamp = {2013.03.25},
}

