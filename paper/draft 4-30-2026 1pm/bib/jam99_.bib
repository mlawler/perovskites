@Unpublished{Chen2013jan,
  Title                    = {Magnetic Resonance Force Microscopy Detected Long-Lived Spin Magnetization Signal by Electron Spin Saturation},
  Author                   = {Chen, L. and Longenecker, J. G. and Moore, E. W. and Marohn, J. A.},
  Note                     = {12th MMM-Intermag Conference; Chicago, Illinois; Jan 14 -- 18},

  Month                    = {jan},
  Year                     = {2013},

  Abstract                 = {The magnetic resonance force microscopy (MRFM) has been able to achieve nanometer resolution MRI. However, the measurements often require a long averaging time to achieve a good signal-to-noise ratio. Employing an enhancement technique such as dynamic nuclear polarization (DNP) could greatly speed up the detection process in MRFM. DNP has been demonstrat- ed in conventional nuclear magnetic resonance (NMR) to increase the polar- ization of nuclear spins by saturating the electron spin polarization in the sys- tem. Here, we detail a signal observed in an MRFM experiment that is much larger in amplitude and longer in relaxation time than our electron spin reso- nance (ESR) signal. A high-compliance cantilever with a 4 μm diameter magnetic tip was used to observe the spin polarization in real-time in perdeuterated polystyrene film doped with the nitroxide electron spin probe TEMPAMINE. In additional to the expected prompt cantilever frequen- cy shift due to saturation of the nitroxide’s electron-spin polarization, we also observed an associated large persistent cantilever frequency shift. This per- sistent signal shows the same field dependence as the ESR signal at low field. The persistent signal’s lifetime, field dependence, and size are consis- tent with spin polarization transferred to deuterons from electrons through cross-effect DNP.},
  Keywords                 = {marohn-talk-contributed, grant-NIH-5R01GM-070012},
  Owner                    = {jam99},
  Timestamp                = {2013.03.28}
}

@Article{Chen2013jul,
  author    = {Lei Chen and Jonilyn G. Longenecker and Eric W. Moore and John A. Marohn},
  title     = {Magnetic Resonance Force Microscopy Detected Long-Lived Spin Magnetization},
  journal   = {{IEEE} Trans. Magn.},
  year      = {2013},
  volume    = {49},
  number    = {7},
  month     = {jul},
  pages     = {3528 -- 3532},
  note      = {\href{http://www.ncbi.nlm.nih.gov/pmc/articles/PMC4474500}{[PMCID:PMC4474500]}},
  doi       = {10.1109/TMAG.2013.2239268},
  url       = {http://dx.doi.org/10.1109/TMAG.2013.2239268},
  abstract  = {Magnetic resonance force microscopy (MRFM), which combines magnetic resonance imaging with scanning probe microscopy together, is capable of performing ultra-sensitive detection of spin magnetization. In an attempt to observe dynamic nuclear polarization (DNP) in an MRFM experiment, which could possibly further improve its sensitivity towards a single proton spin, a film of perdeuterated polystyrene doped with a nitroxide electron-spin probe was prepared. A high-compliance cantilever with a 4-μm-diameter magnetic tip was brought near the film at a temperature of 7.3 K and in a background magnetic field of ~0.6 T. The film was irradiated with 16.7-GHz microwaves while the resulting transient change in cantilever frequency was recorded in real time. In addition to observing the expected prompt change in cantilever frequency due to saturation of the nitroxide's electron-spin magnetization, we observed a persistent cantilever frequency change. Based on its magnitude, lifetime, and field dependence, we tentatively attribute the persistent signal to polarized deuteron magnetization created via transfer of magnetization from electron spins. Further measurements of the persistent signal's dependence on the cantilever amplitude and tip-sample separation are presented and explained by the cross-effect DNP mechanism in high magnetic field gradients.},
  comment   = {Suggested filename = {Chen2013jul Magnetic Resonance Force Microscopy Detected Long-Lived Spin Magnetization.pdf}

A peer-reviewed conference proceedings paper associated with Lei's presentation at the 12th Joint MMM/Intermag Conference (Chicago, Illinois; January 14 -- 18, 2013).

