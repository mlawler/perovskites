  year      = {2012},
}

@Article{Jannasch2011nov,
  author    = {Jannasch, Anita and Mahamdeh, Mohammed and Sch\"affer, Erik},
  title     = {Inertial Effects of a Small Brownian Particle Cause a Colored Power Spectral Density of Thermal Noise},
  volume    = {107},
