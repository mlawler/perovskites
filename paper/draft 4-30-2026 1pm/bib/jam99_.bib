@Article{Duke2010oct,
  author    = {Duke, E. M. H. and Johnson, L. N.},
  title     = {Macromolecular Crystallography at Synchrotron Radiation Sources: {C}urrent Status and Future Developments},
  journal   = {Proc. Royal Soc. A},
  year      = {2010},
  volume    = {466},
  number    = {2124},
