}

@Article{Ziffer2018jul,
  author    = {Ziffer, Mark E. and Jo, Sae Byeok and Zhong, Hongliang and Ye, Long and Liu, Hongbin and Lin, Francis and Zhang, Jie and Li, Xiaosong and Ade, Harald W. and Jen, Alex K.-Y. and Ginger, David S.},
  title     = {Long-Lived, Non-Geminate, Radiative Recombination of Photogenerated Charges in a Polymer/Small-Molecule Acceptor Photovoltaic Blend},
  volume    = {140},
  number    = {31},
  pages     = {9996 -- 10008},
  doi       = {10.1021/jacs.8b05834},
  url       = {http://dx.doi.org/10.1021/jacs.8b05834},
  abstract  = {Minimization of open-circuit-voltage (V-OC) loss is required to transcend the efficiency limitations on the performance of organic photovoltaics (OPV). We study charge recombination in an OPV blend comprising a polymer donor with a small molecule nonfullerene acceptor that exhibits both high photovoltaic internal quantum efficiency and relatively high external electroluminescence quantum efficiency. Notably, this donor/acceptor blend, consisting of the donor polymer commonly referred to as PCE10 with a pseudoplanar small molecule acceptor (referred to as FIDTT-2PDI) exhibits relatively bright delayed photoluminescence on the microsecond time scale beyond that observed in the neat material. We study the photoluminescence decay kinetics of the blend in detail and conclude that this long-lived photoluminescence arises from radiative nongeminate recombination of charge carriers, which we propose occurs via a donor/acceptor CT state located close in energy to the singlet state of the polymer donor. Additionally, crystallographic and spectroscopic studies point toward low subgap disorder, which could be beneficial for low radiative and nonradiative losses. These results provide an important demonstration of photoluminescence due to nongeminate charge recombination in an efficient OPV blend, a key step in identifying new OPV materials and materials-screening criteria if OPV is to approach the theoretical limits to efficiency.},
  comment   = {Suggested filename = {Ziffer2018jul Long-Lived, Non-Geminate, Radiative Recombination of Photogenerated Charges in a Polymer/Small-Molecule Acceptor Photovoltaic Blend.pdf},
Source = {wxdoi2bib}},
  file      = {:Ziffer2018jul Long-Lived, Non-Geminate, Radiative Recombination of Photogenerated Charges in a Polymer\:Small-Molecule Acceptor Photovoltaic Blend.pdf:PDF},
  journal   = {J. Am. Chem. Soc.},
  keywords  = {project > EFM, personnel > Cohn},
  month     = {jul},
  owner     = {jam99},
  timestamp = {2019.03.03},
  year      = {2018},
}

