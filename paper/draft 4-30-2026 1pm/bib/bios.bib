    journal = "J. Phys. Chem. C",
    keywords = "project > EFM, materials > semiconductor > perovskite, collaborator > Moore, collaborator > Estroff",
    month = "jul",
    owner = "jam99",
    timestamp = "2019.03.03",
    year = "2014"
}

@Article{Senocrate2017jun,
    author = {Senocrate, Alessandro and Moudrakovski, Igor and Kim, Gee Yeong and Yang, Tae-Youl and Gregori, Giuliano and Gr\"atzel, Michael and Maier, Joachim},
    title = "The Nature of Ion Conduction in Methylammonium Lead Iodide: {A} Multimethod Approach",
    volume = "56",
    number = "27",
    pages = "7755 -- 7759",
    doi = "10.1002/anie.201701724",
    url = "http://dx.doi.org/10.1002/anie.201701724",
    abstract = "By applying a multitude of experimental techniques including H-1, N-14, Pb-207 NMR and I-127 NMR/NQR, tracer diffusion, reaction cell and doping experiments, as well as stoichiometric variation, conductivity, and polarization experiments, iodine ions are unambiguously shown to be the mobile species in CH3NH3PbI3, with iodine vacancies shown to represent the mechanistic centers under equilibrium conditions. Pb2+ and CH3NH3+ ions do not significantly contribute to the long range transport (upper limits for their contributions are given), whereby the latter exhibit substantial local motion. The decisive electronic contribution to the mixed conductivity in the experimental window stems from electron holes. As holes can be associated with iodine orbitals, local variations of the iodine stoichiometry may be fast and enable light effects on ion transport.",
    comment = "Suggested filename = {Senocrate2017jun The Nature of Ion Conduction in Methylammonium Lead Iodide \textasciitilde\ A Multimethod Approach.pdf}, Source = {wxdoi2bib}",
    file = "Senocrate2017jun The Nature of Ion Conduction in Methylammonium Lead Iodide \textasciitilde\ A Multimethod Approach.pdf:Senocrate2017jun The Nature of Ion Conduction in Methylammonium Lead Iodide \textasciitilde\ A Multimethod Approach.pdf:PDF",
    journal = "Angew. Chem. Int. Ed.",
    keywords = "project > EFM, personnel > Tirmzi, materials > semiconductor > perovskite, materials > semiconductor > perovskite > ion motion",
    month = "jun",
    owner = "jam99",
    timestamp = "2019.03.03",
