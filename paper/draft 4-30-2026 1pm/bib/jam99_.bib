@Article{Dang2013jan,
  author    = {Dang, Xiangnan and Qi, Jifa and Klug, Matthew T. and Chen, Po-Yen and Yun, Dong Soo and Fang, Nicholas X. and Hammond, Paula T. and Belcher, Angela M.},
  title     = {Tunable Localized Surface Plasmon-Enabled Broadband Light-Harvesting Enhancement for High-Efficiency Panchromatic Dye-Sensitized Solar Cells},
  journal   = {Nano Lett.},
  year      = {2013},
  month     = {jan},
  pages     = {130201175707002},
  doi       = {10.1021/nl3043823},
  url       = {http://dx.doi.org/10.1021/nl3043823},
  abstract  = {In photovoltaic devices, light harvesting (LH) and carrier collection have opposite relations with the thickness of the photoactive layer, which imposes a fundamental compromise for the power conversion efficiency (PCE). Unbalanced LH at different wavelengths further reduces the achievable PCE. Here, we report a novel approach to broadband balanced LH and panchromatic solar energy conversion using multiple-core--shell structured oxide-metal-oxide plasmonic nanoparticles. These nanoparticles feature tunable localized surface plasmon resonance frequencies and the required thermal stability during device fabrication. By simply blending the plasmonic nanoparticles with available photoactive materials, the broadband LH of practical photovoltaic devices can be significantly enhanced. We demonstrate a panchromatic dye-sensitized solar cell with an increased PCE from 8.3\% to 10.8\%, mainly through plasmon-enhanced photoabsorption in the otherwise less harvested region of solar spectrum. This general and simple strategy also highlights easy fabrication, and may benefit solar cells using other photoabsorbers or other types of solar-harvesting devices.},
  comment   = {Suggested filename = {Dang2013jan Tunable Localized Surface Plasmon-Enabled Broadband Light-Harvesting Enhancement for High-Efficiency Panchromatic Dye-Sensitized Solar Cells.pdf}},
  file      = {Dang2013jan Tunable Localized Surface Plasmon-Enabled Broadband Light-Harvesting Enhancement for High-Efficiency Panchromatic Dye-Sensitized Solar Cells.pdf:UNSORTED/Dang2013jan Tunable Localized Surface Plasmon-Enabled Broadband Light-Harvesting Enhancement for High-Efficiency Panchromatic Dye-Sensitized Solar Cells.pdf:PDF},
  keywords  = {devices > solar cell > DSSC, nanooptics > SPR},
  owner     = {jam99},
  timestamp = {2013.02.12},
}

@Article{Dang2010sep,
  author    = {Dang, Xuan-Dung and Mikhailovsky, Alexander and Nguyen, Thuc-Quyen},
  title     = {Measurement of Nanoscale External Quantum Efficiency of Conjugated Polymer:Fullerene Solar Cells by Photoconductive Atomic Force Microscopy},
  journal   = {Appl. Phys. Lett.},
  year      = {2010},
  volume    = {97},
  number    = {11},
  month     = {sep},
  pages     = {113303},
  doi       = {10.1063/1.3483613},
  url       = {http://dx.doi.org/10.1063/1.3483613},
  abstract  = {Photoconductive atomic force microscopy is used to investigate nanoscale incident photon-to-current efficiency spectra of polymer bulk heterojunction solar cells based on poly[2-methoxy-5-(3,7-dimethyloctyloxy)]-1,4-phenylenevinylene (MDMO-PPV) and [6,6]-phenyl-C71-butyric acid methyl ester (PC71BM). Nanoscale external quantum efficiency reveals the complex morphology of MDMO-PPV:PC71BM films cast from toluene solution. Not only electron transfer from the photoexcited donor to the fullerene but also hole transfer process from photoexcited fullerene to the donor phase due to highest occupied molecular orbital offset is observed. The difference in performance between toluene and chlorobenzene-cast devices is explained by the variation in relative contributions from two charge transfer mechanisms.},
  comment   = {Suggested filename = Dang2010sep Measurement of nanoscale external quantum efficiency of conjugated polymer~fullerene solar cells by photoconductive atomic force microscopy 10.1063/1.3483613 *.pdf},
  file      = {Dang2010sep Measurement of nanoscale external quantum efficiency of conjugated polymer~fullerene solar cells by photoconductive atomic force microscopy 10.1063\:1.3483613 *.pdf:UNSORTED/Dang2010sep Measurement of nanoscale external quantum efficiency of conjugated polymer~fullerene solar cells by photoconductive atomic force microscopy 10.1063\:1.3483613 *.pdf:PDF},
  owner     = {jam99},
  timestamp = {2012.08.03},
}

@Article{Dang2010oct,
  author    = {Dang, Xuan-Dung and Tamayo, Arnold B. and Seo, Junghwa and Hoven, Corey V. and Walker, Bright and Nguyen, Thuc-Quyen},
  title     = {Nanostructure and Optoelectronic Characterization of Small Molecule Bulk Heterojunction Solar Cells by Photoconductive Atomic Force Microscopy},
  journal   = {Adv. Funct. Mater.},
  year      = {2010},
  volume    = {20},
  number    = {19},
  month     = {oct},
  pages     = {3314 -- 3321},
  doi       = {10.1002/adfm.201090087},
  url       = {http://dx.doi.org/10.1002/adfm.201090087},
  abstract  = {Photoconductive atomic force microscopy is employed to study the nano­scale morphology and optoelectronic properties of bulk heterojunction solar cells based on small molecules containing a benzofuran substituted diketopyrrolopyrrole (DPP) core (3,6-bis(5-(benzofuran-2-yl)thiophen-2-yl)-2,5-bis(2-ethylhexyl)pyrrolo[3,4-c]pyrrole-1,4-dione, DPP(TBFu)2, and [6,6]–phenyl-C71-butyric acid methyl ester (PC71BM), which were recently reported to have power conversion efficiencies of 4.4%. Electron and hole collection networks are visualized for blends with different donor:acceptor ratios. Formation of nanostructures in the blends leads to a higher interfacial area for charge dissociation, while maintaining bicontinuous collection networks; conditions that lead to the high efficiency observed in the devices. An excellent agreement between nanoscale and bulk open-circuit voltage measurements is achieved by surface modification of the indium tin oxide (ITO) substrate by using aminopropyltrimethoxysilane. The local open-circuit voltage is linearly dependent on the cathode work function. These results demonstrate that photoconductive atomic force microscopy coupled with surface modification of ITO substrate can be used to study nanoscale optoelectronic phenomena of organic solar cells.},
  comment   = {Suggested filename = Dang2010oct Nanostructure and Optoelectronic Characterization of Small Molecule Bulk Heterojunction Solar Cells by Photoconductive Atomic Force Microscopy 10.1002/adfm.201090087 *.pdf},
  file      = {Dang2010oct Nanostructure and Optoelectronic Characterization of Small Molecule Bulk Heterojunction Solar Cells by Photoconductive Atomic Force Microscopy 10.1002\:adfm.201090087 *.pdf:UNSORTED/Dang2010oct Nanostructure and Optoelectronic Characterization of Small Molecule Bulk Heterojunction Solar Cells by Photoconductive Atomic Force Microscopy 10.1002\:adfm.201090087 *.pdf:PDF},
  keywords  = {SPM > PES},
  owner     = {jam99},
  timestamp = {2011.07.11},
}

@Article{Danhier2012jul,
  author    = {Danhier, Fabienne and Ansorena, Eduardo and Silva, Joana M. and Coco, R\'egis and Le Breton, Aude and Pr\'eat, V\'eronique},
  title     = {PLGA-based Nanoparticles: An Overview of Biomedical Applications},
  journal   = {J. Controlled Release},
  year      = {2012},
  volume    = {161},
  number    = {2},
  month     = {jul},
  pages     = {505 -- 522},
  doi       = {10.1016/j.jconrel.2012.01.043},
  url       = {http://dx.doi.org/10.1016/j.jconrel.2012.01.043},
  abstract  = {Poly(lactic-co-glycolic acid) (PLGA) is one of the most successfully developed biodegradable polymers. Among the different polymers developed to formulate polymeric nanoparticles, PLGA has attracted considerable attention due to its attractive properties: (i) biodegradability and biocompatibility, (ii) FDA and European Medicine Agency approval in drug delivery systems for parenteral administration, (iii) well described formulations and methods of production adapted to various types of drugs e.g. hydrophilic or hydrophobic small molecules or macromolecules, (iv) protection of drug from degradation, (v) possibility of sustained release, (vi) possibility to modify surface properties to provide stealthness and/or better interaction with biological materials and (vii) possibility to target nanoparticles to specific organs or cells. This review presents why PLGA has been chosen to design nanoparticles as drug delivery systems in various biomedical applications such as vaccination, cancer, inflammation and other diseases. This review focuses on the understanding of specific characteristics exploited by PLGA-based nanoparticles to target a specific organ or tissue or specific cells.},
  comment   = {Suggested filename = {Danhier2012jul PLGA-based Nanoparticles ~ An Overview of Biomedical Applications.pdf},
Source = {wxdoi2bib}},
  file      = {Danhier2012jul PLGA-based Nanoparticles ~ An Overview of Biomedical Applications.pdf:UNSORTED/Danhier2012jul PLGA-based Nanoparticles ~ An Overview of Biomedical Applications.pdf:PDF},
  keywords  = {project > MRFM, biology > protein delivery, biology > drug delivery },
  owner     = {jam99},
  timestamp = {2015.11.27},
}

@Article{Daniels2007jun,
  author    = {Daniels, Jonathan S. and Pourmand, Nader},
  title     = {Label-Free Impedance Biosensors: {O}pportunities and Challenges},
  journal   = {Electroanalysis},
  year      = {2007},
  volume    = {19},
  number    = {12},
  month     = {jun},
  pages     = {1239 -- 1257},
  doi       = {10.1002/elan.200603855},
  url       = {http://dx.doi.org/10.1002/elan.200603855},
  abstract  = {Impedance biosensors are a class of electrical biosensors that show promise for point-of-care and other applications due to low cost, ease of miniaturization, and label-free operation. Unlabeled DNA and protein targets can be detected by monitoring changes in surface impedance when a target molecule binds to an immobilized probe. The affinity capture step leads to challenges shared by all label-free affinity biosensors; these challenges are discussed along with others unique to impedance readout. Various possible mechanisms for impedance change upon target binding are discussed. We critically summarize accomplishments of past label-free impedance biosensors and identify areas for future research.},
  comment   = {Suggested filename = Daniels2007jun Label-Free Impedance Biosensors ~ Opportunities and Challenges 10.1002/elan.200603855 *.pdf'},
