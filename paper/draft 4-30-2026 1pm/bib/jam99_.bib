@Article{Ade2009apr,
  author    = {Ade, Harald and Stoll, Herman},
  title     = {Near-edge X-ray absorption fine-structure microscopy of organic and magnetic materials},
  journal   = {Nat. Mater.},
  year      = {2009},
  volume    = {8},
  number    = {4},
  month     = {apr},
  pages     = {281 -- 290},
  issn      = {1476-1122},
  doi       = {10.1038/nmat2399},
  url       = {http://dx.doi.org/10.1038/nmat2399},
  abstract  = {Many high-performance materials and novel devices consist of multiple components and are naturally or intentionally nanostructured for optimal properties and performance. To understand their structure-property relationships fully, quantitative compositional analysis at length scales below 100 nm is required, a need that is often uniquely addressed using soft X-ray microscopy. Similarly, the interaction of X-rays with magnetic materials provides unique element-specific contrast that allows the determination of magnetic properties in multi-element antiferromagnetic and ferromagnetic materials. Pump-probe-type experiments can even investigate magnetic domain dynamics. Here we review and exemplify the ability of soft X-ray microscopy to provide information that is otherwise inaccessible, and discuss a perspective on future developments.},
  comment   = {Suggesed filename = Ade2009apr Near-edge X-ray absorption fine-structure microscopy of organic and magnetic materials 10.1038/nmat2399 *.pdf

Comment; Lusia = "Ade2009 nature materials shows that minority component of F8BT in PFB-rich regions is significant, while minority component of PFB in F8BT-rich regions is small. This explains how electrons get trapped in PFB-rich regions, by falling in to the minority component. This explains why both regions fall in contact potential."},
  file      = {Ade2009apr Near-edge X-ray absorption fine-structure microscopy of organic and magnetic materials 10.1038\:nmat2399 *.pdf:UNSORTED/Ade2009apr Near-edge X-ray absorption fine-structure microscopy of organic and magnetic materials 10.1038\:nmat2399 *.pdf:PDF},
  owner     = {jam99},
  timestamp = {2011.06.06},
  unique-id = {ISI:000264501000018},
}

