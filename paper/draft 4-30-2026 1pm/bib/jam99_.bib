  month     = {mar},
  owner     = {jam99},
  timestamp = {2019.03.03},
  year      = {2015},
}

@Article{Subba-Rao2009nov,
  author    = {Subba-Rao, Venkatesh and Sudakar, Chandran and Esmacher, Jason and Pantea, Mircea and Naik, Ratna and Hoffmann, Peter M.},
