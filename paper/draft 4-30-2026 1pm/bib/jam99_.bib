  number    = {5},
  pages     = {432 -- 436},
  doi       = {10.1038/nnano.2015.339},
  url       = {http://dx.doi.org/10.1038/nnano.2015.339},
  abstract  = {In the research field of magnonics, it is envisaged that spin waves will be used as information carriers, promoting operation based on their wave properties. However, the field still faces major challenges. To become fully competitive, novel schemes for energy-efficient control of spin-wave propagation in two dimensions have to be realized on much smaller length scales than used before. In this Letter, we address these challenges with the experimental realization of a novel approach to guide spin waves in reconfigurable, nano-sized magnonic waveguides. For this purpose, we make use of two inherent characteristics of magnetism: the non-volatility of magnetic remanence states and the nanometre dimensions of domain walls formed within these magnetic configurations. We present the experimental observation and micromagnetic simulations of spin-wave propagation inside nano-sized domain walls and realize a first step towards a reconfigurable domain-wall-based magnonic nanocircuitry.},
  comment   = {Suggested filename = {Wagner2016feb Magnetic Domain Walls as Reconfigurable Spin-wave Nanochannels.pdf},
Source = {wxdoi2bib}},
