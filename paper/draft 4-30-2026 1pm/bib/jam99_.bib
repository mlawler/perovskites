@Article{Berman2005jan,
  author    = {Berman, G. P. and Borgonovi, F. and Gorshkov, V. N. and Tsifrinovich, V. I.},
  title     = {Modeling and Simulations of a Single-Spin Measurement Using {MRFM}},
  journal   = {IEEE Trans. Nanotechnology},
  year      = {2005},
  volume    = {4},
  number    = {1},
  month     = {jan},
  pages     = {14 -- 20},
  doi       = {10.1109/TNANO.2004.840143},
  url       = {http://dx.doi.org/10.1109/TNANO.2004.840143},
  abstract  = {We review the quantum theory of a single-spin magnetic resonance force microscopy (MRFM). We concentrate on the novel technique called oscillating cantilever-driven adiabatic reversals (OSCARs), which has been used for a single-spin detection. First we describe the quantum dynamics of the cantilever-spin system using simple estimates in the spirit of the mean field approximation. Then we present the results of our computer simulations of the Schrödinger equation for the wave function of the cantilever-spin system and of the master equation for the density matrix of the system. We demonstrate that the cantilever behaves like a quasi-classical measurement device which detects the spin projection along the effective magnetic field. We show that the OSCAR technique provides continuous monitoring of the single spin, which could be used to detect the mysterious quantum collapses of the wave function of the cantilever-spin system.},
  comment   = {Suggested filename = Berman2005jan Modeling and Simulations of a Single-Spin Measurement Using MRFM 10.1109/TNANO.2004.840143 *.pdf},
  file      = {Berman2005jan Modeling and Simulations of a Single-Spin Measurement Using MRFM 10.1109\:TNANO.2004.840143 *.pdf:UNSORTED/Berman2005jan Modeling and Simulations of a Single-Spin Measurement Using MRFM 10.1109\:TNANO.2004.840143 *.pdf:PDF},
  keywords  = {MRFM > theory > single spin},
  owner     = {jam99},
  timestamp = {2011.07.25},
}

