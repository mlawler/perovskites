@Article{Yamamoto2013dec,
  author    = {Yamamoto, Kazutoshi and Caporini, Marc A. and Im, Sangchoul and Waskell, Lucy and Ramamoorthy, Ayyalusamy},
  title     = {Shortening Spin--lattice Relaxation Using a Copper-chelated Lipid at Low-temperatures -- a Magic Angle Spinning Solid-state NMR Study on a Membrane-bound Protein},
  volume    = {237},
  pages     = {175 -- 181},
  doi       = {10.1016/j.jmr.2013.10.017},
  url       = {http://dx.doi.org/10.1016/j.jmr.2013.10.017},
  abstract  = {Inherent low sensitivity of NMR spectroscopy has been a major disadvantage, especially to study biomolecules like membrane proteins. Recent studies have successfully demonstrated the advantages of performing solid-state NMR experiments at very low and ultralow temperatures to enhance the sensitivity. However, the long spin-lattice relaxation time, T-1, at very low temperatures is a major limitation. To overcome this difficulty, we demonstrate the use of a copper-chelated lipid for magic angle spinning solid-state NMR measurements on cytochrome-b5 reconstituted in multilamellar vesicles. Our results on multilamellar vesicles containing as small as 0.5 mol\% of a copper-chelated lipid can significantly shorten T-1 of protons, which can be used to considerably reduce the data collection time or to enhance the signal-to-noise ratio. We also monitored the effect of slow cooling on the resolution and sensitivity of C-13 and N-15 signals from the protein and C-13 signals from lipids.},
  comment   = {Suggested filename = {Yamamoto2013dec Shortening Spin--lattice Relaxation Using a Copper-chelated Lipid at Low-temperatures -- a Magic Angle Spinning Solid-state NMR Study on a Membrane-bound Protein.pdf}, Source = {wxdoi2bib}},
