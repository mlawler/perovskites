@Article{Dougherty2000mar,
  author    = {Dougherty, W.M and Bruland, K.J and Chao, S.H and Garbini, J.L and Jensen, S.E and Sidles, J.A},
  title     = {The {B}loch Equations in High-Gradient {M}agnetic {R}esonance {F}orce {M}icroscopy: {T}heory and Experiment},
  journal   = {J. Magn. Reson.},
  year      = {2000},
  volume    = {143},
  number    = {1},
  month     = {mar},
  pages     = {106 -- 119},
  doi       = {10.1006/jmre.1999.1994},
  url       = {http://dx.doi.org/10.1006/jmre.1999.1994},
  abstract  = {We report theory and observations of paramagnetic resonance in a measured field gradient of 44,000 T per meter by the technique of magnetic resonance force microscopy (MRFM). Resonance was induced in a dilute solid solution of diphenylpicrylhydrazyl in polystyrene at 77 and 10 K by an amplitude-modulated microwave field. This modulated the force between resonant sample spins and a micrometer-scale SmCo magnetic tip on a force microscope cantilever. The force signals were typically of order 10 fN, and were detected above a thermal noise floor of 80 aN per root hertz at 10 K, equivalent to a magnetic moment noise of 200 $\mu_B$ per root hertz of bandwidth. Resonance saturation was readily observed. Starting with the Bloch equations, we derived simple analytic expressions for the predicted cantilever signal amplitudes and T1-dependent phase lags, valid at low microwave power levels. For power levels below saturation, the data were in good agreement with the Bloch equation predictions, while above saturation the measured force increased more slowly with power than predicted. Several ESR mechanisms which might lead to non-Bloch dynamics in the MRFM environment are reviewed. Spin-relaxation mechanisms are also reviewed. A detailed description of the experimental apparatus is offered.},
  comment   = {Suggested filename = Dougherty2000mar The Bloch Equations in High-Gradient Magnetic Resonance Force Microscopy ~ Theory and Experiment 10.1006/jmre.1999.1994 *.pdf'},
  file      = {Dougherty2000mar The Bloch Equations in High-Gradient Magnetic Resonance Force Microscopy ~ Theory and Experiment 10.1006\:jmre.1999.1994 *..pdf:UNSORTED/Dougherty2000mar The Bloch Equations in High-Gradient Magnetic Resonance Force Microscopy ~ Theory and Experiment 10.1006\:jmre.1999.1994 *..pdf:PDF},
  owner     = {jam99},
  timestamp = {2012.11.09},
}

@Article{Douheret2006jul,
  author         = {Douheret, Olivier and Lutsen, Laurence and Swinnen, Ann and Breselge, Martin and Vandewal, Koen and Goris, Ludwig and Manca, Jean},
  title          = {Nanoscale electrical characterization of organic photovoltaic blends by conductive atomic force microscopy},
