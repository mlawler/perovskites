    j9 = "APPL PHYS LETT",
    ji = "Appl. Phys. Lett.",
    keywords = "marohn-manuscript, MRFM > NMR, MRFM > force gradient, MRFM > magnet-on-tip >NMR",
    owner = "jam99",
    pg = "3",
