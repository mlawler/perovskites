@Article{O'Barr1996apr,
  author      = {O'Barr, R and Lederman, M and Schultz, S and Xu, WH and Scherer, A and Tonucci, RJ},
  title       = {Preparation and quantitative magnetic studies of single-domain nickel cylinders},
  journal     = {J. Appl. Phys.},
  year        = {1996},
  volume      = {79},
  number      = {8, Part 2A},
  month       = {apr},
  pages       = {5303 -- 5305},
  issn        = {0021-8979},
  doi         = {10.1063/1.361359},
  url         = {http://dx.doi.org/10.1063/1.361359},
  abstract    = {For a complete experimental and theoretical explanation of the magnetic processes in an interacting collection of submicron magnetic particles, a fundamental understanding of the magnetic properties of individual single-domain particles must first be achieved. We have prepared elongated Ni columns ranging in diameter from 0.15 to 1.0 mu m by electroplating into specially prepared Al2O3 and glass channeled pore membranes. We have also prepared controlled arrays of Ni columns using e-beam lithography, subsequently electroplating into the written patterns. Using transmission electron microscopy, we have characterized the shape, size, morphology, and crystal structure of the columns. Magnetic force microscopy has been used to determine the switching field H-s versus the applied field angle of the columns. Although the switching field data can be fit to the functional form for nucleation by curling in an infinite cylinder, the observed weak dependence of H-s on column diameter is inconsistent with that expected for curling, particularly for columns of diameter >0.3 mu m. (C) 1996 American Institute of Physics.},
  affiliation = {OBarr, R (Reprint Author), UNIV CALIF SAN DIEGO, DEPT PHYS, 9500 GILMAN DR, LA JOLLA, CA 92093 USA. UNIV CALIF SAN DIEGO, CTR MAGNET RECORDING RES, LA JOLLA, CA 92093 USA. CALTECH, DEPT ELECT ENGN, PASADENA, CA 91125 USA. USN, RES LABS, DIV OPT SCI, WASHINGTON, DC 20375 USA.},
  comment     = {Comment = Switching in single nickel cylinders observed by MFM. Diameter = 0.15 micron to 1 micron, lengths from 1.5 micron up to 10's of microns. Check out FIG 4 which shows switching for particle "\beta" having d = 150 nm and L = 1650 nm, almost identical to ours. The observed longitudinal switching field for this particle was ~20 to 30 mT. For the larger-diameter and longer particle "C", the longitudinal switching field is closer to ~10 mT. The transverse switchig field for their rods approaches ~0.150 mT. Cited = 48.

Suggested filename = O'Barr1996apr Preparation and quantitative magnetic studies of single-domain nickel cylinders 10.1063/1.361359 *.pdf},
  file        = {O'Barr1996apr Preparation and quantitative magnetic studies of single-domain nickel cylinders 10.1063\:1.361359 *.pdf:UNSORTED/O'Barr1996apr Preparation and quantitative magnetic studies of single-domain nickel cylinders 10.1063\:1.361359 *.pdf:PDF},
  journal-iso = {J. Appl. Phys.},
