@Article{Momeni2011mar,
  author    = {Momeni, Omeed and Afshari, Ehsan},
  title     = {High Power Terahertz and Millimeter-Wave Oscillator Design: {A} Systematic Approach},
  journal   = {IEEE J. Solid-State Circuits},
  year      = {2011},
  volume    = {46},
  number    = {3},
