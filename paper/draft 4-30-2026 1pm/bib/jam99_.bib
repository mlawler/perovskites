  title     = {Temperature-Dependent Bias Poling and Hysteresis in Planar Organo-Metal Halide Perovskite Photovoltaic Cells},
  volume    = {6},
  number    = {7},
  pages     = {1501994},
  doi       = {10.1002/aenm.201501994},
  url       = {http://dx.doi.org/10.1002/aenm.201501994},
  abstract  = {The efficiency of perovskite photovoltaic cells is greatly impacted by the anomalous hysteresis effect. It is found that by applying a forward bias prior to testing, device efficiency ([eta sub p]) can be significantly improved. This bias poling effect can be stabilized at temperatures [less than or equal to] 250 K. As a result, hysteresis free operation of a planar perovskite photovoltaic cell is achieved at 170 K with [eta sub p] of 19 [percent].},
