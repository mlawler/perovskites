@Unpublished{Marohn2002apr,
  Title                    = {Putting the Magnetic Resonance Force Microscope to Use},
  Author                   = {John A. Marohn},
  Note                     = {43rd Experimental Nuclear Magnetic Resonance Conference, Session on Next-Generation Theoretical and Experimental Methods; Pacific Grove, California; April 14 -- 19},

  Month                    = {apr},
  Year                     = {2002},

  Abstract                 = {Solid-state nuclear magnetic resonance is a well-established tool for probing chemical structure and dynamics in biological, electronic, magnetic, and superconducting materials. Disappointingly, conventional inductively detected NMR is too insensitive to image emerging nanoscale phenomena in such materials. Recently invented strategies for mechanically detecting magnetic resonance have generated considerable interest, as they do offer a generally applicable route to achieving the sensitivity required for nanoscale NMR. We are employing magnetic resonance force microscopy (MRFM) to answer fundamental and applied questions in nanoscale organic electronic devices, and will detail our associated efforts at significantly expanding the capabilities of MRFM, required to put the microscope to use to study working devices.

We have developed and tested a novel route to Fourier Transform (FT) image encoding that will increase MRFM imaging resolution by at least an order of magnitude, from the current micron scale down to the nanoscale. Using our recently developed scaling laws and numerical signal-to-noise simulations, we will show that MRFM can detect NMR from a single monolayero We will describe force microscopes under development that are optimized to detect monolayer NMR and perform FT-MRFM imaging at variable temperature. In order to improve sensitivity, we have fabricated silicon cantilevers, only 340 nm thick, exhibiting force sensitivity as good as a few tens of attoNewtons per root Hertz at low temperature - orders of magnitude more sensitive than the best commercially available cantilevers. We will describe efforts underway to append single nanoscale magnets to the tips of these cantilevers and characterize the magnets by our highly accurate variant of cantilever magnetometry.

We will report on recently-tested improvements in experimental protocol that allow application of such cantilevers in a scanned-probe MRFM operating at high magnetic field and cryogenic temperatures.},
  Keywords                 = {marohn-talk-invited},
  Owner                    = {jam99},
  Timestamp                = {2012.06.07},
  Url                      = {http://www.enc-conference.org/files/enc\%202002.pdf}
}

@Unpublished{Marohn2002jul,
  Title                    = {Ultrasensitive Detection of Nuclear Magnetic Resonance by Magnetic Resonance Force Microscopy},
  Author                   = {John A. Marohn},
  Note                     = {44th Rocky Mountain Conference on Analytical Chemistry; Denver, Colorado; July 28 -- August 1},

  Month                    = {jul},
  Year                     = {2002},

  Abstract                 = {Ultrasensitive Detection of NMR by Magnetic Resonance Force Microscopy. John A. Marohn, Cornell University, Department of Chemistry and Chemical Biology, Ithaca, NY 14853-1301; Sean Garner and Erik Muller, Cornell University, Department of Physics, Ithaca, NY 14853-1301; Neil Jenkins, Lauren DeFlores, Tina Ng, William Silveira, and Jim Kempf, Cornell University, Department of Chemistry and Chemical Biology, Ithaca, NY 14853-1301. 

Recently invented strategies for detecting magnetic resonance mechanically have generated considerable interest, as they do offer a generally applicable route to achieving the sensitivity required for nanoscale NMR. We are employing magnetic resonance force microscopy (MRFM) to answer fundamental and applied questions in organic electronic devices, and will detail our associated efforts at significantly expanding the capabilities of MRFM, required to put the microscope to use to study nanoscale phenomena in working devices. We have recently force detected ESR at low temperature and NMR at room temperature and high magnetic field using a homebuilt force microscope. We have invented and tested a novel route to Fourier Transform (FT) image encoding that will increase MRFM imaging resolution by at least an order of magnitude, from the current micron scale down to the nanoscale. Using our recently developed scaling laws and numerical signal-to-noise simulations, we will show that MRFM can detect NMR from a single small-area monolayer. We will describe force microscopes under development that are optimized to detect monolayer NMR and perform FT-MRFM imaging at variable temperature. In order to improve sensitivity, we have fabricated silicon cantilevers, only 340 nm thick, exhibiting force sensitivity as good as a few tens of attoNewtons per root Hertz at low temperature – orders of magnitude more sensitive than the best commercially available cantilevers. We will describe efforts underway to append single nanoscale magnets to the tips of these cantilevers and characterize the magnets by our highly accurate variant of cantilever magnetometry. We will report on recently-tested improvements in experimental protocol that allow application of such cantilevers in a scanned-probe MRFM operating at high magnetic field and cryogenic temperatures. Supported by Cornell University, the National Science Foundation (DMR-0134956, EEC-0117770, and ECS-9731293), and the Army Research Office.

NMR Symposia (new detection methods – Yue Wu chair)
Oral Session
John Marohn, Cornell University, Department of Chemistry and Chemical Biology, 150 Baker Laboratory, Ithaca, NY 14853-1301, phone 607-255-2004, fax 607-255-4137, jam99@cornell.edu},
  Keywords                 = {marohn-talk-invited},
  Owner                    = {jam99},
  Timestamp                = {2012.06.07},
  Url                      = {http://web.archive.org/web/20031223194547/http://www.milestoneshows.com/rmcac02/RMCAC_NMR_Schedule.htm}
}

@Unpublished{Marohn2002mar,
  Title                    = {Putting Magnetic Resonance Force Microscopy to Use to Study Organic Electronic Materials},
  Author                   = {John A. Marohn},
  Note                     = {March Meeting of the American Physical Society, Division of Condensed Matter Physics Session on Applications of Ultra-high Sensitivity NMR; Indianapolis, Indiana; March 18 -- 22},

  Month                    = {mar},
  Year                     = {2002},

  Abstract                 = {``All-organic'' electronics (circuits built around semiconducting organic molecules, oligomers, and polymers) promise mass-produced economical electronic devices that can be fabricated under ambient conditions. Efforts at commercializing organic transistors suggest that new tools are sorely needed for imaging subsurface charge traps and characterizing chemical morphology and electronics at the buried organic/dielectric interface.

We will show that it is feasible to employ the emerging ultrasensitive technique of magnetic resonance force microscopy (MRFM) to study thin-film electronic organic materials by nuclear magnetic resonance (NMR). Detailed numerical simulations show that it will soon be possible to use MRFM to detect NMR from a single monolayer. We will describe a powerful new method for phase-encoding images in MRFM. Numerical simulations and proof-of-principle conventional NMR experiments suggest that nanoscale resolution is achievable. Magnetic resonance force microscopes are being developed in our laboratory that are optimized for both multiple-pulse NMR of monolayers and Fourier-transform MRFM imaging of films at 9 Tesla, from 4-300 K. Custom-fabricated ultrafloppy, 340 nm-thick, silicon cantilevers are used to significantly improve sensitivity. We will detail ongoing work towards using NMR-MRFM to study organic electronic devices, and will show images of devices recorded with related homebuilt low-temperature atomic force and electric force microscopes.},
  Keywords                 = {marohn-talk-invited},
  Owner                    = {jam99},
  Timestamp                = {2012.06.07},
  Url                      = {http://flux.aps.org/meetings/YR02/MAR02/baps/abs/S7650003.html}
}

