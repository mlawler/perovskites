  abstract = {Heat capacities of CH3NH3PbX3 (X = Cl, Br, I) were measured between 13 and 300 K (365 K for the iodide). Two anomalies were found in the chloride and the iodide, and three in the bromide. All the phase transitions were of the first order, although the highest temperature transitions in the bromide and the iodide were close to second order. Their temperatures and entropies are as follows: CH3NH3PbCl3: 171.5 K (14.6 J K-1mol-1), 177.2 K (10.0 J K-1mol-1); CH3NH3PbBr3: 148.8 K(11.2 JK-1mol-1), 154.0K(4.1 J K-1mol-1), 236.3 K (8.2 J K-1mol-1); CH3NH3PbI3: 161.4 K (19.0 J K-1mol-1), 330.4 K (9.7 J K-1mol-1). The transition entropies indicated that the phase transitions are of the order-disorder type. They are interpreted with three possible models involving the methylammonium ions disordered with respect to the orientation of the C-N axis itself and around the C-N axis. The infrared line width of the v12 vibration of the methylammonium ion depended markedly on the temperature and was interpreted as caused by the hindered rotational motion in the cubic and tetragonal phases.},
  langid = {english},
  keywords = {heat capacity,infrared line broadening,lead-halide perovskite > heat capacity,methylammonium trihalogenoplumbate (II),orientation disorder,Phase transition,transition entropy},
  file = {/Users/jam99/Zotero/storage/46RMI8TB/Onoda-Yamamuro et al_1990_Calorimetric and IR spectroscopic studies of phase transitions in.pdf;/Users/jam99/Zotero/storage/X8S68SJ8/0022369790900217.html}
}

@article{Ortiz-Cervantes2019jan,
  title = {Two-Dimensional Halide Perovskites in Solar Cells: {2D} or not {2D}?},
  shorttitle = {Two-Dimensional Halide Perovskites in Solar Cells},
  author = {Ortiz‐Cervantes, Carmen and Carmona‐Monroy, Paulina and Solis‐Ibarra, Diego},
  year = 2019,
  month = jan,
