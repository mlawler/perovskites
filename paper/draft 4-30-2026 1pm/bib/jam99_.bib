@Article{Schirhagl2014apr,
  author    = {Schirhagl, Romana and Chang, Kevin and Loretz, Michael and Degen, Christian L.},
  title     = {Nitrogen-Vacancy Centers in Diamond: Nanoscale Sensors for Physics and Biology},
  volume    = {65},
