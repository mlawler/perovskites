@Article{Puls2007aug,
  author    = {Stefan Peter Puls and Hellmut Eckert},
  title     = {Spatial distribution of lithium ions in glasses studied by $^7$Li{$^6$Li} spin echo double resonance},
  journal   = {Phys. Chem. Chem. Phys.},
  year      = {2007},
  volume    = {9},
  month     = {aug},
  pages     = {3992 -- 3998},
  doi       = {10.1039/b705338j},
  url       = {http://dx.doi.org/10.1039/b705338j},
  abstract  = {This manuscript introduces 7Li{6Li} spin echo double resonance (SEDOR) spectroscopy as a novel approach for studying the spatial distribution of lithium ions in solid electrolytes. Theoretical simulations using density operator theory as well as experimental validation on the model compound lithium carbonate reveal that this method affords a selective measurement of 7Li-6Li heteronuclear dipole?dipole couplings. Dipolar second moments characterizing internuclear lithium-lithium interactions have been measured in lithium silicate (Li2O)x(SiO2)1-x, (0.1 </= x </= 0.4) and lithium borate (Li2O)x(B2O3)1-x, (0.1 </= x </= 0.3) glasses. The results indicate that the spatial distributions of the lithium ions in these two glass systems are decidedly different. In the lithium silicate glass system, the results give clear evidence of strong cation clustering for x </= 0.3, providing quantitative support for a previously proposed model of a one-dimensional channel structure. In contrast, in the lithium borate glass system, the cations seem to be more or less randomly distributed. Nevertheless, an observed superlinear dependence of M2(7Li-6Li) as a function of ion concentration indicates subtle changes of the lithium arrangement principles, which are discussed in relation to the previously proposed ring structure of borate glasses.},
  comment   = {suggested filename = Puls2007jun Spatial distribution of lithium ions in glasses studied by 7Li-6Li- spin echo double resonance 10.1039/b705338j *.pdf},
  file      = {Puls2007jun Spatial distribution of lithium ions in glasses studied by 7Li-6Li- spin echo double resonance.pdf:Puls2007jun Spatial distribution of lithium ions in glasses studied by 7Li-6Li- spin echo double resonance.pdf:PDF},
  keywords  = {magnetic resonance > double res, magnetic resonance > double res > SEDOR},
  owner     = {Jonilyn},
  timestamp = {2010.10.11},
}

