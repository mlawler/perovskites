@Article{Christians2018jan,
  author    = {Christians, Jeffrey A. and Schulz, Philip and Tinkham, Jonathan S. and Schloemer, Tracy H. and Harvey, Steven P. and Tremolet de Villers, Bertrand J. and Sellinger, Alan and Berry, Joseph J. and Luther, Joseph M.},
  title     = {Tailored Interfaces of Unencapsulated Perovskite Solar Cells for $>1,000$ Hour Operational Stability},
  volume    = {3},
  number    = {1},
  pages     = {68 -- 74},
  doi       = {10.1038/s41560-017-0067-y},
  url       = {http://dx.doi.org/10.1038/s41560-017-0067-y},
  abstract  = {Long-term device stability is the most pressing issue that impedes perovskite solar cell commercialization, given the achieved 22.7 [percent] efficiency. The perovskite absorber material itself has been heavily scrutinized for being prone to degradation by water, oxygen and ultraviolet light. To date, most reports characterize device stability in the absence of these extrinsic factors. Here we show that, even under the combined stresses of light (including ultraviolet light), oxygen and moisture, perovskite solar cells can retain 94 [percent] of peak efficiency despite 1,000 hours of continuous unencapsulated operation in ambient air conditions (relative humidity of 10-20 [percent]). Each interface and contact layer throughout the device stack plays an important role in the overall stability which, when appropriately modified, yields devices in which both the initial rapid decay (often termed burn-in) and the gradual slower decay are suppressed. This extensively modified device architecture and the understanding developed will lead towards durable long-term device performance.},
  comment   = {Suggested filename = {Christians2018jan Tailored Interfaces of Unencapsulated Perovskite Solar Cells for >1,000 Hour Operational Stability.pdf},
Source = {wxdoi2bib}},
  file      = {Christians2018jan Tailored Interfaces of Unencapsulated Perovskite Solar Cells for >1,000 Hour Operational Stability.pdf:Christians2018jan Tailored Interfaces of Unencapsulated Perovskite Solar Cells for >1,000 Hour Operational Stability.pdf:PDF},
  journal   = {Nat. Energy},
  keywords  = {project > EFM, personnel > Tirmzi, collaborator > NREL, materials > semiconductor > perovskite, materials > semiconductor > perovskite > contacts, materials > semiconductor > perovskite > contacts},
  month     = {jan},
  owner     = {jam99},
  timestamp = {2019.03.03},
  year      = {2018},
}

@Article{Dou2017sep,
  author    = {Dou, Benjia and Miller, Elisa M. and Christians, Jeffrey A. and Sanehira, Erin M. and Klein, Talysa R. and Barnes, Frank S. and Shaheen, Sean E. and Garner, Sean M. and Ghosh, Shuvaraj and Mallick, Arindam and Basak, Durga and van Hest, Maikel F. A. M.},
  title     = {High-Performance Flexible Perovskite Solar Cells on Ultrathin Glass: {I}mplications of the {TCO}},
  volume    = {8},
  number    = {19},
  pages     = {4960 -- 4966},
  doi       = {10.1021/acs.jpclett.7b02128},
  url       = {http://dx.doi.org/10.1021/acs.jpclett.7b02128},
  abstract  = {For halide perovskite solar cells (PSCs) to fulfill their vast potential for combining low-cost, high efficiency, and high throughput production they must be scaled using a truly transformative method, such as roll-to-roll processing. Bringing this reality closer to fruition, the present work demonstrates flexible perovskite solar cells with 18.1 [percent] power conversion efficiency on flexible Willow Glass substrates. We highlight the importance of the transparent conductive oxide (TCO) layers on device performance by studying various TCOs. While tin-doped indium oxide (ITO) and indium zinc oxide (IZO) based PSC devices demonstrate high photovoltaic performances, aluminum-doped zinc oxide (AZO) based devices underperformed in all device parameters. Analysis of X-ray photoemission spectroscopy data shows that the stoichiometry of the perovskite film surface changes dramatically when it is fabricated on AZO, demonstrating the importance of the substrate in perovskite film formation.},
  comment   = {Suggested filename = {Dou2017sep High-Performance Flexible Perovskite Solar Cells on Ultrathin Glass ~ Implications of the TCO.pdf},
Source = {wxdoi2bib}},
  file      = {Dou2017sep High-Performance Flexible Perovskite Solar Cells on Ultrathin Glass ~ Implications of the TCO.pdf:Dou2017sep High-Performance Flexible Perovskite Solar Cells on Ultrathin Glass ~ Implications of the TCO.pdf:PDF},
  journal   = {J. Phys. Chem. Lett.},
  keywords  = {project > EFM, personnel > Tirmzi, collaborator > NREL, materials > semiconductor > perovskite, materials > semiconductor > perovskite > contacts},
  month     = {sep},
  owner     = {jam99},
  timestamp = {2019.03.03},
