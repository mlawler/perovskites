@Article{Shao2014oct,
  author    = {Shao, Guozheng and Glaz, Micah S. and Ma, Fei and Ju, Huanxin and Ginger, David S.},
  title     = {Intensity-Modulated Scanning Kelvin Probe Microscopy for Probing Recombination in Organic Photovoltaics},
  volume    = {8},
  number    = {10},
  pages     = {10799 -- 10807},
  doi       = {10.1021/nn5045867},
  url       = {http://dx.doi.org/10.1021/nn5045867},
  abstract  = {We study surface photovoltage decays on sub-millisecond time scales in organic solar cells using intensity-modulated scanning Kelvin probe microscopy (SKPM). Using polymer/fullerene (poly[N-9primeprime-heptadecanyl-2,7-carbazole-alt-5,5-(4prime,74prime-di-2-thienyl-24prime,14prime,34prime-benzothiadiazole)]/[6,6]-phenyl C71-butyric acid methyl ester, PCDTBT/PC71BM) bulk heterojunction devices as a test case, we show that the decay lifetimes measured by SKPM depend on the intensity of the background illumination. We propose that this intensity dependence is related to the well-known carrier-density-dependent recombination kinetics in organic bulk heterojunction materials. We perform transient photovoltage (TPV) and charge extraction (CE) measurements on the PCDTBT/PC71BM blends to extract the carrier-density dependence of the recombination lifetime in our samples, and we find that the device TPV and CE data are in good agreement with the intensity and frequency dependence observed via SKPM. Finally, we demonstrate the capability of intensity-modulated SKPM to probe local recombination rates due to buried interfaces in organic photovoltaics (OPVs). We measure the differences in photovoltage decay lifetimes over regions of an OPV cell fabricated on an indium tin oxide electrode patterned with two different phosphonic acid monolayers known to affect carrier lifetime.},
  comment   = {Suggested filename = {Shao2014oct Intensity-Modulated Scanning Kelvin Probe Microscopy for Probing Recombination in Organic Photovoltaics.pdf},
Source = {wxdoi2bib}},
  file      = {Shao2014oct Intensity-Modulated Scanning Kelvin Probe Microscopy for Probing Recombination in Organic Photovoltaics.pdf:UNSORTED/Shao2014oct Intensity-Modulated Scanning Kelvin Probe Microscopy for Probing Recombination in Organic Photovoltaics.pdf:PDF},
  journal   = {ACS Nano},
  keywords  = {SPM > SKPM, devices > solar cell > PES > bulk heterojunction, charge separation > measurements > EFM},
  month     = {oct},
  owner     = {jam99},
  timestamp = {2019.03.03},
  year      = {2014},
}

