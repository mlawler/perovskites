  file      = {Coffey2012apr An Optimal Driving Force for Converting Excitons Into Free Carriers in Excitonic Solar Cells.pdf:UNSORTED/Coffey2012apr An Optimal Driving Force for Converting Excitons Into Free Carriers in Excitonic Solar Cells.pdf:PDF},
  owner     = {jam99},
  timestamp = {2015.10.14},
}

