  keywords    = {nanomagnetics, nanomagnetics > theory, nanomagnetics > review, nanomagnetics > switching > coherent rotation, nanomagnetics > switching > curling, nanomagnetics > switching > pinning, nanomagnetics > switching > nucleation, nanomagnetics > switching > review},
  owner       = {jam99},
  timestamp   = {2010.05.28},
  unique-id   = {ISI:A1986D843100047},
}

@Article{Aharoni1958mar,
  author    = {Aharoni, A. and Shtrikman. S.},
  title     = {Magnetization Curve of the Infinite Cylinder},
  journal   = {Phys. Rev.},
  year      = {1958},
  volume    = {109},
  number    = {5},
  month     = {mar},
  pages     = {1522 -- 1528},
  issn      = {0031-899X},
  doi       = {10.1103/PhysRev.109.1522},
  url       = {http://dx.doi.org/10.1103/PhysRev.109.1522},
  abstract  = {The nucleation field for an infinite circular ferromagnetic cylinder, with the field applied along its axis, is rigorously calculated by exploring the whole eigenvalue spectrum of Brown's equations. The nucleation fields for cylinders with "large" radii are found to be those of the magnetization curling. For "small" radii the nucleation field is found to be somewhat smaller than that for the magnetization buckling. However, the difference is only about 1%, and the exact mode of reversal is very close to the buckling. The transition from exact buckling to curling is abrupt. These two modes are shown to be the only modes for nucleation for any radius, the other modes giving higher nucleation fields.
It is shown that the magnetization reversal occurs in one jump, which means that the magnetization curve for the cylinder is a rectangular loop.},
  comment   = {Suggested filename = Aharoni1958mar Magnetization Curve of the Infinite Cylinder 10.1103/PhysRev.109.1522 *.pdf},
  file      = {Aharoni1958mar Magnetization Curve of the Infinite Cylinder 10.1103\:PhysRev.109.1522 *.pdf:UNSORTED/Aharoni1958mar Magnetization Curve of the Infinite Cylinder 10.1103\:PhysRev.109.1522 *.pdf:PDF},
  keywords  = {nanomagnetics, nanomagnetics > theory, nanomagnetics > switching > curling},
  owner     = {jam99},
  timestamp = {2010.05.28},
  unique-id = {ISI:A1958WB74200017},
}

@Article{Ahme2014feb,
  author    = {Ahme, Helene and Lee, Myounghee and Im, Chan and W\"urfel, Uli},
  title     = {Influence of the Acceptor on Electrical Performance and Charge Carrier Transport in Bulk Heterojunction Solar Cells With {HXS}-1},
  journal   = {J. Phys. Chem. C},
  year      = {2014},
  volume    = {118},
  number    = {7},
  month     = {feb},
  pages     = {3386 -- 3392},
  doi       = {10.1021/jp408705r},
  url       = {http://dx.doi.org/10.1021/jp408705r},
  abstract  = {Enhancing the open-circuit voltage (VOC) is one way to increase the efficiency of organic solar cells. In cells with the polymer poly(2-(5-(5,6-bis(octyloxy)-4-(thiophen-2-yl)benzo[c][1,2,5]thiadiazol-7-yl)thiophen-2-yl)-9-octyl-9H-carbazole) (HXS-1) this can be achieved by replacing the acceptor [6,6]-phenyl-C71 butyric acid methyl ester (PC71BM) with indene-C60-bis-adduct (ICBA). The lowest unoccupied molecular orbital (LUMO) of ICBA is located at a higher energy, which leads to an increase of VOC from 0.86 to 1.05 V. However, the short-circuit current density (JSC) and fill factor (FF) are significantly lower in HXS-1:ICBA cells when compared with HXS-1:PC71BM cells, and thus the overall efficiency drops from almost 5\% to 2.5\%. Despite the smaller LUMO--LUMO offset between HXS-1 and ICBA, strong photoluminescence quenching as well as transient absorption studies indicate efficient and fast exciton dissociation in cells with either fullerene. The slope of the current--voltage characteristics of HXS-1:ICBA cells at short-circuit conditions and the lower dark current in forward direction suggest poor charge carrier transport. These findings were reproduced by a reduction of the electron mobility in electrical simulations. Furthermore, results from Suns-VOC measurements reveal a dramatically increased transport resistance in cells with ICBA when compared with devices using PC71BM. The observed effects could at least be partially due to a finer morphology in the HXS-1:ICBA layer, which is supported by AFM images.},
  comment   = {Suggested filename = {Ahme2014feb Influence of the Acceptor on Electrical Performance and Charge Carrier Transport in Bulk Heterojunction Solar Cells With HXS-1.pdf}, Source = {wxdoi2bib}},
  keywords  = {project > EFM},
  owner     = {jam99},
  timestamp = {2014.04.23},
}

