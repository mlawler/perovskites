@article{Montanarella2023jan,
  title = {Growth and {{Self-Assembly}} of {{CsPbBr}}{\textsubscript{3}} {{Nanocrystals}} in the {{TOPO}}/{{PbBr}}{\textsubscript{2}} {{Synthesis}} as {{Seen}} with {{X-ray Scattering}}},
