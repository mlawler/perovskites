@Article{Vasyukov2013sep,
  author    = {Vasyukov, Denis and Anahory, Yonathan and Embon, Lior and Halbertal, Dorri and Cuppens, Jo and Neeman, Lior and Finkler, Amit and Segev, Yehonathan and Myasoedov, Yuri and Rappaport, Michael L. and Huber, Martin E. and Zeldov, Eli},
  title     = {A Scanning Superconducting Quantum Interference Device With Single Electron Spin Sensitivity},
  volume    = {8},
