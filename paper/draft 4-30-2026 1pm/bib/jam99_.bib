  journal-iso   = {Nano Lett.},
  keywords      = {charge transport > measurements > current > thermopower, SPM > STM > variable temperature},
  keywords-plus = {SELF-ASSEMBLED MONOLAYERS; METAL WORK FUNCTION; JUNCTIONS; CONDUCTANCE; RESISTANCE; THERMOELECTRICITY; TRANSPORT; CIRCUITS; SAMS},
