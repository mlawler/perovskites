@Article{Lee1971apr,
  author    = {Lee, C. and Yahia, J. and Brebner, J. L.},
  title     = {Electronic Conduction in Slightly Reduced Strontium Titanate at Low Temperatures},
  journal   = {Phys. Rev. B},
  year      = {1971},
  volume    = {3},
  number    = {8},
  month     = {apr},
  pages     = {2525 -- 2533},
  doi       = {10.1103/PhysRevB.3.2525},
  url       = {http://dx.doi.org/10.1103/PhysRevB.3.2525},
  abstract  = {The electronic transport properties of slightly reduced pure strontium titanate have been studied at low temperatures between 2 and 300 °K. The temperature dependence of resistivity, Hall coefficient, and Hall mobility showed different features from previous results for doped and reduced crystals with higher carrier concentrations. Specifically, the mobility at liquid-helium temperatures is small (5-700 cm2/V sec) and increases with carrier concentration. Optical-absorption measurements showed the existence of several compensating acceptor levels and that the dominant mechanism of electron scattering was by longitudinal optical phonons at room temperature. Further, the data show that a specialized form of ionized-impurity scattering may play a role at low temperatures. A discussion of our experimental results is presented and it is concluded that an explanation of these in terms of a model of impurity-band conduction is appropriate.},
  comment   = {Darrel Shlom "Most perovskites are oxygen defficient, and n-type. An extreme case is SrTiO_2.5, which is colored black!"

