@Article{Shpyrko2007may,
  author    = {Shpyrko, O. G. and Isaacs, E. D. and Logan, J. M. and Feng, Yejun and Aeppli, G. and Jaramillo, R. and Kim, H. C. and Rosenbaum, T. F. and Zschack, P. and Sprung, M. and Narayanan, S. and Sandy, A. R.},
  title     = {Direct measurement of antiferromagnetic domain fluctuations},
  volume    = {447},
  number    = {7140},
  pages     = {68 -- 71},
  issn      = {0028-0836},
  doi       = {10.1038/nature05776},
  url       = {http://dx.doi.org/10.1038/nature05776},
  abstract  = {Measurements of magnetic noise emanating from ferromagnets owing to domain motion were first carried out nearly 100 years ago1, and have underpinned much science and technology. Antiferromagnets, which carry no net external magnetic dipole moment, yet have a periodic arrangement of the electron spins extending over macroscopic distances, should also display magnetic noise. However, this must be sampled at spatial wavelengths of the order of several interatomic spacings, rather than the macroscopic scales characteristic of ferromagnets. Here we present a direct measurement of the fluctuations in the nanometre-scale superstructure of spin- and charge-density waves associated with antiferromagnetism in elemental chromium. The technique used is X-ray photon correlation spectroscopy, where coherent X-ray diffraction produces a speckle pattern that serves as a 'fingerprint' of a particular magnetic domain configuration. The temporal evolution of the patterns corresponds to domain walls advancing and retreating over micrometre distances. This work demonstrates a useful measurement tool for antiferromagnetic domain wall engineering, but also reveals a fundamental finding about spin dynamics in the simplest antiferromagnet: although the domain wall motion is thermally activated at temperatures above 100 K, it is not so at lower temperatures, and indeed has a rate that saturates at a finite value -- consistent with quantum fluctuations -- on cooling below 40 K.},
  comment   = {10.1038/nature05776
Review:
Suggested filename = Shpyrko2007may Direct measurement of antiferromagnetic domain fluctuations 10.1038/nature05776 *.pdf},
  file      = {Shpyrko2007may Direct measurement of antiferromagnetic domain fluctuations 10.1038\:nature05776 *.pdf:UNSORTED/Shpyrko2007may Direct measurement of antiferromagnetic domain fluctuations 10.1038\:nature05776 *.pdf:PDF},
  journal   = {Nature},
  keywords  = {materials > antiferromagnetic, materials > magnetic > exchange bias},
  month     = {may},
  owner     = {jam99},
  timestamp = {2019.03.03},
  year      = {2007},
}

