@Article{Smith2001mar,
  Title                    = {White-noise magnetization fluctuations in magnetoresistive heads},
  Author                   = {Smith, N. and Arnett, P.},
  Journal                  = {Appl. Phys. Lett.},
  Year                     = {2001},

  Month                    = {mar},
  Number                   = {10},
  Pages                    = {1448},
  Volume                   = {78},

  Abstract                 = {Thermal magnetization fluctuations in magnetoresistive (MR) heads for magnetic hard-disk storage are a fundamental limit on their signal-to-noise ratio. The resultant noise is essentially frequency flat (white), scales with head sensitivity as signal does, but increases inversely with sensor volume. It will impact the present course of industrial R&D efforts toward geometric scaling and increasing raw head sensitivity to achieve increased areal storage densities and data rates. Magnetization noise is shown to exceed Johnson noise in 0.4 mum sensor size, giant-MR spin-valve heads designed for similar to 20 Gbit/in.(2) areal storage density. The basic physics underlying the experimental results is shown to be consistent with predictions from the fluctuation-dissipation theorem.},
  Doi                      = {10.1063/1.1352694},
  File                     = {Smith2001mar White-noise magnetization fluctuations in magnetoresistive heads 10.1063\:1.1352694 *.pdf:UNSORTED/Smith2001mar White-noise magnetization fluctuations in magnetoresistive heads 10.1063\:1.1352694 *.pdf:PDF},
  Keywords                 = {MRFM > magnetometry, nanomagnetics},
  Owner                    = {jam99},
  Timestamp                = {2009.08.08},
  Url                      = {http://dx.doi.org/10.1063/1.1352694}
}

@Article{Smith2002may,
  Title                    = {Thermal magnetization fluctuations in {CoFe} spin-valve devices (invited)},
  Author                   = {Smith, N. and Synogatch, V. and Mauri, D. and Katine, J. A. and Cyrille, M. C.},
  Journal                  = {J. Appl. Phys.},
  Year                     = {2002},

  Month                    = {may},
  Number                   = {10},
  Pages                    = {7454},
  Volume                   = {91},

  Abstract                 = {Thermally induced magnetization fluctuations in the Co86Fe14 free (sense) layer of micron-sized, photolithographically defined giant magetoresistive spin-valve devices are measured electrically, by passing a dc current through the devices and measuring the current-dependent part of the voltage noise power spectrum. Using fluctuation-dissipation relations, the effective Gilbert damping parameter alpha for 1.2, 1.8, and 2.4 nm thick free layers is estimated from either the low-frequency white-noise tail, or independently from the observed thermally excited ferromagnetic resonance peaks in the noise power spectrum, as a function of applied field. The geometry, field, and frequency dependence of the measured noise are found to be reasonably consistent with fluctuation-dissipation predictions based on a quasianalytical eigenmode model to describe the spatial dependence for the magnetization fluctuations. The extracted effective damping constant alphaapproximate to0.06 found for the 1.2 nm free layer was close to 3x larger than that measured in either the 1.8 or 2.4 films, which has potentially serious implications for the future scaling down of spin-valve read heads.},
  Doi                      = {10.1063/1.1452685},
  File                     = {Smith2002may Thermal magnetization fluctuations in CoFe spin-valve devices (invited) 10.1063\:1.1452685 *.pdf:UNSORTED/Smith2002may Thermal magnetization fluctuations in CoFe spin-valve devices (invited) 10.1063\:1.1452685 *.pdf:PDF},
  Keywords                 = {MRFM > magnetometry, nanomagnetics},
  Owner                    = {jam99},
  Timestamp                = {2009.08.08},
  Url                      = {http://dx.doi.org/10.1063/1.1452685}
}

