@Article{Salis2001oct,
  author    = {Salis, G. and Awschalom, D. and Ohno, Y. and Ohno, H.},
  title     = {Origin of Enhanced Dynamic Nuclear Polarization and All-optical Nuclear Magnetic Resonance in GaAs Quantum Wells},
  volume    = {64},
  number    = {19},
  pages     = {195304},
  doi       = {10.1103/PhysRevB.64.195304},
  url       = {http://dx.doi.org/10.1103/PhysRevB.64.195304},
  abstract  = {Time-resolved optical measurements of electron-spin dynamics in a (110) GaAs quantum well are used to study the consequences of a strongly anisotropic electron g tensor, and the origin of previously discovered all-optical nuclear magnetic resonance. All components of the g tensor are measured, and a strong anisotropy even along the in-plane directions is found. The amplitudes of the spin signal allow the study of the spatial directions of the injected spin and its precession axis. Surprisingly efficient dynamic nuclear polarization in a geometry where the electron spins are injected almost transverse to the applied magnetic field is attributed to an enhanced nonprecessing electron spin component. The small absolute value of the electron g factor combined with efficient nuclear spin polarization leads to large nuclear fields that dominate electron spin precession at low temperatures. These effects allow for sensitive detection of all-optical nuclear magnetic resonance induced by periodically excited quantum-well electrons. The mechanism of previously observed $\Delta$m=2 transitions is investigated and found to be attributable to electric quadrupole coupling, whereas $\Delta$m=1 transitions show signatures of both quadrupole and electron-spin induced magnetic dipole coupling.},
  comment   = {Suggested filename = {Salis2001oct Origin of Enhanced Dynamic Nuclear Polarization and All-optical Nuclear Magnetic Resonance in GaAs Quantum Wells.pdf}, Source = {wxdoi2bib}},
  journal   = {Phys. Rev. B},
  keywords  = {magnetic resonance > detection > optical},
  month     = {oct},
  owner     = {jam99},
  timestamp = {2019.03.03},
  year      = {2001},
}

@Article{Salleo2005jun,
  author                     = {Salleo, A. and Endicott, F. and Street, R. A.},
  title                      = {Reversible and irreversible trapping at room temperature in poly(thiophene) thin-film transistors},
  language                   = {English},
  volume                     = {86},
  number                     = {26},
  pages                      = {263505},
  issn                       = {0003-6951},
  doi                        = {10.1063/1.1968437},
  url                        = {http://dx.doi.org/10.1063/1.1968437},
  abstract                   = {We measured the bias stress characteristics of poly(thiophene) semicrystalline thin-film transistors (TFTs) as a function stress times, gate voltages, and duty cycles. At room temperature, the bias stress has two components: a fast reversible component and a slow long-lived component. We hypothesize that the irreversible component is due to charge trapping in the disordered areas of the semiconductor film. At low duty cycle (< 2\%), the fast bias stress component is reversed during the off-part of the cycle therefore the observed threshold voltage (V-T) shift is only caused by long-lived trapping. Long-lived trapping follows power-law kinetics with a time exponent approximately equal to 0.37. We use these findings to estimate the lifetime of TFTs used as switches in display backplanes. (c) American Institute of Physics.},
  address                    = {CIRCULATION \& FULFILLMENT DIV, 2 HUNTINGTON QUADRANGLE, STE 1 N O 1, MELVILLE, NY 11747-4501 USA},
  affiliation                = {Salleo, A (Reprint Author), Xerox Corp, Palo Alto Res Ctr, 3333 Coyote Hill Rd, Palo Alto, CA 94304 USA. Xerox Corp, Palo Alto Res Ctr, Palo Alto, CA 94304 USA.},
