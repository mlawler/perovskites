@Article{Azulay2007jan,
  author    = {Azulay, Doron and Millo, Oded and Balberg, Isaac and Schock, Hans-{W}erner and Visoly-{F}isher, Iris and Cahen, David},
  title     = {Current routes in polycrystalline {CuInSe}$_2$ and {Cu(In,Ga)Se}$_2$ films},
