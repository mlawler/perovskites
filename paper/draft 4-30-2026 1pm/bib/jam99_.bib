@Article{Mihailetchi2003nov,
  Title                    = {Cathode dependence of the open-circuit voltage of polymer : fullerene bulk heterojunction solar cells},
  Author                   = {Mihailetchi, VD and Blom, PWM and Hummelen, JC and Rispens, MT},
  Journal                  = {J. Appl. Phys.},
  Year                     = {2003},

  Month                    = {nov},
  Number                   = {10},
  Pages                    = {6849 -- 6854},
  Volume                   = {94},

  Abstract                 = {The open-circuit voltage (V-OC) of bulk-heterojunction solar cells based on {[}6,6]-phenyl C-61-butyric acid methyl ester (PCBM) as electron acceptor and poly{[}2-methoxy-5(3',7'-dimethyloctyloxy)-p-phenylene vinylene] (OC1C10-PPV) as an electron donor has been investigated. In contrast to the present understanding, it is now demonstrated that for non-ohmic contacts the experimental V-OC is determined by the work function difference of the electrodes. A total variation of more than 0.5 V of the V-OC was observed by variation of the negative electrode (cathode) work function. For ohmic contacts the V-OC is governed by the LUMO and HOMO levels of the acceptor and donor, respectively, which pin the Fermi levels of the cathode and anode. The band bending created by accumulated charges at an ohmic contact produce a considerable loss in V-OC of 0.2 V at room temperature. The experimentally observed voltage loss in V-OC of 0.38 V due to the presence of ohmic contacts at both interfaces strongly limits the maximum open-circuit voltage of OC1C10-PPV/PCBM solar cells. (C) 2003 American Institute of Physics.},
  Affiliation              = {Mihailetchi, VD (Reprint Author), Univ Groningen, Mat Sci Ctr Plus, Nijenborgh 4, NL-9747 AG Groningen, Netherlands. Univ Groningen, Mat Sci Ctr Plus, NL-9747 AG Groningen, Netherlands.},
  Doi                      = {10.1063/1.1620683},
  ISSN                     = {0021-8979},
  Journal-iso              = {J. Appl. Phys.},
  Owner                    = {jam99},
  Times-cited              = {243},
  Timestamp                = {2011.05.01},
  Type                     = {Article},
  Unique-id                = {ISI:000186276600096},
  Url                      = {http://dx.doi.org/10.1063/1.1620683}
}

