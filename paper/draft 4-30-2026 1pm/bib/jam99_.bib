@Article{Jahng2015feb,
  author    = {Jahng, Junghoon and Brocious, Jordan and Fishman, Dmitry A. and Yampolsky, Steven and Nowak, Derek and Huang, Fei and Apkarian, Vartkess A. and Wickramasinghe, H. Kumar and Potma, Eric Olaf},
