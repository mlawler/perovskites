@article{Kaczaral2023dec,
  title = {Improved Reproducibility of Metal Halide Perovskite Solar Cells via Automated Gas Quenching},
  author = {Kaczaral, Samantha C. and Morales, Jr., Daniel A. and Schreiber, Samuel W. and Martinez, Daniel and Conley, Ashley M. and Herath, Randi and Eperon, Giles E. and Choi, Joshua J. and McGehee, Michael D. and Moore, David T.},
