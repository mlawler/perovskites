@Article{Zhu2017aug,
    author = "Zhu, Xiaojian and Lee, Jihang and Lu, Wei D.",
    title = "Iodine Vacancy Redistribution in Organic-Inorganic Halide Perovskite Films and Resistive Switching Effects",
