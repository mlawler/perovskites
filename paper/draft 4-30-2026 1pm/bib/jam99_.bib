@Article{Vinante2011dec,
  author    = {A. Vinante and L. Schinkelshoek and O. Usenko and G. Wijts and T.H. Oosterkamp},
  title     = {Magnetic Resonance Force Microscopy of paramagnetic electron spins at millikelvin temperatures},
  volume    = {2},
