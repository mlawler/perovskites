@Article{OHayre2004sep,
  author    = {O'Hayre, Ryan and Feng, Gang and Nix, William D. and Prinz, Fritz B.},
  title     = {Quantitative Impedance Measurement Using Atomic Force Microscopy},
  volume    = {96},
  number    = {6},
  pages     = {3540 -- 3549},
  doi       = {10.1063/1.1778217},
  url       = {http://dx.doi.org/10.1063/1.1778217},
  abstract  = {Obtaining quantitative electrical information with scanning probe microscopy techniques poses a significant challenge since the nature of the probe/sample contact is frequently unkown. For example, obtaining quantitative kinetic data from the recently developed atomic force microscopy (AFM) impedance technique requires normalization by the probe/sample contact area. In this paper, a methodology is proposed that enables the extraction of quantitative information from the AFM impedance technique. This methodology applies results from nanoindentation experiments and contact mechanics theory to characterize AFM probe contacts. Using these results, probe/sample contact forces (which can be accurately measured in the AFM) may be converted into probe/sample contact area estimates. These contact area estimates, when included in model of the probe/sample contact, enable the extraction of quantitative data. This methodology is applied to the recently developed AFM impedance measurement technique, enabling a quantitative study of the oxygen reduction reaction (ORR) at nanometer length scales. Using the AFM impedance system, kinetic data for the (ORR) at nanoscale Platinum/Nafion contacts is extracted. The kinetic data obtained from the AFM impedance technique match previous bulk measurements---affirming the technique's quantitative potential.},
  comment   = {Suggested filename = {OHayre2004sep Quantitative Impedance Measurement Using Atomic Force Microscopy.pdf},
Source = {wxdoi2bib}},
  file      = {OHayre2004sep Quantitative Impedance Measurement Using Atomic Force Microscopy.pdf:OHayre2004sep Quantitative Impedance Measurement Using Atomic Force Microscopy.pdf:PDF},
  journal   = {J. Appl. Phys.},
  keywords  = {SPM > impedance, electrochemistry > impedance spectroscopy},
