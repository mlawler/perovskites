@Article{Leis2009feb,
  author    = {Leis, Andrew and Rockel, Beate and Andrees, Lars and Baumeister, Wolfgang},
  title     = {Visualizing cells at the nanoscale},
  journal   = {Trends in Biochemical Sciences},
  year      = {2009},
  volume    = {34},
