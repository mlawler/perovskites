  year           = {2008},
}

@Article{Tsetseris2007apr,
  author         = {Tsetseris, L. and Pantelides, S. T.},
  title          = {Intercalation of oxygen and water molecules in pentacene crystals: {F}irst-principles calculations},
  volume         = {75},
  number         = {15},
  pages          = {153202},
  issn           = {1098-0121},
  doi            = {10.1103/PhysRevB.75.153202},
  url            = {http://dx.doi.org/10.1103/PhysRevB.75.153202},
  abstract       = {Defect formation processes in semiconductors play an important role in controlling structural, electronic and transport properties. Here, we report the results of first-principles calculations of defect formation by oxygen and water molecules in a pentacene (Pn) molecular crystal, a prototypical system in organic electronics. We find that for both species, it is energetically favorable to enter Pn. The most stable defect structures resulting from O-2 intercalation and dissociation are either O complexes or single-O configurations. A special case is an intermolecular O bridge with levels in the energy gap of Pn, 0.33-0.40 eV above the valence-band maximum. In contrast to O-2, H2O molecules stay preferably intact between layers.},
  article-number = {153202},
  comment        = {Suggested filename = Tsetseris2007apr Intercalation of oxygen and water molecules in pentacene crystals ~ First-principles calculations 10.1103/PhysRevB.75.153202 *.pdf},
  file           = {Tsetseris2007apr Intercalation of oxygen and water molecules in pentacene crystals ~ First-principles calculations 10.1103\:PhysRevB.75.153202 *.pdf:UNSORTED/Tsetseris2007apr Intercalation of oxygen and water molecules in pentacene crystals ~ First-principles calculations 10.1103\:PhysRevB.75.153202 *.pdf:PDF},
  journal        = {Phys. Rev. B},
  keywords       = {charge trapping > mechanisms > H2O, charge trapping > mechanisms > O2, charge trapping > mechanisms > epoxide, charge trapping > mechanisms > peroxide, charge trapping > mechanisms > calculations, materials > PES > pentacene, materials > PES > acenes},
  month          = {apr},
