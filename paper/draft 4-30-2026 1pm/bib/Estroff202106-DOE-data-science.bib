@article{DeYoreo2013may,
  title = {In Situ Atomic Force Microscopy as a Tool for Investigating Interactions and Assembly Dynamics in Biomolecular and Biomineral Systems},
  author = {De Yoreo, James J. and Chung, Sungwook and Friddle, Raymond W.},
  year = 2013,
