@Article{Goobes2007dec,
  author    = {Goobes, Gil and Goobes, Rivka and Shaw, Wendy J. and Gibson, James M. and Long, Joanna R. and Raghunathan, Vinodhkumar and Schueler-Furman, Ora and Popham, Jennifer M. and Baker, David and Campbell, Charles T. and Stayton, Patrick S. and Drobny, Gary P.},
  title     = {The structure, dynamics, and energetics of protein adsorption -- lessons learned from adsorption of statherin to hydroxyapatite},
  journal   = {Magn. Res. Chem.},
  year      = {2007},
