@Article{Cao2013dec,
  author    = {Cao, Erhu and Liao, Maofu and Cheng, Yifan and Julius, David},
  title     = {{TRPV1} Structures in Distinct Conformations Reveal Activation Mechanisms},
  journal   = {Nature},
  year      = {2013},
  volume    = {504},
