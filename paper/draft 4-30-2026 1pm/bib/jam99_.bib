@Article{Taki1981jun,
  Title                    = {Pulsed nuclear double resonance in impurity-doped ionic crystals},
  Author                   = {Taki, Toshihiko and Satoh, Mitsuo},
  Journal                  = {Phys. Rev. B},
  Year                     = {1981},

  Month                    = {jun},
  Number                   = {12},
  Pages                    = {6721--6731},
  Volume                   = {23},

  Abstract                 = {The highly sensitive nuclear magnetic double-resonance technique has been used to study the first- and second-order quadrupole interactions of nuclear magnetic resonance lines due to the nuclei surrounding the substitutional impurity ions in ionic crystals. By studying the rotational pattern of the quadrupole spectra, signals observed are assigned to (1,0,0)-, (1,1,0)-, and (1,1,1)-site nuclei around the doped impurity ions in NaCl, NaI, and NaBr single crystals. The principal values and the asymmetry parameters of the field gradients were found by using the quadrupole frequency obtained from the present study and the nuclear quadrupole moment for the nuclei under study. The asymmetry parameters of the field gradients at every (1,1,0) site in NaCl-Br, NaCl-I, NaCl-K, NaBr-Cl, and NaBr-I crystals have the same value, 0.10 within the experimental errors, with the same assignment of the principal axes.},
  Doi                      = {10.1103/PhysRevB.23.6721},
  File                     = {Taki1981jun.pdf:Taki1981jun.pdf:PDF},
  Keywords                 = {magnetic resonance > double res, magnetic resonance > double res > cross depolarization},
  Numpages                 = {10},
  Owner                    = {ewm},
  Publisher                = {American Physical Society},
  Timestamp                = {2010.10.14},
  Url                      = {http://dx.doi.org/10.1103/PhysRevB.23.6721}
}

