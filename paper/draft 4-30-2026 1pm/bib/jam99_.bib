@Article{Balestra1994dec,
  author    = {Balestra, F. and Ghibaudo, G.},
  title     = {Brief Review of the {MOS} Device Physics for Low Temperature Electronics},
  journal   = {Solid-State Electronics},
  year      = {1994},
  volume    = {37},
  number    = {12},
