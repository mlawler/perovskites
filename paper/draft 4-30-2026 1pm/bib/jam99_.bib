@Article{Gloos2003mar,
  author    = {Gloos, K and Koppinen, P J and Pekola, J P},
  title     = {Properties of Native Ultrathin Aluminium Oxide Tunnel Barriers},
  journal   = {J. Phys.: Condens. Matter},
  year      = {2003},
  volume    = {15},
  number    = {10},
  month     = {mar},
  pages     = {1733 -- 1746},
  doi       = {10.1088/0953-8984/15/10/320},
  url       = {http://dx.doi.org/10.1088/0953-8984/15/10/320},
  abstract  = {We have investigated planar metal–insulator–metal tunnel junctions with aluminium oxide as the dielectricum. These oxide barriers were grown on an aluminium electrode in pure oxygen at room temperature till saturation. By applying the Simmons model we derived discrete widths of the tunnelling barrier, separated by Δs ≈ 0.38 nm. This corresponds to the addition of single layers of oxygen atoms. The minimum thickness of s0 ≈ 0.54 nm is then due to a double layer of oxygen. We found a strong and systematic dependence of the barrier height on the barrier thickness. Breakdown fields up to 5 GV m−1 were reached. They decreased strongly with increasing barrier thickness. Electrical breakdown could be described by a metal–insulator like transition of the dielectric barrier due to the large density of tunnelling electrons.},
  comment   = {Suggested filename = Gloos2003mar Properties of native ultrathin aluminium oxide tunnel barriers 10.1088/0953-8984/15/10/320 *.pdf},
  file      = {Gloos2003mar Properties of native ultrathin aluminium oxide tunnel barriers 10.1088\:0953-8984\:15\:10\:320 *.pdf:UNSORTED/Gloos2003mar Properties of native ultrathin aluminium oxide tunnel barriers 10.1088\:0953-8984\:15\:10\:320 *.pdf:PDF},
  owner     = {jam99},
  timestamp = {2012.02.17},
}

@Article{Goehring2003nov,
  author    = {Goehring, Lucas and Michal, Carl A.},
  title     = {Nuclear Spin Polarization Transfer Across an Organic-semiconductor Interface},
  journal   = {J. Chem. Phys.},
  year      = {2003},
  volume    = {119},
  number    = {19},
  month     = {nov},
  pages     = {10325},
  doi       = {10.1063/1.1617975},
  url       = {http://dx.doi.org/10.1063/1.1617975},
  abstract  = {Motivated by Tycko's proposal to harness optically pumped nuclear spinpolarization for the enhancement of nuclear magnetic resonance(NMR) signals from biological macromolecules, we investigate the transfer of thermal nuclear spinpolarization between 1H or 19F in an organic overlayer and 31P at the surface of micron-sized InP particles by Hartmann-Hahn cross polarization. Comparison with analytic and numerical models indicates that the total quantity of polarization transferred across the semiconductor-organic interface is limited by the relatively short room-temperature 1H T1rho (11 ms) and the slow diffusion of nuclear spinpolarization in the semiconductor. Models and spin-counting experiments indicate that we are able to transfer approximately 20 percent of the total nuclear spin polarization originating in the organic overlayer to the semiconductor, supporting the feasibility of transferred optically pumped NMR.},
  comment   = {Suggested filename = {Goehring2003nov Nuclear Spin Polarization Transfer Across an Organic-Semiconductor Interface.pdf},
Source = {wxdoi2bib}},
