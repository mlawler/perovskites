@Article{Choi2009apr,
  author                     = {Choi, T. and Lee, S. and Choi, Y. J. and Kiryukhin, V. and Cheong, S. -W.},
  title                      = {Switchable Ferroelectric Diode and Photovoltaic Effect in {BiFeO}$_3$},
