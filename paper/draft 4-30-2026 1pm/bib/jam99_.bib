  author    = {King, Jonathan P. and Jeong, Keunhong and Vassiliou, Christophoros C. and Shin, Chang S. and Page, Ralph H. and Avalos, Claudia E. and Wang, Hai-Jing and Pines, Alexander},
  title     = {Room-temperature in Situ Nuclear Spin Hyperpolarization From Optically Pumped Nitrogen Vacancy Centres in Diamond},
  journal   = {Nat Comms},
