  year      = {2016},
}

@Article{Yu2003sep,
  author    = {Yu, Tianyue and Ober, Christopher K.},
  title     = {Methods for the Topographical Patterning and Patterned Surface Modification of Hydrogels Based on Hydroxyethyl Methacrylate},
