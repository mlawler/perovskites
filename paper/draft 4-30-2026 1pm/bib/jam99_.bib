@Article{Moraes2014jan,
  author    = {Moraes, Isabel and Evans, Gwyndaf and Sanchez-Weatherby, Juan and Newstead, Simon and Stewart, Patrick D. Shaw},
  title     = {Membrane Protein Structure Determination --- {T}he Next Generation},
  journal   = {Biochim. Biophys. Acta},
  year      = {2014},
  volume    = {1838},
  number    = {1},
  month     = {jan},
  pages     = {78 -- 87},
  doi       = {10.1016/j.bbamem.2013.07.010},
  url       = {http://dx.doi.org/10.1016/j.bbamem.2013.07.010},
  abstract  = {The field of Membrane Protein Structural Biology has grown significantly since its first landmark in 1985 with the first three-dimensional atomic resolution structure of a membrane protein. Nearly twenty-six years later, the crystal structure of the beta2 adrenergic receptor in complex with G protein has contributed to another landmark in the field leading to the 2012 Nobel Prize in Chemistry. At present, more than 350 unique membrane protein structures solved by X-ray crystallography (http://blanco.biomol.uci.edu/mpstruc/exp/list, Stephen White Lab at UC Irvine) are available in the Protein Data Bank. The advent of genomics and proteomics initiatives combined with high-throughput technologies, such as automation, miniaturization, integration and third-generation synchrotrons, has enhanced membrane protein structure determination rate. X-ray crystallography is still the only method capable of providing detailed information on how ligands, cofactors, and ions interact with proteins, and is therefore a powerful tool in biochemistry and drug discovery. Yet the growth of membrane protein crystals suitable for X-ray diffraction studies amazingly remains a fine art and a major bottleneck in the field. It is often necessary to apply as many innovative approaches as possible. In this review we draw attention to the latest methods and strategies for the production of suitable crystals for membrane protein structure determination. In addition we also highlight the impact that third-generation synchrotron radiation has made in the field, summarizing the latest strategies used at synchrotron beamlines for screening and data collection from such demanding crystals. This article is part of a Special Issue entitled: Structural and biophysical characterisation of membrane protein-ligand binding.},
  comment   = {Suggested filename = {Moraes2014jan Membrane Protein Structure Determination --- the Next Generation.pdf},
Source = {wxdoi2bib}},
  file      = {Moraes2014jan Membrane Protein Structure Determination --- the Next Generation.pdf:UNSORTED/Moraes2014jan Membrane Protein Structure Determination --- the Next Generation.pdf:PDF},
  keywords  = {project > MRFM, X-ray > diffraction, X-ray > diffraction > sample preparation, biology > protein > membrane},
  owner     = {jam99},
  timestamp = {2016.08.09},
}

@Article{Moreland2003mar,
  author    = {Moreland, J},
  title     = {Micromechanical instruments for ferromagnetic measurements},
  journal   = {J. Phys. D},
  year      = {2003},
  volume    = {36},
  number    = {5},
  month     = {mar},
  pages     = {R39 -- R51},
  issn      = {0022-3727},
  doi       = {10.1088/0022-3727/36/5/201},
  url       = {http://dx.doi.org/10.1088/0022-3727/36/5/201},
  abstract  = {I review some of the novel methods for measuring ferromagnetic properties of thin films based on micromechanical magnetometers and put them into context relative to current research on nanomagnetism. Measurements rely on the detection of mechanical forces or torques on thin films deposited onto microcantilevers. Displacements of the cantilever are detected by optical methods similar to those developed for atomic force microscopy. High sensitivities are achieved by integrating the sample with the detector, allowing magnetic measurements of samples with a total magnetic moment smaller than that detectable with conventional magnetometers. Cantilevers with low spring constants and high mechanical Q are essential for these measurements. Sensitivities better than 10(5) mu(B) are possible at room temperature with the potential for single spin detection below 1 K, where the thermomechanical noise of micromechanical sensors is substantially reduced.},
  comment   = {Suggested filename = Moreland2003mar Micromechanical instruments for ferromagnetic measurements 10.1088/0022-3727/36/5/201 *.pdf},
  file      = {Moreland2003mar Micromechanical instruments for ferromagnetic measurements 10.1088\:0022-3727\:36\:5\:201 *.pdf:UNSORTED/Moreland2003mar Micromechanical instruments for ferromagnetic measurements 10.1088\:0022-3727\:36\:5\:201 *.pdf:PDF},
  keywords  = {MRFM > magnetometry, MRFM > magnetometry > review, MRFM > FMR, nanomagnetics > review},
  owner     = {jam99},
  timestamp = {2010.05.30},
  unique-id = {ISI:000181815700001},
}

