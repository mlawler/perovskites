@Article{Greeley2009sep,
  author    = {Greeley, J. and Stephens, I. E. L. and Bondarenko, A. S. and Johansson, T. P. and Hansen, H. A. and Jaramillo, T. F. and Rossmeisl, J. and Chorkendorff, I. and N{\o}rskov, J. K.},
