@Article{Calado2016dec,
  author    = {Calado, Philip and Telford, Andrew M. and Bryant, Daniel and Li, Xiaoe and Nelson, Jenny and O'Regan, Brian C. and Barnes, Piers R.F.},
  title     = {Evidence for Ion Migration in Hybrid Perovskite Solar Cells With Minimal Hysteresis},
  journal   = {Nat Comms},
  year      = {2016},
  volume    = {7},
  month     = {dec},
  pages     = {13831},
  doi       = {10.1038/ncomms13831},
  url       = {http://dx.doi.org/10.1038/ncomms13831},
  abstract  = {Ion migration has been proposed as a possible cause of photovoltaic current-voltage hysteresis in hybrid perovskite solar cells. A major objection to this hypothesis is that hysteresis can be reduced by changing the interfacial contact materials; however, this is unlikely to significantly influence the behaviour of mobile ionic charge within the perovskite phase. Here, we show that the primary effects of ion migration can be observed regardless of whether the contacts were changed to give devices with or without significant hysteresis. Transient optoelectronic measurements combined with device simulations indicate that electric-field screening, consistent with ion migration, is similar in both high and low hysteresis CH3NH3PbI3 cells. Simulation of the photovoltage and photocurrent transients shows that hysteresis requires the combination of both mobile ionic charge and recombination near the perovskite-contact interfaces. Passivating contact recombination results in higher photogenerated charge concentrations at forward bias which screen the ionic charge, reducing hysteresis.},
  comment   = {Suggested filename = {Calado2016dec Evidence for Ion Migration in Hybrid Perovskite Solar Cells With Minimal Hysteresis.pdf},
Source = {wxdoi2bib}},
  file      = {Calado2016dec Evidence for Ion Migration in Hybrid Perovskite Solar Cells With Minimal Hysteresis.pdf:Calado2016dec Evidence for Ion Migration in Hybrid Perovskite Solar Cells With Minimal Hysteresis.pdf:PDF},
  keywords  = {project > EFM, personnel > Tirmzi, collaborator > Hanrath, materials > semiconductor > perovskite > ion motion, materials > semiconductor > perovskite > hysteresis, devices > solar cell > hysteresis},
  owner     = {jam99},
  timestamp = {2017.01.25},
}

