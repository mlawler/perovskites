  file = {/Users/jam99/Zotero/storage/CZYJNWYH/Kulichenko et al. - 2023 - Uncertainty-driven dynamics for active learning of.pdf}
}

@article{Kumar2022dec,
  title = {Localized {{Heating Tailors Nucleation}} for {{Reproducible Growth}} of {{Thin Halide Perovskite Single Crystals}}},
  author = {Kumar, Sujit and Rukban, Alexandra and Sinisi, Julia and Damle, Vinayaka H. and Cahen, David},
  year = 2022,
