  file      = {:Walsh2015feb Self-Regulation Mechanism for Charged Point Defects in Hybrid Halide Perovskites.pdf:PDF},
  journal   = {Angew. Chem. Int. Ed.},
  keywords  = {project > EFM, personnel > Tirmzi, materials > semiconductor > perovskite, materials > semiconductor > perovskite > defect},
  month     = {feb},
  owner     = {jam99},
  timestamp = {2019.03.03},
  year      = {2015},
}

