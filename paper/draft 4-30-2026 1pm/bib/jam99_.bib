@Article{Domanski2017feb,
  author    = {Domanski, Konrad and Roose, Bart and Matsui, Taisuke and Saliba, Michael and Turren-Cruz, Silver-Hamill and Correa-Baena, Juan-Pablo and Carmona, Cristina Roldan and Richardson, Giles and Foster, Jamie M. and De Angelis, Filippo and Ball, James M. and Petrozza, Annamaria and Mine, Nicolas and Nazeeruddin, Mohammad K. and Tress, Wolfgang and Gr\"atzel, Michael and Steiner, Ullrich and Hagfeldt, Anders and Abate, Antonio},
  title     = {Migration of Cations Induces Reversible Performance Losses Over Day/night Cycling in Perovskite Solar Cells},
  volume    = {10},
  number    = {2},
  pages     = {604 -- 613},
  doi       = {10.1039/C6EE03352K},
  url       = {http://dx.doi.org/10.1039/C6EE03352K},
  abstract  = {Perovskites have been demonstrated in solar cells with a power conversion efficiency of well above 20 [percent], which makes them one of the strongest contenders for next generation photovoltaics. While there are no concerns about their efficiency, very little is known about their stability under illumination and load. Ionic defects and their migration in the perovskite crystal lattice are some of the most alarming sources of degradation, which can potentially prevent the commercialization of perovskite solar cells (PSCs). In this work, we provide direct evidence of electric field-induced ionic defect migration and we isolate their effect on the long-term performance of state-of-the-art devices. Supported by modelling, we demonstrate that ionic defects, migrating on timescales significantly longer (above 10(3) s) than what has so far been explored (from 10(-1) to 10(2) s), abate the initial efficiency by 10-15 [percent] after several hours of operation at the maximum power point. Though these losses are not negligible, we prove that the initial efficiency is fully recovered when leaving the device in the dark for a comparable amount of time. We verified this behaviour over several cycles resembling day/night phases, thus probing the stability of PSCs under native working conditions. This unusual behaviour reveals that research and industrial standards currently in use to assess the performance and the stability of solar cells need to be adjusted for PSCs. Our work paves the way for much needed new testing protocols and figures of merit specifically designed for PSCs.},
  comment   = {Suggested filename = {Domanski2017feb Migration of Cations Induces Reversible Performance Losses Over Day/night Cycling in Perovskite Solar Cells.pdf},
Source = {wxdoi2bib},
Cited = {jam99, 04.05.18: 33 times}},
  file      = {:Domanski2017feb Migration of Cations Induces Reversible Performance Losses Over Day\:night Cycling in Perovskite Solar Cells.pdf:PDF},
  journal   = {Energy Environ. Sci.},
  keywords  = {project > EFM, personnel > Tirmzi, materials > semiconductor > perovskite, materials > semiconductor > perovskite > ion motion, materials > semiconductor > perovskite > defect},
  month     = {feb},
  owner     = {jam99},
  timestamp = {2019.03.03},
  year      = {2017},
}

@Article{Leijtens2013dec,
  author    = {Leijtens, Tomas and Eperon, Giles E. and Pathak, Sandeep and Abate, Antonio and Lee, Michael M. and Snaith, Henry J.},
  title     = {Overcoming Ultraviolet Light Instability of Sensitized TiO2 With Meso-superstructured Organometal Tri-halide Perovskite Solar Cells},
  volume    = {4},
  pages     = {583},
  doi       = {10.1038/ncomms3885},
  url       = {http://dx.doi.org/10.1038/ncomms3885},
  abstract  = {The power conversion efficiency of hybrid solid-state solar cells has more than doubled from 7 to 15 [percent] over the past year. This is largely as a result of the incorporation of organometallic trihalide perovskite absorbers into these devices. But, as promising as this development is, long-term operational stability is just as important as initial conversion efficiency when it comes to the development of practical solid-state solar cells. Here we identify a critical instability in mesoporous TiO2-sensitized solar cells arising from light-induced desorption of surface-adsorbed oxygen. We show that this instability does not arise in mesoporous TiO2-free mesosuperstructured solar cells. Moreover, our TiO2-free cells deliver stable photocurrent for over 1,000 h continuous exposure and operation under full spectrum simulated sunlight.},
  comment   = {Suggested filename = {Leijtens2013dec Overcoming Ultraviolet Light Instability of Sensitized TiO2 With Meso-superstructured Organometal Tri-halide Perovskite Solar Cells.pdf},
Source = {wxdoi2bib}},
  file      = {Leijtens2013dec Overcoming Ultraviolet Light Instability of Sensitized TiO2 With Meso-superstructured Organometal Tri-halide Perovskite Solar Cells.pdf:Leijtens2013dec Overcoming Ultraviolet Light Instability of Sensitized TiO2 With Meso-superstructured Organometal Tri-halide Perovskite Solar Cells.pdf:PDF},
  journal   = {Nat Comms},
  keywords  = {project > EFM, personnel > Tirmzi, materials > semiconductor > perovskite, materials > semiconductor > perovskite > mixed anion},
  month     = {dec},
  owner     = {jam99},
  timestamp = {2019.03.03},
  year      = {2013},
}

@Article{Li2015dec,
  author    = {Li, Jiang-Jun and Ma, Jing-Yuan and Ge, Qian-Qing and Hu, Jin-Song and Wang, Dong and Wan, Li-Jun},
  title     = {Microscopic Investigation of Grain Boundaries in Organolead Halide Perovskite Solar Cells},
  volume    = {7},
  number    = {51},
  pages     = {28518 -- 28523},
  doi       = {10.1021/acsami.5b09801},
  url       = {http://dx.doi.org/10.1021/acsami.5b09801},
  abstract  = {Grain boundaries (GBs) play an important role in organic inorganic halide perovskite solar cells, which have generally been recognized as a new class of materials for photovoltaic applications. To definitely understand the electrical structure and behavior of GBs, here we present Kelvin probe force microscopy and conductive atomic force microscopy (cAFM) measurements of both typical and inverted planar organolead halide perovskite solar cells. By comparing the contact potential difference (CPD) of these two devices in the dark and under illumination, we found that a downward band bending exists in GBs that predominantly attract photoinduced electrons. The c-AFM measurements observed that higher photocurrents flow through GBs when a low bias overcomes the barrier created by the band bending, indicating that GBs act as effective charge dissociation interfaces and photocurrent transduction pathways rather than recombination sites.},
  comment   = {Suggested filename = {Li2015dec Microscopic Investigation of Grain Boundaries in Organolead Halide Perovskite Solar Cells.pdf},
Source = {wxdoi2bib},
Cited = {jam99, 04.05.18: 38 times}},
