  month     = {may},
  pages     = {1919},
  doi       = {10.1038/ncomms2865},
  url       = {http://dx.doi.org/10.1038/ncomms2865},
  abstract  = {Interferometric techniques have proven useful to infer proximity and local surface profiles of microscopic objects near surfaces. But a critical trade-off emerges between accuracy and mathematical complexity when these methods are applied outside the vicinity of closest approach. Here we introduce a significant advancement that enables reflection interference contrast microscopy to provide nearly instantaneous reconstruction of an arbitrary convex object's contour next to a bounding surface with nanometre resolution, making it possible to interrogate microparticle/surface interaction phenomena at radii of curvature 1,000 times smaller than those accessible by the conventional surface force apparatus. The unique view-from-below perspective of reflection interference contrast microscopy also reveals previously unseen deformations and allows the first direct observation of femtolitre-scale capillary condensation dynamics underneath micron-sized particles. Our implementation of reflection interference contrast microscopy provides a generally applicable nanometre-scale resolution tool that can be potentially exploited to dynamically probe ensembles of objects near surfaces so that statistical/probabilistic behaviour can be realistically captured.},
  comment   = {Suggested filename = {Contreras-Naranjo2013may A Nanometre-scale Resolution Interference-based Probe of Interfacial Phenomena Between Microscopic Objects and Surfaces.pdf}},
  file      = {Contreras-Naranjo2013may A Nanometre-scale Resolution Interference-based Probe of Interfacial Phenomena Between Microscopic Objects and Surfaces.pdf:UNSORTED/Contreras-Naranjo2013may A Nanometre-scale Resolution Interference-based Probe of Interfacial Phenomena Between Microscopic Objects and Surfaces.pdf:PDF},
  keywords  = {project > TSRI},
  owner     = {jam99},
  timestamp = {2013.11.22},
}

