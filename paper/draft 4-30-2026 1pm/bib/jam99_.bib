@MastersThesis{Peeples2004jun,
  author    = {Mark E. Peeples},
  title     = {Vibration Suppression and Control of a Piezoelectric Scanner with Application to Magnetic Resonance Force Microscopy},
  year      = {2004},
  month     = {jun},
  abstract  = {This work was concerned with one part of the MRFMapparatus – the sample scanner. Even a small reduction in the settling time of the scanner response could have a large impact in time savings of a complete MRFM scan, which can last several hours and may eventually contain millions of voxels. One of the goals of this research was to improve an existing feedback controller to reduce the step–settle times during voxel transitions. Specifically, a feedforward input was combined with the feedback loop in order to speed up transient responses, while limiting input induced vibrations. In addition, a previously designed position sensor was built and integrated with the 3–D sample scanner to provide three–axis feedback sensing.

In Chapter 2 the sample scanner is discussed in detail, and challenges that compete with the desired positioning resolution and transient responses are given. Also, an analytic model is developed to facilitate initial controller design and preliminary simulations. Chapter 3 discusses some compensation techniques that could help overcome these positioning challenges, and a feedforward–feedback approach is stated and justified. The feedback and feedforward controllers are discussed separately and then combined to provide a robust solution that mitigates MRFM sample positioning challenges. Also, the background and design of the feedback sensor is presented. Experimental results are given in Chapter 4 and demonstrate that the controller and sensor are effective in the intended function. Concluding remarks follow in Chapter 5.},
  comment   = {Suggested filename = Peeples2004jun Vibration Suppression and Control of a Piezoelectric Scanner with Application to Magnetic Resonance Force Microscopy *.pdf},
  file      = {Peeples2004jun Vibration Suppression and Control of a Piezoelectric Scanner with Application to Magnetic Resonance Force Microscopy *.pdf:UNSORTED/Peeples2004jun Vibration Suppression and Control of a Piezoelectric Scanner with Application to Magnetic Resonance Force Microscopy *.pdf:PDF;Peeples2004jun-README.rtf:UNSORTED/Peeples2004jun-README.rtf:Rich Text Format},
  keywords  = {SPM > methods > feedback, SPM > methods > feedforward, nanopositioning > piezoelectric > vibration control},
  owner     = {jam99},
  school    = {University of Washington},
  timestamp = {2011.09.09},
}

