@Article{Menke2016nov,
  author    = {Menke, S. Matthew and Sadhanala, Aditya and Nikolka, Mark and Ran, Niva A. and Ravva, Mahesh Kumar and Abdel-Azeim, Safwat and Stern, Hannah L. and Wang, Ming and Sirringhaus, Henning and Nguyen, Thuc-Quyen and Br\'edas, Jean-Luc and Bazan, Guillermo C. and Friend, Richard H.},
  title     = {Limits for Recombination in a Low Energy Loss Organic Heterojunction},
  journal   = {ACS Nano},
  year      = {2016},
  month     = {nov},
  doi       = {10.1021/acsnano.6b06211},
  url       = {http://dx.doi.org/10.1021/acsnano.6b06211},
  abstract  = {Donor-acceptor organic solar cells often show high quantum yields for charge collection, but relatively low open-circuit voltages (VOC) limit power conversion efficiencies to around 12 percent. We report here the behavior of a system, PIPCP:PC61BM, that exhibits very low electronic disorder (Urbach energy less than 27 meV), very high carrier mobilities in the blend (field-effect mobility for holes >10E-2 cm2/Vs), and a very low driving energy for initial charge separation (50 meV). These characteristics should give excellent performance, and indeed, the VOC is high relative to the donor energy gap. However, we find the overall performance is limited by recombination, with formation of lower-lying triplet excitons on the donor accounting for 90 percent of the recombination. We find this is a bimolecular process that happens on time scales as short as 100 ps. Thus, although the absence of disorder and the associated high carrier mobility speeds up charge diffusion and extraction at the electrodes, which we measure as early as 1 ns, this also speeds up the recombination channel, giving overall a modest quantum yield of around 60 percent. We discuss strategies to remove the triplet exciton recombination channel.},
  comment   = {Suggested filename = {Menke2016nov Limits for Recombination in a Low Energy Loss Organic Heterojunction.pdf},
Source = {wxdoi2bib}},
  file      = {Menke2016nov Limits for Recombination in a Low Energy Loss Organic Heterojunction.pdf:UNSORTED/Menke2016nov Limits for Recombination in a Low Energy Loss Organic Heterojunction.pdf:PDF},
  keywords  = {project > EFM, personnel > Dwyer, SPM > ultrafast, project > MRFM, personnel > Curley},
  owner     = {jam99},
  timestamp = {2016.11.05},
}

