@Article{Mamin2007may,
  author      = {Mamin, H. J. and Poggio, M. and Degen, C. L. and Rugar, D.},
  title       = {Nuclear Magnetic Resonance Imaging with 90-nm Resolution},
  journal     = {Nat. Nanotechnol.},
  year        = {2007},
  volume      = {2},
  number      = {5},
  month       = {may},
