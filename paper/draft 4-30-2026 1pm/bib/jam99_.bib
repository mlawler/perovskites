  journal   = {Corrosion},
  keywords  = {project > EMC2, electrochemistry > corrosion},
  month     = {feb},
  owner     = {jam99},
  timestamp = {2019.03.03},
  year      = {2000},
}

@Article{Sebastian1981oct,
  author    = {Sebastian, L. and Weiser, G. and B\"{a}ssler, H.},
  title     = {Charge transfer transitions in solid tetracene and pentacene studied by electroabsorption},
  volume    = {61},
  number    = {1-2},
  pages     = {125--135},
  issn      = {0301-0104},
  doi       = {10.1016/0301-0104(81)85055-0},
  url       = {http://dx.doi.org/10.1016/0301-0104(81)85055-0},
  abstract  = {Electric field modulated absorption spectra of vapor deposited layers of tetracene and pentacene indicate existence of charge transfer transitions. In tetracene the transitions from a molecule located at (0, 0, 0) to molecules located at (, , 0), (0, 1, 0), (1, 0, 0), and (1, 1, 0) or , , 0) occur at 2.71 eV, 2.779 eV, 2.895 eV and 3.063 eV, respectively. The dependence of the electron--hole binding energy on the pair separation is coulombic and yields a bandgap Eg= 3.4 = 0.05 eV. The oscillator strengths of the transition between nearest neighbors is about 0.03. In pentacene the transition between molecules located at (0, 0, 0) and (, , 0), (0, 1, 0), (1, 0, 0) could be resolved. They appear at 2.120 eV, 2.270 eV and 2.345 eV, respectively, and are the dominant features in the absorption spectrum. The electron--hole pair binding energy decreases faster than rCT-1 with increasing separation. This effect explains the high carrier generation efficiency in pentacene. The results are in accord with recent work of Bounds and Siebrand suggesting that CT excitons are generated by direct transitions rather than by autoionization of a localized excited molecular state followed by thermalization. The influence of the external field on the singlet exciton transition is explained in terms of a quadratic Stark effect.},
  comment   = {Suggested filename = Sebastian1981oct Charge transfer transitions in solid tetracene and pentacene studied by electroabsorption 10.1016/0301-0104(81)85055-0 *.pdf

