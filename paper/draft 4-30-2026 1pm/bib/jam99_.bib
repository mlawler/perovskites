@Article{Salleo2003jul,
  author    = {A. Salleo and R. A. Street},
  title     = {Light-induced bias stress reversal in polyfluorene thin-film transistors},
  volume    = {94},
  number    = {1},
  pages     = {471 -- 479},
  doi       = {10.1063/1.1581352},
  url       = {http://dx.doi.org/10.1063/1.1581352},
  abstract  = {Gate bias-stress effects in the high-performance semiconducting polymer poly-9,9[prime] dioctyl-fluorene-co-bithiophene (F8T2) were studied. The bias stress in F8T2 was characterized in devices having various gate dielectric materials -- different types of SiO2 and a polymer -- and a variety of chemically modified dielectric/semiconductor interfaces. A bias-stress effect was reversed by illuminating the transistor structure with band gap radiation. The recovery rate was directly related to the absorption characteristics of F8T2. We conclude that bias stress in F8T2 is due to hole charge trapping inside the polymer, close to the dielectric interface and not to a structural change in the polymer, or to charge in the dielectric. (c)2003 American Institute of Physics.},
  comment   = {Suggested filename = Salleo2003jul Light-induced bias stress reversal in polyfluorene thin-film transistors 10.1063/1.1581352 *.pdf},
  file      = {Salleo2003jul Light-induced bias stress reversal in polyfluorene thin-film transistors 10.1063\:1.1581352 *.pdf:UNSORTED/Salleo2003jul Light-induced bias stress reversal in polyfluorene thin-film transistors 10.1063\:1.1581352 *.pdf:PDF},
  journal   = {J. Appl. Phys.},
  keywords  = {charge trapping; de- > mechanisms > recombination exciton, charge trapping; de- > mechanisms > recombination free-charge, charge trapping; de- > mechanisms > light},
  month     = {jul},
  owner     = {jam99},
  publisher = {AIP},
  timestamp = {2019.03.03},
  year      = {2003},
}

@Article{Salzberg2005jan,
  author    = {Salzberg, B.M. and Kosterin, P.V. and Muschol, M. and Obaid, A.L. and Rumyantsev, S.L. and Bilenko, Yu. and Shur, M.S.},
  title     = {An ultra-stable non-coherent light source for optical measurements in neuroscience and cell physiology},
  volume    = {141},
  number    = {1},
  pages     = {165 -- 169},
  doi       = {10.1016/j.jneumeth.2004.06.009},
  url       = {http://dx.doi.org/10.1016/j.jneumeth.2004.06.009},
  abstract  = {We demonstrate that high power light-emitting diodes (LED’s) exhibit low-frequency noise characteristics that are clearly superior to those of quartz tungsten halogen lamps, the non-coherent light source most commonly employed when freedom from intensity variation is critical. Their extreme stability over tens of seconds (combined with readily selectable wavelength) makes high power LED’s ideal light sources for DC recording of optical changes, from living cells and tissues, that last more than a few hundred milliseconds. These optical signals (ΔI/I0) may be intrinsic (light scattering, absorbance or fluorescence) or extrinsic (absorbance or fluorescence from probe molecules) and we show that changes as small as ~8 × 10−5 can be recorded without signal averaging when LED’s are used as monochromatic light sources. Here, rapid and slow changes in the intrinsic optical properties of mammalian peptidergic nerve terminals are used to illustrate the advantages of high power LED’s compared to filament bulbs.},
  comment   = {Suggested filename = Salzberg2005jan An ultra-stable non-coherent light source for optical measurements in neuroscience and cell physiology 10.1016/j.jneumeth.2004.06.009 *.pdf},
  file      = {Salzberg2005jan An ultra-stable non-coherent light source for optical measurements in neuroscience and cell physiology 10.1016\:j.jneumeth.2004.06.009 *.pdf:UNSORTED/Salzberg2005jan An ultra-stable non-coherent light source for optical measurements in neuroscience and cell physiology 10.1016\:j.jneumeth.2004.06.009 *.pdf:PDF},
  journal   = {Journal of Neuroscience Methods},
  keywords  = {SPM > EMF > light source},
  month     = {jan},
  owner     = {jam99},
  timestamp = {2019.03.03},
  year      = {2005},
}

@Article{Salzmann2007may,
  author                     = {Salzmann, Ingo and Opitz, Ricarda and Rogaschewski, Siegfried and Rabe, Juergen P. and Koch, Norbert and Nickel, Bert},
  title                      = {Phase separation in vacuum codeposited pentacene/6,13-pentacenequinone thin films},
  language                   = {English},
  volume                     = {75},
  number                     = {17},
  pages                      = {174108},
  issn                       = {1098-0121},
  doi                        = {10.1103/PhysRevB.75.174108},
  url                        = {http://dx.doi.org/10.1103/PhysRevB.75.174108},
  abstract                   = {Pentacene (P) and 6,13-pentacenequinone (PQ) have been vacuum codeposited onto SiO2 in order to control phase separation in thin films for the application as bulk heterojunctions in organic photovoltaic devices. Structural investigations by means of scanning electron microscopy (SEM) and atomic force microscopy revealed pronounced phase separation of the two materials at length scales that turned out to be tunable by the variation of the deposition rate. X-ray diffraction provided evidence for polymorphism in pure films of P and PQ on SiO2. While pure films exhibited both the bulk and thin-film phase, the bulk phase is mainly suppressed within the co-deposited films (P+PQ). This was corroborated by Fourier-transform infrared spectroscopy results. SEM investigations of pure and codeposited films indicated that PQ bulk crystallites of up to 200 nm height form continuous paths to the substrate and grow within a matrix formed of P and PQ thin-film phases. The obtained heterojunction morphologies thus appear interesting for the application in organic-based photovoltaic cells.},
  address                    = {ONE PHYSICS ELLIPSE, COLLEGE PK, MD 20740-3844 USA},
