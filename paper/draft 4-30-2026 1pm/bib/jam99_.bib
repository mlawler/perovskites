@Article{Ng2007feb,
  author         = {Ng, Tse Nga and Silveira, William R. and Marohn, John A.},
  title          = {Dependence of charge injection on temperature, electric field, and energetic disorder in an organic semiconductor},
  journal        = {Phys. Rev. Lett.},
