}

@Article{Chen2013apr,
  author    = {Lei Chen and Jonilyn G. Longenecker and Eric W. Moore and John A. Marohn},
  title     = {Long-Lived Frequency Shifts Observed in a Magnetic Resonance Force Microscope Experiment Following Microwave Irradiation of a Nitroxide Spin Probe},
  journal   = {Appl. Phys. Lett.},
  year      = {2013},
  volume    = {102},
  number    = {13},
  month     = {apr},
  pages     = {132404},
  note      = {\href{http://www.ncbi.nlm.nih.gov/pmc/articlerender.fcgi?artid=PMC3631243}{[PMCID:PMC3631243]}},
  doi       = {10.1063/1.4795018},
  url       = {http://dx.doi.org/10.1063/1.4795018},
  abstract  = {We introduce a spin-modulation protocol for force-gradient detection of magnetic resonance that enables the real-time readout of longitudinal magnetization in an electron spin resonance experiment involving fast-relaxing spins. We applied this method to observe a prompt change in longitudinal magnetization following the microwave irradiation of a nitroxide-doped perdeuterated polystyrene film having an electron spin-lattice relaxation time of T1 ∼ 1ms. The protocol allowed us to discover a large, long-lived cantilever frequency shift. Based on its magnitude, lifetime, and field dependence, we tentatively attribute this persistent signal to deuteron spin magnetization created via transfer of polarization from nitroxide spins.},
  comment   = {Suggested filename = Chen2013apr Long-Lived Frequency Shifts Observed in a Magnetic Resonance Force Microscope Experiment Following Microwave Irradiation of a Nitroxide Spin Probe.pdf},
  file      = {Chen2013apr Long-Lived Frequency Shifts Observed in a Magnetic Resonance Force Microscope Experiment Following Microwave Irradiation of a Nitroxide Spin Probe.pdf:UNSORTED/Chen2013apr Long-Lived Frequency Shifts Observed in a Magnetic Resonance Force Microscope Experiment Following Microwave Irradiation of a Nitroxide Spin Probe.pdf:PDF},
