@Article{Maturova2009may,
  author    = {Maturova, K. and Kemerink, M. and Wienk, M.M. and Charrier, D. and Janssen, R.},
  title     = {Scanning {K}elvin Probe Microscopy on Bulk Heterojunction Polymer Blends},
  journal   = {Adv. Funct. Mater.},
  year      = {2009},
  volume    = {19},
  number    = {9},
  month     = {may},
