  year      = {2011},
}

@Article{VisolyFisher2003dec,
  author    = {Visoly-{F}isher, Iris and Cohen, Sidney R. and Cahen, David and Ferekides, Christos S.},
  title     = {Electronically active layers and interfaces in polycrystalline devices: {C}ross-section mapping of {CdS}/{CdTe} solar cells},
  volume    = {83},
