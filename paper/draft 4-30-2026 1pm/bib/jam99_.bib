  issn      = {1521-3773},
  doi       = {10.1002/anie.201509858},
  url       = {http://dx.doi.org/10.1002/anie.201509858},
  abstract  = {Glycosylation is a ubiquitous post-translational modification, present in over 50 percent of the proteins in the human genome, with important roles in cell-cell communication and migration. Interest in glycome profiling has increased with the realization that glycans can be used as biomarkers of many diseases, including cancer. We report here the first tomographic imaging of glycosylated tissues in live mice by using metabolic labeling and a gadolinium-based bioorthogonal MRI probe. Significant N-azidoacetylgalactosamine dependent T1-contrast was observed in-vivo two hours after probe administration. Tumor, kidney, and liver showed significant contrast, and several other tissues, including the pancreas, spleen, heart, and intestines, showed a very high contrast (>10-fold). This approach has the potential to enable the rapid and non-invasive magnetic resonance imaging of glycosylated tissues in-vivo in preclinical models of disease.},
  comment   = {Suggested filename = {Neves2016mar Imaging Glycosylation In Vivo by Metabolic Labeling and Magnetic Resonance Imaging.pdf}},
  file      = {Neves2016mar Imaging Glycosylation In Vivo by Metabolic Labeling and Magnetic Resonance Imaging.pdf:Neves2016mar Imaging Glycosylation In Vivo by Metabolic Labeling and Magnetic Resonance Imaging.pdf:PDF},
  keywords  = {project > MRFM, magnetic resonance > labeling, magnetic resonance > labeling > in vivo, biology > labeling > protein, biology > labeling > in vivo},
  owner     = {jam99},
  timestamp = {2016.03.31},
}

