@article{Xue2020mar,
  title = {Regulating Strain in Perovskite Thin Films through Charge-Transport Layers},
  author = {Xue, Ding-Jiang and Hou, Yi and Liu, Shun-Chang and Wei, Mingyang and Chen, Bin and Huang, Ziru and Li, Zongbao and Sun, Bin and Proppe, Andrew H. and Dong, Yitong and Saidaminov, Makhsud I. and Kelley, Shana O. and Hu, Jin-Song and Sargent, Edward H.},
