  journal-iso                = {Nano Lett.},
  keywords                   = {devices > fuel cell > membrane, materials > ionic conductors > cation > Nafion},
  keywords-plus              = {ATOMIC-FORCE MICROSCOPY; NAFION MEMBRANE; SURFACE; AFM; NANOLITHOGRAPHY; SPECTROSCOPY; MORPHOLOGY; INTERFACE; TRANSPORT; ELECTRODE},
  number-of-cited-references = {22},
