@Article{Henderson2013nov,
  author    = {Henderson, R.},
  title     = {Avoiding the Pitfalls of Single Particle Cryo-electron Microscopy: {E}instein From Noise},
  journal   = {Proc. Natl. Acad. Sci.},
  year      = {2013},
