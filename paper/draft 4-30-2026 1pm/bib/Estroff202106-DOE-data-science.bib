@article{Gu2023apr,
  title = {Design Optimization of Bifacial Perovskite Minimodules for Improved Efficiency and Stability},
  author = {Gu, Hangyu and Fei, Chengbin and Yang, Guang and Chen, Bo and Uddin, Md Aslam and Zhang, Hengkai and Ni, Zhenyi and Jiao, Haoyang and Xu, Wenzhan and Yan, Zijie and Huang, Jinsong},
