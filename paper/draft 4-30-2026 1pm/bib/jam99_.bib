  timestamp = {2010.03.15},
  ut        = {WOS:000256441100041},
}

@Article{Neves2016mar,
  author    = {Neves, Andr\`{e} A. and Wainman, Y\`{e}l\`{e}na A. and Wright, Alan and Kettunen, Mikko I. and Rodrigues, Tiago B. and McGuire, Sarah and Hu, De-En and Bulat, Flaviu and Geninatti Crich, Simonetta and St\"{o}ckmann, Henning and Leeper, Finian J. and Brindle, Kevin M.},
  title     = {Imaging Glycosylation In Vivo by Metabolic Labeling and Magnetic Resonance Imaging},
  journal   = {Angew. Chem. Int. Ed.},
