@article{Legrain2018jan,
  title = {Materials {{Screening}} for the {{Discovery}} of {{New Half-Heuslers}}: {{Machine Learning}} versus Ab {{Initio Methods}}},
  shorttitle = {Materials {{Screening}} for the {{Discovery}} of {{New Half-Heuslers}}},
  author = {Legrain, Fleur and Carrete, Jes{\'u}s and {van Roekeghem}, Ambroise and Madsen, Georg K.H. and Mingo, Natalio},
