  timestamp = {2010.04.08},
}

@Article{Contreras-Naranjo2013may,
  author    = {Contreras-Naranjo, Jose C. and Ugaz, Victor M.},
  title     = {A Nanometre-scale Resolution Interference-based Probe of Interfacial Phenomena Between Microscopic Objects and Surfaces},
  journal   = {Nat Comms},
  year      = {2013},
