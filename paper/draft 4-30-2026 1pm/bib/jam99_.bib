@Article{Deegan1997oct,
  author    = {Deegan, Robert D. and Bakajin, Olgica and Dupont, Todd F. and Huber, Greb and Nagel, Sidney R. and Witten, Thomas A.},
  title     = {Capillary flow as the cause of ring stains from dried liquid drops},
  volume    = {389},
