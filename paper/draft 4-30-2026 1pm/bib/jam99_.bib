  keywords  = {marohn-thesis, grant-Sidles-ARO-W911NF-05-1-0403, grant-Marohn-NIH-5R01GM-070012},
  owner     = {jam99},
  school    = {Cornell University},
  timestamp = {2010.07.08},
}

