@Article{Meyer1973sep,
  author    = {Meyer, W. J. and Lang, D. V. and Slichter, C. P.},
  title     = {Electric Field Nuclear Double Resonance in {Ag}$^{+}$-Doped {NaCl}},
  journal   = {Phys. Rev. B},
  year      = {1973},
  volume    = {8},
  number    = {5},
  month     = {sep},
  pages     = {1924--1934},
  doi       = {10.1103/PhysRevB.8.1924},
  url       = {http://dx.doi.org/10.1103/PhysRevB.8.1924},
  abstract  = {An electric field-nuclear-magnetic-double-resonance experiment is described which enables the resolution of certain weak resonances otherwise concealed under a nearby, much stronger resonance. In Ag+-doped NaCl, the weak resonance of the nearest-neighbor sodium nuclei to the Ag+ impurity is concealed by the strong resonance of the sodium nuclei far from the impurity due to the small quadrupole splitting of the nearest neighbors. The technique is based on the fact that the Ag+ ion breaks the inversion symmetry of the near neighbors, whereas the distant nuclei remain at sites of inversion symmetry. As a result an external oscillating electric field can induce deltam=+/-2 transitions in the near neighbors but not in the distant ones. The absorption is detected by monitoring the saturation of the magnetic resonance of the distant nuclei as a function of electric field frequency. The nearest-neighbor sodium nuclei were found to have a static quadrupole coupling constant vQ=12.5 +/-0.2 kHz with an asymmetry parameter of eda=0.28+/-0.04. A simple theory is developed which explains the intensities of the quadrupole lines as a function of the orientation of the electric and magnetic fields. A dynamic quadrupole coupling constant vD is defined. For the nearest-neighbor sodium nuclei vD 3×10-2 Hz/(V/cm) and for the next-nearest-neighbor sodium nuclei vD 3×10-4 Hz/(V/cm).},
  comment   = {suggested filename = Meyer1973sep Electric Field Nuclear Double Resonance in Ag-Doped NaCl 10.1103/PhysRevB.8.1924 *.pdf},
  file      = {Meyer1973sep Electric Field Nuclear Double Resonance in Ag-Doped NaCl 10.1103\:PhysRevB.8.1924 *.pdf:UNSORTED/Meyer1973sep Electric Field Nuclear Double Resonance in Ag-Doped NaCl 10.1103\:PhysRevB.8.1924 *.pdf:PDF},
  keywords  = {Stark effect, magnetic resonance > Stark shifts},
  numpages  = {10},
  owner     = {Jonilyn},
  publisher = {American Physical Society},
  timestamp = {2010.10.15},
}

@Article{Meza2015sep,
