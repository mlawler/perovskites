@Article{Snaith2002dec,
  author    = {Snaith, HJ and Arias, AC and Morteani, AC and Silva, C and Friend, RH},
  title     = {Charge Generation Kinetics and Transport Mechanisms in Blended Polyfluorene Photovoltaic Devices},
  volume    = {2},
  number    = {12},
  pages     = {1353 -- 1357},
  issn      = {1530-6984},
