@Article{Beaumont2012feb,
  author    = {Beaumont, Nicola and Cho, Sang Wan and Sullivan, Paul and Newby, David and Smith, Kevin E. and Jones, Tim. S.},
  title     = {Boron Subphthalocyanine Chloride as an Electron Acceptor for High-Voltage Fullerene-Free Organic Photovoltaics},
