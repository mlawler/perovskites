@Article{Narkowicz2008aug,
  author    = {R. Narkowicz and D. Suter and I. Niemeye},
  title     = {Scaling of sensitivity and efficiency in planar microresonators for electron spin resonance},
  journal   = {Rev. Sci. Instrum.},
  year      = {2008},
  volume    = {79},
  month     = {aug},
  pages     = {084702},
  doi       = {10.1063/1.2964926},
  url       = {http://dx.doi.org/10.1063/1.2964926},
  abstract  = {Electron spin resonance (ESR) of volume-limited samples or nanostructured materials can be made significantly more efficient by using microresonators whose size matches that of the structures under investigation. We describe a series of planar microresonators that show large improvements over conventional ESR resonators in terms of microwave conversion efficiency (microwave field strength for a given input power) and sensitivity (minimum number of detectable spins). We explore the dependence of these parameters on the size of the resonator and find that both scale almost linearly with the inverse of the resonator size. Scaling down the loops of the planar microresonators from 500 down to 20 \micro m improves the microwave efficiency and the sensitivity of these structures by more than an order of magnitude and reduces the microwave power requirements by more than two orders of magnitude.},
  comment   = {Suggested filename = Narkowicz2008aug Scaling of sensitivity and efficiency in planar microresonators for electron spin resonance 10.1063/1.2964926 *.pdf},
  file      = {Narkowicz2008aug Scaling of sensitivity and efficiency in planar microresonators for electron spin resonance 10.1063\:1.2964926 *.pdf:UNSORTED/Narkowicz2008aug Scaling of sensitivity and efficiency in planar microresonators for electron spin resonance 10.1063\:1.2964926 *.pdf:PDF},
  keywords  = {MRFM > rf source > microwire, microwave > stripline > resonator},
  owner     = {jam99},
  timestamp = {2011.06.21},
}

@Article{Narkowicz2005aug,
  author    = {R. Narkowicz and D. Suter and R. Stonies},
  title     = {Planar microresonators for {EPR} experiments},
  journal   = {J. Magn. Res.},
  year      = {2005},
  volume    = {175},
  number    = {2},
  month     = {aug},
  pages     = {275 -- 284},
  doi       = {10.1016/j.jmr.2005.04.014},
  url       = {http://dx.doi.org/10.1016/j.jmr.2005.04.014},
  abstract  = {EPR resonators on the basis of standing-wave cavities are optimised for large samples. For small samples it is possible to design different resonators that have much better power handling properties and higher sensitivity. Other parameters being equal, the sensitivity of the resonator can be increased by minimising its size and thus increasing the filling factor. Like in NMR, it is possible to use lumped elements; coils can confine the microwave field to volumes that are much smaller than the wavelength. We discuss the design and evaluation of EPR resonators on the basis of planar microcoils. Our test resonators, which operate at a frequency of 14 GHz, have excellent microwave efficiency factors, achieving 24 ns \pi/2 EPR pulses with an input power of 17 mW. The sensitivity tests with DPPH samples resulted in the sensitivity value 2.3 \times 10^9 spins per \sqrt{G} \sqrt{Hz} at 300 K},
  comment   = {Suggested filename = Narkowicz2005aug Planar microresonators for EPR experiments 10.1016/j.jmr.2005.04.014 *.pdf},
  file      = {Narkowicz2005aug Planar microresonators for EPR experiments 10.1016\:j.jmr.2005.04.014 *.pdf:UNSORTED/Narkowicz2005aug Planar microresonators for EPR experiments 10.1016\:j.jmr.2005.04.014 *.pdf:PDF},
  keywords  = {MRFM > rf source > microwire, microwave > stripline > resonator},
