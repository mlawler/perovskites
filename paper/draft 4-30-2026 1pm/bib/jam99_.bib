  keywords  = {SPM > ultrafast},
  owner     = {jam99},
  timestamp = {2014.06.12},
}

@Article{Han2009mar,
  author       = {Han, Nianmei and Guo, Guanghua and Zhang, Lamei and Zhang, Guangfu and Song, Wenbin},
