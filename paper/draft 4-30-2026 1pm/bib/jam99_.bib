  doi       = {10.1088/1367-2630/7/1/235},
  url       = {http://dx.doi.org/10.1088/1367-2630/7/1/235},
  abstract  = {Measuring and monitoring the dynamic parameters of a nanomechanical resonator, in particular the resonance frequency, has received significant attention recently, in part due to the possibility of very sensitive, fast and precise mass sensing. Added mass can include chemisorbed or physisorbed metals or organic molecules, and if sufficiently high sensitivity, dynamic range and detector speed can be achieved, they could have applications in, e.g., proteomics. Here, I investigate some of the fundamental limits to mass sensing in such resonators, discussing the limits imposed by thermomechanical noise on both the linear operating regime of a simple harmonic oscillator, and the equivalent limits on nonlinear parametric amplifiers used as parametric sensors. The model system is a cantilevered flexural resonator, but the results apply equally well (in most cases) to doubly clamped or torsional resonant structures as well.},
  comment   = {Suggested filename = {Cleland2005jan Thermomechanical Noise Limits on Parametric Sensing With Nanomechanical Resonators.pdf},
Source = {wxdoi2bib}

Quote = {"However, we also arrive at the surprising result that parametric amplification does not give improved performance over that achieved in the linear regime."}},
  file      = {Cleland2005jan Thermomechanical Noise Limits on Parametric Sensing With Nanomechanical Resonators.pdf:UNSORTED/Cleland2005jan Thermomechanical Noise Limits on Parametric Sensing With Nanomechanical Resonators.pdf:PDF},
  keywords  = {MRFM > parametric amplification, MRFM > frequency detection, oscillators > phase noise, oscillator > detection limits},
