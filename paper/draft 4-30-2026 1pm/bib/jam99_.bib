@Article{Maurano2010nov,
  author       = {Maurano, Andrea and Hamilton, Rick and Shuttle, Chris G. and Ballantyne, Amy M. and Nelson, Jenny and O'Regan, Brian and Zhang, Weimin and McCulloch, Iain and Azimi, Hamed and Morana, Mauro and Brabec, Christoph J. and Durrant, James R.},
