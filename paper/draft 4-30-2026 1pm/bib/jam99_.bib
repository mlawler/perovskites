  journal        = {Phys. Rev. B},
  keywords       = {charge trapping > mechanisms > H2O, charge trapping > mechanisms > O2, charge trapping > mechanisms > epoxide, charge trapping > mechanisms > peroxide, charge trapping > mechanisms > calculations, materials > PES > rubrene, materials > PES > acenes},
  month          = {sep},
