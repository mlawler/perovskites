@article{prince_sustainability_2025,
	title = {Sustainability pathways for perovskite photovoltaics},
	volume = {24},
	issn = {1476-4660},
	url = {https://doi.org/10.1038/s41563-024-01945-6},
	doi = {10.1038/s41563-024-01945-6},
	abstract = {Solar energy is the fastest-growing source of electricity generation globally. As deployment increases, photovoltaic ({PV}) panels need to be produced sustainably. Therefore, the resource utilization rate and the rate at which those resources become available in the environment must be in equilibrium while maintaining the well-being of people and nature. Metal halide perovskite ({MHP}) semiconductors could revolutionize {PV} technology due to high efficiency, readily available/accessible materials and low-cost production. Here we outline how {MHP}-{PV} panels could scale a sustainable supply chain while appreciably contributing to a global renewable energy transition. We evaluate the critical material concerns, embodied energy, carbon impacts and circular supply chain processes of {MHP}-{PVs}. The research community is in an influential position to prioritize research efforts in reliability, recycling and remanufacturing to make {MHP}-{PVs} one of the most sustainable energy sources on the market.},
	pages = {22--33},
	number = {1},
	journaltitle = {Nature Materials},
	journal = {Nat. Mater.},
	author = {Prince, Kevin J. and Mirletz, Heather M. and Gaulding, E. Ashley and Wheeler, Lance M. and Kerner, Ross A. and Zheng, Xiaopeng and Schelhas, Laura T. and Tracy, Paul and Wolden, Colin A. and Berry, Joseph J. and Ovaitt, Silvana and Barnes, Teresa M. and Luther, Joseph M.},
	date = {2025-01-01},
    year={2025},
}

