@article{Zheng2023mar,
  title = {Co-Deposition of Hole-Selective Contact and Absorber for Improving the Processability of Perovskite Solar Cells},
  author = {Zheng, Xiaopeng and Li, Zhen and Zhang, Yi and Chen, Min and Liu, Tuo and Xiao, Chuanxiao and Gao, Danpeng and Patel, Jay B. and Kuciauskas, Darius and Magomedov, Artiom and Scheidt, Rebecca A. and Wang, Xiaoming and Harvey, Steven P. and Dai, Zhenghong and Zhang, Chunlei and Morales, Daniel and Pruett, Henry and Wieliczka, Brian M. and Kirmani, Ahmad R. and Padture, Nitin P. and Graham, Kenneth R. and Yan, Yanfa and Nazeeruddin, Mohammad Khaja and McGehee, Michael D. and Zhu, Zonglong and Luther, Joseph M.},
  year = 2023,
