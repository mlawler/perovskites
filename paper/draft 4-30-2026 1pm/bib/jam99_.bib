  journal   = {Nano Energy},
  keywords  = {project > EFM, personnel > Tirmzi, materials > semiconductor > perovskite, materials > semiconductor > perovskite > contacts, materials > semiconductor > perovskite > contacts > ZnO, materials > semiconductor > perovskite > ion motion, materials > semiconductor > perovskite > low temperature},
