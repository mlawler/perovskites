@Article{Shah2007nov,
  author    = {Shah, Vishal and Knappe, Svenja and Schwindt, Peter D. D. and Kitching, John},
  title     = {Subpicotesla atomic magnetometry with a microfabricated vapour cells},
  volume    = {1},
  number    = {11},
  pages     = {649 -- 652},
  issn      = {1749-4885},
  doi       = {10.1038/nphoton.2007.201},
  url       = {http://dx.doi.org/10.1038/nphoton.2007.201},
  abstract  = {Highly sensitive magnetometers capable of measuring magnetic fields below 1 pT have an impact on areas as diverse as geophysical surveying(1), the detection of unexploded ordinance(2), space science(3), nuclear magnetic resonance(4,5), health care(6) and perimeter and remote monitoring. Recently, it has been shown that laboratory optical magnetometers(7,8), based on the precession of the spins of alkali atoms in the vapour phase, could achieve sensitivities in the femtotesla range, comparable to(9-12), or even exceeding(13), those of superconducting quantum interference devices(6). We demonstrate here an atomic magnetometer based on a millimetre-scale microfabricated alkali vapour cell with sensitivity below 70 fT Hz(-1/2). Additionally, we use a simplified optical configuration that requires only a single low-power laser. This result suggests that millimetre-scale, low-power femtotesla magnetometers are feasible, and we support this proposition with a simple sensitivity scaling analysis. Such an instrument would greatly expand the range of applications in which atomic magnetometers could be used.},
  comment   = {Suggested filename = Shah2007nov Subpicotesla atomic magnetometry with a microfabricated vapour cell 10.1038/nphoton.2007.201 *.pdf

Comments = jam99; millimeter scale; 70 fT/sqrt(Hz) achieved},
  file      = {Shah2007nov Subpicotesla atomic magnetometry with a microfabricated vapour cell 10.1038\:nphoton.2007.201 *.pdf:UNSORTED/Shah2007nov Subpicotesla atomic magnetometry with a microfabricated vapour cell 10.1038\:nphoton.2007.201 *.pdf:PDF},
  journal   = {Nat. Photonics},
  keywords  = {MRFM > competition, MRFM > magnetometry > atomic magnetometer, MRFM > magnetometry > Hanle effect, MRFM > luminescence depolarization},
  month     = {nov},
  owner     = {jam99},
  timestamp = {2019.03.03},
