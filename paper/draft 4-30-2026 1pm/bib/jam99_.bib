Go to http://shortdoi.org/ and get a shortened doi number. Yea!},
  owner     = {jam99},
  timestamp = {2013.11.17},
}

@Article{Frey2006jun,
  author    = {Frey, Terrence G. and Perkins, Guy A. and Ellisman, Mark H.},
  title     = {Electron Tomography of Membrane-Bound Cellular Organelles},
  journal   = {Annu. Rev. Biophys. Biomol. Struct.},
  year      = {2006},
  volume    = {35},
