@article{Dai2022aug,
  title = {Efficient Monolithic All-Perovskite Tandem Solar Modules with Small Cell-to-Module Derate},
  author = {Dai, Xuezeng and Chen, Shangshang and Jiao, Haoyang and Zhao, Liang and Wang, Ke and Ni, Zhenyi and Yu, Zhenhua and Chen, Bo and Gao, Yongli and Huang, Jinsong},
  year = 2022,
