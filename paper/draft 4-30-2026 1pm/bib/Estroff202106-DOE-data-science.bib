@article{Guo2015deca,
  title = {Chemical {{Pathways Connecting Lead}}({{II}}) {{Iodide}} and {{Perovskite}} via {{Polymeric Plumbate}}({{II}}) {{Fiber}}},
  author = {Guo, Yunlong and Shoyama, Kazutaka and Sato, Wataru and Matsuo, Yutaka and Inoue, Kento and Harano, Koji and Liu, Chao and Tanaka, Hideyuki and Nakamura, Eiichi},
  year = 2015,
