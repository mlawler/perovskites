@article{Tai2016apr,
  title = {Efficient and Stable Perovskite Solar Cells Prepared in Ambient Air Irrespective of the Humidity},
  author = {Tai, Qidong and You, Peng and Sang, Hongqian and Liu, Zhike and Hu, Chenglong and Chan, Helen L. W. and Yan, Feng},
  year = 2016,
