@Article{Havugimana2012aug,
  author    = {Havugimana, Pierre~C. and Hart, G.~Traver and Nepusz, Tam\'as and Yang, Haixuan and Turinsky, Andrei~L. and Li, Zhihua and Wang, Peggy~I. and Boutz, Daniel~R. and Fong, Vincent and Phanse, Sadhna and Babu, Mohan and Craig, Stephanie~A. and Hu, Pingzhao and Wan, Cuihong and Vlasblom, James and Dar, Vaqaar-un-Nisa and Bezginov, Alexandr and Clark, Gregory~W. and Wu, Gabriel~C. and Wodak, Shoshana~J. and Tillier, Elisabeth~R.M. and Paccanaro, Alberto and Marcotte, Edward~M. and Emili, Andrew},
