  journal   = {J. Appl. Phys.},
  month     = {oct},
  owner     = {jam99},
  timestamp = {2019.03.03},
  year      = {2010},
}

@Article{Reid2016sep,
  author    = {Reid, Obadiah G. and Yang, Mengjin and Kopidakis, Nikos and Zhu, Kai and Rumbles, Garry},
  title     = {Grain-Size-Limited Mobility in Methylammonium Lead Iodide Perovskite Thin Films},
  volume    = {1},
  number    = {3},
  pages     = {561 -- 565},
  doi       = {10.1021/acsenergylett.6b00288},
  url       = {http://dx.doi.org/10.1021/acsenergylett.6b00288},
  abstract  = {We report a systematic study of the gigahertz-frequency charge carrier mobility found in methylammonium lead iodide perovskite films as a function of average grain size using time-resolved microwave conductivity and a single processing chemistry. Our measurements are in good agreement with the Kubo formula for the AC mobility of charges confined within finite grains, suggesting (1) that the surface grains imaged via scanning electron microscopy are representative of the true electronic domain size and not substantially subdivided by twinning or other defects not visible by microscopy and (2) that the time scale of diffusive transport across grain boundaries is much slower than the period of the microwave field in this measurement (ca 100 ps). The intrinsic (infinite grain size) minimum mobility extracted form the model is 29 [+/-] 6 cm^2/Vs at the probe frequency (8.9 GHz).},
