@Article{Huang2009nov,
  author    = {Xiaojing Huang and Johanna Nelson and Janos Kirz and Enju Lima and Stefano Marchesini and Huijie Miao and Aaron M. Neiman and David Shapiro and Jan Steinbrener and Andrew Stewart and Joshua J. Turner and Chris Jacobsen},
