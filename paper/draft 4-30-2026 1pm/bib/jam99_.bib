  journal   = {J. Phys. Chem. Lett.},
  keywords  = {materials > semiconductor > perovskite, materials > semiconductor > perovskite > MAPbI3, measurements > conductivity, measurements > photoconductivity, project > EFM, personnel > Tirmzi, collaborator > Hanrath, materials > semiconductor > perovskite > contacts},
