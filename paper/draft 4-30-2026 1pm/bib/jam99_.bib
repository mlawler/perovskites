  author    = {Maturov\'a, Kl\'ara and van Bavel, Svetlana S. and Wienk, Martijn M. and Janssen, Ren\'e A. J. and Kemerink, Martijn},
  title     = {Description of the Morphology Dependent Charge Transport and Performance of Polymer:{F}ullerene Bulk Heterojunction Solar Cells},
  journal   = {Adv. Funct. Mater.},
  year      = {2011},
  volume    = {21},
