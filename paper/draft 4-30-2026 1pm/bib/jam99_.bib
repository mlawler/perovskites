@Article{Monzel2009nov,
  author    = {Monzel, Cornelia and Fenz, Susanne F. and Merkel, Rudolf and Sengupta, Kheya},
  title     = {Probing Biomembrane Dynamics by Dual-Wavelength Reflection Interference Contrast Microscopy},
