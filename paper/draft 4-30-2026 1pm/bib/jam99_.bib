@Article{Stieg2008oct,
  author    = {Stieg, A. Z. and Rasool, H. I. and Gimzewski, J. K.},
  title     = {A Flexible, Highly Stable Electrochemical Scanning Probe Microscope for Nanoscale Studies at the Solid-liquid Interface},
  volume    = {79},
  number    = {10},
  pages     = {103701},
  doi       = {10.1063/1.2992480},
  url       = {http://dx.doi.org/10.1063/1.2992480},
  abstract  = {This work describes the design, fabrication, and application of an ultrastable scanning probe microscope for nanoscale studies at the solid-liquid interface, specifically in electrolyte environments. Quantification of system noise limits in the tunneling mode, mechanical drift rates, and lowest mechanical resonance provided values of $\le$ 10 pA/Hz^(1/2), 2 nm/min (XY) and 0.15 nm/min (Z), and 7.9 kHz, respectively. Measurement of the closed-loop transfer function in the tunneling condition demonstrated linear feedback responses up to 4.2 and 2.5 kHz in ambient and electrochemical conditions. Atomic and molecular resolution imagings have been achieved in ambient, in situ, and electrochemical imaging environments at scan rates up to 80 lines/s. A modular design approach has produced a highly flexible microscope capable of imaging and spectroscopy in tunneling, tapping force [amplitude modulation atomic force microscopy (AFM)], and noncontact force (frequency modulation-AFM) modes.},
  comment   = {Suggested filename = {Stieg2008oct A Flexible, Highly Stable Electrochemical Scanning Probe Microscope for Nanoscale Studies at the Solid-liquid Interface.pdf}},
  file      = {Stieg2008oct A Flexible, Highly Stable Electrochemical Scanning Probe Microscope for Nanoscale Studies at the Solid-liquid Interface.pdf:UNSORTED/Stieg2008oct A Flexible, Highly Stable Electrochemical Scanning Probe Microscope for Nanoscale Studies at the Solid-liquid Interface.pdf:PDF},
  journal   = {Rev. Sci. Instrum.},
  keywords  = {SPM > AFM > resolution, SPM > AFM > molecular resolution, project > DOE EMC2},
  month     = {oct},
  owner     = {jam99},
  timestamp = {2019.03.03},
  year      = {2008},
}

@Article{Stieg2007mar,
  author    = {Stieg, A Z and Wilkinson, P and Gimzewski, J K},
  title     = {Vertical inertial sliding drive for coarse and fine approaches in scanning probe microscopy},
  volume    = {78},
  number    = {3},
  pages     = {036110},
  issn      = {0034-6748},
  doi       = {10.1063/1.2712808},
  url       = {http://dx.doi.org/10.1063/1.2712808},
  abstract  = {Mechanisms for controlled approach of a probe tip toward the sample surface are essential in high resolution imaging by scanning probe microscopy (SPM). This work describes the development and performance of an inertial sliding drive capable of translating a relatively large mass (25 g) at up to 1 mms over 1 cm with step sizes of 10-250 nm in ambient conditions using various wave forms as measured by fiber optic interferometry. The drive functions independent of orientation with a threshold voltage of less than 15 V using a single drive signal. Use of piezotube actuators in a radially symmetric arrangement provides guided motion and minimizes differential thermal expansion between critical components. Controlled translation of the entire scanning component in both ambient and electrochemical scanning tunneling microscopy has been routinely achieved with no evidence of tip crash. This device has been specifically designed for use in in situ SPM applications where stability of the sample and that of the liquid environment are paramount.},
  comment   = {Suggested filename = Stieg2007mar Vertical inertial sliding drive for coarse and fine approaches in scanning probe microscopy 10.1063/1.2712808 *.pdf},
  file      = {Stieg2007mar Vertical inertial sliding drive for coarse and fine approaches in scanning probe microscopy 10.1063\:1.2712808 *.pdf:UNSORTED/Stieg2007mar Vertical inertial sliding drive for coarse and fine approaches in scanning probe microscopy 10.1063\:1.2712808 *.pdf:PDF},
  journal   = {Rev. Sci. Instrum.},
  keywords  = {SPM > nanopositioning, SPM > AFM > hardware, nanopositioning, nanopositioning > slip-stick},
  month     = mar,
  owner     = {jam99},
