@Article{Jorritsma1998jul,
  author       = {Jorritsma, J and Mydosh, JA},
  title        = {Temperature-dependent magnetic anisotropy in {Ni} nanowires},
  journal      = {J. Appl. Phys.},
  year         = {1998},
  volume       = {84},
  number       = {2},
  month        = {jul},
  pages        = {901 -- 906},
  issn         = {0021-8979},
  doi          = {10.1063/1.368154},
  url          = {http://dx.doi.org/10.1063/1.368154},
  abstract     = {Magnetic properties of Ni nanowire arrays, prepared by oblique evaporation of Ni onto V-groove InP substrates, were investigated between 5 and 300 K using magnetoresistance and SQUID magnetization measurements. The results show that as-prepared wires, which range from 70-130 nm in width, have an easy axis of magnetization parallel to the wire axis at room temperature, but transverse to the wire axis at low temperature. The crossover of the easy axis direction from transverse to parallel as a function of temperature is more pronounced for the narrower wires. We interpret our results in terms of a competition between a temperature-dependent magnetic anisotropy (K-perpendicular to), which tends to align the magnetization transverse to the wire axis, and the shape anisotropy of the wires which tends to orient it along the wire axis. Several mechanisms are proposed (e.g., oblique evaporation, stress, and surface oxidation) from which K-perpendicular to could originate. Based upon the stress values deduced from K-perpendicular to, and the thermal expansion mismatch between Ni and InP, the stress mechanism appears to dominate. (C) 1998 American Institute of Physics. {[}S0021-8979(98)02814-X].},
  affiliation  = {Jorritsma, J (Reprint Author), Leiden Univ, Kamerlingh Onnes Lab, POB 9506, NL-2300 RA Leiden, Netherlands. Leiden Univ, Kamerlingh Onnes Lab, NL-2300 RA Leiden, Netherlands.},
  author-email = {jorrtsma@rulkol.leidenuniv.nl},
  comment      = {Suggested filename = Jorritsma1998jul Temperature-dependent magnetic anisotropy in Ni nanowires 10.1063/1.368154 *.pdf},
  file         = {Jorritsma1998jul Temperature-dependent magnetic anisotropy in Ni nanowires 10.1063\:1.368154 *.pdf:UNSORTED/Jorritsma1998jul Temperature-dependent magnetic anisotropy in Ni nanowires 10.1063\:1.368154 *.pdf:PDF},
  journal-iso  = {J. Appl. Phys.},
  keywords     = {materials > magnetic > nickel, materials > magnetic > nickel oxide, MRFM > magnetometry > magnetoresistance, nanomagnetics},
  owner        = {jam99},
  timestamp    = {2010.05.28},
  unique-id    = {ISI:000075257800036},
}

@Article{Joye2006jun,
  author    = {Joye, C.D. and Griffin, R.G. and Hornstein, M.K. and Kan-Nian Hu and Kreischer, K.E. and Rosay, M. and Shapiro, M.A. and Sirigiri, J.R. and Temkin, R.J. and Woskov, P.P.},
  title     = {Operational characteristics of a {14-W} {140-GHz} gyrotron for dynamic nuclear polarization},
  journal   = {IEEE Transactions on Plasma Science},
  year      = {2006},
  volume    = {34},
  number    = {3},
  month     = {jun},
  pages     = {518 -- 523},
  issn      = {0093-3813},
  doi       = {10.1109/TPS.2006.875776},
  url       = {http://dx.doi.org/10.1109/TPS.2006.875776},
  abstract  = {The operating characteristics of a 140-GHz 14-W long pulse gyrotron are presented. The device is being used in dynamic nuclear polarization enhanced nuclear magnetic resonance (DNP/NMR) spectroscopy experiments. The gyrotron yields 14 W peak power at 139.65 GHz from the TE(0,3) operating mode using a 12.3-kV 25-mA electron beam. Additionally, up to 12 W peak has been observed in the TE(2,3) mode at 136.90 GHz. A series of mode converters transform the TE(0,3) operating mode to the TE(1,1) mode. Experimental results are compared with nonlinear simulations and show reasonable agreement. The millimeter-wave output beam was imaged in a single shot using a pyroelectric camera. The mode patterns matched reasonably well to theory for both the TE(0,1) mode and the TE(1,1) mode. Repeatable mode patterns were obtained at intervals ranging from 0.8 s apart to 11 min apart at the output of the final mode converter},
  comment   = {keywords = 12 W;12.3 kV;136.90 GHz;139.65 GHz;14 W;140 GHz;25 mA;dynamic nuclear polarization;electron beam;gyrotron;millimeter-wave output beam;mode converters;mode patterns;nonlinear simulations;nuclear magnetic resonance spectroscopy;pyroelectric camera;electron beams;gyrotrons;millimetre wave generation;mode matching;},
  owner     = {Sanggap},
  timestamp = {2010.10.19},
}

@Article{Juarez-Perez2014jul,
  author    = {Juarez-Perez, Emilio J. and Sanchez, Rafael S. and Badia, Laura and Garcia-Belmonte, Germ\'a and Kang, Yong Soo and Mora-Sero, Ivan and Bisquert, Juan},
  title     = {Photoinduced Giant Dielectric Constant in Lead Halide Perovskite Solar Cells},
  journal   = {J. Phys. Chem. Lett.},
  year      = {2014},
  volume    = {5},
  number    = {13},
  month     = {jul},
  pages     = {2390 -- 2394},
  doi       = {10.1021/jz5011169},
  url       = {http://dx.doi.org/10.1021/jz5011169},
  abstract  = {Organic-inorganic lead trihalide perovskites have emerged as an outstanding photovoltaic material that demonstrated a high 17.9 percent conversion efficiency of sunlight to electricity in a short time. We have found a giant dielectric constant (GDC) phenomenon in these materials consisting on a low frequency dielectric constant in the dark of the order of [epsilon0] = 1000. We also found an unprecedented behavior in which [epsilon0] further increases under illumination or by charge injection at applied bias. We observe that [epsilon0] increases nearly linearly with the illumination intensity up to an additional factor 1000 under 1 sun. Measurement of a variety of samples of different morphologies, compositions, and different types of contacts shows that the GDC is an intrinsic property of MAPbX3 (MA = CH3NH3+). We hypothesize that the large dielectric response is induced by structural fluctuations. Photoinduced carriers modify the local unit cell equilibrium and change the polarizability, assisted by the freedom of rotation of MA. The study opens a way for the understanding of a key aspect of the photovoltaic operation of high efficiency perovskite solar cells.},
  comment   = {Suggested filename = {Juarez-Perez2014jul Photoinduced Giant Dielectric Constant in Lead Halide Perovskite Solar Cells.pdf},
Source = {wxdoi2bib}},
  file      = {Juarez-Perez2014jul Photoinduced Giant Dielectric Constant in Lead Halide Perovskite Solar Cells.pdf:UNSORTED/Juarez-Perez2014jul Photoinduced Giant Dielectric Constant in Lead Halide Perovskite Solar Cells.pdf:PDF},
  keywords  = {materials > semiconductor > perovskite, materials > semiconductor > perovskite > MAPbI3, materials > semiconductor > perovskite > MAPbCl3, materials > semiconductor > perovskite > mixed, measurements > dielectric spectroscopy, project > EFM, personnel > Tirmzi, collaborator > Hanrath},
  owner     = {jam99},
  timestamp = {2016.10.08},
}

