@Article{Thorland1972feb,
  author    = {Thorland, R. H. and Garrison, A. K. and DuVarney, R. C.},
  title     = {Stark Shift of Nuclear Spin Levels of $^{9}${Be} in Beryllium Oxide},
  volume    = {5},
  number    = {3},
  pages     = {784--788},
  doi       = {10.1103/PhysRevB.5.784},
  url       = {http://dx.doi.org/10.1103/PhysRevB.5.784},
  abstract  = {Measurements of the angular variation of the quadrupole splitting in the NMR spectrum of 9Be in single-crystal BeO are reported and give e2qQ/h=39.4+/-0.2 kHz. The dependence of the field-gradient parameter q on an applied external electric field is investigated and interpreted using the phenomenological relation of the form e(deltaq)ij=sumRijkEk+sum-sumTijlmelm, where the first term represents the constant-strain electric-field-induced change and the second term represents the piezoelectric contribution. The strain-induced part of deltaq is measured separately and found to be negligible compared with the part due directly to the electric field. We report an experimental value for Rzzz of +/- (1.3 +/- 0.5) X 109 cm-1. Calculations of Rzzz on the basis of ionic and covalent models of the BeO structure give - 4.1 X 108 and - 8.2 × 108 cm-1, respectively, for the ionic and covalent contributions and a total calculated Rzzz of - 1.2 X 109 cm-1. It is thus unlikely that the ionic model can account for the observed Stark shift. A determination of the crystal c axis was made using the pyroelectric effect and this, together with the Stark-shift data, indicates that the sign of the field gradient is positive.},
  comment   = {suggested filename = Thorland1972feb Stark Shift of Nuclear Spin Levels of Be in Beryllium Oxide 10.1103/PhysRevB.5.784 *.pdf},
  file      = {Thorland1972feb Stark Shift of Nuclear Spin Levels of Be in Beryllium Oxide 10.1103\:PhysRevB.5.784 .pdf:UNSORTED/Thorland1972feb Stark Shift of Nuclear Spin Levels of Be in Beryllium Oxide 10.1103\:PhysRevB.5.784 .pdf:PDF},
  journal   = {Phys. Rev. B},
  keywords  = {Stark effect, magnetic resonance > Stark shifts},
  month     = {feb},
  numpages  = {4},
  owner     = {Jonilyn},
  publisher = {American Physical Society},
  timestamp = {2019.03.03},
  year      = {1972},
}

