@article{Mbumba2021oct,
  title = {Compositional Engineering Solutions for Decreasing Trap State Density and Improving Thermal Stability in Perovskite Solar Cells},
  author = {Mbumba, Manala Tabu and Malouangou, Davy Maurice and Tsiba, Jadel Matondo and Akram, Muhammad Waleed and Bai, Luyun and Yang, Yifan and Guli, Mina},
  year = 2021,
