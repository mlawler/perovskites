  journal = {J. Chem. Theory Comput.},
  volume = {12},
  number = {2},
  pages = {825--838},
  doi = {10.1021/acs.jctc.5b00918},
  abstract = {For colloidal quantum dots to transition from research laboratories to deployment as optical and electronic products, there will be a need to scale-up their production to large-scale manufacturing processes. This demand increases the need to understand their formation via a molecular representation of the nucleation of lead sulfide (PbS) quantum dot systems passivated by lead oleate complexes. We demonstrate the effectiveness of a new type of reactive potential, custom-made for this system, that is drawn from simple Morse, Lennard-Jones, and Coulombic components, which can reproduce reactions across a broad range of PbS quantum dot sizes with good accuracy. We validate the capability of this model to capture reactive systems by comparison to ab initio calculations for a reaction between two dots.},
  keywords = {duplicate-citation-key},
  timestamp = {2019.03.03}
}

@article{Armstrong2020jan,
  title = {Ultrafast Shock Synthesis of Nanocarbon from a Liquid Precursor},
  author = {Armstrong, Michael R. and Lindsey, Rebecca K. and Goldman, Nir and Nielsen, Michael H. and Stavrou, Elissaios and Fried, Laurence E. and Zaug, Joseph M. and Bastea, Sorin},
