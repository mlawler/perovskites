@Article{Morteani2004jun,
  author    = {Morteani, Arne C. and Sreearunothai, Paiboon and Herz, Laura M. and Friend, Richard H. and Silva, Carlos},
  title     = {Exciton Regeneration at Polymeric Semiconductor Heterojunctions},
