@Article{Schlenker2011apr,
  author    = {Schlenker, Cody W. and Thompson, Mark E.},
  title     = {The Molecular Nature of Photovoltage Losses in Organic Solar Cells},
  volume    = {47},
  issue     = {13},
  pages     = {3702 -- 3716},
  doi       = {10.1039/C0CC04020G},
  url       = {http://dx.doi.org/10.1039/C0CC04020G},
  abstract  = {Since the inception of heterojunction organic photovoltaic research the organic/organic interface has been thought to play a crucial role in determining the magnitude of the open-circuit voltage. Yet{,} the task of defining the molecular properties dictating the photovoltage delivered by these devices{,} that employ mixed or neat layers of different organic molecules to convert incident photons to electricity{,} is still an active area of research. This will likely be a key step in designing the new materials required for improving future device efficiencies. With the intent to underscore the importance of considering both thermodynamic and kinetic factors{,} this article highlights recent progress in elucidating molecular characteristics dictating photovoltage losses in heterojunction organic photovoltaics.},
  comment   = {Suggested filename = Schlenker2011apr The molecular nature of photovoltage losses in organic solar cells 10.1039/C0CC04020G *.pdf

Cites Groves2010may

Conclusion ~ WOW ~

The outlook for organic photovoltaic devices as an economically
viable solar energy conversion technology is extremely
promising. However, despite continued improvements in
single junction OPV power conversion efficiencies, certified
record efficiencies have still not exceeded the tacit 10% minimum
requirement considered practical for consumer applications.
Photovoltage losses are a major contributing factor. The
content of this article is intended to help the reader appreciate
the photoelectrochemical origin of photovoltage losses in OPV
devices and encourage the chemical community to undertake a
coordinated effort in developing new materials, device
architectures, characterization techniques, and theoretical
models that address these potential losses.},
  file      = {Schlenker2011apr The molecular nature of photovoltage losses in organic solar cells 10.1039\:C0CC04020G *.pdf:UNSORTED/Schlenker2011apr The molecular nature of photovoltage losses in organic solar cells 10.1039\:C0CC04020G *.pdf:PDF},
