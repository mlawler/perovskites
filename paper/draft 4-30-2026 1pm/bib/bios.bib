    journal = "Science",
    keywords = "project > EFM, materials > semiconductor > perovskite > CsPbI3, collaborator > NREL, collaborator > Moore",
    month = "oct",
    owner = "jam99",
    timestamp = "2019.03.03",
    year = "2016"
}

