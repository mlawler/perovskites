  timestamp = {2019.03.03},
  year      = {2017},
}

@Article{Dong2015may,
  author    = {Dong, Qingshun and Shi, Yantao and Wang, Kai and Li, Yu and Wang, Shufeng and Zhang, Hong and Xing, Yujin and Du, Yi and Bai, Xiaogong and Ma, Tingli},
  title     = {Insight Into Perovskite Solar Cells Based on SnO$_{2}$ Compact Electron-Selective Layer},
  volume    = {119},
  number    = {19},
  pages     = {10212 -- 10217},
  doi       = {10.1021/acs.jpcc.5b00541},
  url       = {http://dx.doi.org/10.1021/acs.jpcc.5b00541},
  abstract  = {Considering the remarkable progress in photovoltaic performance, scholars have focused on perovskite solar cells (PSCs) over the recent two years. TiO2 thin film is a semiconductor with a wide band gap and is usually used as an electron-selective layer (ESL) in PSCs. Although SnO2 exhibits conductivity higher than that of TiO2, its use as a compact ESL in PSCs has not been reported. In this study, nanocrystalline SnO2 thin film was prepared through a sol-gel method and then characterized. The prepared SnO2 thin film was composed of small tetragonal rutile nanocrystals. We applied the SnO2 compact ESL into PSCs and compared their performance with that of PSCs based on a TiO2 thin layer. SnO2-ESL-based PSCs (S-PSCs) showed higher short-circuit current density and lower open-circuit voltage, fill factor, and conversion efficiency than the conventional TiO2-ESL-based PSCs. Furthermore, the photovoltaic performance of S-PSCs was highly dependent on measurement means, and this relationship was investigated and is discussed in detail.},
  comment   = {Suggested filename = {Dong2015may Insight Into Perovskite Solar Cells Based on SnO2 Compact Electron-Selective Layer.pdf},
Source = {wxdoi2bib},
Cited = {jam99, 04.05.18: 61 times}},
  file      = {Dong2015may Insight Into Perovskite Solar Cells Based on SnO2 Compact Electron-Selective Layer.pdf:Dong2015may Insight Into Perovskite Solar Cells Based on SnO2 Compact Electron-Selective Layer.pdf:PDF},
  journal   = {J. Phys. Chem. C},
  keywords  = {project > EFM, personnel > Tirmzi, collaborator > NREL, materials > semiconductor > perovskite, materials > semiconductor > perovskite > contacts, materials > semiconductor > perovskite > contacts > SnO2},
  month     = {may},
  owner     = {jam99},
  timestamp = {2019.03.03},
  year      = {2015},
}

@Article{CorreaBaena2015oct,
  author    = {Correa Baena, Juan Pablo and Steier, Ludmilla and Tress, Wolfgang and Saliba, Michael and Neutzner, Stefanie and Matsui, Taisuke and Giordano, Fabrizio and Jacobsson, T. Jesper and Srimath Kandada, Ajay Ram and Zakeeruddin, Shaik M. and Petrozza, Annamaria and Abate, Antonio and Nazeeruddin, Mohammad Khaja and Gr\"atzel, Michael and Hagfeldt, Anders},
  title     = {Highly Efficient Planar Perovskite Solar Cells Through Band Alignment Engineering},
  volume    = {8},
  number    = {10},
  pages     = {2928 -- 2934},
  doi       = {10.1039/C5EE02608C},
  url       = {http://dx.doi.org/10.1039/C5EE02608C},
  abstract  = {The simplification of perovskite solar cells (PSCs), by replacing the mesoporous electron selective layer (ESL) with a planar one, is advantageous for large-scale manufacturing. PSCs with a planar TiO2 ESL have been demonstrated, but these exhibit unstabilized power conversion efficiencies (PCEs). Herein we show that planar PSCs using TiO2 are inherently limited due to conduction band misalignment and demonstrate, with a variety of characterization techniques, for the first time that SnO2 achieves a barrier-free energetic configuration, obtaining almost hysteresis-free PCEs of over 18 [percent] with record high voltages of up to 1.19 V.},
  comment   = {Suggested filename = {CorreaBaena2015oct Highly Efficient Planar Perovskite Solar Cells Through Band Alignment Engineering.pdf},
Source = {wxdoi2bib},
Cited = {jam99, 04.05.18: 239 times}},
  file      = {CorreaBaena2015oct Highly Efficient Planar Perovskite Solar Cells Through Band Alignment Engineering.pdf:CorreaBaena2015oct Highly Efficient Planar Perovskite Solar Cells Through Band Alignment Engineering.pdf:PDF},
  journal   = {Energy Environ. Sci.},
  keywords  = {project > EFM, personnel > Tirmzi, materials > semiconductor > perovskite, materials > semiconductor > perovskite > contacts, materials > semiconductor > perovskite > contacts > SnO2, materials > semiconductor > perovskite > contacts > TiO2},
  month     = {oct},
  owner     = {jam99},
  timestamp = {2019.03.03},
  year      = {2015},
}

@Article{Draguta2017dec,
  author    = {Draguta, Sergiu and Sharia, Onise and Yoon, Seog Joon and Brennan, Michael C. and Morozov, Yurii V. and Manser, Joseph S. and Kamat, Prashant V. and Schneider, William F. and Kuno, Masaru},
  title     = {Rationalizing the Light-induced Phase Separation of Mixed Halide Organic--inorganic Perovskites},
  volume    = {8},
  number    = {1},
  pages     = {4088},
  doi       = {10.1038/s41467-017-00284-2},
  url       = {http://dx.doi.org/10.1038/s41467-017-00284-2},
  abstract  = {Mixed halide hybrid perovskites, CH3NH3Pb(I1-xBrx)(3), represent good candidates for low-cost, high efficiency photovoltaic, and light-emitting devices. Their band gaps can be tuned from 1.6 to 2.3 eV, by changing the halide anion identity. Unfortunately, mixed halide perovskites undergo phase separation under illumination. This leads to iodide-and bromide-rich domains along with corresponding changes to the material's optical/electrical response. Here, using combined spectroscopic measurements and theoretical modeling, we quantitatively rationalize all microscopic processes that occur during phase separation. Our model suggests that the driving force behind phase separation is the bandgap reduction of iodide-rich phases. It additionally explains observed non-linear intensity dependencies, as well as self-limited growth of iodide-rich domains. Most importantly, our model reveals that mixed halide perovskites can be stabilized against phase separation by deliberately engineering carrier diffusion lengths and injected carrier densities.},
  comment   = {Suggested filename = {Draguta2017dec Rationalizing the Light-induced Phase Separation of Mixed Halide Organic--inorganic Perovskites.pdf},
Source = {wxdoi2bib},
Cited = {jam99, 04.05.18: 8 times}},
  file      = {Draguta2017dec Rationalizing the Light-induced Phase Separation of Mixed Halide Organic--inorganic Perovskites.pdf:Draguta2017dec Rationalizing the Light-induced Phase Separation of Mixed Halide Organic--inorganic Perovskites.pdf:PDF},
  journal   = {Nat Commun},
  keywords  = {project > EFM, personnel > Tirmzi, materials > semiconductor > perovskite, materials > semiconductor > perovskite > ion motion, materials > semiconductor > perovskite > mixed anion},
  month     = {dec},
  owner     = {jam99},
  timestamp = {2019.03.03},
  year      = {2017},
}

@Article{Collins2018feb,
  author    = {Collins, Liam and Ahmadi, Mahshid and Qin, Jiajun and Ovchinnikova, Olga S. and Hu,Bin and Jesse, Stephen and Kalinin, Sergei V.},
  title     = {Mapping Fast Evolution of Transient Surface Photovoltage Dynamics using {G}-mode {K}elvin Probe Force Microscopy},
  url       = {https://arxiv.org/abs/1802.06102},
  abstract  = {Optoelectronic phenomena in materials such as organic/inorganic hybrid perovskites depend on a complex interplay between light induced carrier generation and fast (electronic) and slower (ionic) processes, all of which are known to be strongly affected by structural inhomogeneities such as interfaces and grain boundaries. Here, we develop a time resolved Kelvin probe force microscopy (KPFM) approach, based on the G-Mode SPM platform, allowing quantification of surface photovoltage (SPV) with microsecond temporal and nanoscale spatial resolution. We demonstrate the approach on methylammonium lead bromide (MAPbBr3) thin films and further highlight the usefulness of unsupervised clustering methods to quickly discern spatial variability in the information rich SPV dataset. Using this technique, we observe concurrent spatial and ultra-fast temporal variations in the SPV generated across the thin film, indicating that structure is likely responsible for the heterogenous behavior.},
  comment   = {Suggested filename = {Collins2018feb Mapping Fast Evolution of Transient Surface Photovoltage Dynamics using G-mode Kelvin Probe Force Microscopy.pdf}},
  file      = {:Collins2018feb Mapping Fast Evolution of Transient Surface Photovoltage Dynamics using G-mode Kelvin Probe Force Microscopy.pdf:PDF},
  journal   = {{arXiv:1802.06102}},
  keywords  = {project > EFM, personnel > Tirmzi, SPM > KPFM, SPM > G-mode, SPM > surface photovoltage, SPM > ultrafast, materials > semiconductor > perovskite},
  month     = {2},
  owner     = {jam99},
  timestamp = {2019.03.03},
  year      = {2018},
}

@Article{Miller2014oct,
  author    = {Miller, Elisa M. and Zhao, Yixin and Mercado, Candy C. and Saha, Sudip K. and Luther, Joseph M. and Zhu, Kai and Stevanovic, Vladan and Perkins, Craig L. and van de Lagemaat, Jao},
  title     = {Substrate-controlled Band Positions in CH$_{3}$NH$_{3}$PbI$_{3}$ Perovskite Films},
  volume    = {16},
  number    = {40},
  pages     = {22122 -- 22130},
  doi       = {10.1039/C4CP03533J},
  url       = {http://dx.doi.org/10.1039/C4CP03533J},
  abstract  = {Using X-ray and ultraviolet photoelectron spectroscopy, the surface band positions of solution-processed CH(3)NH(3)Pbl(3) perovskite thin films deposited on an insulating substrate (Al2O3), various n-type (TiO2, ZrO2, ZnO, and F:SnO2 (FTO)) substrates, and various p-type (PEDOT:PSS, NiO, and Cu2O) substrates are studied. Many-body GW calculations of the valence band density of states, with spin orbit interactions included, show a clear correspondence with our experimental spectra and are used to confirm our assignment of the valence band maximum. These surface-sensitive photoelectron spectroscopy measurements result in shifting of the CH(3)NH(3)Pbl(3) valence band position relative to the Fermi energy as a function of substrate type, where the valence band to Fermi energy difference reflects the substrate type (insulating-, n-, or p-type). Specifically, the insulating- and n-type substrates increase the CH(3)NH(3)Pbl(3) valence band to Fermi energy difference to the extent of pinning the conduction band to the Fermi level; whereas, the p-type substrates decrease the valence band to Fermi energy difference. This observation implies that the substrate's properties enable control over the band alignment of CH(3)NH(3)Pbl(3) perovskite thin-film devices, potentially allowing for new device architectures as well as more efficient devices.},
  comment   = {Suggested filename = {Miller2014oct Substrate-controlled Band Positions in CH3NH3PbI3 Perovskite Films.pdf},
Source = {wxdoi2bib},
Cited = {jam99, 04.06.18: 72 times},
Notes = {jam99, 04.08.18: Web of Science title is "Substrate-controlled band positions in CH(3)NH(3)Pbl(3) perovskite films"}},
  file      = {Miller2014oct Substrate-controlled Band Positions in CH3NH3PbI3 Perovskite Films.pdf:Miller2014oct Substrate-controlled Band Positions in CH3NH3PbI3 Perovskite Films.pdf:PDF},
  journal   = {Phys. Chem. Chem. Phys.},
  keywords  = {project > EFM, personnel > Tirmzi, materials > semiconductor > perovskite, materials > semiconductor > perovskite > contacts},
  month     = {oct},
  owner     = {jam99},
  timestamp = {2019.03.03},
  year      = {2014},
}

@Article{Zu2017nov,
  author    = {Zu, Fengshuo and Amsalem, Patrick and Ralaiarisoa, Maryline and Schultz, Thorsten and Schlesinger, Raphael and Koch, Norbert},
  title     = {Surface State Density Determines the Energy Level Alignment at Hybrid Perovskite/Electron Acceptors Interfaces},
  volume    = {9},
  number    = {47},
  pages     = {41546 -- 41552},
  doi       = {10.1021/acsami.7b12586},
  url       = {http://dx.doi.org/10.1021/acsami.7b12586},
  abstract  = {Substantial variations in the electronic structure and thus possibly conflicting energetics at interfaces between hybrid perovskites and charge transport layers in solar cells have been reported by the research community. In an attempt to unravel the origin of these variations and enable reliable device design, we demonstrate that donor-like surface states stemming from reduced lead (Pb-0) directly impact the energy level alignment at perovskite (CH3NH3PbI3-xClx) and molecular electron acceptor layer interfaces using photoelectron spectroscopy. When forming the interfaces, it is found that electron transfer from surface states to acceptor molecules occurs, leading to a strong decrease in the density of ionized surface states. As a consequence, for perovskite samples with low surface state density, the initial band bending at the pristine perovskite surface can be flattened upon interface formation. In contrast, for perovskites with a high surface state density, the Fermi level is strongly pinned at the conduction band edge, and only minor changes in surface band bending are observed upon acceptor deposition. Consequently, depending on the initial perovskite surface state density, very different interface energy level alignment situations (variations over 0.5 eV) are demonstrated and rationalized. Our findings help explain the rather dissimilar reported energy levels at interfaces with perovskites, refining our understanding of the operating principles in devices comprising this material.},
  comment   = {Suggested filename = {Zu2017nov Surface State Density Determines the Energy Level Alignment at Hybrid Perovskite/Electron Acceptors Interfaces.pdf},
Source = {wxdoi2bib},
PI = {Norbert Koch @ Berlin},
Quote = {jam99, 04.09.18: "... our findings help to rationalize the discrepancies regarding the ELA reported in literature for similar interfaces."}},
  file      = {Zu2017nov Surface State Density Determines the Energy Level Alignment at Hybrid Perovskite/Electron Acceptors Interfaces.pdf:Zu2017nov Surface State Density Determines the Energy Level Alignment at Hybrid Perovskite\:Electron Acceptors Interfaces.pdf:PDF},
  journal   = {ACS Appl. Mater. Interfaces},
  keywords  = {project > EFM, personnel > Tirmzi, materials > semiconductor > perovskite, materials > semiconductor > perovskite > contacts},
  month     = {nov},
  owner     = {jam99},
  timestamp = {2019.03.03},
  year      = {2017},
}

