}

@Article{Guo2009jan,
  author       = {Guo, Xuefeng and Xiao, Shengxiong and Myers, Matthew and Miao, Qian and Steigerwald, Michael L. and Nuckolls, Colin},
  title        = {Photoresponsive nanoscale columnar transistors},
  journal      = {Proc. Natl. Acad. Sci.},
  year         = {2009},
  volume       = {106},
  number       = {3},
  month        = {jan},
  pages        = {691 -- 696},
  issn         = {0027-8424},
  doi          = {10.1073/pnas.0807596106},
  url          = {http://dx.doi.org/10.1073/pnas.0807596106},
  abstract     = {This study reports a general methodology for making stable high-performance photosensitive field effect transistors (FET) from self-assembled columns of polycyclic aromatic hydrocarbons by using single-walled carbon nanotubes (SWNTs) as point contacts. In particular, the molecules used in this work are liquid crystalline materials of tetra(dodecyloxy) hexabenzocoronenes (HBCs) that are able to self-organize into columnar nanostructures with a diameter similar to that of SWNTs and then form nanoscale columnar transistors. To rule out potential artifacts, 2 different structural approaches were used to construct devices. One approach is to coat thin films of HBCs onto the devices with the SWNT-metal junctions protected by hydrogensilsesquioxane resin (HSQ), and the other is to place a droplet of HBC exactly on the nanogaps of SWNT electrodes. Both types of devices showed typical FET behaviors, indicating that SWNT-molecule-SWNT nano-junctions are responsible for the electrical characteristics of the devices. After thermally annealing the devices, HBC molecules assembled into columnar structures and formed more efficacious transistors with increased current modulation and higher gate efficiency. More interestingly, when the devices were exposed to visible light, photocurrents with an on/off ratio of >3 orders of magnitude were observed. This study demonstrates that stimuli-responsive nanoscale transistors have the potential applications in ultrasensitive devices for environmental sensing and solar energy harvesting.},
  affiliation  = {Guo, XF (Reprint Author), Peking Univ, Coll Chem \& Mol Engn, Ctr Nanochem, Beijing Natl Lab Mol Sci,State Key Lab Struct Che, Beijing 100871, Peoples R China. {[}Guo, Xuefeng] Peking Univ, Coll Chem \& Mol Engn, Ctr Nanochem, Beijing Natl Lab Mol Sci,State Key Lab Struct Che, Beijing 100871, Peoples R China. {[}Xiao, Shengxiong; Myers, Matthew; Steigerwald, Michael L.; Nuckolls, Colin] Columbia Univ, Ctr Elect Mol Nanostruct, New York, NY 10027 USA. {[}Xiao, Shengxiong; Myers, Matthew; Steigerwald, Michael L.; Nuckolls, Colin] Columbia Univ, Dept Chem, New York, NY 10027 USA. {[}Miao, Qian] Chinese Univ Hong Kong, Dept Chem, Shatin, Hong Kong, Peoples R China.},
  author-email = {cn37@columbia.edu},
  comment      = {Suggested filename = Guo2009jan Photoresponsive nanoscale columnar transistors 10.1073/pnas.0807596106 *.pdf},
  file         = {Guo2009jan Photoresponsive nanoscale columnar transistors 10.1073\:pnas.0807596106 *.pdf:UNSORTED/Guo2009jan Photoresponsive nanoscale columnar transistors 10.1073\:pnas.0807596106 *.pdf:PDF},
  journal-iso  = {Proc. Natl. Acad. Sci. U. S. A.},
  keywords     = {materials > PES > hexabenzocoronene, materials > PES > HBC, charge transport > measurements > transistor, charge transport > measurements > photocurrent},
  owner        = {jam99},
