  unique-id = {ISI:A1979HM71900009},
}

@Article{Dai2009dec,
  author    = {Dai, Wei and Wang, Haijiang and Yuan, Xiao-Zi and Martin, Jonathan J. and Yang, Daijun and Qiao, Jinli and Ma, Jianxin},
  title     = {A Review on Water Balance in the Membrane Electrode Assembly of Proton Exchange Membrane Fuel Cells},
