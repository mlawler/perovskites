@Article{Yan2008may,
  author    = {Yan, Liuming and Ji, Xiaobo and Lu, Wencong},
  title     = {Molecular Dynamics Simulations of Electroosmosis in Perfluorosulfonic Acid Polymer},
  volume    = {112},
  number    = {18},
  pages     = {5602 -- 5610},
  doi       = {10.1021/jp7121449},
  url       = {http://dx.doi.org/10.1021/jp7121449},
  abstract  = {An atomistic MD simulation method has been developed to study the electroosmotic drag in the hydrated perfluorosulfortic acid polymer. The transport characteristics of the hydroniums and water molecules are evaluated from their velocity distribution functions with an electric field applied. It is shown that the microstructure of the hydrated perfluorosulfonic acid polymer is not perturbed significantly by the electric field up to 2 V/mu m, and the velocity distribution functions obey the peak shifted Maxwell velocity distribution functions. The evaluated peak shifting velocities are only about 1\% of the average thermal Motion. The hydronium flow and water flow are evaluated from the average transport velocities or the peak shifting velocities. The electroosmotic drag coefficients from the MD simulations are in good correspondence with the experimental values. It is also shown that the electroosmotic drag coefficient has no or weak temperature dependence.},
  comment   = {Suggested filename = {Yan2008may Molecular Dynamics Simulations of Electroosmosis in Perfluorosulfonic Acid Polymer.pdf}},
  file      = {Yan2008may Molecular Dynamics Simulations of Electroosmosis in Perfluorosulfonic Acid Polymer.pdf:UNSORTED/Yan2008may Molecular Dynamics Simulations of Electroosmosis in Perfluorosulfonic Acid Polymer.pdf:PDF},
  journal   = {J. Phys. Chem. B},
  keywords  = {project > DOE EMC2, device > fuel cell > electro-osmotic drag},
  month     = {may},
  owner     = {jam99},
  timestamp = {2019.03.03},
  year      = {2008},
}

