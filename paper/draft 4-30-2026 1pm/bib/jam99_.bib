  title     = {Charge-carrier injection into CuPc thin films: a scanning tunneling microscopy study},
  journal   = {Synthetic Metals},
  year      = {2001},
  volume    = {122},
  number    = {1},
  month     = {may},
  pages     = {73 - 77},
  note      = {<ce:title>Proceedings of the E-MRS 2000 Spring Meeting, Symposium I</ce:title>},
