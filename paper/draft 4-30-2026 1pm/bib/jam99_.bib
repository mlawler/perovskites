  journal-iso = {Nat. Mater.},
  keywords    = {devices > solar cell > PES > bulk heterojunction, materials > PES > PFB, materials > PES > F8T2, SPM > EFM > PES, SPM > methods > frequency shift, SPM > methods > force-gradient, charge separation > measurements > EFM},
  owner       = {jam99},
  timestamp   = {2009.07.31},
  type        = {Article},
