  keywords  = {devices > solar cell > tandem},
  month     = {aug},
  owner     = {jam99},
  timestamp = {2019.03.03},
  year      = {2011},
}

@Article{Yang2010jun,
  author    = {Yang, Jin and Zhang, Zhaozhu and Men, Xuehu and Xu, Xianghui and Zhu, Xiaotao},
  title     = {Reversible Superhydrophobicity to Superhydrophilicity Switching of a Carbon Nanotube Film via Alternation of UV Irradiation and Dark Storage},
  volume    = {26},
  number    = {12},
  pages     = {10198 -- 10202},
  doi       = {10.1021/la100355n},
  url       = {http://dx.doi.org/10.1021/la100355n},
  abstract  = {We describe a simple method of fabricating a superhydrophobic carbon nanotube (CNT) film without any chemical modification. A remarkable surface wettability transition between superhydrophobicity and superhydrophilicity can be easily observed by the alternation of UV irradiation and dark storage. The adsorption and desorption of surface water molecules on the CNT surfaces account for their tunable surface wettability, which is disclosed by X-ray photoelectron spectroscopy analysis. We also perform a series of comparison experiments to confirm the explanation of its distinctive surface wettability. This switchable wettability on the CNT film could have potential applications in areas requiring multifunctional CNT-based films.},
  comment   = {Suggested filename = Yang2010jun Reversible Superhydrophobicity to Superhydrophilicity Switching of a Carbon Nanotube Film via Alternation of UV Irradiation and Dark Storage 10.1021/la100355n *.pdf},
  file      = {Yang2010jun Reversible Superhydrophobicity to Superhydrophilicity Switching of a Carbon Nanotube Film via Alternation of UV Irradiation and Dark Storage 10.1021\:la100355n *.pdf:UNSORTED/Yang2010jun Reversible Superhydrophobicity to Superhydrophilicity Switching of a Carbon Nanotube Film via Alternation of UV Irradiation and Dark Storage 10.1021\:la100355n *.pdf:PDF},
  journal   = {Langmuir},
  keywords  = {materials > properties > superhydrophilic},
