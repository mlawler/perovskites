@Unpublished{Longenecker2012jul,
  Title                    = {High gradient cobalt nanomagnets integrated on attonewton-sensitivity cantilevers for scanned probe magnetic resonance detection of nuclear spins},
  Author                   = {Jonilyn G. Longenecker and H. John Mamin and Alex W. Senko and Lei Chen and Charles T. Rettner and Daniel Rugar and John A. Marohn},
  Note                     = {Gordon Research Conference on Nanostructure Fabrication; Biddeford, Maine; July 15 -- 20},

  Month                    = {jul},
  Year                     = {2012},

  Abstract                 = {There is a critical need for a technique capable of non-invasive high resolution imaging of single copies of delicate biomolecules and as-fabricated semiconductor and spintronics devices. Magnetic resonance force microscopy (MRFM) detects magnetic resonance as a force between a magnetic tip and nuclear spins, and MRFM has been used to noninvasively obtain 3D images with sub-10 nm resolution of the protons within single copies of a virus [1]. Maximizing the spin force in MRFM demands a high field gradient, and in order to study a wide range of samples it is critical to position the source of this high gradient, in our case a nanomagnet, on the leading edge of the force sensor. Building on the work of Longenecker et al. [2], here we detail the successful fabrication and characterization of attonewton-sensitivity cantilevers with overhanging cobalt nanomagnetic tips. The nanomagnets were patterned using electron beam lithography, evaporation, and liftoff, and nanomagnet-tipped chips were attached to custom attonewton-sensitivity cantilevers by a novel dual-beam focused ion beam (FIB) manipulation process. Tip material was characterized by XPS and SQUID magnetometry, and individual tips were characterized by cantilever magnetometry. MRFM signal from protons in a polystyrene film was studied as a function of rf irradiation frequency and tip-sample separation to characterize the tip field gradient. We observed a gradient of 5×106 Tm-1, which is comparable to the gradient used in the sub-10 nm experiment in Ref. 1 and is larger by nearly an order of magnitude than the gradient achieved in prior magnet-on-tip MRFM experiments. Our results thus demonstrate – for the first time – the feasibility of achieving 4 to 10 nm resolution proton magnetic resonance imaging of a wide range of thin-film samples and devices.

[1] C. Degen et al., Proc. Natl. Acad. Sci. 106(5), 1313 (2009). 
[2] J.G. Longenecker et al., J. Vac. Sci. Technol. B 29, 032001 (2011).},
  Keywords                 = {marohn-talk-contributed, grant-Marohn-NIH-5R01GM-070012, grant-Sidles-ARO-W911NF-05-1-0403, grant-CNS-NSF-EEC-0646547, grant-CNS-NSF-EEC-0117770},
  Owner                    = {jam99},
  Timestamp                = {2012.05.14},
  Url                      = {http://www.grc.org/programs.aspx?year=2012\&program=nanofab}
}

@Unpublished{Longenecker2012jula,
  Title                    = {High gradient nanomagnets on cantilevers used for {NMR-MRFM} force detection},
  Author                   = {Jonilyn G. Longenecker and H. J. Mamin and Alexander W. Senko and Lei Chen and Charles T. Rettner and Daniel Rugar and John A. Marohn},
  Note                     = {NanoMRI Conference 2012; Ascona, Switzerland; July 22 -- 27},

  Month                    = {jul},
  Year                     = {2012},

  Abstract                 = {Poster abstract (Longenecker; jgl62@cornell.edu)

High gradient nanomagnets on cantilevers used for NMR-MRFM force detection

Jonilyn G. Longenecker [a,*], H. J. Mamin [b], Alexander W. Senko [c], Lei Chen [a], Charles T. Rettner [b], Daniel Rugar [b], and John A. Marohn [a]

[a] Dept. of Chemistry and Chemical Biology, Cornell University, Ithaca, New York 14853
[b] IBM Research Division, Almaden Research Center, San Jose, California 95120
[c] Dept. of Materials Science and Engineering, Cornell University, Ithaca, New York 14853
* Email: jgl62@cornell.edu

Sub-10 nm resolution proton imaging has previously been achieved by detecting magnetic resonance as a force between nuclear spins in a single copy of a tobacco mosaic virus on a cantilever and a magnetic tip located on a surface [1]. Most biomacromolecules denature when dried or slowly cooled to cryogenic temperatures. While the Degen et al. experiment achieved unprecedented NMR-MRFM imaging resolution, the “sample-on-cantilever” nature of the experiment precludes the use of cryopreservation techniques. Switching instead to the “magnet-on-cantilever” geometry would enable the study of a broad range of samples, but previous magnet-tipped cantilevers prepared by focused ion beam milling of the magnet have produced damaged magnets with relatively low tip field gradients. Since acquisition time is proportional to the inverse of the field gradient to the fourth power in a spin-noise experiment, developing magnet-tipped cantilevers with tip field gradients comparable to or higher than the 4.2 MT/m vertical field gradient of Degen et al. is critical.

Here we report the development of attonewton-sensitivity cantilevers with integrated high gradient cobalt nanorod tips. To fabricate the electron-beam-defined cobalt tips in high yield, the nickel-tip process of Longenecker et al. [2] was revised to avoid high-temperature processing steps. Characterization of the integrity of the cobalt nanomagnet was conducted using in situ frequency shift cantilever magnetometry. Cantilever dissipation and frequency fluctuations were studied as a function of magnetic field and tip-sample separation. MRFM signal from protons in a polystyrene film was studied versus rf irradiation and tip-sample separation, and from this data the tip field and tip field gradient were evaluated. Damage mechanisms were assessed by numerically modeling the frequency dependence of the magnetic resonance signal. We observed a vertical tip field gradient estimated to be between 4.4 and 5.4 MT/m, which is larger by nearly an order of magnitude than the gradients achieved in prior magnet-on-cantilever MRFM experiments and comparable to the gradient achieved by Degen et al. in their sub-10 nm proton imaging experiment.


[1] C. Degen et al., Proc. Natl. Acad. Sci. 106(5), 1313 (2009).
[2] J.G. Longenecker et al., J. Vac. Sci. Technol. B 29, 032001 (2011).},
  Keywords                 = {marohn-poster, grant-Marohn-NIH-5R01GM-070012, grant-Sidles-ARO-W911NF-05-1-0403, grant-CNS-NSF-EEC-0646547, grant-CNS-NSF-EEC-0117770},
  Owner                    = {jam99},
  Timestamp                = {2012.10.11},
  Url                      = {http://www.spin.ethz.ch/NanoMRI}
}

@Unpublished{Longenecker2012julb,
  Title                    = {Development and characterization of high-gradient cobalt-tipped cantilevers},
  Author                   = {Jonilyn G. Longenecker and H. J. Mamin and Alexander W. Senko and Lei Chen and Charles T. Rettner and Daniel Rugar and John A. Marohn},
  Note                     = {NanoMRI Conference 2012; Ascona, Switzerland; July 22 -- 27},

  Month                    = {jul},
  Year                     = {2012},

  Abstract                 = {Talk abstract (Longenecker; jgl62@cornell.edu)

Development and characterization of high-gradient cobalt-tipped cantilevers

Jonilyn G. Longenecker [a,*], Alexander W. Senko [b], H. J. Mamin [c], Lei Chen [a], Charles T. Rettner [c], Daniel Rugar [c], and John A. Marohn [a]

[a] Dept. of Chemistry and Chemical Biology, Cornell University, Ithaca, New York 14853
[b] Dept. of Materials Science and Engineering, Cornell University, Ithaca, New York 14853
[c] IBM Research Division, Almaden Research Center, San Jose, California 95120
* Email: jgl62@cornell.edu

At previous NanoMRI Conferences we have described the fabrication of nickel nanomagnets on attonewton-sensitivity silicon cantilevers for use in magnetic resonance force microscopy (MRFM) experiments. Although we successfully fabricated these tips by (1) separately batch-fabricating blank cantilevers and magnet-tipped silicon microchips and (2) serially combining them using focused ion beam manipulation, the magnets were observed to magnetically saturate at only 50 to 75% of the expected value for undamaged nickel. Furthermore, magnetic materials with high field gradients such as cobalt, which would produce significantly higher tip field gradients and thus greatly improve imaging acquisition time, were incompatible with post-deposition processing steps. 

Here we detail a revised fabrication protocol that has been used to successfully produce cobalt-tipped cantilevers. Significant characterization of the elemental composition, magnetization, and coercive field of thin cobalt films was conducted using X-ray photoelectron spectroscopy (XPS) depth profiling, superconducting quantum interference device (SQUID) magnetometry, and frequency shift cantilever magnetometry. The tip field and tip field gradient for one of the cobalt nanomagnet-tipped cantilevers were measured by detecting magnetic resonance signal from a polystyrene film. The obtained tip field gradient was estimated to be between 4.4 and 5.4 MT/m, which is nearly an order of magnitude higher than prior magnet-tipped cantilevers employed in MRFM experiments.},
  Keywords                 = {marohn-talk-contributed, grant-Marohn-NIH-5R01GM-070012, grant-Sidles-ARO-W911NF-05-1-0403, grant-CNS-NSF-EEC-0646547, grant-CNS-NSF-EEC-0117770},
  Owner                    = {jam99},
  Timestamp                = {2012.10.11},
  Url                      = {http://www.spin.ethz.ch/NanoMRI}
}

