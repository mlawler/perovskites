@Article{Kerner2017may,
  author    = {Kerner, Ross A. and Rand, Barry P.},
  title     = {Linking Chemistry at the TiO$_{2}$/CH$_{3}$NH$_{3}$PbI$_{3}$Interface to Current--Voltage Hysteresis},
  volume    = {8},
  number    = {10},
  pages     = {2298 -- 2303},
  doi       = {10.1021/acs.jpclett.7b00712},
  url       = {http://dx.doi.org/10.1021/acs.jpclett.7b00712},
  abstract  = {We demonstrate that reversible chemical reactions occur at TiO2/gas and CH3NH3PbI3/gas interfaces on a time scale of seconds to minutes. The chemisorption strongly affects their electronic properties, mainly acting to deplete TiO2 of free electrons and passivate surface traps on the perovskite. Although the chemistry is not directly probed, we infer that reversible chemistry occurs at the solid-state TiO2/CH3NH3PbI3 interface. Equilibrium or steady-state concentrations established for adsorbed species associated with each material would be voltage- and illumination-dependent due to free or photocarriers being a main reactant. Interfacial chemistry provides an additional physical mechanism to explain the origins of normal and anomalous hysteretic current voltage characteristics of perovskite devices. Furthermore, chemical reactions help us to understand why measured perovskite ion-transport properties and the nature of hysteresis are highly dependent on interfaces.},
  comment   = {Suggested filename = {Kerner2017may Linking Chemistry at the TiO2/CH3NH3PbI3 Interface to Current--Voltage Hysteresis.pdf},
Source = {wxdoi2bib},
Cited = {jam99, 04.05.18: 4 times},
Notes = {jam99, 04.05.18: "Our results strongly indicate that hysteresis is not solely due toion motion and stoichiometric polarization".}},
  file      = {:Kerner2017may Linking Chemistry at the TiO2\:CH3NH3PbI3 Interface to Current--Voltage Hysteresis.pdf:PDF},
  journal   = {J. Phys. Chem. Lett.},
  keywords  = {project > EFM, personnel > Tirmzi, materials > semiconductor > perovskite, materials > semiconductor > perovskite > contacts, materials > semiconductor > perovskite > contacts > TiO2, materials > semiconductor > perovskite > contacts > ion motion},
  month     = {may},
