  comment   = {Search = (((CdSe) WN KY) AND ((permanent dipole moment) WN KY)), which returns only 7 references. Suggested filename = Seufert2001aug Stark effect and polarizability in a single CdSe/ZnSe quantum dot 10.1063/1.1389504 *.pdf},
  copyright = {Copyright 2001, IEE},
