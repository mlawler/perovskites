@Article{Weiss2016oct,
  author    = {Weiss, Leah R. and Bayliss, Sam L. and Kraffert, Felix and Thorley, Karl J. and Anthony, John E. and Bittl, Robert and Friend, Richard H. and Rao, Akshay and Greenham, Neil C. and Behrends, Jan},
  title     = {Strongly Exchange-coupled Triplet Pairs in an Organic Semiconductor},
  volume    = {13},
  number    = {2},
  pages     = {176 -- 181},
  doi       = {10.1038/nphys3908},
  url       = {http://dx.doi.org/10.1038/nphys3908},
  abstract  = {From biological complexes to devices based on organic semiconductors, spin interactions play a key role in the function of molecular systems. For instance, triplet-pair reactions impact operation of organic light-emitting diodes as well as photovoltaic devices. Conventional models for triplet pairs assume they interact only weakly. Here, using electron spin resonance, we observe long-lived, strongly interacting triplet pairs in an organic semiconductor, generated via singlet fission. Using coherent spin manipulation of these two-triplet states, we identify exchange-coupled (spin-2) quintet complexes coexisting with weakly coupled (spin-1) triplets. We measure strongly coupled pairs with a lifetime approaching 3 [micro]s and a spin coherence time approaching 1 [micro]s, at 10 K. Our results pave the way for the utilization of high-spin systems in organic semiconductors.},
  comment   = {Suggested filename = {Weiss2016oct Strongly Exchange-coupled Triplet Pairs in an Organic Semiconductor.pdf},
Source = {wxdoi2bib}},
