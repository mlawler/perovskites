@Article{Ciuchi2009jan,
  author    = {Ciuchi, S. and Fratini, S.},
  title     = {Hopping Dynamics of Interacting Polarons},
  journal   = {Phys. Rev. B},
  year      = {2009},
  volume    = {79},
  number    = {3},
  month     = {jan},
  pages     = {035113},
  doi       = {10.1103/PhysRevB.79.035113},
  url       = {http://dx.doi.org/10.1103/PhysRevB.79.035113},
  abstract  = {We derive an effective cluster model to address the transport properties of mutually interacting small polarons. We propose a decoupling scheme where the hopping dynamics of any given particle is determined by separating out explicitly the degrees of freedom of its environment, which are treated as a statistical bath. The general cavity method developed here shows that the long-range Coulomb repulsion between the carriers leads to a net increase in the thermal activation barrier for electrical transport and hence to a sizable reduction in the carrier mobility. A mean-field calculation of this effect is provided based on the known correlation functions of the interacting liquid in two and three dimensions. The present theory gives a natural explanation of recent experiments performed in organic field-effect transistors with highly polarizable gate dielectrics and might well find application in other classes of polaronic systems such as doped transition-metal oxides.},
  comment   = {Suggested filename = Ciuchi2009jan Hopping Dynamics of Interacting Polarons 10.1103/PhysRevB.79.035113 *.pdf'},
  file      = {Ciuchi2009jan Hopping Dynamics of Interacting Polarons 10.1103\:PhysRevB.79.035113 *.pdf:UNSORTED/Ciuchi2009jan Hopping Dynamics of Interacting Polarons 10.1103\:PhysRevB.79.035113 *.pdf:PDF;Ciuchi2009jan--README.rtf:UNSORTED/Ciuchi2009jan--README.rtf:Rich Text Format},
  keywords  = {charge transport > theory > Coulomb interactions},
  owner     = {jam99},
  timestamp = {2013.01.22},
}

