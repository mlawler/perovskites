@Article{Chen2012jan,
  author    = {Chen, LeuJen and Kim, Seong Heon and Lee, Alfred K. H. and de Lozanne, Alex},
  title     = {Simple Electronics for Inertial and Pan-type Piezoelectric Positioners Used in Scanning Probe Microscopes},
