@Article{Ramanathan1996aug,
  author    = {Ramanathan, Chandrasekhar and Wu, Yaotang and Pfleiderer, Bettina and Lizak, Martin J. and Garrido, Leoncio and Ackerman, Jerome L.},
  title     = {{ADRF-CP} Surface-Coil Spectroscopy of Synthetic Calcium Phosphates and Bone Mineral},
  journal   = {J. Magn. Reson., Ser. A},
