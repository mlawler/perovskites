@Article{Li2011jun,
  author    = {Li, Jing and Park, Jong Keun and Moore, Robert B. and Madsen, Louis A.},
  title     = {Linear coupling of alignment with transport in a polymer electrolyte membrane},
  journal   = {Nat Mater},
  year      = {2011},
  volume    = {10},
  number    = {7},
  month     = {jun},
  pages     = {507 -- 511},
  doi       = {10.1038/nmat3048},
  url       = {http://dx.doi.org/10.1038/nmat3048},
  abstract  = {Polymer electrolyte membranes (PEMs) selectively transport ions and polar molecules in a robust yet formable solid support. Tailored PEMs allow for devices such as solid-state batteries,‘artificial muscle’ actuators and reverse-osmosis water purifiers. Understanding how PEM structure and morphology relate to mobile species transport presents a challenge for designing next-generation materials. Material length scales from subnanometre1, 2 to 1 μm (refs 3, 4) influence bulk properties such as ion conductivity and water transport. Here we employ multi-axis pulsed-field-gradient NMR (ref. 5) to measure diffusion anisotropy, and 2H NMR spectroscopy5, 6 and synchrotron small-angle X-ray scattering7 to probe orientational order as a function of water content and of membrane stretching. Strikingly, transport anisotropy linearly depends on the degree of alignment, signifying that membrane stretching affects neither the nanometre-scale channel dimensions nor the defect structure,causing only domain reorientation. The observed reorientation of anisotropic domains without perturbation of the inherent nematic-like domain character parallels the behaviour of nematic elastomers8, promises tailored membrane conduction and potentially allows understanding of tunable shape-memory effects in PEM materials9. This quantitative understanding will drive PEM design efforts towardsoptimal membrane transport, thus enabling more efficient polymeric batteries, fuel cells, mechanical actuators and water purification.},
  comment   = {Suggested filename = Li2011jun Linear coupling of alignment with transport in a polymer electrolyte membrane 10.1038/nmat3048 *.pdf},
  file      = {Li2011jun Linear coupling of alignment with transport in a polymer electrolyte membrane 10.1038\:nmat3048 *.pdf:UNSORTED/Li2011jun Linear coupling of alignment with transport in a polymer electrolyte membrane 10.1038\:nmat3048 *.pdf:PDF},
  keywords  = {materials > ionic conductors > characterization > PFGNMR, materials > ionic conductors > characterization > SAXS, materials > ionic conductors > characterization > 2H NMR},
  owner     = {jam99},
  timestamp = {2012.06.04},
}

@Article{Li2009apr,
  author    = {Li, Mo and Pernice, W. H. P. and Tang, H. X.},
  title     = {Broadband all-photonic transduction of nanocantilevers},
  journal   = {Nature Nanotech},
  year      = {2009},
  volume    = {4},
  number    = {6},
  month     = {apr},
  pages     = {377 -- 382},
  doi       = {10.1038/nnano.2009.92},
  url       = {http://dx.doi.org/10.1038/nnano.2009.92},
  abstract  = {Nanoelectromechanical systems1, 2 based on cantilevers have consistently set records for sensitivity in measurements of displacement3, force4 and mass3, 5, 6 over the past decade. Continued progress will require the integration of efficient transduction on a chip so that nanoelectromechanical systems may be operated at higher speeds and sensitivities. Conventional electrical schemes have limited bandwidth7, 8, and although optical methods9, 10 are fast, they are subject to the diffraction limit. Here, we demonstrate the integration of nanocantilevers on a silicon photonic platform with a non-interferometric transduction scheme that avoids the diffraction limit by making use of near-field effects in optomechanical interactions11. The use of a non-interferometric method means that a coherent light source is not required, making the monolithic integration of optomechanical systems with on-chip light sources feasible. We further demonstrate optomechanical multiplexing of an array of ten nanocantilevers with a displacement sensitivity of 40 fm Hz−1/2.},
  comment   = {Suggested filename = Li2009apr Broadband all-photonic transduction of nanocantilevers 10.1038/nnano.2009.92 *.pdf},
  file      = {Li2009apr Broadband all-photonic transduction of nanocantilevers 10.1038\:nnano.2009.92 *.pdf:UNSORTED/Li2009apr Broadband all-photonic transduction of nanocantilevers 10.1038\:nnano.2009.92 *.pdf:PDF},
  keywords  = {cantilever > self-sensing, cantilever > readout > nano-photonic},
  owner     = {jam99},
  timestamp = {2012.05.19},
}

@Article{Li2007jana,
  author    = {Li, Mo and Tang, H. X. and Roukes, M. L.},
  title     = {Ultra-sensitive NEMS-based cantilevers for sensing, scanned probe and very high-frequency applications},
  journal   = {Nature Nanotech},
  year      = {2007},
  volume    = {2},
  number    = {2},
  month     = {jan},
  pages     = {114 -- 120},
  doi       = {10.1038/nnano.2006.208},
  url       = {http://dx.doi.org/10.1038/nnano.2006.208},
  abstract  = {Scanning probe microscopies (SPM) and cantilever-based sensors generally use low-frequency mechanical devices of microscale dimensions or larger. Almost universally, off-chip methods are used to sense displacement in these devices, but this approach is not suitable for nanoscale devices. Nanoscale mechanical sensors offer a greatly enhanced performance that is unattainable with microscale devices. Here we describe the fabrication and operation of self-sensing nanocantilevers with fundamental mechanical resonances up to very high frequencies (VHF). These devices use integrated electronic displacement transducers based on piezoresistive thin metal films, permitting straightforward and optimal nanodevice readout. This non-optical transduction enables applications requiring previously inaccessible sensitivity and bandwidth, such as fast SPM and VHF force sensing. Detection of 127 MHz cantilever vibrations is demonstrated with a thermomechanical-noise-limited displacement sensitivity of 39 fm Hz−1/2. Our smallest devices, with dimensions approaching the mean free path at atmospheric pressure, maintain high resonance quality factors in ambient conditions. This enables chemisorption measurements in air at room temperature, with unprecedented mass resolution less than 1 attogram (10−18 g).},
  comment   = {Suggested filename = Li2007jana Ultra-sensitive NEMS-based cantilevers for sensing, scanned probe and very high-frequency applications 10.1038/nnano.2006.208 *.pdf},
  file      = {Li2007jana Ultra-sensitive NEMS-based cantilevers for sensing, scanned probe and very high-frequency applications 10.1038\:nnano.2006.208 *.pdf:UNSORTED/Li2007jana Ultra-sensitive NEMS-based cantilevers for sensing, scanned probe and very high-frequency applications 10.1038\:nnano.2006.208 *.pdf:PDF},
  keywords  = {cantilever > self-sensing, cantilever > readout > piezoresistor},
  owner     = {jam99},
  timestamp = {2012.05.19},
}

@Article{Li2014jan,
  author    = {Li, Mingguang and Wang, Lei and Liu, Jiangang and Zhou, Ke and Yu, Xinhong and Xing, Rubo and Geng, Yanhou and Han, Yanchun},
  title     = {Cooperative Effects of Solvent and Polymer Acceptor Co-additives in {P3HT:PDI} Solar Cells: {S}imultaneous Optimization in Lateral and Vertical Phase Separation},
  journal   = {Phys. Chem. Chem. Phys.},
  year      = {2014},
  volume    = {16},
  number    = {10},
  month     = {jan},
  pages     = {4528},
  doi       = {10.1039/c3cp55075c},
  url       = {http://dx.doi.org/10.1039/c3cp55075c},
  abstract  = {In this work, solvent chloronaphthalene (CN) and polymer acceptor an alternating copolymer of perylene diimide and carbazole (PCPDI) were utilized as co-additives to optimize the nanoscale phase-separated morphology and photovoltaic properties of bulk-heterojunction (BHJ) polymer solar cells based on the poly(3-hexyl thiophene) (P3HT)/N,N-bis(1-ethylpropyl)-perylene-3,4,9,10-tetracarboxylic diimide (EP-PDI) system. The domain size of EP-PDI molecules together with that of P3HT distinctly decreased by adding a 0.75 vol percent CN additive. The optimized lateral phase separation increased the donor-acceptor interfacial area and facilitated the exciton dissociation process, leading to 5-fold enhancement of short-circuit current (JSC). Furthermore, when PCPDI was employed as a co-additive, acceptor materials (including PCPDI and EP-PDI) were prone to aggregation towards the top surface of blend films, improving vertical phase separation of active layers. PCPDI incorporation, which improved the percolation pathways for electron carriers, suppressed the crystallinity of P3HT distinctly. Thus, much more balanced charge transport was achieved by PCPDI addition, which resulted in almost 1-fold enhancement of open-circuit voltage (VOC) by reducing nongeminate recombination. As a consequence, cooperative effects of CN and PCPDI additives improved the nanoscale phase-separated morphology in lateral and vertical directions simultaneously, achieving the enhancement in both VOC and JSC.},
  comment   = {Suggested filename = {Li2014jan Cooperative Effects of Solvent and Polymer Acceptor Co-additives in P3HT ~ PDI Solar Cells ~ Simultaneous Optimization in Lateral and Vertical Phase Separation.pdf},
Source = {wxdoi2bib}},
  keywords  = {materials > PES > PDI > EP-PDI, materials > PES > P3HT, devices > solar cell > bulk heterojunction > solvent additive},
  owner     = {jam99},
  timestamp = {2016.01.20},
}

@Article{Li2013mar,
  author    = {Li, Mengyuan and Wondergem, Harry J. and Spijkman, Mark-Jan and Asadi, Kamal and Katsouras, Ilias and Blom, Paul W. M. and de Leeuw, Dago M.},
  title     = {Revisiting the $\delta$-phase of Poly(vinylidene Fluoride) for Solution-processed Ferroelectric Thin Films},
  journal   = {Nat Mater},
  year      = {2013},
  month     = {mar},
  doi       = {10.1038/nmat3577},
  url       = {http://dx.doi.org/10.1038/nmat3577},
  abstract  = {erroelectric poly(vinylidene-fluoride) (PVDF) has, in the past, been proposed as an ideal candidate for data storage applications as it exhibits a bistable, remanent, polarization that can repeatedly be switched by an electric field. However, fabrication of smooth ferroelectric PVDF thin films, as required for microelectronic applications, is a long-standing problem. At present, the copolymer of PVDF with trifluoroethylene P(VDF--TrFE) is used, but the stack integrity and the limited thermal stability of its remanent polarization hamper large-scale integration. Here we show that smooth neat PVDF films can be made at elevated substrate temperature. On applying a short electrical pulse the ferroelectric polar $\delta$-phase is formed, an overlooked polymorph of PVDF proposed 30 years ago, but never experimentally verified. The remanent polarization and coercive field are comparable to those of the copolymer. The enhanced thermal stability of the polarization is directly related to the high Curie temperature, whereas the ferroelectric properties are related to the molecular packing as derived from the refined crystal structure. The replacement of P(VDF--TrFE) by the commodity polymer PVDF may boost large-scale industrial applications.},
  comment   = {Suggested filename = {Li2013mar Revisiting the delta-phase of Poly(vinylidene Fluoride) for Solution-processed Ferroelectric Thin Films.pdf}},
  file      = {Li2013mar Revisiting the delta-phase of Poly(vinylidene Fluoride) for Solution-processed Ferroelectric Thin Films.pdf:UNSORTED/Li2013mar Revisiting the delta-phase of Poly(vinylidene Fluoride) for Solution-processed Ferroelectric Thin Films.pdf:PDF},
  keywords  = {materials > ferroelectric, materials > ferroelectric > matl's > organic},
  owner     = {jam99},
  timestamp = {2013.03.25},
}

@Article{Li2003sep,
