  doi       = {10.1063/1.372855},
  url       = {http://dx.doi.org/10.1063/1.372855},
  abstract  = {Thermally excited magnetic fluctuations are fundamental to the behavior of small ferromagnetic particles and have practical consequences for the proposed detection of individual spins by magnetic resonance force microscopy (MRFM). In particular, fluctuating fields from a nearby magnetic tip can increase the relaxation rate of spins in a sample if there is significant spectral density of field fluctuation at the Larmor frequency of the target spin. As an initial step toward understanding this issue, magnetic field fluctuations have been simulated which emanate from a magnetic tip with dimensions 60 nmx60 nmx2 mu m. It was found that the fluctuations in a cobalt magnetic tip were too strong for MRFM experiments aimed at detecting individual electron spins. However, the results obtained for a PrFeB tip fell within the tolerance required. (C) 2000 American Institute of Physics. [S0021-8979(00)81308-0].},
  cl        = {SAN JOSE, CALIFORNIA},
  comment   = {Suggested filename = Hannay2000may Thermal field fluctuations in a magnetic tip/implications for magnetic resonance force microscopy10.1063/1.372855 *.pdf},
  ct        = {44th Annual Conference on Magnetism and Magnetic Materials},
  cy        = {NOV 15-18, 1999},
  file      = {Hannay2000may Thermal field fluctuations in a magnetic tip\:implications for magnetic resonance force microscopy10.1063\:1.372855 *.pdf:UNSORTED/Hannay2000may Thermal field fluctuations in a magnetic tip\:implications for magnetic resonance force microscopy10.1063\:1.372855 *.pdf:PDF},
  keywords  = {nanomagnetics > fluctuations, nanomagnetics > simulation},
  owner     = {jam99},
