  number       = {2},
  month        = {mar},
  pages        = {151 -- 154},
  issn         = {1005-0302},
  abstract     = {The magnetization reversal mechanisms for Ni nanowires with different diameters were investigated by micromagnetic simulations. The results show that the reversal mechanisms are significantly dependent on the diameter of wire. For very thin wires, the reversal occurs by pseudo-coherent rotation. With increasing diameter, magnetization reversal takes place via different nucleation (the transverse domain wall and the vortex domain wall) and subsequent propagation. The reason of transition from the transverse domain wall to the vortex domain wall is given by analytical studies. With further increase of the diameter, the reversal nuclear domain wall becomes tundish-shaped form. As the diameter increases, the width of wall becomes larger.},
  affiliation  = {Guo, GH (Reprint Author), Cent S Univ Technol, Sch Phys Sci \& Technol, Changsha 410083, Peoples R China. {[}Han, Nianmei; Guo, Guanghua; Zhang, Lamei; Zhang, Guangfu; Song, Wenbin] Cent S Univ Technol, Sch Phys Sci \& Technol, Changsha 410083, Peoples R China. {[}Guo, Guanghua] Cent S Univ Technol, State Key Lab Powder Met, Changsha 410083, Peoples R China.},
