@article{Biliroglu2022apr,
  title = {Room-Temperature Superfluorescence in Hybrid Perovskites and Its Origins},
  author = {Biliroglu, Melike and Findik, Gamze and Mendes, Juliana and Seyitliyev, Dovletgeldi and Lei, Lei and Dong, Qi and Mehta, Yash and Temnov, Vasily V. and So, Franky and Gundogdu, Kenan},
  year = 2022,
