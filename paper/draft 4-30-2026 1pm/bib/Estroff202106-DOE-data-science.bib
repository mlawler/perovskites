@article{Thota2023nov,
  title = {{{NestedAE}}: {{Interpretable Nested Autoencoders}} for {{Multi-Scale Material Modelling}}},
  shorttitle = {{{NestedAE}}},
  author = {Thota, Nikhil Kumar and Sharma Priyadarshini, Maitreyee and Hernandez, Rigoberto},
