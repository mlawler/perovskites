@Article{Meier2004apr,
  author    = {Meier, Frank and Eigenberger, Gerhart},
  title     = {Transport Parameters for the Modelling of Water Transport in Ionomer Membranes for {PEM}-fuel Cells},
  journal   = {Electrochimica Acta},
  year      = {2004},
  volume    = {49},
  number    = {11},
  month     = {apr},
  pages     = {1731 -- 1742},
  doi       = {10.1016/j.electacta.2003.12.004},
  url       = {http://dx.doi.org/10.1016/j.electacta.2003.12.004},
  abstract  = {The water transport number (drag coefficient) and the hydraulic permeability were measured for Nafion. The results show a significant increase of both parameters with increasing water content indicating that they are strongly influenced by the membrane microstructure. Based on these experimental studies a new model approach to describe water transport in the H2-PEFC membrane is presented. This approach considers water transport by electro-osmosis caused by the proton flux through the membrane and by osmosis caused by a gradient in the chemical potential of water. It is parametrized by the measured data for the water transport number and the hydraulic permeability of Nafion. First simulation results applying this approach to a one-dimensional model of the H2-PEFC show good agreement with experimental data. Therefore, the developed model can be used for a new insight into the dominating mechanisms of water transport in the membrane.},
  comment   = {Suggested filename = {Meier2004apr Transport Parameters for the Modelling of Water Transport in Ionomer Membranes for PEM-fuel Cells.pdf}},
