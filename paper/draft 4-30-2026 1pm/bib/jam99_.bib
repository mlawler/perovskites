  journal   = {ACS Chem. Biol.},
  keywords  = {project > MRFM, magnetic resonance > labeling, magnetic resonance > labeling > in vivo, biology > labeling > protein, biology > labeling > in vivo, biology > protein > membrane},
  month     = {dec},
