  issn      = {1064-1858},
  doi       = {10.1006/jmra.1995.1059},
  url       = {http://dx.doi.org/10.1006/jmra.1995.1059},
  abstract  = {The time evolution of dipolar-dephasing NMR signals reveals the strength of dipolar couplings in solids. In most instances where microcrystalline samples are investigated, numerical simulations of dipolar-dephasing intensities provide fits to experimental data in order to determine internuclear distances. In this paper, analytic solutions are derived for the time evolution of signals in heteronuclear SEDOR, REDOR, and TEDOR experiments. These solutions, in terms of infinite series of Bessel functions of the first kind, are exact and replace a numerical integration over the possible orientations of the internuclear vectors in a powdered or amorphous sample. Results from the analytic solutions converge rapidly and are compared here with results from numerical integration. A method for efficient least-squares fitting of dipolar-dephasing data is also demonstrated, including fits to experimental SEDOR and TEDOR dephasing curves},
  address   = {USA},
  comment   = {search = INSPEC "SEDOR"; one of ~70 references. Note the early references to Erwin Hahn's introduction of SEDOR in the late 1950's and early 1960's./ Suggested filename = Mueller1995mar Analytic solutions for the time evolution of dipolar-dephasing NMR signals 10.1006/jmra.1995.1059 *.pdf},
