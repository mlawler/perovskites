@Article{Fujii2009nov,
  author    = {Fujii, Takashi and Kato, Takayuki and Namba, Keiichi},
  title     = {Specific Arrangement of α-Helical Coiled Coils in the Core Domain of the Bacterial Flagellar Hook for the Universal Joint Function},
